#!/bin/sh
# The daily schedule that runs scripts/sync. Run it through sync (sync --schedule [HH:MM],
# --schedule-status, --unschedule); doctor runs `sync-schedule status`.
#
# On macOS it is a launch agent of this user, com.agent-skills.sync in ~/Library/LaunchAgents. It
# runs `scripts/sync --from-schedule` of this checkout once a day (08:30 unless a time is given;
# launchd runs a time missed while the Mac slept when it wakes), with standard input from /dev/null,
# so nothing can wait for an answer, and its output appended to ~/Library/Logs/agent-skills-sync.log.
# Its PATH is the installing shell's, limited to folders that exist, so it finds git, node and npm;
# AGENT_SKILLS_PRIVATE, AGENT_SKILLS_STATE, AGENT_SKILLS_COMPUTER and XDG_STATE_HOME go with it when
# they are set. Installing replaces an agent with the same label, a hand-made one included, and
# changes nothing when the same agent is already installed and loaded. Every agent it replaces or
# removes is moved into ~/Library/LaunchAgents/.agent-skills-sync-backups/, on the agents' own
# volume, so the move keeps the file itself (a program still writing to it writes into the
# backup). Hand-made and changed ones stay there; of the ones it wrote and nobody changed, the newest
# three stay (an older one goes once nothing has touched it for a day and lsof finds no program
# holding it open; without lsof, none goes). Backups from before that folder existed stay in
# ${XDG_STATE_HOME:-~/.local/state}/agent-skills-sync/.
#
# Elsewhere it prints the line to add to cron and changes nothing.
#
#   sync-schedule install [HH:MM]   install or replace the schedule
#   sync-schedule remove [--dry-run]
#                                   remove it (uninstall --all runs this)
#   sync-schedule status            INFO or WARN lines, as doctor prints them: whether it is
#                                   installed, and when it last ran, from the log. Never FAIL.
#   sync-schedule trim-log          keeps the log under AGENT_SKILLS_SYNC_LOG_MAX bytes (1 MiB unless
#                                   set): over it, only its last quarter stays, from a whole line on,
#                                   bytes and line ends as they were. sync --from-schedule runs this.
#
# AGENT_SKILLS_SCHEDULER=launchd|cron chooses the kind regardless of the system (tests use it).
set -u

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
label=com.agent-skills.sync
# Every agent this script writes has this comment as its second line, after the XML declaration,
# ending with the checksum of the plist's other lines, so a hand edit is seen.
marker='<!-- Written by agent-skills scripts/sync-schedule: change it with scripts/sync and its schedule options, not here. Checksum: '
start_marker='agent-skills sync started '
finish_marker='agent-skills sync finished '

usage() {
  echo "Usage: sync-schedule install [HH:MM] | remove [--dry-run] | status | trim-log" >&2
}

case "${AGENT_SKILLS_SCHEDULER:-}" in
  launchd|cron) scheduler=$AGENT_SKILLS_SCHEDULER ;;
  "") if [ "$(uname -s)" = Darwin ]; then scheduler=launchd; else scheduler=cron; fi ;;
  *) echo "sync-schedule: AGENT_SKILLS_SCHEDULER is launchd or cron, not $AGENT_SKILLS_SCHEDULER" >&2; exit 2 ;;
esac
agents_dir=$HOME/Library/LaunchAgents
plist=$agents_dir/$label.plist
if [ "$scheduler" = launchd ]; then
  log=$HOME/Library/Logs/agent-skills-sync.log
else
  log=${XDG_STATE_HOME:-$HOME/.local/state}/agent-skills-sync.log
fi
# Beside the agents, hidden, so a backup is the same file under another name (launchd reads only
# *.plist files directly in the folder, and no backup name ends in .plist).
backups=$agents_dir/.agent-skills-sync-backups
# Where backups went before: still named in the status, never changed.
old_backups=${XDG_STATE_HOME:-$HOME/.local/state}/agent-skills-sync
# How many of the agents this script wrote, unchanged, stay in the backup folder; and an older one
# goes only when nothing has changed it, or linked it, for AGENT_SKILLS_SYNC_PRUNE_MINUTES (a day
# unless set; 0, as tests use, for no wait): a program that held it open and wrote to it after the
# check would lose that write.
keep_intact=3
prune_minutes=${AGENT_SKILLS_SYNC_PRUNE_MINUTES:-1440}
case "$prune_minutes" in ''|*[!0-9]*) prune_minutes=1440 ;; esac
domain=gui/$(id -u)

# $1 with &, < and > written as XML writes them.
xml() {
  printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

# $1 in single quotes, for a shell.
quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# The installing shell's PATH, without relative entries, folders that don't exist or repeats, and
# with the system's own folders at the end if it lacks them.
schedule_path() {
  kept=
  old_ifs=$IFS
  IFS=:
  set -f
  # shellcheck disable=SC2086
  set -- $PATH /usr/bin /bin /usr/sbin /sbin
  set +f
  IFS=$old_ifs
  for entry in "$@"; do
    case "$entry" in /*) ;; *) continue ;; esac
    [ -d "$entry" ] || continue
    case ":$kept:" in *":$entry:"*) continue ;; esac
    kept=${kept:+$kept:}$entry
  done
  printf '%s\n' "$kept"
}

# Reading a plist: with plutil -extract (macOS has it), whatever its layout or format. Where that
# can't give the value (no plutil, or one before macOS 12, without the raw format), from the plist as
# XML on one line: plutil -convert xml1 reads binary and JSON plists too, and without plutil the file
# is read as XML.
plist_flat() {
  if command -v plutil >/dev/null 2>&1; then plutil -convert xml1 -o - "$1" 2>/dev/null; else cat "$1" 2>/dev/null; fi |
    tr '\n\r\t' '   ' | sed -e 's/>[[:space:]]*</></g'
}

# From plist_flat on standard input: the text of the first element that follows $1 (one or more
# tags, such as <key>Label</key><string>), up to the next tag, with &, < and > as they are.
flat_value() {
  awk -v lead="$1" '{
    at = index($0, lead); if (at == 0) exit
    rest = substr($0, at + length(lead)); end = index(rest, "<"); if (end == 0) exit
    value = substr(rest, 1, end - 1)
    gsub(/&lt;/, "<", value); gsub(/&gt;/, ">", value); gsub(/&amp;/, "\\&", value)
    print value; exit
  }'
}

# The Label of the plist $1, or nothing.
plist_label() {
  if command -v plutil >/dev/null 2>&1; then
    plutil -extract Label raw -o - "$1" 2>/dev/null && return 0
  fi
  plist_flat "$1" | flat_value '<key>Label</key><string>'
}

# The launch agents' files that carry this label, whatever their names.
labelled_plists() {
  [ -d "$agents_dir" ] || return 0
  for candidate in "$agents_dir"/*.plist; do
    [ -f "$candidate" ] || continue
    [ "$(plist_label "$candidate")" = "$label" ] && printf '%s\n' "$candidate"
  done
}

# The checksum of a plist's lines other than its second.
plist_sum() {
  sed 2d "$1" | cksum | awk '{ print $1 "-" $2 }'
}

# Did this script write $1? Its second line is the marker.
is_ours() {
  [ -f "$1" ] || return 1
  case "$(sed -n 2p "$1")" in "$marker"*) return 0 ;; esac
  return 1
}

# Did this script write $1, and has nobody changed it since? Only such a backup may be deleted, when
# newer ones like it are kept (prune_backups).
is_intact() {
  is_ours "$1" && [ "$(sed -n 2p "$1")" = "$marker$(plist_sum "$1") -->" ]
}

# HH:MM (or H:MM) to "hour minute", or nothing when it isn't a time of day.
parse_time() {
  printf '%s\n' "$1" | awk -F: 'NF == 2 && $1 ~ /^[0-9][0-9]?$/ && $2 ~ /^[0-9][0-9]$/ && $1 + 0 < 24 && $2 + 0 < 60 { print $1 + 0, $2 + 0 }'
}

# The time of day the plist $1 runs at, as HH:MM, or nothing.
plist_time() {
  if command -v plutil >/dev/null 2>&1 &&
    at_hour=$(plutil -extract StartCalendarInterval.Hour raw -o - "$1" 2>/dev/null) &&
    at_minute=$(plutil -extract StartCalendarInterval.Minute raw -o - "$1" 2>/dev/null); then
    case "$at_hour" in ''|*[!0-9]*) return 0 ;; esac
    case "$at_minute" in ''|*[!0-9]*) return 0 ;; esac
    # As numbers: a leading zero would be read as octal.
    printf '%02d:%02d\n' "$(expr "$at_hour" + 0)" "$(expr "$at_minute" + 0)"
    return 0
  fi
  flat=$(plist_flat "$1")
  at_hour=$(printf '%s\n' "$flat" | flat_value '<key>Hour</key><integer>')
  at_minute=$(printf '%s\n' "$flat" | flat_value '<key>Minute</key><integer>')
  case "$at_hour" in ''|*[!0-9]*) return 0 ;; esac
  case "$at_minute" in ''|*[!0-9]*) return 0 ;; esac
  printf '%02d:%02d\n' "$(expr "$at_hour" + 0)" "$(expr "$at_minute" + 0)"
}

# The program the plist $1 runs: the first of its ProgramArguments.
plist_program() {
  if command -v plutil >/dev/null 2>&1 && plutil -extract ProgramArguments.0 raw -o - "$1" 2>/dev/null; then
    echo
    return 0
  fi
  plist_flat "$1" | flat_value '<key>ProgramArguments</key><array><string>'
}

# One --schedule or --unschedule at a time for this home's LaunchAgents folder, whatever state folder
# a run uses: a folder made in one step beside the agents is the lock (launchd reads only *.plist
# files), and a second run waits up to 30 seconds for it. A run that was killed leaves it behind;
# the message names it.
lock=
take_lock() {
  mkdir -p "$agents_dir" 2>/dev/null || return 0
  waited=0
  until mkdir "$agents_dir/.agent-skills-sync.lock" 2>/dev/null; do
    if [ "$waited" -ge 30 ]; then
      echo "FAIL another scripts/sync --schedule or --unschedule has held $agents_dir/.agent-skills-sync.lock for 30 seconds; if none is running, remove that folder and try again" >&2
      exit 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
  lock=$agents_dir/.agent-skills-sync.lock
}
release_lock() {
  [ -z "$lock" ] || rmdir "$lock" 2>/dev/null || true
  lock=
}

# Do $1 and $2 name the same file (the same path, or the same file reached another way)?
same_file() {
  [ "$1" = "$2" ] || [ "$1" -ef "$2" ]
}

# Is there anything at $1, a link that leads nowhere included?
present() {
  [ -e "$1" ] || [ -L "$1" ]
}

# Renames $1 to $2 only where nothing is at $2 (mv -n would put it inside a folder there), and
# succeeds only when $1 is gone and something is at $2.
move_new() {
  ! present "$2" || return 1
  mv -n "$1" "$2" 2>/dev/null || return 1
  ! present "$1" && present "$2"
}

stamp() {
  date +%Y%m%d-%H%M%S
}

# Moves every file in $1 (one per line) into the backup folder, so that nothing can change one there
# between judging it and letting it go. A file that can't be moved stops it: those already moved go
# back, and nothing else is changed. Sets $staged to "original<TAB>backup" lines.
stage_all() {
  staged=
  tab=$(printf '\t')
  [ -n "$1" ] || return 0
  if ! mkdir -p "$backups" 2>/dev/null; then
    echo "FAIL could not make $backups to keep the launch agents in, so nothing was changed" >&2
    return 1
  fi
  while IFS= read -r original; do
    [ -n "$original" ] || continue
    # Never over a backup already there: another run may have taken the same name meanwhile.
    count=1
    moved=0
    while [ "$count" -le 20 ]; do
      aside="$backups/$(basename -- "$original").before-agent-skills-$(stamp)"
      [ "$count" -eq 1 ] || aside="$aside-$count"
      count=$((count + 1))
      ! present "$aside" || continue
      # A hard link is made only where no file is, in one step: the same file under its backup name.
      # Then the old name goes by a rename into the backup folder, never by deleting the name, so
      # whatever file is there in that instant is what moves, and it is checked: the same file, and
      # this extra name goes; another one (an editor's save just then), and it goes back, while the
      # backup keeps the old one. The backup is never deleted here. Where the folder can't hold hard
      # links, mv -n: on the same volume, a rename, which keeps the file itself too.
      if ln "$original" "$aside" 2>/dev/null; then
        hold="$backups/.moving-$(basename -- "$aside")"
        # (A file saved at the old name again right after this rename is not this run's to judge.)
        if present "$hold" || ! mv -n "$original" "$hold" 2>/dev/null || ! present "$hold"; then
          echo "FAIL could not remove the launch agent $original once it was linked to $aside, which stays as a second name of the same file" >&2
          break
        fi
        if [ "$hold" -ef "$aside" ]; then
          rm -f "$hold"
          moved=1
          break
        fi
        if ! move_new "$hold" "$original"; then
          echo "FAIL another file appeared at $original while it was being moved to $aside, which keeps the old one; the file that appeared is at $hold, since yet another took its place" >&2
        else
          echo "FAIL another file appeared at $original while it was being moved to $aside, which keeps the old one; the file that appeared stays at $original" >&2
        fi
        break
      fi
      ! present "$aside" || continue
      if move_new "$original" "$aside"; then moved=1; fi
      break
    done
    if [ "$moved" -eq 0 ]; then
      before=$(printf '%s' "$staged" | grep -c . || true)
      back=$(unstage_all | grep -c . || true)
      if [ "$back" -eq "$before" ]; then
        echo "FAIL could not move the launch agent $original into $backups, so no agent was moved or unloaded" >&2
      else
        echo "FAIL could not move the launch agent $original into $backups; no agent was unloaded, and those moved before it that couldn't go back are named above" >&2
      fi
      return 1
    fi
    staged="$staged$original$tab$aside
"
  done <<EOF
$1
EOF
}

# Puts the staged files back where they were, never over a file that appeared there meanwhile, and
# prints each one put back. Those that can't go back stay in the backup folder, and it says so.
unstage_all() {
  printf '%s' "$staged" | while IFS="$tab" read -r original aside; do
    [ -n "$original" ] || continue
    if ! move_new "$aside" "$original"; then
      echo "FAIL could not put $aside back as $original (another file is there now, or the folder can't be written): move it back by hand" >&2
    else
      printf '%s\n' "$original"
    fi
  done
}

# Keeps every staged file where it is now, in the backup folder, and names each one: a program may
# still hold one open and write to it. Then prune_backups.
judge_staged() {
  printf '%s' "$staged" | while IFS="$tab" read -r original aside; do
    [ -n "$original" ] || continue
    if is_intact "$aside"; then
      echo "KEPT the launch agent $original, unchanged since agent-skills wrote it, at $aside"
    elif is_ours "$aside"; then
      echo "KEPT the launch agent $original, changed since agent-skills wrote it, as $aside"
    else
      echo "KEPT the launch agent $original, which agent-skills didn't write, as $aside"
    fi
  done
  prune_backups
}

# Of the backups this script wrote and nobody changed, the newest $keep_intact stay and the older
# ones go, so the folder doesn't grow with every new time. A hand-made or changed one always stays,
# as does anything in the folder before it existed ($old_backups), every backup this run made (it
# counts as the newest), any changed in the last $prune_minutes minutes and any a program holds
# open. Newest by its name's time, then its count within that second (a name without one is that
# second's first), whatever another run's clock said.
prune_backups() {
  [ -d "$backups" ] || return 0
  for candidate in "$backups"/*.before-agent-skills-*; do
    [ -f "$candidate" ] && [ ! -L "$candidate" ] || continue
    is_intact "$candidate" || continue
    case "$tab$(printf '%s' "$staged" | cut -f 2 | paste -sd "$tab" -)$tab" in
      *"$tab$candidate$tab"*) key="~" ;;
      *) key=$(printf '%s\n' "${candidate##*.before-agent-skills-}" | awk -F - '{ printf "%s-%s-%02d", $1, $2, ($3 == "" ? 1 : $3) }') ;;
    esac
    printf '%s\t%s\n' "$key" "$candidate"
  done | sort -r | awk -F '\t' -v keep="$keep_intact" 'NR > keep && $1 != "~" { print $2 }' | while IFS= read -r older; do
    # Still unchanged a moment later, untouched for $prune_minutes minutes, and open in no program
    # (one that holds it open could still write to it): only then it goes. Without lsof to ask,
    # none goes.
    is_intact "$older" || continue
    command -v lsof >/dev/null 2>&1 || continue
    ! lsof -w -- "$older" >/dev/null 2>&1 || continue
    if [ "$prune_minutes" -gt 0 ] && [ -z "$(find "$older" -prune -cmin +"$prune_minutes" 2>/dev/null)" ]; then
      continue
    fi
    rm -f "$older" && echo "REMOVED the older backup $older, unchanged since agent-skills wrote it ($keep_intact newer ones stay)"
  done
}

# What launchd has loaded with this label, from `launchctl print`; sets $loaded_from to the file its
# `path =` line names. Returns 0 when that file is in this home's LaunchAgents folder; 1 when nothing
# is loaded; 2 when it is loaded from another folder (another home's, as a test's made-up HOME is),
# which is never touched; 3 when it is loaded but the output names no file, since launchctl's format
# changed: the callers then act as if it might be this home's and say so, rather than guess.
loaded_state() {
  loaded_from=
  printed=$(launchctl print "$domain/$label" 2>/dev/null) || return 1
  loaded_from=$(printf '%s\n' "$printed" | awk '/^[[:space:]]*path = / { sub(/^[[:space:]]*path = /, ""); print; exit }')
  case "$loaded_from" in
    "") return 3 ;;
    "$agents_dir"/*) return 0 ;;
  esac
  # The same folder written another way (a home given with a trailing slash, or through a link).
  if [ "$(dirname -- "$loaded_from")" -ef "$agents_dir" ]; then return 0; fi
  return 2
}

# Unloads the agent with this label, and checks with `launchctl print` that launchd let it go (once
# more a moment later). Returns 1 when it is still loaded.
unload() {
  launchctl bootout "$domain/$label" >/dev/null 2>&1 || true
  launchctl print "$domain/$label" >/dev/null 2>&1 || return 0
  sleep 1
  launchctl print "$domain/$label" >/dev/null 2>&1 || return 0
  return 1
}

# With the label loaded from outside this home's LaunchAgents, or from a file launchctl print doesn't
# name ($1 is loaded_state's answer), nothing is changed: that agent is never unloaded here.
refuse_elsewhere() {
  case "$1" in
    2) echo "FAIL launchd has the daily sync ($label) loaded from $loaded_from, outside $agents_dir, so nothing was changed: if it is this home's, launchctl bootout $domain/$label unloads it; then run this again" >&2 ;;
    3) echo "FAIL launchd has the daily sync ($label) loaded, but launchctl print names no file it was loaded from, so nothing was changed: if it is this home's, launchctl bootout $domain/$label unloads it; then run this again" >&2 ;;
    *) return 0 ;;
  esac
  exit 1
}

# "is gone" or "no longer carries the label", for a file launchd loaded an agent from.
gone_or_changed() {
  if [ -e "$1" ] || [ -L "$1" ]; then echo "which no longer carries the label"; else echo "which is gone"; fi
}

# The files that carry the label, and the one at the label's name whatever it carries.
agent_files() {
  { labelled_plists; if [ -e "$plist" ] || [ -L "$plist" ]; then printf '%s\n' "$plist"; fi; } | awk 'NF && !seen[$0]++'
}

# The plist, with the marker and its checksum as the second line.
render_plist() {
  render_body "$@" >"$1.body"
  sed -n 1p "$1.body"
  printf '%s%s -->\n' "$marker" "$(cksum <"$1.body" | awk '{ print $1 "-" $2 }')"
  sed 1d "$1.body"
  rm -f "$1.body"
}

# The plist without its second line: $1 is where it goes, then the hour, minute and PATH.
render_body() {
  hour=$2
  minute=$3
  path=$4
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$label</string>
	<key>ProgramArguments</key>
	<array>
		<string>$(xml "$repo_root/scripts/sync")</string>
		<string>--from-schedule</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>$hour</integer>
		<key>Minute</key>
		<integer>$minute</integer>
	</dict>
	<key>StandardInPath</key>
	<string>/dev/null</string>
	<key>StandardOutPath</key>
	<string>$(xml "$log")</string>
	<key>StandardErrorPath</key>
	<string>$(xml "$log")</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>$(xml "$path")</string>
EOF
  for name in AGENT_SKILLS_PRIVATE AGENT_SKILLS_STATE AGENT_SKILLS_COMPUTER XDG_STATE_HOME; do
    eval "is_set=\${$name+set} value=\${$name-}"
    # shellcheck disable=SC2154
    [ "$is_set" = set ] || continue
    printf '\t\t<key>%s</key>\n\t\t<string>%s</string>\n' "$name" "$(xml "$value")"
  done
  cat <<EOF
	</dict>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
EOF
}

# The schedule must run a checkout that stays: a linked worktree is removed when its work is done.
refuse_worktree() {
  git_dir=$(git -C "$repo_root" rev-parse --absolute-git-dir 2>/dev/null) || return 0
  common=$(git -C "$repo_root" rev-parse --git-common-dir 2>/dev/null) || return 0
  common=$(CDPATH= cd -- "$repo_root" && CDPATH= cd -- "$common" && pwd -P)
  if [ "$(CDPATH= cd -- "$git_dir" && pwd -P)" != "$common" ]; then
    echo "sync-schedule: $repo_root is a linked worktree, which goes away when its work is done; run sync --schedule from the main checkout ($(dirname -- "$common"))" >&2
    exit 2
  fi
}

install() {
  when=${1:-08:30}
  parsed=$(parse_time "$when")
  [ -n "$parsed" ] || { echo "sync-schedule: $when is not a time of day (HH:MM, 24-hour)" >&2; exit 2; }
  hour=${parsed% *}
  minute=${parsed#* }
  shown=$(printf '%02d:%02d' "$hour" "$minute")
  refuse_worktree
  path=$(schedule_path)
  PATH=$path command -v git >/dev/null 2>&1 || { echo "sync-schedule: git is not on PATH ($path), and sync needs it" >&2; exit 1; }
  for tool in node npm; do
    PATH=$path command -v "$tool" >/dev/null 2>&1 ||
      echo "WARN $tool is not on PATH ($path): a scheduled sync can't install the pinned runtimes when a pull changes them; run sync --schedule from a shell that has it"
  done

  if [ "$scheduler" = cron ]; then
    echo "This system has no launchd. To run sync every day at $shown, add this line to your crontab (crontab -e); nothing was changed:"
    echo
    # cron reads % as a new line: written \% it is a percent sign.
    printf '%s %s * * * mkdir -p %s && PATH=%s %s --from-schedule </dev/null >>%s 2>&1\n' "$minute" "$hour" \
      "$(quote "$(dirname -- "$log")")" "$(quote "$path")" "$(quote "$repo_root/scripts/sync")" "$(quote "$log")" | sed 's/%/\\%/g'

    return 0
  fi

  mkdir -p "$agents_dir" "$(dirname -- "$log")"
  next=$(mktemp "$agents_dir/.agent-skills-sync.XXXXXX")
  trap 'rm -f "$next" "$next.body" "$next.plist"; release_lock' EXIT
  trap 'exit 1' HUP INT TERM
  render_plist "$next" "$hour" "$minute" "$path" >"$next.plist"
  mv "$next.plist" "$next"
  chmod 644 "$next"
  take_lock
  loaded_state
  state=$?
  refuse_elsewhere "$state"
  if cmp -s "$next" "$plist" && [ "$state" -eq 0 ] && same_file "$loaded_from" "$plist" && [ "$(labelled_plists)" = "$plist" ]; then
    echo "OK the daily sync is scheduled at $shown ($plist)"
    return 0
  fi
  # Every file that would load this label again is moved aside, into the backup folder (if one can't
  # be moved, nothing is changed); whatever runs with the label stops; the new agent goes in.
  stage_all "$(agent_files)" || exit 1
  if ! unload; then
    # Nothing changes: the agents go back, so the old one runs from its own file and a second try
    # sees the difference and tries again.
    before=$(printf '%s' "$staged" | grep -c . || true)
    back=$(unstage_all | grep -c . || true)
    if [ "$back" -eq "$before" ]; then
      echo "FAIL launchd still has the old daily sync loaded after launchctl bootout, so nothing was changed: launchctl bootout $domain/$label unloads it; then run scripts/sync --schedule again" >&2
    else
      echo "FAIL launchd still has the old daily sync loaded after launchctl bootout, and the agents named above couldn't go back: launchctl bootout $domain/$label unloads it; then run scripts/sync --schedule again" >&2
    fi
    exit 1
  fi
  # Never over a file that appeared meanwhile.
  if ! move_new "$next" "$plist"; then
    # The agents that were there go back where nothing took their place, but none is loaded again:
    # which file launchd would read can't be known for sure, so the owner runs --schedule again.
    back=$(unstage_all)
    put_back=
    if [ -n "$back" ]; then
      put_back="; the agents that were there were put back ($(printf '%s\n' "$back" | paste -sd' ' -)), unloaded until the next login: run scripts/sync --schedule again"
    elif [ -n "$staged" ]; then
      put_back="; the agents that were there couldn't go back and stay in $backups, as named above: run scripts/sync --schedule again"
    fi
    echo "FAIL could not put the new launch agent at $plist (another file is there now, or the folder can't be written)$put_back" >&2
    exit 1
  fi
  judge_staged
  # launchd can still be letting go of the old agent: one more try a moment later.
  if ! launchctl bootstrap "$domain" "$plist" >/dev/null 2>&1; then
    sleep 1
    if ! loaded=$(launchctl bootstrap "$domain" "$plist" 2>&1); then
      printf '%s\n' "$loaded" | sed 's/^/  /' >&2
      echo "FAIL launchctl could not load $plist; it loads at the next login, or run sync --schedule again" >&2
      exit 1
    fi
  fi
  echo "SCHEDULED the daily sync at $shown: $plist runs $repo_root/scripts/sync --from-schedule, appending to $log"
}

remove() {
  if [ "$scheduler" = cron ]; then
    if crontab -l 2>/dev/null | grep -qF -- "$repo_root/scripts/sync"; then
      echo "This system has no launchd: remove the line that runs $repo_root/scripts/sync from your crontab (crontab -e); nothing was changed."
    else
      echo "OK no daily sync is scheduled"
    fi
    return 0
  fi
  trap 'release_lock' EXIT
  trap 'exit 1' HUP INT TERM
  [ "$1" -eq 1 ] || take_lock
  found=$(agent_files)
  if [ -z "$found" ]; then
    # Its file deleted by hand (or no longer carrying the label), an agent stays loaded until the
    # next login.
    loaded_state
    case $? in
      0)
        why=$(gone_or_changed "$loaded_from")
        if [ "$1" -eq 1 ]; then
          echo "DRY RUN: unload the daily sync, loaded from $loaded_from, $why"
        elif unload; then
          echo "UNSCHEDULED the daily sync ($label), loaded from $loaded_from, $why"
        else
          echo "FAIL launchd still has the daily sync ($label) loaded from $loaded_from after launchctl bootout; it runs until the next login unless launchctl bootout $domain/$label succeeds" >&2
          exit 1
        fi
        ;;
      3)
        # Loaded, but from where can't be read: it may be this home's, so never "nothing scheduled".
        if [ "$1" -eq 1 ]; then
          echo "WARN launchd has the daily sync ($label) loaded, but launchctl print names no file it was loaded from, so it would be left loaded: if it is this home's, launchctl bootout $domain/$label unloads it"
        else
          echo "FAIL launchd has the daily sync ($label) loaded, but launchctl print names no file it was loaded from, so it was left loaded: if it is this home's, launchctl bootout $domain/$label unloads it" >&2
          exit 1
        fi
        ;;
      *) echo "OK no daily sync is scheduled" ;;
    esac
    return 0
  fi
  if [ "$1" -eq 1 ]; then
    printf '%s\n' "$found" | sed 's/^/DRY RUN: unload and remove the daily sync /'
    return 0
  fi
  loaded_state
  refuse_elsewhere "$?"
  stage_all "$found" || exit 1
  if ! unload; then
    judge_staged
    echo "FAIL launchd still has the daily sync ($label) loaded after launchctl bootout; its files are in $backups, so it won't load at the next login, but it runs until then unless launchctl bootout $domain/$label succeeds" >&2
    exit 1
  fi
  judge_staged
  echo "UNSCHEDULED the daily sync ($label); its log stays at $log"
}

# Keeps the log under AGENT_SKILLS_SYNC_LOG_MAX bytes (1 MiB unless set to a whole number): over it,
# only its last quarter stays, from its first whole line on (a line longer than that quarter goes
# whole), byte for byte, line ends of any kind as they were. It is written back into the same file,
# not replaced: launchd (or cron's >>) holds it open for appending, so what the run writes next goes
# after it.
trim_log() {
  max=${AGENT_SKILLS_SYNC_LOG_MAX:-1048576}
  case "$max" in ''|*[!0-9]*) max=1048576 ;; esac
  [ -f "$log" ] && [ ! -L "$log" ] || return 0
  size=$(wc -c <"$log" | tr -d ' ')
  [ "$size" -gt "$max" ] || return 0
  tailed=$(mktemp "$log.XXXXXX") || return 0
  trimmed=$(mktemp "$log.XXXXXX") || { rm -f "$tailed"; return 0; }
  # Only from a whole copy of the end, and not when something wrote to the log meanwhile.
  # One byte more than the quarter: when the cut falls at a line's start, that byte is the line end
  # before it, so the line that is dropped as partial is an empty one.
  if tail -c "$((max / 4 + 1))" "$log" >"$tailed" && LC_ALL=C sed 1d "$tailed" >"$trimmed" &&
    [ "$(wc -c <"$log" | tr -d ' ')" = "$size" ]; then
    if ! cat "$trimmed" >"$log"; then
      echo "WARN could not write the trimmed log back into $log; its last part is kept in $trimmed" >&2
      rm -f "$tailed"
      return 0
    fi
  fi
  rm -f "$tailed" "$trimmed"
}

# When the last scheduled sync ran, from the lines sync --from-schedule writes around a run.
last_run() {
  if [ ! -s "$log" ]; then
    echo "INFO the daily sync has not run yet: no log at $log"
    return 0
  fi
  last=$(awk -v s="$start_marker" -v f="$finish_marker" '
    { sub(/\r$/, "") }
    index($0, s) == 1 { started = substr($0, length(s) + 1); finished = "" }
    index($0, f) == 1 { finished = substr($0, length(f) + 1) }
    END { print started "\t" finished }
  ' "$log")
  started=${last%%"	"*}
  finished=${last#*"	"}
  # A trimmed log can start after a run's first line: its last line still says how it ended.
  if [ -z "$started" ] && [ -z "$finished" ]; then
    echo "INFO the daily sync's log ($log) was last written $(date -r "$log" '+%Y-%m-%d %H:%M' 2>/dev/null || echo 'at an unknown time'), by a sync that doesn't mark its runs; the next scheduled run will"
  elif [ -z "$finished" ]; then
    echo "WARN the last daily sync, started $started, has not finished: it is running now, or it was stopped; see $log"
  else
    case "$finished" in
      *": ok") echo "INFO the daily sync last ran ${finished%: ok}: ok" ;;
      *) echo "WARN the last daily sync, finished ${finished%%: *}, ${finished#*: }: see $log, and run scripts/sync to see what fails now" ;;
    esac
  fi
}

status() {
  if [ "$scheduler" = cron ]; then
    line=$(crontab -l 2>/dev/null | grep -F -- "$repo_root/scripts/sync" | head -n 1)
    if [ -n "$line" ]; then
      echo "INFO the daily sync is scheduled by cron: $line"
      last_run
    else
      echo "INFO no daily sync is scheduled: scripts/sync --schedule prints the line to add to cron"
    fi
    return 0
  fi
  found=$(labelled_plists)
  if [ -z "$found" ] && { [ -e "$plist" ] || [ -L "$plist" ]; }; then found=$plist; fi
  if [ -z "$found" ]; then
    loaded_state
    case $? in
      0) echo "WARN the daily sync is loaded from $loaded_from, $(gone_or_changed "$loaded_from"), so it runs until the next login: scripts/sync --unschedule stops it, --schedule replaces it" ;;
      3) echo "WARN launchd has the daily sync ($label) loaded, but launchctl print names no file it was loaded from: if it is this home's, launchctl bootout $domain/$label unloads it" ;;
      *) echo "INFO no daily sync is scheduled: scripts/sync --schedule installs one" ;;
    esac
    backups_kept
    return 0
  fi
  count=$(printf '%s\n' "$found" | wc -l | tr -d ' ')
  if [ "$count" -gt 1 ]; then
    echo "WARN $count launch agents carry the label $label: $(printf '%s\n' "$found" | paste -sd' ' -); run scripts/sync --schedule to keep one"
  fi
  file=$(printf '%s\n' "$found" | head -n 1)
  at=$(plist_time "$file")
  program=$(plist_program "$file")
  if is_intact "$file"; then
    how="scripts/sync --schedule installed it"
  elif is_ours "$file"; then
    how="changed by hand since scripts/sync --schedule installed it; --schedule keeps a copy and replaces it"
  else
    how="hand-made; scripts/sync --schedule takes it over, keeping a copy"
  fi
  echo "INFO the daily sync is scheduled${at:+ at $at} ($file, $how)"
  loaded_state
  case $? in
    1) echo "WARN the daily sync's launch agent is not loaded, so it won't run until the next login: run scripts/sync --schedule" ;;
    2) echo "WARN the daily sync is loaded from $loaded_from, outside $agents_dir, not from $file" ;;
    3) echo "WARN launchd has the daily sync ($label) loaded, but launchctl print names no file it was loaded from, so whether it runs $file can't be told" ;;
    0)
      loaded_found=0
      while IFS= read -r candidate; do
        ! same_file "$loaded_from" "$candidate" || loaded_found=1
      done <<EOF
$found
EOF
      if [ "$loaded_found" -eq 0 ]; then
        echo "WARN the daily sync is loaded from $loaded_from, $(gone_or_changed "$loaded_from"), not from $file: scripts/sync --schedule replaces it"
      fi
      ;;
  esac
  if is_ours "$file" && [ -n "$program" ] && [ "$program" != "$repo_root/scripts/sync" ]; then
    echo "WARN the daily sync runs $program, not this checkout's scripts/sync"
  fi
  backups_kept
  last_run
}

# Where the agents it replaced or removed are kept, when there are any.
backups_kept() {
  for folder in "$backups" "$old_backups"; do
    kept=0
    for candidate in "$folder"/*.before-agent-skills-*; do
      present "$candidate" && kept=$((kept + 1))
    done
    [ "$kept" -eq 0 ] || echo "INFO $kept launch agent(s) that scripts/sync --schedule or --unschedule replaced or removed are kept in $folder"
  done
}

[ "$#" -gt 0 ] || { usage; exit 2; }
action=$1
shift
case "$action" in
  install) [ "$#" -le 1 ] || { usage; exit 2; }; install "$@" ;;
  remove)
    case "$*" in "") remove 0 ;; --dry-run) remove 1 ;; *) usage; exit 2 ;; esac
    ;;
  status) [ "$#" -eq 0 ] || { usage; exit 2; }; status ;;
  trim-log) [ "$#" -eq 0 ] || { usage; exit 2; }; trim_log ;;
  -h|--help) usage ;;
  *) usage; exit 2 ;;
esac
