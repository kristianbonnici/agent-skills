#!/bin/sh
# Prints what the install manifests declare. Each repository of skills has these tables in install/:
#   hosts.tsv      where each host looks for skills: host, label, mode, folder
#   skills.tsv     which hosts get each skill: mode (install, vendor or retired), skill, hosts. A
#                  skill may sit in a group folder, named group/skill; hosts see it by its own name.
#   links.tsv      any other link: host, mode, source, target, and for an external link, optionally,
#                  the computers it is on (names separated by spaces; none means every computer)
#   computers.tsv  optional: which hosts each computer has: computer, hosts. A computer with no row,
#                  or no table at all, has every host.
#   instructions.tsv  optional: the instruction files bootstrap builds on each computer (a host's
#                  global AGENTS.md or CLAUDE.md): computer, host, target, sections. The sections
#                  are names separated by spaces, each a file instructions/sections/<name>.md of
#                  the same repository, joined in that order with a blank line between them.
# The tables are read from this repository and, when it exists, the owner's private one
# (AGENT_SKILLS_PRIVATE, by default agent-skills-private next to this repository; set it empty to
# leave it out). bootstrap, doctor and uninstall read their links from here, so only this script
# knows the tables.
#
# This computer is named by AGENT_SKILLS_COMPUTER when it is set, otherwise by
# `scutil --get LocalHostName` on macOS and `hostname -s` elsewhere.
#
#   manifest [links]   every link this computer has: host, mode, source, target. A source is an
#                      absolute path, except for an external link, whose source names what installs it.
#   manifest away      the links of hosts this computer leaves out, and the external links of other
#                      computers, in the same columns: bootstrap removes the ones it installed
#   manifest hosts     every host this computer has
#   manifest left-out  every host this computer leaves out (none without a row for it)
#   manifest computer  this computer's name
#   manifest computers every computer computers.tsv names
#   manifest unhosted  every host with links that no row of computers.tsv names (none without one)
#   manifest instructions  every instruction file this computer has: host, target, then the path of
#                      each of its sections, all separated by tabs (none without a row for it)
#   manifest folders   every folder a host of this computer reads skills from: host, mode, folder
#   manifest skills    every installed skill and the hosts that get it, by their labels, on any computer
#   manifest roots     every repository read, this one first
#
# --dir INSTALL_DIR, once or more, reads only those folders' tables instead. The first must have a
# hosts.tsv; each needs a skills.tsv.
#
# Exits 1, printing nothing but the reasons, on a row it cannot read, a host no table names, a
# skill named twice for one host, a path claimed by two sources or both installed and retired, a
# computer named twice, an external link or instruction file on a computer no computers.tsv names,
# and an instruction file for a host its computer leaves out, named twice for one computer, at a
# path a link claims, or with a section that has no file.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
what=links
dirs=""
nl='
'

usage() {
  echo "Usage: manifest [links | away | hosts | left-out | computer | computers | unhosted | instructions | folders | skills | roots] [--dir INSTALL_DIR]..." >&2
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    links|away|hosts|left-out|computer|computers|unhosted|instructions|folders|skills|roots) what=$1; shift ;;
    --dir) [ "$#" -ge 2 ] || { usage; exit 2; }; dirs="$dirs$2$nl"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; usage; exit 2 ;;
  esac
done

if [ -z "$dirs" ]; then
  dirs="$repo_root/install$nl"
  # Unset: the sibling folder, if there is one. Empty: none. Named: it must be there.
  if [ "${AGENT_SKILLS_PRIVATE+set}" = set ]; then
    if [ -n "$AGENT_SKILLS_PRIVATE" ]; then
      [ -d "$AGENT_SKILLS_PRIVATE/install" ] || {
        echo "manifest: AGENT_SKILLS_PRIVATE is $AGENT_SKILLS_PRIVATE, which has no install folder" >&2; exit 1; }
      dirs="$dirs$AGENT_SKILLS_PRIVATE/install$nl"
    fi
  elif [ -d "$(dirname -- "$repo_root")/agent-skills-private/install" ]; then
    dirs="$dirs$(dirname -- "$repo_root")/agent-skills-private/install$nl"
  fi
fi

# Hosts first, from every folder, so any repository's skills may name any repository's hosts.
set --
first=1
roots=""
table_dirs=""
while IFS= read -r dir; do
  [ -n "$dir" ] || continue
  [ -d "$dir" ] || { echo "manifest: no folder $dir" >&2; exit 1; }
  # Absolute, so that awk never reads a table's path as a variable assignment.
  dir=$(CDPATH= cd -- "$dir" && pwd)
  [ -f "$dir/skills.tsv" ] || { echo "manifest: missing $dir/skills.tsv" >&2; exit 1; }
  if [ "$first" -eq 1 ]; then
    [ -f "$dir/hosts.tsv" ] || { echo "manifest: missing $dir/hosts.tsv" >&2; exit 1; }
    first=0
  fi
  roots="$roots$(dirname -- "$dir")$nl"
  table_dirs="$table_dirs$dir$nl"
  [ ! -f "$dir/hosts.tsv" ] || set -- "$@" table=hosts root="$(dirname -- "$dir")" "$dir/hosts.tsv"
done <<EOF
$dirs
EOF

if [ "$what" = roots ]; then
  printf '%s' "$roots"
  exit 0
fi

# This computer's name: its row in computers.tsv says which hosts it has.
if [ -n "${AGENT_SKILLS_COMPUTER:-}" ]; then
  computer=$AGENT_SKILLS_COMPUTER
elif [ "$(uname -s)" = Darwin ] && computer=$(scutil --get LocalHostName 2>/dev/null) && [ -n "$computer" ]; then
  :
else
  computer=$(hostname -s 2>/dev/null) || computer=
fi
if [ "$what" = computer ]; then
  [ -n "$computer" ] || { echo "manifest: cannot tell this computer's name: set AGENT_SKILLS_COMPUTER" >&2; exit 1; }
  printf '%s\n' "$computer"
  exit 0
fi

while IFS= read -r dir; do
  [ -n "$dir" ] || continue
  set -- "$@" table=skills root="$(dirname -- "$dir")" "$dir/skills.tsv"
  [ ! -f "$dir/links.tsv" ] || set -- "$@" table=links root="$(dirname -- "$dir")" "$dir/links.tsv"
done <<EOF
$table_dirs
EOF
# Computers last, so that a row may name a host from any table.
while IFS= read -r dir; do
  [ -n "$dir" ] || continue
  [ ! -f "$dir/computers.tsv" ] || set -- "$@" table=computers root="$(dirname -- "$dir")" "$dir/computers.tsv"
done <<EOF
$table_dirs
EOF
# Instruction files after computers, so that a row is checked against its computer's hosts.
while IFS= read -r dir; do
  [ -n "$dir" ] || continue
  [ ! -f "$dir/instructions.tsv" ] || set -- "$@" table=instructions root="$(dirname -- "$dir")" "$dir/instructions.tsv"
done <<EOF
$table_dirs
EOF

awk -F '\t' -v what="$what" -v computer="$computer" '
# Is there a folder at path? Quoted for sh, so any path is safe.
function is_dir(path,    quoted) {
  quoted = path
  gsub(/'"'"'/, "'"'"'\\'"'"''"'"'", quoted)
  return system("test -d '"'"'" quoted "'"'"'") == 0
}
function is_file(path,    quoted) {
  quoted = path
  gsub(/'"'"'/, "'"'"'\\'"'"''"'"'", quoted)
  return system("test -f '"'"'" quoted "'"'"'") == 0
}
function here(    parts, count) {
  count = split(FILENAME, parts, "/")
  return parts[count - 2] "/" parts[count - 1] "/" parts[count] ":" FNR
}
function refuse(message) {
  printf "manifest: %s: %s\n", here(), message > "/dev/stderr"
  refused = 1
}
function known_mode(mode) {
  return mode == "link" || mode == "adapter" || mode == "retired"
}
# One link. A path may be named twice only for the same source in the same mode (two hosts that
# share a folder); anything else would leave what is installed there to the order of the rows.
function add(host, mode, source, target, computers) {
  if (mode == "retired") {
    if (target in live_source) {
      refuse(target " is both installed (" live_where[target] ") and retired")
      return
    }
    if (!(target in retired_where)) retired_where[target] = here()
  } else {
    if (target in retired_where) {
      refuse(target " is both retired (" retired_where[target] ") and installed")
      return
    }
    if (target in live_source && (live_source[target] != source || live_mode[target] != mode)) {
      refuse(target " is claimed twice: by " live_source[target] " (" live_where[target] ") and by " source)
      return
    }
    live_source[target] = source
    live_mode[target] = mode
    live_where[target] = here()
  }
  rows++
  row_host[rows] = host
  row_mode[rows] = mode
  row_source[rows] = source
  row_target[rows] = target
  row_computers[rows] = computers
  row_where[rows] = here()
}
function name_host(host) {
  if (host in host_named) return
  host_named[host] = 1
  host_names[++host_count] = host
}

{ sub(/\r$/, "") }
/^[ \t]*(#|$)/ { next }

table == "hosts" {
  if (NF != 4) { refuse("expected four columns: host, label, mode, folder"); next }
  if (!known_mode($3)) { refuse("unknown mode \"" $3 "\": expected link, adapter or retired"); next }
  if (($1, $4) in folder_seen) { refuse($4 " is listed twice for " $1); next }
  if ($1 in host_label && host_label[$1] != $2) {
    refuse($1 " has two labels: \"" host_label[$1] "\" and \"" $2 "\""); next
  }
  folder_seen[$1, $4] = 1
  host_label[$1] = $2
  name_host($1)
  folders++
  folder_host[folders] = $1
  folder_mode[folders] = $3
  folder_path[folders] = $4
  next
}

table == "skills" {
  if (NF != 3) { refuse("expected three columns: mode, skill, hosts"); next }
  if ($1 != "install" && $1 != "vendor" && $1 != "retired") {
    refuse("unknown mode \"" $1 "\": expected install, vendor or retired"); next
  }
  if ($2 !~ /^([a-z0-9]+(-[a-z0-9]+)*\/)?[a-z0-9]+(-[a-z0-9]+)*$/) {
    refuse("not a skill folder name, or group/name: \"" $2 "\""); next
  }
  # Skills of the owner are in skills/, pinned copies of skills by others in vendor/, either one
  # in a group folder. A host sees a skill by its own name, so two groups cannot both have one.
  # A retired pinned copy whose folder is still in vendor/ (parked, not removed) was linked from
  # there, so its links are looked for there.
  source = root "/" ($1 == "vendor" || ($1 == "retired" && is_dir(root "/vendor/" $2)) ? "vendor" : "skills") "/" $2
  name = $2
  sub(/^.*\//, "", name)
  pieces = split($3, named, / +/)
  used = 0
  for (piece = 1; piece <= pieces; piece++) {
    host = named[piece]
    if (host == "") continue
    used++
    if (!(host in host_label)) { refuse("no hosts.tsv names a host \"" host "\""); continue }
    # Within one repository; across two, the path check below names both sources.
    if ((root, name, host) in pair_seen) { refuse(name " is named twice for " host); continue }
    pair_seen[root, name, host] = 1
    for (folder = 1; folder <= folders; folder++) {
      if (folder_host[folder] != host) continue
      # The mode of the folder, which is already "retired" for one the host no longer reads.
      mode = ($1 == "retired") ? "retired" : folder_mode[folder]
      add(host, mode, source, folder_path[folder] "/" name)
      if (mode == "retired") continue
      if (!(name in skill_listed)) { skill_listed[name] = 1; skill_names[++skill_count] = name }
      installed[name, host] = 1
    }
  }
  if (used == 0) refuse(name " names no host")
  next
}

table == "links" {
  if (NF != 4 && NF != 5) { refuse("expected four columns: host, mode, source, target (and computers, for an external link)"); next }
  # external: something else installs it (a tool, or a host itself); listed so doctor knows it.
  if (!known_mode($2) && $2 != "external") {
    refuse("unknown mode \"" $2 "\": expected link, adapter, retired or external"); next
  }
  # The computers an external link is on: a tool may be installed on one computer and not another.
  # Bootstrap installs every other link wherever the host is, so only an external one names them.
  computers = (NF == 5) ? $5 : ""
  gsub(/^ +| +$/, "", computers)
  if (computers != "" && $2 != "external") { refuse("only an external link names its computers"); next }
  name_host($1)
  add($1, $2, $2 == "external" ? $3 : root "/" $3, $4, computers)
  next
}

table == "computers" {
  if (NF != 2) { refuse("expected two columns: computer, hosts"); next }
  if ($1 == "" || $1 ~ / /) { refuse("not a computer name: \"" $1 "\""); next }
  if ($1 in computer_where) { refuse($1 " is named twice (first at " computer_where[$1] ")"); next }
  computer_where[$1] = here()
  computer_names[++computer_count] = $1
  pieces = split($2, named, / +/)
  used = 0
  for (piece = 1; piece <= pieces; piece++) {
    if (named[piece] == "") continue
    used++
    if (!(named[piece] in host_named)) { refuse("no table names a host \"" named[piece] "\""); continue }
    computer_host[$1, named[piece]] = 1
    hosted[named[piece]] = 1
  }
  if (used == 0) refuse($1 " names no host")
  next
}

table == "instructions" {
  if (NF != 4) { refuse("expected four columns: computer, host, target, sections"); next }
  if ($1 == "" || $1 ~ / /) { refuse("not a computer name: \"" $1 "\""); next }
  if (!($2 in host_named)) { refuse("no table names a host \"" $2 "\""); next }
  if ($3 !~ /^(~\/|\/)./) { refuse("not a path that starts with ~/ or /: \"" $3 "\""); next }
  if (($1, $3) in instruction_where) { refuse($3 " is named twice for " $1 " (first at " instruction_where[$1, $3] ")"); next }
  if ($3 in live_source) { refuse($3 " is also a link (" live_where[$3] ")"); next }
  if ($1 in computer_where && !(($1, $2) in computer_host)) { refuse($1 " leaves out " $2 " in computers.tsv"); next }
  paths = ""
  pieces = split($4, named, / +/)
  used = 0
  bad = 0
  for (piece = 1; piece <= pieces; piece++) {
    if (named[piece] == "") continue
    used++
    if (named[piece] !~ /^[a-z0-9]+(-[a-z0-9]+)*$/) { refuse("not a section name: \"" named[piece] "\""); bad = 1; continue }
    section = root "/instructions/sections/" named[piece] ".md"
    if (!is_file(section)) { refuse("no section file " section); bad = 1; continue }
    paths = paths "\t" section
  }
  if (used == 0) refuse($3 " names no section")
  if (used == 0 || bad) next
  instruction_where[$1, $3] = here()
  instructions++
  instruction_computer[instructions] = $1
  instruction_host[instructions] = $2
  instruction_target[instructions] = $3
  instruction_paths[instructions] = paths
  next
}

END {
  # A computer an instruction file names must have a row, when there is a table, as for links.
  for (row = 1; row <= instructions; row++) {
    if (computer_count == 0 || instruction_computer[row] in computer_where) continue
    printf "manifest: %s: no computers.tsv names a computer \"%s\"\n", instruction_where[instruction_computer[row], instruction_target[row]], instruction_computer[row] > "/dev/stderr"
    refused = 1
  }
  # A computer an external link names must have a row, when there is a table: a misspelt name
  # would leave the link expected nowhere.
  for (row = 1; row <= rows; row++) {
    if (row_computers[row] == "") continue
    pieces = split(row_computers[row], named, / +/)
    for (piece = 1; piece <= pieces; piece++) {
      if (named[piece] == "" || named[piece] in computer_where || computer_count == 0) continue
      printf "manifest: %s: no computers.tsv names a computer \"%s\"\n", row_where[row], named[piece] > "/dev/stderr"
      refused = 1
    }
  }
  if (refused) exit 1
  # Without a row for this computer, it has every host.
  has_row = (computer != "" && computer in computer_where)
  for (host = 1; host <= host_count; host++)
    host_here[host_names[host]] = !has_row || ((computer, host_names[host]) in computer_host)
  for (row = 1; row <= rows; row++) {
    on_computer = row_computers[row] == "" || computer != "" && index(" " row_computers[row] " ", " " computer " ") > 0
    row_here[row] = host_here[row_host[row]] && on_computer
    if (row_here[row]) here_target[row_target[row]] = 1
  }
  if (what == "links" || what == "away") {
    # A folder two hosts share keeps its links while one of them is here.
    for (row = 1; row <= rows; row++) {
      if (what == "links" ? !row_here[row] : (row_here[row] || row_target[row] in here_target)) continue
      printf "%s\t%s\t%s\t%s\n", row_host[row], row_mode[row], row_source[row], row_target[row]
    }
  } else if (what == "instructions") {
    for (row = 1; row <= instructions; row++)
      if (computer != "" && instruction_computer[row] == computer)
        printf "%s\t%s%s\n", instruction_host[row], instruction_target[row], instruction_paths[row]
  } else if (what == "computers") {
    for (named_computer = 1; named_computer <= computer_count; named_computer++) print computer_names[named_computer]
  } else if (what == "unhosted") {
    # A host that still has links but is on no computer: a host added to hosts.tsv and to no row.
    if (computer_count > 0) {
      for (row = 1; row <= rows; row++) if (row_mode[row] != "retired") linked_host[row_host[row]] = 1
      for (host = 1; host <= host_count; host++)
        if (host_names[host] in linked_host && !(host_names[host] in hosted)) print host_names[host]
    }
  } else if (what == "hosts" || what == "left-out") {
    for (host = 1; host <= host_count; host++)
      if (host_here[host_names[host]] == (what == "hosts")) print host_names[host]
  } else if (what == "folders") {
    for (folder = 1; folder <= folders; folder++)
      if (host_here[folder_host[folder]])
        printf "%s\t%s\t%s\n", folder_host[folder], folder_mode[folder], folder_path[folder]
  } else {
    # Labels in the order hosts.tsv names the hosts, each once: two hosts may share a label.
    for (skill = 1; skill <= skill_count; skill++) {
      labels = ""
      split("", label_used)
      for (host = 1; host <= host_count; host++) {
        if (!((skill_names[skill], host_names[host]) in installed)) continue
        label = host_label[host_names[host]]
        if (label in label_used) continue
        label_used[label] = 1
        labels = labels (labels == "" ? "" : ", ") label
      }
      printf "%s\t%s\n", skill_names[skill], labels
    }
  }
}
' "$@"
