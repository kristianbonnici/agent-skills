#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
# The owner's private state repository: each <skill>/<file> in it is linked into
# the skills' state folder, so per-owner facts follow the owner between computers.
state_repo=${AGENT_SKILLS_STATE:-$(dirname -- "$repo_root")/agent-skills-state}
state_home=${XDG_STATE_HOME:-$HOME/.local/state}/agent-skills

host=all
dry_run=0
install_links=1
install_dependencies=1
adopt_instructions=0
left_any=0
left_count=0

usage() {
  # The hosts are the ones the install manifests give this computer, not a second list kept here.
  hosts=$("$script_dir/manifest" hosts 2>/dev/null | paste -sd, - | sed 's/,/, /g')
  cat >&2 <<EOF
Usage: bootstrap [--all | --host HOST] [--dry-run] [--skip-dependencies] [--adopt-instructions]
       bootstrap --dependencies [--dry-run]

Hosts: $hosts

A host this computer leaves out (install/computers.tsv) gets nothing, and --all removes the links
an earlier bootstrap made for it.

Also builds this computer's instruction files (a host's global AGENTS.md or CLAUDE.md) from the
sections install/instructions.tsv names. A file already there that bootstrap didn't build is left
as it is; --adopt-instructions takes it over, keeping it first as a backup beside it. A built file
changed in place is kept as a backup beside it before it is rebuilt.

Also links the files of a private state repository (AGENT_SKILLS_STATE, by default
agent-skills-state next to this repository) into \${XDG_STATE_HOME:-~/.local/state}/agent-skills.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --all) host=all; shift ;;
    --host)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      host=$2
      shift 2
      ;;
    --dry-run) dry_run=1; shift ;;
    --skip-dependencies) install_dependencies=0; shift ;;
    --dependencies) install_links=0; install_dependencies=1; shift ;;
    --adopt-instructions) adopt_instructions=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; usage; exit 2 ;;
  esac
done

# A host this computer leaves out gets nothing: --all removes what an earlier run made for it.
if [ "$host" != all ] && "$script_dir/manifest" left-out 2>/dev/null | grep -qxF -- "$host"; then
  echo "bootstrap: this computer ($("$script_dir/manifest" computer)) leaves out $host in install/computers.tsv, so nothing is installed for it; bootstrap --all removes the links an earlier run made for it" >&2
  exit 1
fi

expand_target() {
  case "$1" in
    '~'/*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

run() {
  if [ "$dry_run" -eq 1 ]; then
    printf 'DRY RUN:'
    printf ' %s' "$@"
    printf '\n'
  else
    "$@"
  fi
}

link_one() {
  link_source=$1
  link_target=$2
  run mkdir -p "$(dirname -- "$link_target")"
  if [ -L "$link_target" ]; then
    current=$(readlink "$link_target")
    if [ "$current" = "$link_source" ]; then
      echo "OK $link_target"
      return
    fi
    run rm "$link_target"
  elif is_adapter_folder "$link_target" "$link_source"; then
    # The host took adapter folders when an earlier bootstrap ran: the folder becomes the link.
    for name in SKILL.md agents references scripts assets; do
      [ -L "$link_target/$name" ] || continue
      run rm "$link_target/$name"
    done
    [ ! -f "$link_target/.DS_Store" ] || run rm "$link_target/.DS_Store"
    run rmdir "$link_target"
    [ "$dry_run" -eq 1 ] || echo "REPLACED adapter folder $link_target"
  elif [ -e "$link_target" ]; then
    echo "Refusing to replace existing path: $link_target" >&2
    if [ -d "$link_target" ] && [ ! -L "$link_target" ]; then
      echo "  It holds something bootstrap didn't put there: move that out of it, then run bootstrap again." >&2
    fi
    return 1
  fi
  # -n: if another run made the link meanwhile, fail instead of linking inside what it points to.
  run ln -sn "$link_source" "$link_target"
  echo "LINK $link_target -> $link_source"
}

# Is $1 an adapter folder of the skill $2: a real folder holding only links named after the skill's
# parts, each to that part of a folder of the skill's name (this checkout's or another's), and maybe
# Finder's .DS_Store? An empty folder counts too: it holds nothing to lose, as when a run replacing
# one stopped before its rmdir. Anything else in it (a file, another link, a folder) is someone's.
is_adapter_folder() {
  [ -d "$1" ] && [ ! -L "$1" ] || return 1
  [ -z "$(find "$1" -mindepth 1 -maxdepth 1 ! -name SKILL.md ! -name agents ! -name references ! -name scripts ! -name assets ! -name .DS_Store -print -quit)" ] || return 1
  if [ -e "$1/.DS_Store" ] || [ -L "$1/.DS_Store" ]; then
    [ -f "$1/.DS_Store" ] && [ ! -L "$1/.DS_Store" ] || return 1
  fi
  adapter_skill=$(basename -- "$2")
  for adapter_part in SKILL.md agents references scripts assets; do
    [ -e "$1/$adapter_part" ] || [ -L "$1/$adapter_part" ] || continue
    [ -L "$1/$adapter_part" ] || return 1
    # Spelled differently, the same part: repeated slashes, ./ steps and a closing / are dropped.
    adapter_to=$(readlink "$1/$adapter_part" | sed -e 's://*:/:g' -e 's:/\./:/:g' -e 's:/*$::')
    case "$adapter_to" in */"$adapter_skill/$adapter_part") ;; *) return 1 ;; esac
  done
}

adapter_one() {
  adapter_source=$1
  adapter_target=$2
  if [ -L "$adapter_target" ]; then
    echo "Refusing adapter directory symlink: $adapter_target" >&2
    return 1
  fi
  if [ -e "$adapter_target" ] && [ ! -d "$adapter_target" ]; then
    echo "Refusing non-directory adapter path: $adapter_target" >&2
    return 1
  fi
  run mkdir -p "$adapter_target"
  for name in SKILL.md agents references scripts assets; do
    [ -e "$adapter_source/$name" ] || continue
    link_one "$adapter_source/$name" "$adapter_target/$name"
  done
}

# Is $1 the link this checkout installed for the retired source $2? Only an exact match is: that is
# the one link known to be ours, so the only one removed.
is_retired_link() {
  [ -L "$1" ] && [ "$(readlink "$1")" = "$2" ]
}
# Does $1 look like the retired skill installed from somewhere else (another or a moved checkout):
# a link, broken or not, to a skills/<same name> folder? It is kept and reported, never removed.
looks_retired() {
  [ -L "$1" ] || return 1
  # Spelled differently, the same folder: repeated slashes and ./ steps are dropped before matching.
  retired_to=$(readlink "$1" | sed -e 's://*:/:g' -e 's:/\./:/:g' -e 's:^\./::' -e 's:/*$::')
  case "$retired_to" in skills/"$(basename -- "$2")"|*/skills/"$(basename -- "$2")") return 0 ;; esac
  return 1
}

# Does another retired row this run acts on, for the same target $1 (as the table spells it), name
# exactly what the link at $2 points to? Then that row removes it, and this one says nothing.
retired_elsewhere() {
  [ -L "$2" ] || return 1
  printf '%s\n' "$rows" | awk -F '\t' -v h="$host" -v t="$1" -v s="$(readlink "$2")" \
    '$2 == "retired" && (h == "all" || $1 == h) && $4 == t && $3 == s { found = 1 } END { exit !found }'
}

# A retired row names a link an earlier version installed (a renamed or removed skill): it is
# removed, and anything else at that path is kept.
retire_one() {
  retire_source=$1
  retire_target=$2
  if is_retired_link "$retire_target" "$retire_source"; then
    run rm "$retire_target"
    [ "$dry_run" -eq 1 ] || echo "REMOVED retired link $retire_target"
  elif retired_elsewhere "$3" "$retire_target"; then
    :
  elif looks_retired "$retire_target" "$retire_source"; then
    echo "KEEP $retire_target -> $(readlink "$retire_target"): the retired skill from another checkout? If so, remove it by hand" >&2
  elif [ -e "$retire_target" ] || [ -L "$retire_target" ]; then
    echo "KEEP $retire_target: not the retired link this repository installed" >&2
  fi
}

# A host this computer leaves out: the links an earlier bootstrap made for it are removed, as safely
# as a retired link (only a link to exactly the source this checkout installed), and an adapter
# folder that is left empty once its links are gone. Anything else there is kept.
leave_one() {
  leave_source=$1
  leave_target=$2
  if is_retired_link "$leave_target" "$leave_source"; then
    run rm "$leave_target"
    left_any=1
    left_count=$((left_count + 1))
    [ "$dry_run" -eq 1 ] || echo "REMOVED $leave_target: this computer leaves out $row_host"
  elif [ -e "$leave_target" ] || [ -L "$leave_target" ]; then
    echo "KEEP $leave_target: this computer leaves out $row_host, but this repository didn't install it" >&2
  fi
}
leave_adapter() {
  leave_parts=$1
  leave_folder=$2
  if [ -L "$leave_folder" ] || { [ -e "$leave_folder" ] && [ ! -d "$leave_folder" ]; }; then
    echo "KEEP $leave_folder: this computer leaves out $row_host, but this repository didn't install it" >&2
    return 0
  fi
  [ -d "$leave_folder" ] || return 0
  # The folder goes only with the links it held: an empty folder bootstrap never filled is kept.
  left_any=0
  left_count=0
  for name in SKILL.md agents references scripts assets; do
    leave_one "$leave_parts/$name" "$leave_folder/$name"
  done
  [ "$left_any" -eq 1 ] || return 0
  if [ "$dry_run" -eq 1 ]; then
    # Nothing was removed: the folder would be left empty if those links are all it holds.
    [ "$(find "$leave_folder" -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ')" -ne "$left_count" ] || echo "DRY RUN: rmdir $leave_folder"
  elif [ -z "$(find "$leave_folder" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
    rmdir "$leave_folder"
  fi
}

selected_product_design=0
selected_excalidraw_drawing=0
if [ "$install_links" -eq 1 ]; then
  # Every link the install tables declare, here and in the private repository, as host, mode,
  # source and target; tables that cannot be read install nothing.
  rows=$("$script_dir/manifest" links) || exit 1
  while IFS=$(printf '\t') read -r row_host mode source target; do
    [ -n "$row_host" ] || continue
    [ "$host" = all ] || [ "$row_host" = "$host" ] || continue
    # Something else installs an external link: it is listed only so doctor knows it.
    [ "$mode" != external ] || continue
    source_path=$source
    target_path=$(expand_target "$target")
    if [ "$mode" = retired ]; then retire_one "$source_path" "$target_path" "$target"; continue; fi
    [ -e "$source_path" ] || { echo "Missing source: $source_path" >&2; exit 1; }
    case "$mode" in
      link) link_one "$source_path" "$target_path" ;;
      adapter) adapter_one "$source_path" "$target_path" ;;
      *) echo "Unknown manifest mode: $mode" >&2; exit 1 ;;
    esac
    case "$source" in "$repo_root"/skills/product-design*) selected_product_design=1 ;; esac
    case "$source" in "$repo_root"/skills/excalidraw-drawing*) selected_excalidraw_drawing=1 ;; esac
  done <<EOF
$rows
EOF

  # The links of hosts this computer leaves out. Only --all: --host for one of them stopped above.
  if [ "$host" = all ]; then
    # Two hosts that share a folder list its links once each: act on each link once.
    away=$("$script_dir/manifest" away) || exit 1
    away=$(printf '%s\n' "$away" | awk -F '\t' '!seen[$2 FS $3 FS $4]++')
    while IFS=$(printf '\t') read -r row_host mode source target; do
      [ -n "$row_host" ] || continue
      target_path=$(expand_target "$target")
      # A host that took adapter folders when bootstrap last ran here may have left one where a
      # link now goes: it goes as an adapter folder does, with only this checkout's links in it.
      if [ "$mode" = link ] && is_adapter_folder "$target_path" "$source"; then mode=adapter; fi
      case "$mode" in
        link|retired) leave_one "$source" "$target_path" ;;
        adapter) leave_adapter "$source" "$target_path" ;;
      esac
    done <<EOF
$away
EOF
  fi

  if [ -d "$state_repo/.git" ]; then
    for state_file in "$state_repo"/*/*; do
      [ -f "$state_file" ] || continue
      link_one "$state_file" "$state_home/${state_file#"$state_repo"/}"
    done
  else
    echo "No private state repository at $state_repo; skills keep their state locally."
  fi

  # The instruction files install/instructions.tsv gives this computer; nothing without a row.
  set -- --host "$host"
  [ "$dry_run" -eq 0 ] || set -- "$@" --dry-run
  [ "$adopt_instructions" -eq 0 ] || set -- "$@" --adopt
  "$script_dir/instructions" install "$@"
fi

if [ "$install_dependencies" -eq 1 ] && { [ "$install_links" -eq 0 ] || [ "$selected_product_design" -eq 1 ] || [ "$host" = all ]; }; then
  command -v node >/dev/null 2>&1 || { echo "Node.js 18+ is required for Product Design browser capture." >&2; exit 1; }
  command -v npm >/dev/null 2>&1 || { echo "npm is required for Product Design browser capture." >&2; exit 1; }
  if [ "$dry_run" -eq 1 ]; then
    echo "DRY RUN: npm ci --prefix $repo_root/runtime/playwright"
  else
    npm ci --prefix "$repo_root/runtime/playwright" --no-audit --no-fund
  fi
fi

# excalidraw-drawing draws with a pinned mcp-excalidraw-server, which needs Node 20 or newer.
# --ignore-scripts: its only package with an install script is fsevents, an optional macOS file
# watcher the renderer never uses, so no install script needs to run.
if [ "$install_dependencies" -eq 1 ] && { [ "$install_links" -eq 0 ] || [ "$selected_excalidraw_drawing" -eq 1 ] || [ "$host" = all ]; }; then
  command -v npm >/dev/null 2>&1 || { echo "npm is required for excalidraw-drawing." >&2; exit 1; }
  node_major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
  if ! [ "$node_major" -ge 20 ] 2>/dev/null; then
    # One skill's runtime doesn't fail the whole bootstrap: the other skills stay installed, and
    # doctor reports this runtime as missing.
    echo "Skipping the excalidraw-drawing runtime: it needs Node 20 or newer (found ${node_major})." >&2
  elif [ "$dry_run" -eq 1 ]; then
    echo "DRY RUN: npm ci --ignore-scripts --prefix $repo_root/runtime/excalidraw"
  else
    npm ci --ignore-scripts --prefix "$repo_root/runtime/excalidraw" --no-audit --no-fund
  fi
fi

echo "Bootstrap complete. Restart installed hosts so they reindex skills."
