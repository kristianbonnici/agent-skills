#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
state_repo=${AGENT_SKILLS_STATE:-$(dirname -- "$repo_root")/agent-skills-state}
state_home=${XDG_STATE_HOME:-$HOME/.local/state}/agent-skills
host=all
dry_run=0
removed_any=0
removed_count=0

usage() {
  echo "Usage: uninstall [--all | --host HOST] [--dry-run]" >&2
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --all) host=all; shift ;;
    --host) [ "$#" -ge 2 ] || { usage; exit 2; }; host=$2; shift 2 ;;
    --dry-run) dry_run=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; usage; exit 2 ;;
  esac
done

# A host this computer leaves out (install/computers.tsv) has nothing installed to remove.
if [ "$host" != all ] && "$script_dir/manifest" left-out 2>/dev/null | grep -qxF -- "$host"; then
  echo "uninstall: this computer ($("$script_dir/manifest" computer)) leaves out $host in install/computers.tsv, so nothing is installed for it; uninstall --all also removes the links an earlier bootstrap made for it" >&2
  exit 1
fi

expand_target() {
  case "$1" in
    '~'/*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

remove_link() {
  remove_source=$1
  remove_target=$2
  if [ ! -L "$remove_target" ]; then
    [ ! -e "$remove_target" ] || echo "KEEP unmanaged path: $remove_target" >&2
    return
  fi
  [ "$(readlink "$remove_target")" = "$remove_source" ] || { echo "KEEP foreign link: $remove_target" >&2; return; }
  if [ "$dry_run" -eq 1 ]; then
    echo "DRY RUN: rm $remove_target"
  else
    rm "$remove_target"
    echo "REMOVED $remove_target"
  fi
  removed_any=1
  removed_count=$((removed_count + 1))
}

# Does the real folder $1 hold one or more of this checkout's links to $2's parts, as an adapter
# folder does? A host that took adapter folders when bootstrap last ran may have left one where a
# link now goes; it is removed as an adapter folder is, its other contents kept.
holds_part_link() {
  [ -d "$1" ] && [ ! -L "$1" ] || return 1
  for held_part in SKILL.md agents references scripts assets; do
    [ -L "$1/$held_part" ] && [ "$(readlink "$1/$held_part")" = "$2/$held_part" ] && return 0
  done
  return 1
}

# Is $1 the link this checkout installed for the retired source $2? Only an exact match is: that is
# the one link known to be ours, so the only one removed.
is_retired_link() {
  [ -L "$1" ] && [ "$(readlink "$1")" = "$2" ]
}
# Does $1 look like the retired skill installed from somewhere else (another or a moved checkout):
# a link, broken or not, to a skills/<same name> folder? It is kept and reported, never removed.
looks_retired() {
  [ -L "$1" ] || return 1
  # Spelled differently, the same folder: repeated slashes and ./ steps are dropped before matching.
  retired_to=$(readlink "$1" | sed -e 's://*:/:g' -e 's:/\./:/:g' -e 's:^\./::' -e 's:/*$::')
  case "$retired_to" in skills/"$(basename -- "$2")"|*/skills/"$(basename -- "$2")") return 0 ;; esac
  return 1
}

# Does another retired row this run acts on, for the same target $1 (as the table spells it), name
# exactly what the link at $2 points to? Then that row removes it, and this one says nothing.
retired_elsewhere() {
  [ -L "$2" ] || return 1
  printf '%s\n' "$rows" | awk -F '\t' -v h="$host" -v t="$1" -v s="$(readlink "$2")" \
    '$2 == "retired" && (h == "all" || $1 == h) && $4 == t && $3 == s { found = 1 } END { exit !found }'
}

# Every link the install tables declare, here and in the private repository: this computer's, and
# with --all those of the hosts it leaves out, in case an earlier bootstrap made them.
rows=$("$script_dir/manifest" links) || exit 1
if [ "$host" = all ]; then
  away=$("$script_dir/manifest" away) || exit 1
  rows=$(printf '%s\n%s\n' "$rows" "$away")
fi
while IFS=$(printf '\t') read -r row_host mode source target; do
  [ -n "$row_host" ] || continue
  [ "$host" = all ] || [ "$row_host" = "$host" ] || continue
  [ "$mode" != external ] || continue
  source_path=$source
  target_path=$(expand_target "$target")
  # An adapter folder where a link now goes is removed as one, with only this checkout's links.
  if [ "$mode" = link ] && holds_part_link "$target_path" "$source_path"; then mode=adapter; fi
  case "$mode" in
    link) remove_link "$source_path" "$target_path" ;;
    retired)
      if is_retired_link "$target_path" "$source_path"; then
        if [ "$dry_run" -eq 1 ]; then echo "DRY RUN: rm $target_path"; else rm "$target_path"; echo "REMOVED $target_path"; fi
      elif retired_elsewhere "$target" "$target_path"; then
        :
      elif looks_retired "$target_path" "$source_path"; then
        echo "KEEP $target_path -> $(readlink "$target_path"): the retired skill from another checkout? If so, remove it by hand" >&2
      elif [ -e "$target_path" ] || [ -L "$target_path" ]; then
        echo "KEEP $target_path: not the retired link this repository installed" >&2
      fi
      ;;
    adapter)
      adapter_source=$source_path
      adapter_target=$target_path
      # Bootstrap makes an adapter folder a real folder: a link there is someone else's, and so is
      # what it points to.
      if [ -L "$adapter_target" ]; then echo "KEEP foreign link: $adapter_target" >&2; continue; fi
      # The folder goes only with the links it held: an empty folder bootstrap never filled is kept.
      removed_any=0
      removed_count=0
      for name in SKILL.md agents references scripts assets; do
        [ -e "$adapter_source/$name" ] || continue
        remove_link "$adapter_source/$name" "$adapter_target/$name"
      done
      if [ "$removed_any" -eq 1 ] && [ -d "$adapter_target" ]; then
        # A dry run removed nothing: the folder would be left empty if those links are all it holds.
        if [ "$dry_run" -eq 1 ]; then
          [ "$(find "$adapter_target" -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ')" -ne "$removed_count" ] || echo "DRY RUN: rmdir $adapter_target"
        elif [ -z "$(find "$adapter_target" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
          rmdir "$adapter_target"
        fi
      fi
      ;;
  esac
done <<EOF
$rows
EOF

if [ -d "$state_repo/.git" ]; then
  for state_file in "$state_repo"/*/*; do
    [ -f "$state_file" ] || continue
    remove_link "$state_file" "$state_home/${state_file#"$state_repo"/}"
  done
fi

# The instruction files bootstrap built (they carry its marker); the owner's own files are kept.
set -- --host "$host"
[ "$dry_run" -eq 0 ] || set -- "$@" --dry-run
"$script_dir/instructions" remove "$@"

# The daily sync, whose next run would install everything again: with --all only.
if [ "$host" = all ]; then
  if [ "$dry_run" -eq 1 ]; then "$script_dir/sync-schedule" remove --dry-run; else "$script_dir/sync-schedule" remove; fi
fi
