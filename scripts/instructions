#!/bin/sh
# Builds the owner's global instruction files (a host's AGENTS.md or CLAUDE.md) from sections, as
# install/instructions.tsv says for this computer (scripts/manifest instructions). bootstrap,
# doctor and uninstall run it; run them instead.
#
# A built file is a real file whose first line is a marker that says it is generated and where to
# edit it. A file at a target without the marker is the owner's own: it is left as it is until
# install --adopt takes it over, after copying it to a backup beside it. Remove deletes only files
# that carry the marker.
#
#   instructions install [--host HOST] [--dry-run] [--adopt]
#                     build what is missing, rebuild a built file that no longer matches its
#                     sections, report an unadopted file (--adopt takes it over)
#   instructions check [--host HOST]
#                     print PASS, FAIL or WARN for each file, as doctor does; never changes a file
#   instructions remove [--host HOST] [--dry-run]
#                     delete each built file
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# Every built file starts with this. Changing it would make every built file look like the owner's.
marker_start='<!-- Generated by agent-skills scripts/bootstrap from '

usage() {
  echo "Usage: instructions install|check|remove [--host HOST] [--dry-run] [--adopt]" >&2
}

[ "$#" -gt 0 ] || { usage; exit 2; }
action=$1
shift
case "$action" in install|check|remove) ;; -h|--help) usage; exit 0 ;; *) usage; exit 2 ;; esac
host=all
dry_run=0
adopt=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --host) [ "$#" -ge 2 ] || { usage; exit 2; }; host=$2; shift 2 ;;
    --all) host=all; shift ;;
    --dry-run) dry_run=1; shift ;;
    --adopt) adopt=1; shift ;;
    *) echo "Unknown argument: $1" >&2; usage; exit 2 ;;
  esac
done
[ "$adopt" -eq 0 ] || [ "$action" = install ] || { echo "--adopt is for install only" >&2; exit 2; }

rows=$("$script_dir/manifest" instructions) || {
  [ "$action" != check ] || echo "FAIL install/instructions.tsv cannot be read"
  exit 1
}
[ -n "$rows" ] || exit 0

expand_target() {
  case "$1" in
    '~'/*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# The marker for a file built from sections of the repository at $1.
marker() {
  case "$1" in
    "$HOME"/*) marker_root="~/${1#"$HOME"/}" ;;
    *) marker_root=$1 ;;
  esac
  printf '%s%s (install/instructions.tsv, instructions/sections/). Edit there and run scripts/bootstrap: changes made here are overwritten. -->\n' "$marker_start" "$marker_root"
}

# Writes to $1 the file built from the sections $2...: the marker, then each section's lines, a
# blank line between two sections.
build() {
  build_out=$1
  shift
  # The repository the sections are in: each is <root>/instructions/sections/<name>.md.
  build_root=${1%/instructions/sections/*}
  {
    marker "$build_root"
    awk 'FNR == 1 && NR > 1 { print "" } { print }' "$@"
  } >"$build_out"
}

# Is $1 a file bootstrap built: a real file, not a link, whose first line is the marker?
is_built() {
  [ -f "$1" ] && [ ! -L "$1" ] || return 1
  first_line=
  IFS= read -r first_line <"$1" || [ -n "$first_line" ] || return 1
  case "$first_line" in "$marker_start"*) return 0 ;; esac
  return 1
}

# A free name beside $1 for the owner's file it replaces.
backup_name() {
  backup="$1.before-agent-skills-$(date +%Y%m%d-%H%M%S)"
  candidate=$backup
  count=1
  while [ -e "$candidate" ] || [ -L "$candidate" ]; do
    count=$((count + 1))
    candidate="$backup-$count"
  done
  printf '%s\n' "$candidate"
}

scratch=$(mktemp -d "${TMPDIR:-/tmp}/agent-skills-instructions.XXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
built="$scratch/built"
status=0
tab=$(printf '\t')

while IFS= read -r row; do
  [ -n "$row" ] || continue
  row_host=${row%%"$tab"*}
  rest=${row#*"$tab"}
  target=${rest%%"$tab"*}
  sections=${rest#*"$tab"}
  [ "$host" = all ] || [ "$row_host" = "$host" ] || continue
  target_path=$(expand_target "$target")
  # The section paths as arguments: they are separated by tabs.
  old_ifs=$IFS
  IFS=$tab
  # shellcheck disable=SC2086
  set -- $sections
  IFS=$old_ifs
  build "$built" "$@"

  case "$action" in
    check)
      if is_built "$target_path"; then
        if cmp -s "$built" "$target_path"; then
          echo "PASS $target_path is built from install/instructions.tsv"
        else
          echo "FAIL $target_path no longer matches its sections in install/instructions.tsv: run scripts/bootstrap to rebuild it"
        fi
      elif [ -e "$target_path" ] || [ -L "$target_path" ]; then
        echo "WARN $target_path is not adopted: it is your own file, not built from install/instructions.tsv. To build it from there, keeping yours as a backup beside it, run scripts/bootstrap --adopt-instructions"
      else
        echo "FAIL $target_path is missing: run scripts/bootstrap to build it from install/instructions.tsv"
      fi
      ;;

    remove)
      if is_built "$target_path"; then
        if [ "$dry_run" -eq 1 ]; then
          echo "DRY RUN: rm $target_path"
        else
          rm "$target_path"
          echo "REMOVED $target_path"
        fi
      elif [ -e "$target_path" ] || [ -L "$target_path" ]; then
        echo "KEEP $target_path: your own file, not built by bootstrap" >&2
      fi
      ;;

    install)
      if [ -d "$target_path" ] && [ ! -L "$target_path" ]; then
        echo "KEEP $target_path: a folder, where install/instructions.tsv expects a file" >&2
        status=1
        continue
      fi
      if is_built "$target_path"; then
        if cmp -s "$built" "$target_path"; then
          echo "OK $target_path"
          continue
        fi
        verb=REBUILT
      elif [ -e "$target_path" ] || [ -L "$target_path" ]; then
        if [ "$adopt" -eq 0 ]; then
          echo "NOT ADOPTED $target_path: your own file, so bootstrap leaves it. To build it from install/instructions.tsv, keeping yours as a backup beside it, run scripts/bootstrap --adopt-instructions" >&2
          continue
        fi
        verb=ADOPTED
      else
        verb=BUILT
      fi
      if [ "$dry_run" -eq 1 ]; then
        [ "$verb" != ADOPTED ] || echo "DRY RUN: cp $target_path $(backup_name "$target_path")"
        echo "DRY RUN: write $target_path"
        continue
      fi
      target_dir=$(dirname -- "$target_path")
      mkdir -p "$target_dir"
      note=
      if [ "$verb" = ADOPTED ]; then
        backup=$(backup_name "$target_path")
        # A link is kept as the link it was; a file is copied, so it stays in place until replaced.
        if [ -L "$target_path" ]; then
          mv "$target_path" "$backup"
        else
          cp -p "$target_path" "$backup"
        fi
        note="; your file is kept as $backup"
      fi
      # Written beside the target and moved into place, so a host never reads half a file.
      next_file=$(mktemp "$target_dir/.agent-skills-instructions.XXXXXX")
      cp "$built" "$next_file"
      chmod 644 "$next_file"
      mv "$next_file" "$target_path"
      echo "$verb $target_path$note"
      ;;
  esac
done <<EOF
$rows
EOF
exit "$status"
