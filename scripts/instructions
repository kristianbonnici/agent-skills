#!/bin/sh
# Builds the owner's global instruction files (a host's AGENTS.md or CLAUDE.md) from sections, as
# install/instructions.tsv says for this computer (scripts/manifest instructions). bootstrap,
# doctor and uninstall run it; run them instead.
#
# A built file is a real file whose first line is a marker: it says the file is generated, where to
# edit it, and the checksum of the lines below it as built, so a change made in the file itself is
# seen. A file at a target without the marker is the owner's own: it is left as it is until
# install --adopt takes it over, after keeping it as a backup beside it (a link stays a link there).
# A built file someone changed is kept as a backup beside it before it is rebuilt, and is never
# removed. A rebuilt file keeps the permissions of the file it replaces.
#
#   instructions install [--host HOST] [--dry-run] [--adopt]
#                     build what is missing, rebuild a built file that no longer matches its
#                     sections, report an unadopted file (--adopt takes it over)
#   instructions check [--host HOST]
#                     print PASS, FAIL or WARN for each file, as doctor does; never changes a file.
#                     Exits 1 after any FAIL.
#   instructions remove [--host HOST] [--dry-run]
#                     delete each built file that nobody changed
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# Every built file starts with this. Changing it would make every built file look like the owner's.
marker_start='<!-- Generated by agent-skills scripts/bootstrap from '

usage() {
  echo "Usage: instructions install|check|remove [--host HOST] [--dry-run] [--adopt]" >&2
}

[ "$#" -gt 0 ] || { usage; exit 2; }
action=$1
shift
case "$action" in install|check|remove) ;; -h|--help) usage; exit 0 ;; *) usage; exit 2 ;; esac
host=all
dry_run=0
adopt=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --host) [ "$#" -ge 2 ] || { usage; exit 2; }; host=$2; shift 2 ;;
    --all) host=all; shift ;;
    --dry-run) dry_run=1; shift ;;
    --adopt) adopt=1; shift ;;
    *) echo "Unknown argument: $1" >&2; usage; exit 2 ;;
  esac
done
[ "$adopt" -eq 0 ] || [ "$action" = install ] || { echo "--adopt is for install only" >&2; exit 2; }

rows=$("$script_dir/manifest" instructions) || {
  [ "$action" != check ] || echo "FAIL install/instructions.tsv cannot be read"
  exit 1
}
[ -n "$rows" ] || exit 0

expand_target() {
  case "$1" in
    '~'/*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# The checksum of what follows a file's first line.
body_sum() {
  tail -n +2 "$1" | cksum | awk '{ print $1 "-" $2 }'
}

# Writes to $1 the file built from the sections $2...: the marker, then each section's lines, a
# blank line between two sections. The marker names the repository by its folder's name, so that
# another clone of it builds the same file.
build() {
  build_out=$1
  shift
  # The repository the sections are in: each is <root>/instructions/sections/<name>.md.
  build_root=${1%/instructions/sections/*}
  awk 'FNR == 1 && NR > 1 { print "" } { print }' "$@" >"$scratch/body"
  {
    printf '%s%s (install/instructions.tsv, instructions/sections/). Edit there and run scripts/bootstrap: it rebuilds this file, keeping a change made here in a backup beside it. Checksum: %s -->\n' \
      "$marker_start" "$(basename -- "$build_root")" "$(cksum <"$scratch/body" | awk '{ print $1 "-" $2 }')"
    cat "$scratch/body"
  } >"$build_out"
}

# Is $1 a file bootstrap built: a real file, not a link, whose first line is the marker?
is_built() {
  [ -f "$1" ] && [ ! -L "$1" ] || return 1
  first_line=
  IFS= read -r first_line <"$1" || [ -n "$first_line" ] || return 1
  case "$first_line" in "$marker_start"*) return 0 ;; esac
  return 1
}

# Has the built file $1 changed since bootstrap wrote it? Its first line must be the marker this
# build writes, word for word, with the checksum of the rest of the file as it is now. Anything else,
# a marker without a checksum included, counts as changed, to be safe.
is_changed() {
  first_line=
  IFS= read -r first_line <"$1" || true
  [ "$first_line" != "$marker_head$(body_sum "$1") -->" ]
}

# A free name beside $1, ending in $2 and the time, for a file that is about to be replaced.
backup_name() {
  backup="$1.$2-$(date +%Y%m%d-%H%M%S)"
  candidate=$backup
  count=1
  while [ -e "$candidate" ] || [ -L "$candidate" ]; do
    count=$((count + 1))
    candidate="$backup-$count"
  done
  printf '%s\n' "$candidate"
}

# The permissions a file written at $1 gets: those of the file there (through a link), or what the
# umask gives a new file.
mode_for() {
  if [ -e "$1" ]; then
    stat -L -f %Lp "$1" 2>/dev/null || stat -L -c %a "$1"
  else
    printf '%o\n' $((0666 & ~$(umask)))
  fi
}

scratch=$(mktemp -d "${TMPDIR:-/tmp}/agent-skills-instructions.XXXXXX")
next_file=
trap 'rm -rf "$scratch"; [ -z "$next_file" ] || rm -f "$next_file"' EXIT
trap 'exit 1' HUP INT TERM
built="$scratch/built"
status=0
tab=$(printf '\t')

while IFS= read -r row; do
  [ -n "$row" ] || continue
  row_host=${row%%"$tab"*}
  rest=${row#*"$tab"}
  target=${rest%%"$tab"*}
  sections=${rest#*"$tab"}
  [ "$host" = all ] || [ "$row_host" = "$host" ] || continue
  target_path=$(expand_target "$target")
  # The section paths as arguments: they are separated by tabs, and a path is never a pattern.
  old_ifs=$IFS
  IFS=$tab
  set -f
  # shellcheck disable=SC2086
  set -- $sections
  set +f
  IFS=$old_ifs
  build "$built" "$@"
  # The marker as this build writes it, up to its checksum.
  marker_head=$(head -n 1 "$built")
  marker_head="${marker_head% Checksum: *} Checksum: "

  case "$action" in
    check)
      if is_built "$target_path"; then
        if cmp -s "$built" "$target_path"; then
          echo "PASS $target_path is built from install/instructions.tsv"
        elif is_changed "$target_path"; then
          echo "FAIL $target_path was changed since bootstrap built it: move the change into a section of install/instructions.tsv, then run scripts/bootstrap, which keeps the changed file as a backup beside it"
          status=1
        else
          echo "FAIL $target_path no longer matches its sections in install/instructions.tsv: run scripts/bootstrap to rebuild it"
          status=1
        fi
      elif [ -d "$target_path" ] && [ ! -L "$target_path" ]; then
        echo "FAIL $target_path is a folder, where install/instructions.tsv expects a file: move it away, then run scripts/bootstrap"
        status=1
      elif [ -e "$target_path" ] || [ -L "$target_path" ]; then
        echo "WARN $target_path is not adopted: it is your own file, not built from install/instructions.tsv. To build it from there, keeping yours as a backup beside it, run scripts/bootstrap --adopt-instructions"
      else
        echo "FAIL $target_path is missing: run scripts/bootstrap to build it from install/instructions.tsv"
        status=1
      fi
      ;;

    remove)
      if is_built "$target_path"; then
        if is_changed "$target_path"; then
          echo "KEEP $target_path: it was changed since bootstrap built it" >&2
          continue
        fi
        # The owner's file from before the adoption, if a backup of it is there.
        earlier=$(find "$(dirname -- "$target_path")" -maxdepth 1 -name "$(basename -- "$target_path").before-agent-skills-*" 2>/dev/null | sort | tail -n 1)
        note=
        [ -z "$earlier" ] || note="; your file from before bootstrap built it is $earlier: rename it back to use it again"
        if [ "$dry_run" -eq 1 ]; then
          echo "DRY RUN: rm $target_path$note"
        else
          rm "$target_path"
          echo "REMOVED $target_path$note"
        fi
      elif [ -e "$target_path" ] || [ -L "$target_path" ]; then
        echo "KEEP $target_path: your own file, not built by bootstrap" >&2
      fi
      ;;

    install)
      if [ -d "$target_path" ] && [ ! -L "$target_path" ]; then
        echo "KEEP $target_path: a folder, where install/instructions.tsv expects a file" >&2
        status=1
        continue
      fi
      keep_as=
      if is_built "$target_path"; then
        if cmp -s "$built" "$target_path"; then
          echo "OK $target_path"
          continue
        fi
        verb=REBUILT
        # Judged on a copy, which the target is compared with again just before the move, so a
        # change made in between is seen.
        cp -p "$target_path" "$scratch/judged"
        ! is_changed "$scratch/judged" || keep_as=changed
      elif [ -e "$target_path" ] || [ -L "$target_path" ]; then
        if [ "$adopt" -eq 0 ]; then
          echo "NOT ADOPTED $target_path: your own file, so bootstrap leaves it. To build it from install/instructions.tsv, keeping yours as a backup beside it, run scripts/bootstrap --adopt-instructions" >&2
          continue
        fi
        verb=ADOPTED
        keep_as=before-agent-skills
      else
        verb=BUILT
      fi
      backup=
      [ -z "$keep_as" ] || backup=$(backup_name "$target_path" "$keep_as")
      if [ "$dry_run" -eq 1 ]; then
        if [ -n "$backup" ] && [ -L "$target_path" ]; then
          echo "DRY RUN: keep the link $target_path as $backup"
        elif [ -n "$backup" ]; then
          echo "DRY RUN: cp $target_path $backup"
        fi
        echo "DRY RUN: write $target_path"
        continue
      fi
      target_dir=$(dirname -- "$target_path")
      mkdir -p "$target_dir"
      # Written beside the target and moved into place, so a host never reads half a file, and the
      # target is there throughout: the backup is made before the move replaces it.
      next_file=$(mktemp "$target_dir/.agent-skills-instructions.XXXXXX")
      cat "$built" >"$next_file"
      chmod "$(mode_for "$target_path")" "$next_file"
      note=
      if [ -n "$backup" ]; then
        if [ -L "$target_path" ]; then
          # A link is kept as the link it was, pointing where it pointed.
          ln -s "$(readlink "$target_path")" "$backup"
        else
          cp -p "$target_path" "$backup"
        fi
        if [ "$verb" = ADOPTED ]; then note="; your file is kept as $backup"; else note="; the change made in it is kept as $backup"; fi
      fi
      # Changed since it was judged unchanged: kept after all.
      if [ "$verb" = REBUILT ] && [ -z "$backup" ] && ! cmp -s "$scratch/judged" "$target_path"; then
        backup=$(backup_name "$target_path" changed)
        cp -p "$target_path" "$backup"
        note="; the change made in it is kept as $backup"
      fi
      mv "$next_file" "$target_path"
      next_file=
      echo "$verb $target_path$note"
      ;;
  esac
done <<EOF
$rows
EOF
exit "$status"
