#!/bin/sh
set -u

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
manifest="$repo_root/install/links.tsv"
state_repo=${AGENT_SKILLS_STATE:-$(dirname -- "$repo_root")/agent-skills-state}
state_home=${XDG_STATE_HOME:-$HOME/.local/state}/agent-skills
host=all
failures=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --all) host=all; shift ;;
    --host) [ "$#" -ge 2 ] || exit 2; host=$2; shift 2 ;;
    -h|--help) echo "Usage: doctor [--all | --host HOST]"; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; exit 2 ;;
  esac
done

pass() { echo "PASS $*"; }
fail() { echo "FAIL $*" >&2; failures=$((failures + 1)); }

expand_target() {
  case "$1" in
    '~'/*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

check_link() {
  check_source=$1
  check_target=$2
  if [ -L "$check_target" ] && [ "$(readlink "$check_target")" = "$check_source" ]; then
    pass "$check_target"
  else
    fail "$check_target is missing or points elsewhere"
  fi
}

while IFS=$(printf '\t') read -r row_host mode source target; do
  case "$row_host" in ''|'#'*) continue ;; esac
  [ "$host" = all ] || [ "$row_host" = "$host" ] || continue
  source_path="$repo_root/$source"
  target_path=$(expand_target "$target")
  case "$mode" in
    link) check_link "$source_path" "$target_path" ;;
    retired)
      if [ -L "$target_path" ] && [ "$(readlink "$target_path")" = "$source_path" ]; then
        fail "$target_path is a retired link still installed: run scripts/bootstrap"
      else
        pass "retired $target_path not installed"
      fi
      ;;
    adapter)
      adapter_source=$source_path
      adapter_target=$target_path
      for name in SKILL.md agents references scripts assets; do
        [ -e "$adapter_source/$name" ] || continue
        check_link "$adapter_source/$name" "$adapter_target/$name"
      done
      ;;
  esac
done < "$manifest"

if [ -d "$state_repo/.git" ]; then
  for state_file in "$state_repo"/*/*; do
    [ -f "$state_file" ] || continue
    check_link "$state_file" "$state_home/${state_file#"$state_repo"/}"
  done
else
  echo "SKIP no private state repository at $state_repo"
fi

for forbidden in "$HOME/.agents/skills/product-design" "$HOME/.codex/skills/product-design"; do
  if [ -e "$forbidden" ] || [ -L "$forbidden" ]; then
    fail "portable Product Design must not be exposed to Codex: $forbidden"
  else
    pass "Codex isolation: $forbidden absent"
  fi
done

command -v python3 >/dev/null 2>&1 && pass "python3 available" || fail "python3 missing"
command -v node >/dev/null 2>&1 && pass "node available" || fail "node missing"
command -v npm >/dev/null 2>&1 && pass "npm available" || fail "npm missing"

# Pinned runtimes. Each runtime/<name>/package.json pins one package to an exact version: that pin
# is what must be installed. A newer release on npm is a warning, never a failure: bump the pin on
# purpose (README, "Bumping a pinned runtime"). AGENT_SKILLS_NO_UPDATE_CHECK=1 skips asking npm.
pinned_version() {
  python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["dependencies"][sys.argv[2]])' "$1" "$2" 2>/dev/null
}
installed_version() {
  python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["version"])' "$1" 2>/dev/null
}
check_newer() {
  if [ -n "${AGENT_SKILLS_NO_UPDATE_CHECK:-}" ]; then
    echo "SKIP newer-release check for $1 (AGENT_SKILLS_NO_UPDATE_CHECK)"
    return
  fi
  latest=$(npm view "$1" version --fetch-timeout=5000 --fetch-retries=0 2>/dev/null || true)
  if [ -z "$latest" ]; then
    echo "SKIP could not ask npm whether $1 has a newer release"
    return
  fi
  case "$(semver_order "$latest" "$2")" in
    newer) echo "WARN $1 $latest is out; the runtime pins $2. Bump it on purpose: README, \"Bumping a pinned runtime\"." ;;
    same) pass "$1 $2 is its newest release" ;;
    older) pass "$1 $2 is newer than npm's latest release, $latest" ;;
    *) echo "SKIP could not compare $1 $2 with npm's $latest" ;;
  esac
}

# Prints newer, same or older: how version $1 orders against $2 by semantic-version precedence,
# where a prerelease (2.1.2-beta.1) comes before its release (2.1.2).
semver_order() {
  node -e '
    const parse = v => { const m = /^v?(\d+)\.(\d+)\.(\d+)(?:-([0-9A-Za-z.-]+))?/.exec(v);
      return m && { n: [+m[1], +m[2], +m[3]], pre: m[4] ? m[4].split(".") : [] }; };
    const cmp = (a, b) => {
      for (let i = 0; i < 3; i++) if (a.n[i] !== b.n[i]) return a.n[i] < b.n[i] ? -1 : 1;
      if (!a.pre.length && !b.pre.length) return 0;
      if (!a.pre.length) return 1;   // a release comes after its prereleases
      if (!b.pre.length) return -1;
      for (let i = 0; i < Math.max(a.pre.length, b.pre.length); i++) {
        const x = a.pre[i], y = b.pre[i];
        if (x === undefined) return -1;
        if (y === undefined) return 1;
        const nx = /^\d+$/.test(x), ny = /^\d+$/.test(y);
        if (nx && ny) { if (+x !== +y) return +x < +y ? -1 : 1; }
        else if (nx !== ny) return nx ? -1 : 1;
        else if (x !== y) return x < y ? -1 : 1;
      }
      return 0;
    };
    const [a, b] = process.argv.slice(1).map(parse);
    console.log(!a || !b ? "unknown" : ["older", "same", "newer"][cmp(a, b) + 1]);
  ' "$1" "$2" 2>/dev/null || echo unknown
}

browser_bin="$repo_root/runtime/playwright/node_modules/.bin/playwright-cli"
playwright_pin=$(pinned_version "$repo_root/runtime/playwright/package.json" "@playwright/cli")
if [ -x "$browser_bin" ]; then
  version=$($browser_bin --version 2>/dev/null || true)
  case "$version" in "$playwright_pin"|*" $playwright_pin") pass "Playwright CLI $version" ;; *) fail "Playwright CLI is $version, the runtime pins $playwright_pin" ;; esac
  check_newer @playwright/cli "$playwright_pin"
else
  fail "Product Design browser runtime is not installed"
fi

# The excalidraw-drawing runtime matters only for hosts that install the skill: bootstrap for
# another host never installs it.
if [ "$host" = all ] || awk -F '\t' -v h="$host" '$1 == h && $3 ~ /^skills\/excalidraw-drawing/ { found = 1 } END { exit !found }' "$manifest"; then
  node_major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
  [ "$node_major" -ge 20 ] 2>/dev/null && pass "Node $node_major for excalidraw-drawing" || fail "excalidraw-drawing needs Node 20 or newer (found ${node_major})"
  excalidraw_pin=$(pinned_version "$repo_root/runtime/excalidraw/package.json" mcp-excalidraw-server)
  version=$(installed_version "$repo_root/runtime/excalidraw/node_modules/mcp-excalidraw-server/package.json")
  if [ -z "$version" ]; then
    fail "excalidraw-drawing runtime is not installed (runtime/excalidraw)"
  elif [ "$version" = "$excalidraw_pin" ]; then
    pass "excalidraw-drawing runtime mcp-excalidraw-server $version"
    check_newer mcp-excalidraw-server "$excalidraw_pin"
  else
    fail "mcp-excalidraw-server is $version, the runtime pins $excalidraw_pin"
  fi
fi

if [ "$host" = all ] || [ "$host" = opencode ]; then
  if command -v opencode >/dev/null 2>&1; then
    # OpenCode 2 lists skills through its background service (`opencode api
    # skill.list`); the list can come back empty while the service still loads
    # them, so ask a few times. It truncates stdout at 64 KiB when it writes to
    # a pipe, so read the list from a file instead.
    skill_list=$(mktemp "${TMPDIR:-/tmp}/doctor-opencode.XXXXXX")
    found=0
    for attempt in 1 2 3 4 5; do
      if opencode api skill.list >"$skill_list" 2>/dev/null &&
        python3 -c 'import json, sys; sys.exit(not any(s.get("id") == "product-design" for s in json.load(open(sys.argv[1])).get("data", [])))' "$skill_list" 2>/dev/null; then
        found=1
        break
      fi
      sleep 2
    done
    if [ "$found" -eq 1 ]; then
      pass "OpenCode discovers product-design"
    else
      fail "OpenCode does not discover product-design"
    fi
    rm -f "$skill_list"
  else
    fail "OpenCode CLI missing"
  fi
fi

if [ "$host" = all ] || [ "$host" = factory ]; then
  command -v droid >/dev/null 2>&1 && pass "Factory Droid available" || fail "Factory Droid missing"
fi

if [ "$host" = all ] || [ "$host" = antigravity ]; then
  if [ -d "/Applications/Antigravity.app" ] || [ -d "/Applications/Antigravity IDE.app" ] || [ -x "$HOME/.antigravity-ide/antigravity-ide/bin/antigravity-ide" ]; then
    pass "Google Antigravity available"
  else
    fail "Google Antigravity installation not found"
  fi
fi

if [ "$failures" -gt 0 ]; then
  echo "$failures check(s) failed." >&2
  exit 1
fi
echo "All checks passed."
