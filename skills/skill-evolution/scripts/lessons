#!/usr/bin/env python3
"""Read and write skill-evolution's lessons: one file per entry, each with an ID that never changes,
committed and pushed to the owner's private state repository.

SKILL.md ("Find the files", "Record and propose") says when to use it, and references/entries.md what an entry holds.

Usage:
  lessons show                          one line per entry (ID, status, title), newest first
  lessons show <ID>... | --all          those entries, or all, in full
  lessons add <entry file>...           records new entries; prints each one's ID
  lessons set <ID> <status>             replaces an entry's status ("declined 2026-11-02: too costly")
  lessons note <ID> <incident>          adds an incident to an entry (a repeat)

Where they live: skill-evolution/lessons/<ID>.md in the owner's private state repository
(AGENT_SKILLS_STATE, by default agent-skills-state beside the skills repository, with a .git), or,
without one, ${XDG_STATE_HOME:-~/.local/state}/agent-skills/skill-evolution/lessons/.

An entry file given to `add` is one entry as references/entries.md shows it, its heading
"## L?. <skill>: <title>"; the script gives it an ID (L-K7QM: four letters and digits, never reused)
and a "Recorded:" date. Because every entry is its own file and IDs are chosen at random, two
computers never write the same file, nothing is renumbered, and an ID shown to the owner holds
for good, even one recorded offline. (Should two computers ever pick the same ID offline, the one
sent second moves to a new ID and says so: "moved: ... L-K7QM is now L-P2WD".)

Every command takes a short lock (another run on this computer waits up to a minute), pulls with
rebase, writes, commits only the files it wrote, and pushes, sending any earlier commit that
couldn't be pushed. It pushes only when every unpushed commit is the lessons' own: other unpushed
commits, or uncommitted changes to other files (it then doesn't pull, and never stashes them),
are the owner's to send. When this computer's unsent change to an entry meets another computer's change
to the same entry, the other's wins and this one is dropped, printed with what it said
("dropped: ... L-K7QM ...: <its lines>"; record it again if it still holds). An entry an earlier
command couldn't commit (a failed commit) is committed and sent by the next. It never commits other files, never force-pushes, and never leaves a rebase
it started (any other conflict is aborted); a repository already mid-rebase or mid-merge is left
alone.

Exit 0: done; 3: written here but not pushed (no network, no upstream, a conflict): say so, the
next command sends it; 4: the state repository is mid-rebase or mid-merge, nothing written;
64: a mistake in the command, or no such ID; 75: no lock within a minute.
"""

import os
import random
import re
import subprocess
import sys
import time

ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"     # no 0/O or 1/I
ID = re.compile(r"^L-[A-Z2-9]{3,4}$")
HEADING = re.compile(r"^## L(?:\?|-[A-Z2-9]{3,4})\. ", re.M)
LOCK_WAIT = float(os.environ.get("LESSONS_LOCK_WAIT", "60"))   # seconds; a check may shorten it
REL = os.path.join("skill-evolution", "lessons")


def state_home():
    state = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(state, "agent-skills", "skill-evolution")


def state_repo():
    repo = os.environ.get("AGENT_SKILLS_STATE")
    if not repo:
        # beside the skills repository's main checkout, also when this copy is in one of its worktrees
        here = os.path.dirname(os.path.realpath(__file__))
        common = subprocess.run(["git", "-C", here, "rev-parse", "--path-format=absolute", "--git-common-dir"],
                                capture_output=True, text=True)
        if common.returncode != 0:
            return None
        repo = os.path.join(os.path.dirname(os.path.dirname(common.stdout.strip())), "agent-skills-state")
    if os.path.isdir(os.path.join(repo, ".git")):
        return repo
    print(f"lessons: no private state repository at {repo}: this computer's files only "
          f"(set AGENT_SKILLS_STATE if it is elsewhere)", file=sys.stderr)
    return None


def git(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True, timeout=120)


def fail(code, text):
    print(f"lessons: {text}", file=sys.stderr)
    sys.exit(code)


class Lock:
    """A folder holding the process ID; one whose process is gone is taken over."""

    def __init__(self):
        self.path = os.path.join(state_home(), ".lock")
        self.held = False

    def __enter__(self):
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        deadline = time.monotonic() + LOCK_WAIT
        while True:
            try:
                os.mkdir(self.path)
                with open(os.path.join(self.path, "pid"), "w") as f:
                    f.write(str(os.getpid()))
                self.held = True
                return self
            except FileExistsError:
                dead = self.abandoned()
                if dead is not None:
                    self.remove(only_if=dead)
                    continue
                if time.monotonic() >= deadline:
                    fail(75, "another run is writing the lessons; try again in a minute")
                time.sleep(0.2)

    def owner(self):
        try:
            return open(os.path.join(self.path, "pid")).read().strip()
        except OSError:
            return ""

    def abandoned(self):
        """The lock's owner when it is gone (a process ID, or "" for a lock left half-made), else None."""
        pid = self.owner()
        if not pid.isdigit():
            # being made this moment, or left half-made: abandoned only once it is a minute old
            try:
                return pid if time.time() - os.stat(self.path).st_mtime > 60 else None
            except OSError:
                return None
        try:
            os.kill(int(pid), 0)
            return None
        except ProcessLookupError:
            return pid
        except PermissionError:
            return None

    def remove(self, only_if=None):
        if only_if is not None and self.owner() != only_if:
            return                                 # another waiter took it over first
        try:
            os.unlink(os.path.join(self.path, "pid"))
        except OSError:
            pass
        try:
            os.rmdir(self.path)
        except OSError:
            pass

    def __exit__(self, *exc):
        if self.held:
            self.remove()


def busy(repo):
    g = os.path.join(repo, ".git")
    return any(os.path.exists(os.path.join(g, name)) for name in ("rebase-merge", "rebase-apply", "MERGE_HEAD"))


def has_upstream(repo):
    return git(repo, "rev-parse", "--abbrev-ref", "@{u}").returncode == 0


def settle_rebase(repo):
    """In a rebase this script started: where this computer's unsent edit of an entry meets another
    computer's edit of the same entry, the other computer's (already sent, maybe already shown)
    wins and this one is dropped. Any other conflict is aborted. Returns the IDs dropped, or None."""
    dropped = []
    path = os.path.join(repo, REL)
    for _ in range(50):
        if not busy(repo):
            return dropped
        conflicted = git(repo, "diff", "--name-only", "--diff-filter=U").stdout.split()
        if not conflicted:
            done = subprocess.run(["git", "-C", repo, "rebase", "--continue"], capture_output=True, text=True,
                                  env=dict(os.environ, GIT_EDITOR="true"), timeout=120)
            if done.returncode != 0 and busy(repo):
                if git(repo, "diff", "--name-only", "--diff-filter=U").stdout.split():
                    continue                       # the next commit has conflicts of its own: settle them
                # only a lessons-only step whose change came to nothing is skipped; anything else is aborted
                replayed = git(repo, "show", "--name-only", "--format=", "REBASE_HEAD").stdout.split()
                empty = git(repo, "diff", "--cached", "--quiet").returncode == 0
                if not (empty and replayed and all(f.startswith(REL + "/") for f in replayed)):
                    break
                git(repo, "rebase", "--skip")
            continue
        if not all(f.startswith(REL + "/") for f in conflicted):
            break
        for f in conflicted:
            entry_id = os.path.basename(f)[:-3]
            stages = {line.split()[2] for line in git(repo, "ls-files", "-u", "--", f).stdout.splitlines()}
            mine = git(repo, "show", f":3:{f}").stdout      # in a rebase, stage 3 is this computer's
            theirs = git(repo, "show", f":2:{f}").stdout
            if "1" not in stages and mine:
                # both computers recorded a new entry under the same ID: this one moves to a new ID
                moved = new_id(path)
                with open(os.path.join(path, moved + ".md"), "x", encoding="utf-8") as out:
                    out.write(mine.replace(f"## {entry_id}. ", f"## {moved}. ", 1))
                git(repo, "add", "--", os.path.join(REL, moved + ".md"))
                print(f"moved: this computer's unsent entry {entry_id} is now {moved} (another computer took {entry_id})")
                MOVED.append((entry_id, moved))
            else:
                lost = [line for line in mine.splitlines() if line not in theirs.splitlines()]
                dropped.append((entry_id, lost))
            git(repo, "checkout", "--ours", "--", f)      # and stage 2, "ours", the other computer's
            git(repo, "add", "--", f)
    git(repo, "rebase", "--abort")
    return None


def others_dirty(repo):
    """Tracked files other than the lessons' with uncommitted changes (the owner's work)."""
    lines = git(repo, "status", "--porcelain", "--untracked-files=no").stdout.splitlines()
    return [line[3:] for line in lines if not line[3:].strip('"').startswith(REL + "/")]


MOVED = []


def sync(repo):
    """Pulls with rebase, settling this computer's conflicting entry edits in the other computer's
    favour (printed as "dropped:"); any other failure is aborted. Never stashes the owner's
    uncommitted work: with any, it doesn't pull. Returns a problem or None."""
    if not has_upstream(repo):
        return "no upstream branch"
    if others_dirty(repo):
        return "the state repository has uncommitted changes of its own (" + ", ".join(others_dirty(repo)[:3]) + ")"
    done = git(repo, "pull", "--rebase", "-q")
    if done.returncode == 0:
        return None
    if busy(repo):
        dropped = settle_rebase(repo)
        for old, new in MOVED:
            if any(old == entry_id for entry_id, _ in (dropped or [])) or \
                    git(repo, "log", "--format=%s", "@{u}..HEAD", "--", os.path.join(REL, old + ".md")).stdout.strip():
                print(f"check {old} and {new}: a later change this computer made to {old} may have gone to "
                      f"the other computer's entry; record it again under {new}")
        if dropped is not None:
            for entry_id, lost in dropped:
                print(f"dropped: this computer's unsent change to {entry_id} (another computer changed it first): "
                      + (" | ".join(lost) if lost else "nothing that differed"))
            return None
    lines = (done.stderr or done.stdout).strip().splitlines()
    return lines[-1] if lines else "pull failed"


def push(repo):
    """Pushes, pulling with rebase between tries. Returns a problem or None."""
    if not has_upstream(repo):
        return "no upstream branch"
    if git(repo, "rev-list", "--count", "@{u}..HEAD").stdout.strip() == "0":
        return None
    others = []
    for line in git(repo, "log", "--format=%H %P%x00%s", "@{u}..HEAD").stdout.splitlines():
        shas, _, subject = line.partition("\0")
        sha, *parents = shas.split()
        files = git(repo, "show", "--name-only", "--format=", sha).stdout.split()
        if (len(parents) != 1 or not subject.startswith("skill evolution:") or not files
                or not all(f.startswith(REL + "/") for f in files)):
            others.append(subject or sha[:8])
    if others:
        return ("the state repository has other unpushed commits (" + ", ".join(others[:3])
                + "); push them yourself, and the lessons go with them")
    branch = git(repo, "symbolic-ref", "--short", "-q", "HEAD").stdout.strip()
    remote = git(repo, "config", f"branch.{branch}.remote").stdout.strip()
    merge = git(repo, "config", f"branch.{branch}.merge").stdout.strip()
    if not (branch and remote and merge):
        return "no upstream branch"
    for _ in range(3):
        # exactly this branch to its upstream, whatever push.default or push.followTags say
        if git(repo, "push", "-q", "--no-follow-tags", remote, f"HEAD:{merge}").returncode == 0:
            return None
        problem = sync(repo)
        if problem:
            return problem
    return "rejected three times"


def folder(repo):
    path = os.path.join(repo, REL) if repo else os.path.join(state_home(), "lessons")
    os.makedirs(path, exist_ok=True)
    return path


def entries(path):
    found = []
    for name in sorted(os.listdir(path)):
        if name.endswith(".md") and ID.match(name[:-3]):
            text = open(os.path.join(path, name), encoding="utf-8").read()
            recorded = re.search(r"^- Recorded: (\S+)", text, re.M)
            found.append((recorded.group(1) if recorded else "", name[:-3], text))
    return sorted(found, reverse=True)


def new_id(path):
    taken = {name[:-3] for name in os.listdir(path)}
    while True:
        candidate = "L-" + "".join(random.choice(ALPHABET) for _ in range(4))
        if candidate not in taken:
            return candidate


def commit_leftovers(repo):
    """Commits entry files an earlier command wrote but couldn't commit (a failed commit), so they
    are sent like any other. Returns their IDs."""
    leftovers = []
    for line in git(repo, "status", "--porcelain", "--untracked-files=all", "--", REL).stdout.splitlines():
        f = line[3:].strip().strip('"')
        if f.startswith(REL + "/") and f.endswith(".md") and ID.match(os.path.basename(f)[:-3]):
            leftovers.append(f)
    if not leftovers:
        return None
    names = ", ".join(os.path.basename(f)[:-3] for f in leftovers)
    git(repo, "add", "--", *leftovers)
    done = git(repo, "commit", "-q", "-m", "skill evolution: entries an earlier command couldn't commit", "--", *leftovers)
    if done.returncode != 0:
        return f"{names} still not committed: {(done.stderr or done.stdout).strip()}"
    print(f"committed earlier entries: {names}")
    return None


def write(repo, files, message):
    """Commits only these files (paths relative to the repository) and pushes."""
    if repo is None:
        print("saved (this computer only: no state repository)")
        return 0
    git(repo, "add", "--", *files)
    if git(repo, "diff", "--cached", "--quiet", "--", *files).returncode != 0:
        done = git(repo, "commit", "-q", "-m", message, "--", *files)
        if done.returncode != 0:
            print(f"not committed: {(done.stderr or done.stdout).strip()}")
            return 3
    problem = push(repo)
    if problem:
        print(f"not pushed: {problem}; kept here, the next lessons command sends it")
        return 3
    print("pushed")
    return 0 if not commit_leftovers_failed(repo) else 3


def commit_leftovers_failed(repo):
    return any(ID.match(os.path.basename(line[3:].strip().strip('"'))[:-3] or "")
               for line in git(repo, "status", "--porcelain", "--untracked-files=all", "--", REL).stdout.splitlines()
               if line[3:].strip().endswith(".md"))


def find(path, entry_id):
    if not ID.match(entry_id):
        fail(64, f"{entry_id} isn't an ID like L-K7QM")
    file = os.path.join(path, entry_id + ".md")
    if not os.path.isfile(file):
        fail(64, f"no entry {entry_id}")
    return file


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if argv else 64
    command, args = argv[0], argv[1:]
    if command not in ("show", "add", "set", "note") \
            or (command == "add" and not args) or (command in ("set", "note") and len(args) != 2):
        fail(64, "usage: lessons show [--all | <ID>...] | add <entry file>... | set <ID> <status> | note <ID> <incident>")
    texts = []
    if command == "add":
        for given in args:
            try:
                text = open(given, encoding="utf-8").read().strip() + "\n"
            except OSError as error:
                fail(64, f"{given}: {error.strerror}")
            if len(HEADING.findall(text)) != 1 or not text.startswith("## L?. "):
                fail(64, f"{given}: one entry, its heading starting \"## L?. \"")
            texts.append(text)
    with Lock():
        repo = state_repo()
        if repo and busy(repo):
            fail(4, f"{repo} is mid-rebase or mid-merge; finish that first. Nothing written")
        uncommitted = commit_leftovers(repo) if repo else None
        if uncommitted:
            print(f"not committed: {uncommitted}")
        problem = sync(repo) if repo else None
        if problem:
            print(f"not pulled: {problem} (this computer's copy)")
        path = folder(repo)
        if repo and os.path.exists(os.path.join(repo, "skill-evolution", "lessons.md")):
            print("lessons: skill-evolution/lessons.md is from an earlier version: move its entries with "
                  "`lessons add`, then delete it", file=sys.stderr)
        if command == "show":
            shown = entries(path)
            if not shown:
                print("No lessons yet.")
            wanted = [a for a in args if a != "--all"]
            for _, entry_id, text in shown:
                if "--all" in args or entry_id in wanted:
                    print(text.rstrip("\n") + "\n")
                elif not wanted:
                    title = text.split("\n", 1)[0][len(f"## {entry_id}. "):]
                    status = re.search(r"^- Status: (.*)$", text, re.M)
                    print(f"{entry_id}  {status.group(1) if status else '?'}  {title}")
            for missing in sorted(set(wanted) - {e for _, e, _ in shown}):
                print(f"no entry {missing}")
            sent = push(repo) if repo else None       # sends an earlier save that couldn't go
            if sent:
                print(f"not pushed: {sent}; kept here, the next lessons command sends it")
            return 3 if (sent or uncommitted) else 0
        today = time.strftime("%Y-%m-%d")
        if command == "add":
            written = []
            for text in texts:
                entry_id = new_id(path)
                body = text.replace("## L?. ", f"## {entry_id}. ", 1)
                first, _, rest = body.partition("\n")
                body = first + f"\n- Recorded: {today}\n" + rest
                with open(os.path.join(path, entry_id + ".md"), "x", encoding="utf-8") as f:
                    f.write(body)
                written.append(entry_id)
                print(f"added: {entry_id} {first[len('## ' + entry_id + '. '):]}")
            files = [os.path.join(REL, i + ".md") for i in written]
            return write(repo, files, f"skill evolution: {', '.join(written)}")
        for old, new in MOVED:
            if args[0] == old:
                fail(64, f"this computer's entry {old} just moved to {new} (another computer took {old}); "
                         f"run it again with the ID you mean")
        file = find(path, args[0])
        text = open(file, encoding="utf-8").read()
        if command == "set":
            status = args[1].replace("\n", " ").strip()
            text, n = re.subn(r"^- Status: .*$", lambda _: f"- Status: {status}", text, count=1, flags=re.M)
            if not n:
                text = text.rstrip("\n") + f"\n- Status: {status}\n"
        else:
            incident = f"{today}: " + args[1].replace("\n", " ").strip()
            text, n = re.subn(r"^(- Incidents: .*)$", lambda m: m.group(1) + "; " + incident, text, count=1, flags=re.M)
            if not n:
                text = text.rstrip("\n") + f"\n- Incidents: {incident}\n"
        with open(file, "w", encoding="utf-8") as f:
            f.write(text)
        print(f"{command}: {args[0]}")
        return write(repo, [os.path.join(REL, args[0] + ".md")], f"skill evolution: {args[0]} {command}")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
