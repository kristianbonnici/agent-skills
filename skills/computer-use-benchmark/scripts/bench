def data_folder():
    """Private state folder: <agent-skills-state>/computer-use-benchmark when present, else XDG state."""
    repo = os.environ.get("AGENT_SKILLS_STATE")
    if repo == "":
        repo = None
    if not repo:
        common = subprocess.run(
            ["git", "-C", SCRIPT_DIR, "rev-parse", "--path-format=absolute", "--git-common-dir"],
            capture_output=True,
            text=True,
        )
        if common.returncode == 0:
            repo = os.path.join(os.path.dirname(os.path.dirname(common.stdout.strip())), "agent-skills-state")
    if repo and os.path.isdir(os.path.join(repo, ".git")):
        return os.path.join(os.path.abspath(repo), "computer-use-benchmark")
    state = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(os.path.abspath(state), "agent-skills", "computer-use-benchmark")


def cache_folder():
    """Rebuildable app, manifest, and harness workspace cache."""
    override = os.environ.get("COMPUTER_USE_BENCHMARK_CACHE")
    if override:
        return os.path.abspath(os.path.expanduser(override))
    cache = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.join(os.path.abspath(cache), "agent-skills", "computer-use-benchmark")


def socket_path():
    override = os.environ.get("COMPUTER_USE_BENCHMARK_SOCKET")
    if override:
        return os.path.abspath(os.path.expanduser(override))
    return f"/tmp/cu-bench-{os.getuid()}/cua.sock"


def resolve_codex_home(raw=None, cwd=None):
    """Resolve CODEX_HOME to an absolute path once before child harnesses change directories."""
    val = raw if raw is not None else (os.environ.get("CODEX_HOME") or "~/.codex")
    expanded = os.path.expanduser(val)
    if os.path.isabs(expanded):
        return os.path.abspath(expanded)
    return os.path.abspath(os.path.join(cwd or STARTUP_CWD, expanded))


