#!/usr/bin/env python3
"""Benchmark desktop computer-use setups on Harbor Desk (assets/Bench.swift).

Usage:
  bench where
  bench build
  bench selftest [<task,task|all>] [--seed N]
  bench start-cua | stop-cua
  bench run <out> <setup,setup> <task,task|all> [--seeds 3 | --seed 2] [--limit 420]
            [--quiet] [--force] [--between '<command>'] [--usage <provider-usage>]
            [--allow-overlay <App>]...
  bench record <out> [--name <run-id>] [--note <text>] [--force]
  bench summarize [<out> ...] [--json]
  bench totals [<out> ...] [--json]

Exit 0: done; 64: a mistake in the command, config or manifest; 1: a run stopped or selftest failed.
"""
