def _screen():
    from tui import Screen
    return Screen


class Refused(SystemExit):
    """A mistake in the command, configuration, or manifest: prints its message and exits 64."""

    def __init__(self, message):
        self.message = message
        super().__init__(message)


STARTUP_CWD = os.getcwd()
BUNDLE_ID = "local.computer-use-benchmark.harbor-desk"
