class Refused(SystemExit):
    """A mistake in the command, configuration, or manifest: prints its message and exits 64."""

    def __init__(self, message):
        self.message = message
        super().__init__(message)


class BenchLaunchError(RuntimeError):
    """Harbor Desk failed to write its initial event log or expose its PID in time."""


