def find_driver():
    """Locate the Cua Driver binary in standard install paths or on PATH."""
    candidates = [
        os.path.expanduser("~/.local/bin/cua-driver"),
        shutil.which("cua-driver"),
        DRIVER_HELPER,
    ]
    for path in candidates:
        if path and os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return candidates[0]


def _require_driver(driver=None):
    path = DRIVER if driver is None else driver
    if not (path and os.path.isfile(path) and os.access(path, os.X_OK)):
        raise Refused(
            "no Cua Driver binary found: install Cua Spaces or CuaDriver.app, or put `cua-driver` on PATH"
        )
    return path


