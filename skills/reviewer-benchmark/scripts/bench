#!/usr/bin/env python3
"""Run reviewer models over the benchmark's past changes, hide which model wrote which report for scoring,
and add up the scores.

SKILL.md says when to use each command, references/set.md what the set and a key hold, and
references/scoring.md what a score holds.

Usage:
  bench where
  bench setup [<change> ...]
  bench run <model> [<change> ...]
  bench blind [--discard] <model> [<model> ...]
  bench unblind
  bench totals [--json]

where: prints the data folder, the two cache folders and the set's version. The data is the owner's and
private: <the private state repository>/reviewer-benchmark (AGENT_SKILLS_STATE, by default agent-skills-state
beside the skills repository, with a .git), or, without one,
${XDG_STATE_HOME:-~/.local/state}/agent-skills/reviewer-benchmark. It holds set.json, keys/<change>.json,
runs/<model>/<change>.md and .json, scores/<change>.json and models.json (the owner's own models). What can
be made again is in ${XDG_CACHE_HOME:-~/.cache}/agent-skills (or REVIEWER_BENCHMARK_CACHE): the copies to
review under reviewer-benchmark/, and the blind copies of reports and the reviewers' logs under
reviewer-benchmark-scoring/, apart from the copies, so that a reviewer looking around its folder doesn't
find another's report beside it.

setup: for each change of the set, makes a repository of two commits: the tree before the change and the
tree its first review round read, taken from the key's repository with git archive (a file that repository
marks export-ignore isn't in the copy). A reviewer sees the change and nothing that came after it. It only
reads the key's repository.

run: has one model review each change it has no review of, one at a time, read-only, from the copy's
folder, with the review gate's brief. A model with "paid" gets no time line in its brief. The report is
saved as it came, with how long it took and how it ended. A review that passes its minutes is stopped and
recorded as timed out, and the run goes on. One whose tool ends in an error (a limit, a login) is recorded
as failed, whatever it printed, and run again by the next run. A review of other commits than the key's now names is run
again, and its score is dropped. Stopping bench stops the reviewer it started. Models: the table below, and
the owner's in models.json.

blind: copies those models' reports of every change to blind/<change>/<letter>.md, in an order of its own
for each change, and writes blind/<change>/scores.json for the scorer to fill. A review that timed out,
failed or left under 400 bytes gets no file. The letters' meaning is kept in blind/map.json, which scorers
aren't given. It refuses while the scores of an earlier blind aren't saved; --discard throws them away.

unblind: reads each blind/<change>/scores.json and saves its reports' scores under their models' names in
the data's scores/<change>.json, leaving other models' scores there as they are. A scores.json that doesn't
fit its key (a known defect missing, a verdict it doesn't know) is refused with its reasons, and so is the
score of a report that was reviewed again since blind copied it.

totals: one line per model: reports of reviews tried, known defects found (1 for a defect described, a half
for the right code without the failing case), blockers among them, defects only it found among the models
that tried every change, and its other findings by verdict: real, true but minor or there before, and false.
It names a model that tried only part of the set, a review that failed, and a score that doesn't cover its
key. --json prints the same as JSON.

Exit 0: done; 64: a mistake in the command or in a file it was given; 69: a tool a model needs isn't
installed.
"""

import collections
import contextlib
import fcntl
import json
import os
import random
import shutil
import signal
import subprocess
import sys
import time

CLAUDE_TOOLS = "Read,Grep,Glob,Bash(git diff:*),Bash(git log:*),Bash(git show:*)"
AGY_ALLOW = ["git diff", "git log", "git show", "git status", "grep", "ls", "cat", "sed -n", "find"]
KINDS = ("opencode", "claude", "codex", "agy", "command")
MODELS = {
    "deepseek": {"kind": "opencode", "model": "opencode-go/deepseek-v4.1-flash#high"},
    "glm": {"kind": "opencode", "model": "opencode-go/glm-5.3-flash#high"},
    "muse": {"kind": "opencode", "model": "opencode-go/muse-spark-1.3-contributor#high"},
    "haiku": {"kind": "claude", "model": "claude-haiku-5-5"},
    "hydrogen": {"kind": "agy", "model": "gemini-4-hydrogen-high"},
    "terra": {"kind": "codex", "model": "gpt-6.1-terra", "minutes": 30, "paid": True},
    "sonnet": {"kind": "claude", "model": "claude-sonnet-5-5", "minutes": 30, "paid": True},
    "opus": {"kind": "claude", "model": "claude-opus-5-5", "minutes": 30, "paid": True},
}
VERDICTS = ("real", "true-minor", "pre-existing", "wrong", "unclear")
ISSUE = """Report each issue as:
- a short title;
- file and line;
- what goes wrong and when, as a concrete case;
- blocker (a defect this change introduces or exposes that causes data loss or corruption, a security or privacy hole, a crash, hang or wrong result on a common path, a broken build or test, or another serious defect on a common path), follow-up (a defect this change introduces or exposes that needs unusual timing, rare input or a corner case, or a missing hardening), nit (real but minor) or pre-existing (true, but not caused by this diff);
- for a blocker or follow-up, the fix it needs;
- how often it would happen, from 1 to 10, and how bad it would be, from 1 to 10;
- confirmed (you traced it through the code or ran it) or suspected.

Skip style preferences and theoretical cases you can't make concrete. If you find nothing serious, say so plainly and list what you checked."""
GIT_ENV = {"GIT_AUTHOR_NAME": "bench", "GIT_AUTHOR_EMAIL": "bench@example.invalid", "GIT_COMMITTER_NAME": "bench",
           "GIT_COMMITTER_EMAIL": "bench@example.invalid", "GIT_AUTHOR_DATE": "2026-01-01T12:00:00",
           "GIT_COMMITTER_DATE": "2026-01-01T12:00:00", "GIT_CONFIG_GLOBAL": os.devnull, "GIT_CONFIG_NOSYSTEM": "1"}


class Refused(Exception):
    """A mistake in the command or in a file: its message is printed, and the exit is 64."""


def data_folder():
    repo = os.environ.get("AGENT_SKILLS_STATE")
    if not repo:
        here = os.path.dirname(os.path.realpath(__file__))
        common = subprocess.run(["git", "-C", here, "rev-parse", "--path-format=absolute", "--git-common-dir"],
                                capture_output=True, text=True)
        if common.returncode == 0:
            repo = os.path.join(os.path.dirname(os.path.dirname(common.stdout.strip())), "agent-skills-state")
    if repo and os.path.isdir(os.path.join(repo, ".git")):
        return os.path.join(repo, "reviewer-benchmark")
    state = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(state, "agent-skills", "reviewer-benchmark")


def cache_folders():
    """Where the copies to review are, and where the blind copies and logs are: never one inside the other."""
    root = os.environ.get("REVIEWER_BENCHMARK_CACHE")
    if not root:
        cache = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
        root = os.path.join(cache, "agent-skills")
    return os.path.join(root, "reviewer-benchmark"), os.path.join(root, "reviewer-benchmark-scoring")


def read(path, what):
    try:
        with open(path, encoding="utf-8") as handle:
            return json.load(handle)
    except OSError:
        raise Refused(f"no {what} at {path}")
    except ValueError as error:
        raise Refused(f"{path} isn't valid JSON ({str(error)[:80]})")


def write(path, value):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    part = f"{path}.{os.getpid()}.part"         # its own, so two runs never write one temporary file
    with open(part, "w", encoding="utf-8") as handle:
        json.dump(value, handle, indent=1, ensure_ascii=False)
        handle.write("\n")
    os.replace(part, path)


@contextlib.contextmanager
def scores_locked(data):
    """One run at a time reads, changes and writes a scores file: models run side by side."""
    os.makedirs(os.path.join(data, "scores"), exist_ok=True)
    with open(os.path.join(data, "scores", ".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def plain(name):
    return isinstance(name, str) and name not in ("", ".", "..") and os.path.basename(name) == name and "\0" not in name


def the_set(data):
    found = read(os.path.join(data, "set.json"), "set")
    if not (isinstance(found, dict) and isinstance(found.get("version"), str)
            and isinstance(found.get("changes"), list) and all(plain(c) for c in found["changes"])):
        raise Refused(f'{data}/set.json needs a "version" and a list of "changes", each a plain folder name')
    return found


def the_key(data, change):
    key = read(os.path.join(data, "keys", change + ".json"), "key")
    defects = key.get("defects") if isinstance(key, dict) else None
    numbers = [d.get("n") for d in defects] if isinstance(defects, list) and all(isinstance(d, dict) for d in defects) else None
    if numbers and not all((isinstance(n, int) and not isinstance(n, bool)) or (isinstance(n, str) and n.strip()) for n in numbers):
        numbers = None
    if not numbers or len(set(map(str, numbers))) != len(numbers) or any(
            not isinstance(key.get(name), str) or not key[name] for name in ("repo", "base", "head", "objective")):
        raise Refused(f'{change}: its key needs "repo", "base", "head", "objective" and "defects" numbered each once')
    if not isinstance(key.get("rules", ""), str) or "\n" in key.get("rules", ""):
        raise Refused(f'{change}: "rules" in its key is the path of the rules file in the repository, or empty')
    return key


def the_scores(data, change):
    """A change's saved scores by model: {} when there are none yet."""
    path = os.path.join(data, "scores", change + ".json")
    if not os.path.exists(path):
        return {}
    kept = read(path, "scores")
    if not isinstance(kept, dict) or not isinstance(kept.get("reports"), dict):
        raise Refused(f'{path} needs "reports", an object of scores by model')
    return kept["reports"]


def models(data):
    known = dict(MODELS)
    path = os.path.join(data, "models.json")
    if os.path.exists(path):
        own = read(path, "models")
        if not isinstance(own, dict) or not all(plain(n) and isinstance(s, dict) for n, s in own.items()):
            raise Refused(f"{path} isn't an object of models")
        known.update(own)
    for name, spec in known.items():
        if spec.get("kind") not in KINDS:
            raise Refused(f'model {name}: "kind" is one of {", ".join(KINDS)}')
        if spec["kind"] == "command" and not (isinstance(spec.get("argv"), list) and spec["argv"]):
            raise Refused(f'model {name}: a command needs "argv", a list')
        if spec["kind"] != "command" and not (isinstance(spec.get("model"), str) and spec["model"]):
            raise Refused(f'model {name}: "model" is the model\'s name as its tool takes it')
        minutes = spec.get("minutes", 15)
        if isinstance(minutes, bool) or not isinstance(minutes, int) or not 4 <= minutes <= 120:
            raise Refused(f'model {name}: "minutes" is a whole number from 4 to 120')
        seconds = spec.get("seconds", 1)
        if isinstance(seconds, bool) or not isinstance(seconds, (int, float)) or seconds <= 0:
            raise Refused(f'model {name}: "seconds" is a number above 0')
    return known


def wanted(found, given):
    unknown = [c for c in given if c not in found["changes"]]
    if unknown:
        raise Refused("not in the set: " + ", ".join(unknown))
    return given or found["changes"]


def state_of(meta, key):
    """How a saved review stands: "report", "none" (out of time, or nearly nothing), "failed" (to run again)
    or "stale" (a review of other commits than the key's)."""
    if meta.get("commits") != [key["base"], key["head"]]:
        return "stale"
    if meta.get("failed"):
        return "failed"
    return "none" if meta.get("timed_out") or meta.get("bytes", 0) < 400 else "report"


# setup


def git(folder, *args):
    done = subprocess.run(["git", "-C", folder, *args], capture_output=True, text=True, env=dict(os.environ, **GIT_ENV))
    if done.returncode:
        raise Refused(f"git {' '.join(args[:2])} in {folder}: {done.stderr.strip()[:200]}")
    return done.stdout.strip()


def unpack(repo, commit, folder):
    archive = subprocess.Popen(["git", "-C", repo, "archive", commit], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    tar = subprocess.Popen(["tar", "-x", "-C", folder], stdin=archive.stdout, stdout=subprocess.DEVNULL,
                           stderr=subprocess.PIPE)
    archive.stdout.close()          # so that git archive ends when tar does, and never waits on a full pipe
    tar_said = tar.communicate()[1]
    said = archive.stderr.read()
    if archive.wait() or tar.returncode:
        raise Refused(f"{commit} of {repo} can't be unpacked: {(said or tar_said).decode(errors='replace')[:200].strip()}")


def setup(data, copies, given):
    found = the_set(data)
    for change in wanted(found, given):
        key = the_key(data, change)
        work = os.path.join(copies, change)
        note = os.path.join(work, ".bench.json")
        if os.path.exists(note) and read(note, "note").get("of") == [key["base"], key["head"]]:
            continue
        shutil.rmtree(work, ignore_errors=True)
        os.makedirs(work)
        git(work, "init", "-q", "-b", "main")
        unpack(key["repo"], key["base"], work)
        git(work, "add", "-A", "-f")            # -f: a tracked file its .gitignore names is part of the tree too
        git(work, "commit", "-q", "--allow-empty", "-m", "Before the change")
        base = git(work, "rev-parse", "HEAD")
        git(work, "rm", "-r", "-f", "-q", "--ignore-unmatch", ".")      # folders too: one may be a file at head
        unpack(key["repo"], key["head"], work)
        git(work, "add", "-A", "-f")
        git(work, "commit", "-q", "--allow-empty", "-m", "The change under review")
        with open(os.path.join(work, ".git", "info", "exclude"), "a") as handle:
            handle.write(".bench.json\n")       # kept out of the copy's commits; it holds only the two commits' names
        write(note, {"of": [key["base"], key["head"]], "base": base[:10], "head": git(work, "rev-parse", "HEAD")[:10]})
        print(f"{change}: {git(work, 'diff', '--shortstat', 'HEAD~1', 'HEAD')}")
    return 0


# run


def brief(key, work, note, spec):
    kind, minutes = spec["kind"], spec.get("minutes", 15)
    diff = (f"git diff {note['base']}...{note['head']}, run from that folder" if kind == "agy"
            else f"git -C {work} diff {note['base']}...{note['head']}")
    rules = f"{work}/{key['rules']}" if key.get("rules") else "none written down"
    timed = "" if spec.get("paid") else (
        f"You have {minutes - 3} minutes and about {spec.get('commands', 20)} commands. When you reach either, stop "
        "and report what you have, and list what you didn't get to.")
    if kind == "agy":
        timed += (" Run one shell command at a time, without &&, ; or pipes, and only these: " + ", ".join(AGY_ALLOW)
                  + ". Read files with your file-reading tool. Don't run tests or scripts: any other command ends "
                  "your session before you can report.")
    return (
        "You are reviewing a code change before it merges. Review only: don't edit, create or delete files, don't "
        "commit, and run only commands that read (git diff, git log, git show, reading files, running the existing "
        "tests if that is quick and writes nothing outside a temporary folder). Don't ask anyone anything; answer "
        "with your report.\n\n"
        f"The change: {key['objective']}\n"
        f"Where: {work}. The diff: {diff}. Read the related code and tests as well, not only the diff.\n"
        f"The project's rules: {rules}.\n"
        "Your focus: an open look. Report anything serious you find outside it too.\n"
        + (timed + "\n" if timed else "") + "\n" + ISSUE)


def command(spec, text, work, last):
    """The command for a review, and whether the brief goes in on its standard input."""
    kind, model = spec["kind"], spec.get("model", "")
    if kind == "opencode":
        return ["opencode", "run", "--agent", "plan", "-m", model, text], False
    if kind == "claude":
        # The brief goes in on standard input, since --allowedTools would take it for a tool's name. dontAsk
        # refuses a tool that isn't allowed, where another mode raises an approval card and waits for a person.
        # Of the settings files only the copy's local one is read: the owner's own would add tools and hooks.
        # That covers settings files alone, not everything of the owner's that the tool may load.
        return ["claude", "-p", "--model", model, "--effort", "high", "--permission-mode", "dontAsk",
                "--setting-sources", "local", "--allowedTools", CLAUDE_TOOLS], True
    if kind == "codex":
        return ["codex", "exec", "--sandbox", "read-only", "--ephemeral", "-m", model, "-c",
                'model_reasoning_effort="high"', "-C", work, "--output-last-message", last, text], False
    if kind == "agy":
        settings = {"trustedWorkspaces": [work], "permissions": {"allow": [f"command({c})" for c in AGY_ALLOW]}}
        return ["agy", "--mode", "plan", "--model", model, "--print-timeout", f"{spec.get('minutes', 15)}m",
                "--settings", json.dumps(settings), "-p", text], False
    return [str(part).replace("{work}", work).replace("{brief}", text) for part in spec["argv"]], bool(spec.get("stdin"))


def stop(process):
    """Stop a reviewer and everything it started: ask its group to end, then end what is left of it. Where
    signalling the group isn't allowed, the reviewer alone."""
    for sign, wait in ((signal.SIGTERM, 5), (signal.SIGKILL, 30)):
        try:
            os.killpg(process.pid, sign)
        except ProcessLookupError:
            pass
        except PermissionError:
            try:
                process.send_signal(sign)
            except ProcessLookupError:
                pass
        try:
            process.wait(timeout=wait)
        except subprocess.TimeoutExpired:
            pass
    return process.returncode if process.returncode is not None else -9


def drop_score(data, change, name):
    with scores_locked(data):
        reports = the_scores(data, change)
        if name in reports:
            del reports[name]
            write(os.path.join(data, "scores", change + ".json"), {"id": change, "reports": reports})


def run(data, copies, scoring, name, given):
    found, known = the_set(data), models(data)
    if name not in known:
        raise Refused(f"no model {name}: " + ", ".join(sorted(known)))
    spec = known[name]
    limit = spec["seconds"] if "seconds" in spec else spec.get("minutes", 15) * 60    # "seconds": for a check of this script
    folder, logs = os.path.join(data, "runs", name), os.path.join(scoring, "logs", name)
    os.makedirs(folder, exist_ok=True)
    os.makedirs(logs, exist_ok=True)

    def ended(*_):
        raise KeyboardInterrupt

    for sign in (signal.SIGTERM, signal.SIGHUP):     # so that stopping bench, or closing its terminal, stops
        signal.signal(sign, ended)                   # its reviewer, below
    for change in wanted(found, given):
        key = the_key(data, change)
        meta = os.path.join(folder, change + ".json")
        if os.path.exists(meta) and state_of(read(meta, "run"), key) in ("report", "none"):
            continue
        work = os.path.join(copies, change)
        note = read(os.path.join(work, ".bench.json"), f"copy of {change} (run setup first)")
        if note.get("of") != [key["base"], key["head"]]:
            raise Refused(f"{change}: its copy is of other commits than its key's: run setup")
        drop_score(data, change, name)          # a score of an earlier review isn't this review's
        report, last = os.path.join(folder, change + ".md"), os.path.join(logs, change + ".last")
        text = brief(key, work, note, spec)
        argv, by_stdin = command(spec, text, work, last)
        sent = os.path.join(logs, change + ".brief")
        with open(sent, "w", encoding="utf-8") as handle:
            handle.write(text)
        if os.path.exists(last):
            os.remove(last)                     # an earlier try's last message isn't this one's
        if not shutil.which(argv[0]):
            print(f"bench: {argv[0]} isn't installed", file=sys.stderr)
            return 69
        started = time.time()
        try:
            # The brief is read from a file, never written down a pipe that a reviewer may stop reading.
            with open(report, "wb") as out, open(os.path.join(logs, change + ".err"), "wb") as err, open(
                    sent if by_stdin else os.devnull, "rb") as given_in:
                process = subprocess.Popen(argv, cwd=work, stdout=out, stderr=err, stdin=given_in, start_new_session=True)
                try:
                    code, timed_out = process.wait(timeout=limit), False
                except subprocess.TimeoutExpired:
                    code, timed_out = stop(process), True
                except BaseException:
                    stop(process)
                    os.remove(report)
                    raise
        except OSError as error:
            if os.path.exists(report):
                os.remove(report)
            raise Refused(f"{name}'s review of {change} couldn't start: {error}")
        except KeyboardInterrupt:
            print(f"bench: stopped during {name}'s review of {change}; nothing of it is kept", file=sys.stderr)
            return 130
        if spec["kind"] == "codex":
            # Codex prints its whole session; its last message alone is the report, and without one there is none.
            if os.path.exists(last):
                shutil.copyfile(last, report)
                os.remove(last)
            else:
                open(report, "wb").close()
        size = os.path.getsize(report)
        result = {"model": name, "change": change, "seconds": round(time.time() - started), "returncode": code,
                  "timed_out": timed_out, "bytes": size, "set": found["version"], "commits": [key["base"], key["head"]]}
        if code != 0 and not timed_out:
            result["failed"] = True             # the tool ended in an error: what it printed is no report
        write(meta, result)
        print(json.dumps(result), flush=True)
    return 0


# blind and unblind


def blind(data, scoring, names):
    discard = "--discard" in names
    names = [n for n in names if n != "--discard"]
    found, known = the_set(data), models(data)
    unknown = [n for n in names if n not in known]
    if unknown or not names:
        raise Refused("blind takes the models to score: " + ", ".join(sorted(known)))
    if len(set(names)) > 26:
        raise Refused("at most 26 models at once")
    folder = os.path.join(scoring, "blind")
    if os.path.exists(os.path.join(folder, "map.json")) and not os.path.exists(os.path.join(folder, "saved")) and not discard:
        raise Refused(f"the scores in {folder} aren't saved yet: run unblind, or blind --discard to throw them away")
    mapping, copies, shuffler, of = {}, [], random.Random(), {}
    for change in found["changes"]:
        key = the_key(data, change)
        there = []
        for name in sorted(set(names)):
            meta, report = os.path.join(data, "runs", name, change + ".json"), os.path.join(data, "runs", name, change + ".md")
            if os.path.exists(meta) and state_of(read(meta, "run"), key) == "report":
                if not os.path.isfile(report):
                    raise Refused(f"{report} is missing, though its review has a report: put it back, or delete {meta}")
                there.append(name)
                of[f"{change}/{name}"] = review_id(read(meta, "run"))
        shuffler.shuffle(there)
        mapping[change] = dict(zip("ABCDEFGHIJKLMNOPQRSTUVWXYZ", there))
        copies.append((change, key))
    building = folder + ".part"
    shutil.rmtree(building, ignore_errors=True)
    for change, key in copies:
        os.makedirs(os.path.join(building, change))
        template = {"id": change, "reports": {}}
        for letter, name in mapping[change].items():
            shutil.copyfile(os.path.join(data, "runs", name, change + ".md"), os.path.join(building, change, letter + ".md"))
            template["reports"][letter] = {"is_review": True, "known": {str(d["n"]): 0 for d in key["defects"]},
                                           "others": [], "nits_unchecked": 0}
        write(os.path.join(building, change, "scores.json"), template)
    write(os.path.join(building, "map.json"), mapping)
    write(os.path.join(building, "reviews.json"), of)
    shutil.rmtree(folder, ignore_errors=True)
    os.replace(building, folder)
    print(f"{sum(len(v) for v in mapping.values())} reports of {len(mapping)} changes in {folder}")
    return 0


def review_id(meta):
    """What tells one review of a change by a model from another of the same."""
    return [meta.get("commits"), meta.get("bytes"), meta.get("seconds"), meta.get("returncode")]


def score_problems(change, letter, report, key):
    problems, where = [], f"{change} {letter}"
    if not isinstance(report, dict):
        return [f"{where}: not an object"]
    if not isinstance(report.get("is_review"), bool):
        problems.append(f'{where}: "is_review" is true or false')
    known = report.get("known")
    numbers = [str(d["n"]) for d in key["defects"]]
    if not isinstance(known, dict) or sorted(known) != sorted(numbers):
        problems.append(f'{where}: "known" needs one score for each of the key\'s defects: {", ".join(numbers)}')
    elif any(isinstance(v, bool) or v not in (0, 0.5, 1) for v in known.values()):
        problems.append(f'{where}: a score in "known" is 0, 0.5 or 1')
    others = report.get("others")
    if not isinstance(others, list) or not all(isinstance(o, dict) for o in others):
        problems.append(f'{where}: "others" is a list of findings')
    else:
        for place, other in enumerate(others, 1):
            if other.get("verdict") not in VERDICTS:
                problems.append(f'{where}: finding {place} of "others": "verdict" is one of {", ".join(VERDICTS)}')
            if not isinstance(other.get("title"), str) or not other["title"].strip():
                problems.append(f'{where}: finding {place} of "others" has no "title"')
    nits = report.get("nits_unchecked", 0)
    if isinstance(nits, bool) or not isinstance(nits, int) or nits < 0:
        problems.append(f'{where}: "nits_unchecked" is a count')
    return problems


def unblind(data, scoring):
    folder = os.path.join(scoring, "blind")
    mapping = read(os.path.join(folder, "map.json"), "blind map (run blind first)")
    of = read(os.path.join(folder, "reviews.json"), "list of the reviews blind copied (run blind again)")
    problems, ready = [], {}
    for change, letters in mapping.items():
        key = the_key(data, change)
        for letter, name in sorted(letters.items()):
            meta = os.path.join(data, "runs", name, change + ".json")
            now = read(meta, "run") if os.path.exists(meta) else {}
            if state_of(now, key) != "report" or review_id(now) != of.get(f"{change}/{name}"):
                problems.append(f"{change} {letter}: its model reviewed this change again, or its key changed, since "
                                "blind copied the report: run blind again and score the new report")
        scores = read(os.path.join(folder, change, "scores.json"), "scores")
        reports = scores.get("reports") if isinstance(scores, dict) else None
        if not isinstance(reports, dict) or sorted(reports) != sorted(letters):
            problems.append(f"{change}: scores.json needs exactly the reports {', '.join(sorted(letters)) or 'none'}")
            continue
        for letter in sorted(letters):
            problems += score_problems(change, letter, reports[letter], key)
        ready[change] = {letters[letter]: reports[letter] for letter in letters}
    if problems:
        raise Refused("the scores don't fit:\n  - " + "\n  - ".join(problems))
    with scores_locked(data):
        for change, by_model in ready.items():
            kept = the_scores(data, change)
            kept.update(by_model)
            write(os.path.join(data, "scores", change + ".json"), {"id": change, "reports": kept})
    with open(os.path.join(folder, "saved"), "w") as handle:
        handle.write("unblind saved these scores\n")
    print(f"scores of {sum(len(v) for v in ready.values())} reports saved under their models' names")
    return 0


# totals


def totals(data, as_json):
    found = the_set(data)
    stats, hits = collections.defaultdict(collections.Counter), collections.defaultdict(dict)
    blockers = total = 0
    names = sorted(n for n in os.listdir(os.path.join(data, "runs")) if plain(n)) if os.path.isdir(os.path.join(data, "runs")) else []
    for change in found["changes"]:
        key = the_key(data, change)
        defects = {str(d["n"]): d for d in key["defects"]}
        total += len(defects)
        blockers += sum(1 for d in defects.values() if d.get("tag") == "blocker")
        scores = the_scores(data, change)
        for name in names:
            meta = os.path.join(data, "runs", name, change + ".json")
            if not os.path.exists(meta):
                continue
            meta, s = read(meta, "run"), stats[name]
            state = state_of(meta, key)
            if state in ("failed", "stale"):
                s[state] += 1               # not a review of this change as it is: neither tried nor scored
                continue
            s["tried"] += 1
            s["seconds"] += meta.get("seconds", 0)
            report = scores.get(name)
            if state == "none":
                continue
            if not isinstance(report, dict):
                s["unscored"] += 1
                continue
            if not report.get("is_review", True):
                continue
            known = report.get("known") if isinstance(report.get("known"), dict) else {}
            if sorted(known) != sorted(defects):
                s["uncovered"] += 1         # the key has defects this score says nothing of, or the other way
            s["reports"] += 1
            for n, defect in defects.items():
                score = known.get(n, 0)
                score = score if score in (0.5, 1) else 0
                s["points"] += score
                s["blockers"] += score if defect.get("tag") == "blocker" else 0
                s["hits"] += bool(score)
                if score == 1:
                    hits[(change, n)][name] = True
            for other in report.get("others", []) if isinstance(report.get("others"), list) else []:
                verdict = {"minor": "true-minor"}.get(other.get("verdict"), other.get("verdict"))
                s[verdict if verdict in VERDICTS else "unclear"] += 1
            nits = report.get("nits_unchecked", 0)
            s["nits"] += nits if isinstance(nits, int) and not isinstance(nits, bool) else 0
    whole = [name for name, s in stats.items() if s["tried"] == len(found["changes"])]
    for who in hits.values():
        among = [name for name in who if name in whole]
        if len(among) == 1:
            stats[among[0]]["alone"] += 1
    rows = []
    for name, s in sorted(stats.items(), key=lambda item: (-item[1]["points"], item[0])):
        outside = s["real"] + s["true-minor"] + s["pre-existing"] + s["wrong"] + s["unclear"]
        claims = s["hits"] + outside
        rows.append({"model": name, "tried": s["tried"], "reports": s["reports"], "unscored": s["unscored"],
                     "failed": s["failed"], "stale": s["stale"], "uncovered": s["uncovered"],
                     "known": s["points"], "known_share": round(100 * s["points"] / total, 1) if total else 0,
                     "blockers": s["blockers"], "alone": s["alone"] if name in whole else None, "real": s["real"],
                     "minor": s["true-minor"] + s["pre-existing"], "false": s["wrong"], "unclear": s["unclear"],
                     "false_share": round(100 * s["wrong"] / claims, 1) if claims else 0, "nits_unchecked": s["nits"],
                     "minutes": round(s["seconds"] / 60 / s["tried"], 1) if s["tried"] else 0})
    result = {"set": found["version"], "changes": len(found["changes"]), "defects": total, "blockers": blockers,
              "found_by_any": sum(1 for who in hits.values() if who), "models": rows}
    if as_json:
        json.dump(result, sys.stdout, indent=1)
        print()
        return 0
    print(f"Set {found['version']}: {len(found['changes'])} changes, {total} known defects ({blockers} blockers); "
          f"{result['found_by_any']} found in full by at least one model.")
    print()
    titles = ("Model", "Reports", "Known found", "Blockers", "Alone", "Real", "Minor", "False", "False share", "Min/review")
    table = [titles]
    for row in rows:
        table.append((row["model"], f"{row['reports']} of {row['tried']}", f"{row['known']:g} ({row['known_share']:g}%)",
                      f"{row['blockers']:g} of {blockers}", "-" if row["alone"] is None else str(row["alone"]),
                      str(row["real"]), str(row["minor"]), str(row["false"]), f"{row['false_share']:g}%", f"{row['minutes']:g}"))
    widths = [max(len(line[i]) for line in table) for i in range(len(titles))]
    for line in table:
        print("  ".join(cell.ljust(width) if i == 0 else cell.rjust(width) for i, (cell, width) in enumerate(zip(line, widths))))
    print()
    print("Known found: 1 for a defect described, a half for the right code without the failing case; its share is "
          "of the whole set's defects. Alone: known defects only it found in full, among the models that tried "
          "every change. Real, Minor, False: its findings outside the key that it called a blocker or follow-up, as "
          "checked against the code. False share: of all its blockers and follow-ups.")

    def listed(field, text):
        some = [f"{row['model']} ({row[field]})" for row in rows if row[field]]
        if some:
            print(text + ": " + ", ".join(some) + ".")

    part = [f"{row['model']} ({row['tried']} of {len(found['changes'])})" for row in rows if row["tried"] < len(found["changes"])]
    if part:
        print("Tried only part of the set, so their shares are low by that much: " + ", ".join(part) + ".")
    listed("unscored", "Reports not scored yet")
    listed("failed", "Reviews that failed and are run again by the next run")
    listed("stale", "Reviews of other commits than the key's, run again by the next run")
    listed("uncovered", "Scores that don't cover their key's defects (a defect added since, not scored)")
    return 0


def main(argv):
    data = data_folder()
    copies, scoring = cache_folders()
    try:
        if argv == ["where"]:
            version = the_set(data)["version"] if os.path.exists(os.path.join(data, "set.json")) else "no set yet"
            print(f"data: {data}\ncopies: {copies}\nscoring: {scoring}\nset: {version}")
            return 0
        if argv[:1] == ["setup"]:
            return setup(data, copies, argv[1:])
        if argv[:1] == ["run"] and len(argv) > 1:
            return run(data, copies, scoring, argv[1], argv[2:])
        if argv[:1] == ["blind"]:
            return blind(data, scoring, argv[1:])
        if argv == ["unblind"]:
            return unblind(data, scoring)
        if argv in (["totals"], ["totals", "--json"]):
            return totals(data, len(argv) == 2)
    except Refused as error:
        print(f"bench: {error}", file=sys.stderr)
        return 64
    print("Usage:" + __doc__.split("Usage:")[1].split("\n\n")[0].rstrip(), file=sys.stderr)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
