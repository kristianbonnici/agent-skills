#!/usr/bin/env python3
"""Print subscription usage and reset times for Claude, Codex, Antigravity and Copilot as JSON.

Read-only. By default each provider is asked directly, through its own CLI and
sign-in, so the numbers include use from other devices and apps:
  - Claude: `claude -p /usage`, a local command that makes no model call;
  - Codex: the app server's `account/rateLimits/read` request;
  - Antigravity: `agy -p /usage` and `agy -p /credits`, which answer without an
    agent turn. Each model group gets its own windows, named
    `<group>_five_hour` and `<group>_weekly` (for example `gemini_models_five_hour`,
    `gemini_4_argon_weekly`).
  - Copilot: GitHub's `copilot_internal/user` endpoint through `gh api`, which
    spends no quota. Its premium budget is a monthly window (`monthly`), billed
    by token cost in fractional units.
When a live query fails, or with --cached, Claude and Codex values come from the
last ones each provider wrote to local files (T3 Code provider logs, Codex session
files), and "live_error" says why. Copilot's local session files give only what
this machine used this month, not what is left. Antigravity keeps no such files,
so it is read live only. A window whose reset time has passed is flagged as
reset. When nothing can be read, the provider gets an "error" instead of the
script failing.

Environment overrides: CLAUDE_CONFIG_DIR, CODEX_HOME, T3_USERDATA, COPILOT_HOME.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import select
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path
from zoneinfo import ZoneInfo

TAIL_BYTES = 4 * 1024 * 1024
MAX_FILES = 40
LIVE_TIMEOUT = 45


def iso(ts: float | None) -> str | None:
    return datetime.fromtimestamp(ts, timezone.utc).isoformat(timespec="seconds") if ts else None


def tail_lines(path: Path) -> list[str]:
    with path.open("rb") as f:
        f.seek(0, os.SEEK_END)
        size = f.tell()
        f.seek(max(0, size - TAIL_BYTES))
        return f.read().decode("utf-8", errors="replace").splitlines()


def newest(paths) -> list[Path]:
    files = [p for p in paths if p.is_file()]
    return sorted(files, key=lambda p: p.stat().st_mtime, reverse=True)[:MAX_FILES]


def window(used_percent: float, resets_at: float | None, now: float) -> dict:
    return {
        "used_percent": round(used_percent, 1),
        "resets_at": iso(resets_at),
        "reset_since_observed": bool(resets_at and resets_at < now),
    }


def claude(now: float) -> dict:
    out: dict = {"plan": claude_plan(), "windows": {}, "observed_at": None, "source": None}
    logs = Path(os.environ.get("T3_USERDATA", Path.home() / ".t3" / "userdata")) / "logs" / "provider"
    pattern = re.compile(r'"rate_limit_info":(\{.*?\}\}\})')
    for path in newest(logs.glob("events.*.log*")):
        for line in reversed(tail_lines(path)):
            if '"type":"rate_limit_event"' not in line:
                continue
            match = pattern.search(line)
            if not match:
                continue
            try:
                info = json.loads(match.group(1))  # a line cut off or garbled is skipped, as the next older one is tried
                try:
                    observed = datetime.fromisoformat(re.match(r"\[([^\]]+)\]", line).group(1).replace("Z", "+00:00")).timestamp()
                except (AttributeError, ValueError):
                    observed = path.stat().st_mtime
                windows = {}
                for name, w in (info.get("unifiedWindows") or {}).items():
                    key = "weekly" if name == "seven_day" else name
                    windows[key] = window(100 * float(w.get("utilization", 0)), w.get("resetsAt"), now)
            except (ValueError, TypeError, AttributeError):
                continue
            out["windows"] = windows
            out["status"] = info.get("status")
            out["observed_at"] = iso(observed)
            out["source"] = str(path)
            return out
    out["error"] = "no rate_limit_event found in T3 logs (logged only when Claude runs inside T3)"
    return out


def claude_plan() -> str | None:
    config_dir = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home()))
    try:
        account = json.loads((config_dir / ".claude.json").read_text(encoding="utf-8")).get("oauthAccount") or {}
    except (OSError, ValueError):
        return None
    tier = account.get("organizationRateLimitTier") or account.get("userRateLimitTier")
    kind = account.get("organizationType")
    return " / ".join(x for x in (kind, tier) if x) or None


USAGE_LINE = re.compile(
    r"^Current (session|week)(?: \(([^)]*)\))?:\s*(\d+(?:\.\d+)?)% used(?:\s*·\s*resets (.+?))?\s*$"
)
RESET_TEXT = re.compile(
    r"^(?:(?P<mon>[A-Za-z]{3})[a-z]* (?P<day>\d{1,2})(?:, (?P<year>\d{4}))? at )?"
    r"(?P<hour>\d{1,2})(?::(?P<minute>\d{2}))?\s*(?P<ampm>am|pm)\s*(?:\((?P<tz>[^)]+)\))?$",
    re.IGNORECASE,
)
MONTHS = {m: i for i, m in enumerate("jan feb mar apr may jun jul aug sep oct nov dec".split(), 1)}


def parse_reset(text: str, now: float) -> float | None:
    """'Oct 6 at 1:49am (Europe/Helsinki)' or '3am (Europe/Helsinki)' -> epoch seconds."""
    m = RESET_TEXT.match(text.strip())
    if not m:
        return None
    try:
        zone = ZoneInfo(m["tz"]) if m["tz"] else datetime.now().astimezone().tzinfo
    except Exception:
        zone = datetime.now().astimezone().tzinfo
    hour = int(m["hour"]) % 12 + (12 if m["ampm"].lower() == "pm" else 0)
    minute = int(m["minute"] or 0)
    local_now = datetime.fromtimestamp(now, zone)
    if m["mon"]:
        month, day = MONTHS.get(m["mon"].lower()), int(m["day"])
        if not month:
            return None
        years = [int(m["year"])] if m["year"] else [local_now.year, local_now.year + 1]
        for year in years:
            moment = datetime(year, month, day, hour, minute, tzinfo=zone)
            if m["year"] or moment.timestamp() >= now - 86400:
                return moment.timestamp()
        return None
    moment = local_now.replace(hour=hour, minute=minute, second=0, microsecond=0)
    if moment.timestamp() < now - 60:
        moment += timedelta(days=1)
    return moment.timestamp()


def claude_live(now: float) -> dict:
    """Claude Code's /usage command, which reads the subscription's limits without a model call."""
    proc = subprocess.run(
        ["claude", "-p", "/usage", "--output-format", "json", "--no-session-persistence"],
        cwd=tempfile.gettempdir(),
        capture_output=True,
        text=True,
        timeout=LIVE_TIMEOUT,
    )
    try:
        text = json.loads(proc.stdout).get("result") or ""
    except ValueError:
        text = proc.stdout
    windows = {}
    for line in text.splitlines():
        m = USAGE_LINE.match(line.strip())
        if not m:
            continue
        kind, scope, percent, reset = m.groups()
        if kind == "session":
            key = "five_hour"
        elif not scope or scope.lower() == "all models":
            key = "weekly"
        else:
            key = "weekly_" + re.sub(r"[^a-z0-9]+", "_", scope.lower()).strip("_")
        windows[key] = window(float(percent), parse_reset(reset, now) if reset else None, now)
    if "five_hour" not in windows and "weekly" not in windows:
        detail = (text or proc.stderr).strip().splitlines()[:1]
        raise RuntimeError("claude /usage printed no usage lines" + (f": {detail[0][:160]}" if detail else ""))
    return {
        "plan": claude_plan(),
        "windows": windows,
        "observed_at": iso(now),
        "source": "live: claude -p /usage",
    }


def codex_live(now: float) -> dict:
    """The Codex app server's account/rateLimits/read request, with Codex's own sign-in."""
    proc = subprocess.Popen(
        ["codex", "app-server"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        cwd=tempfile.gettempdir(),
    )
    try:
        for message in (
            {"jsonrpc": "2.0", "id": 1, "method": "initialize",
             "params": {"clientInfo": {"name": "provider-usage", "version": "1"}}},
            {"jsonrpc": "2.0", "method": "initialized"},
            {"jsonrpc": "2.0", "id": 2, "method": "account/rateLimits/read", "params": None},
        ):
            proc.stdin.write((json.dumps(message) + "\n").encode())
        proc.stdin.flush()
        deadline = time.monotonic() + LIVE_TIMEOUT
        pending = b""
        while time.monotonic() < deadline:
            # Raw reads under the deadline, split into lines here: readline() would block on a line the
            # server began and never finished.
            ready, _, _ = select.select([proc.stdout], [], [], min(1, max(0.0, deadline - time.monotonic())))
            if not ready:
                continue
            chunk = os.read(proc.stdout.fileno(), 65536)
            if not chunk:
                break
            pending += chunk
            *lines, pending = pending.split(b"\n")
            if len(pending) > TAIL_BYTES:
                raise RuntimeError("codex app-server sent a line that is too long")
            for line in lines:
                try:
                    reply = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(reply, dict) or reply.get("id") != 2:
                    continue
                return codex_reply(reply, now)
        raise RuntimeError("codex app-server gave no rate limits in time")
    finally:
        proc.kill()
        proc.wait()
        for pipe in (proc.stdin, proc.stdout):
            try:
                pipe.close()
            except OSError:
                pass


def codex_reply(reply: dict, now: float) -> dict:
    """The rate limits in the app server's answer to account/rateLimits/read."""
    if "error" in reply:
        raise RuntimeError(f"account/rateLimits/read failed: {reply['error']}")
    result = reply.get("result") or {}
    limits = result.get("rateLimits") or {}
    out = {
        "plan": limits.get("planType"),
        "windows": codex_windows(
            limits.get("primary"), limits.get("secondary"), now, ("usedPercent", "windowDurationMins")
        ),
        "observed_at": iso(now),
        "source": "live: codex app-server account/rateLimits/read",
    }
    if limits.get("rateLimitReachedType"):
        out["status"] = "rejected"
    credits = (result.get("rateLimitResetCredits") or {}).get("credits") or []
    available = sum(1 for c in credits if c.get("status") == "available")
    if available:
        out["reset_credits_available"] = available  # the user's to spend, never the orchestrator's
    return out


def codex_windows(primary: dict | None, secondary: dict | None, now: float, keys) -> dict:
    windows = {}
    for w in (primary, secondary):
        if not w:
            continue
        minutes = w.get(keys[1])
        name = {300: "five_hour", 10080: "weekly"}.get(minutes, f"window_{minutes}m")
        windows[name] = window(float(w.get(keys[0], 0)), w.get("resets_at") or w.get("resetsAt"), now)
    return windows


def codex_from_t3(now: float) -> dict | None:
    """Live `account/rateLimits/updated` notifications that T3 logs for Codex threads."""
    logs = Path(os.environ.get("T3_USERDATA", Path.home() / ".t3" / "userdata")) / "logs" / "provider"
    pattern = re.compile(r'"rateLimits":(\{.*?"planType":[^,}]*[^}]*\})')
    for path in newest(logs.glob("events.*.log*")):
        for line in reversed(tail_lines(path)):
            if '"account/rateLimits/updated"' not in line:
                continue
            match = pattern.search(line)
            if not match:
                continue
            try:
                limits = json.loads(match.group(1))
            except ValueError:
                continue
            stamp = re.match(r"\[([^\]]+)\]", line)
            return {
                "plan": limits.get("planType"),
                "windows": codex_windows(
                    limits.get("primary"), limits.get("secondary"), now, ("usedPercent", "windowDurationMins")
                ),
                "credits": limits.get("credits"),
                "observed_at": stamp.group(1) if stamp else iso(path.stat().st_mtime),
                "source": str(path),
            }
    return None


def codex(now: float) -> dict:
    out: dict = {"plan": None, "windows": {}, "observed_at": None, "source": None}
    live = codex_from_t3(now)
    sessions = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")) / "sessions"
    for path in newest(sessions.rglob("rollout-*.jsonl")):
        for line in reversed(tail_lines(path)):
            if '"rate_limits"' not in line:
                continue
            try:
                record = json.loads(line)
            except ValueError:
                continue
            payload = record.get("payload") or record
            limits = payload.get("rate_limits") or (payload.get("info") or {}).get("rate_limits")
            if not limits:
                continue
            out["windows"] = codex_windows(
                limits.get("primary"), limits.get("secondary"), now, ("used_percent", "window_minutes")
            )
            out["plan"] = limits.get("plan_type")
            if limits.get("credits"):
                out["credits"] = limits["credits"]
            out["observed_at"] = record.get("timestamp") or iso(path.stat().st_mtime)
            out["source"] = str(path)
            break
        if out["source"]:
            break
    if live and (not out["observed_at"] or stamp_seconds(live["observed_at"]) > stamp_seconds(out["observed_at"])):
        return live
    if not out["source"]:
        out["error"] = "no rate limits found in Codex session files or T3 logs"
    return out


def stamp_seconds(value: str) -> float:
    return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()


def agy_command(command: str) -> dict:
    """A read-only slash command of the Antigravity CLI; it starts no agent turn and spends no quota."""
    agy = shutil.which("agy") or str(Path.home() / ".local" / "bin" / "agy")
    proc = subprocess.run(
        [agy, "-p", command, "--output-format", "json"],
        cwd=tempfile.gettempdir(),
        capture_output=True,
        text=True,
        timeout=LIVE_TIMEOUT,
    )
    try:
        reply = json.loads(proc.stdout)
    except ValueError:
        detail = (proc.stdout or proc.stderr).strip().splitlines()[:1]
        raise RuntimeError(f"agy {command} printed no JSON" + (f": {detail[0][:160]}" if detail else ""))
    if reply.get("status") != "SUCCESS":
        raise RuntimeError(f"agy {command} failed: {str(reply.get('response') or reply)[:160]}")
    return (reply.get("command") or {}).get("data") or {}


def antigravity_live(now: float) -> dict:
    """Antigravity's quota: each model group has its own 5-hour and weekly windows, or a weekly one only."""
    windows, groups = {}, {}
    for group in agy_command("/usage").get("groups") or []:
        slug = re.sub(r"[^a-z0-9]+", "_", (group.get("name") or "").lower()).strip("_")
        if not slug:
            continue
        groups[slug] = group.get("description")  # which models share the group's windows
        for bucket in group.get("buckets") or []:
            if bucket.get("remaining_fraction") is None:
                continue  # a bucket the plan has disabled
            span = {"5h": "five_hour", "weekly": "weekly"}.get(bucket.get("window"), bucket.get("window"))
            reset = bucket.get("reset_time")
            windows[f"{slug}_{span}"] = window(
                100 * (1 - float(bucket["remaining_fraction"])),
                stamp_seconds(reset) if reset else None,
                now,
            )
    if not windows:
        raise RuntimeError("agy /usage listed no quota buckets")
    out = {
        "plan": None,  # agy doesn't name the plan; the owner's profile does
        "windows": windows,
        "groups": groups,
        "observed_at": iso(now),
        "source": "live: agy -p /usage",
    }
    try:
        credits = agy_command("/credits").get("remaining_credits")
    except Exception:
        credits = None
    if credits:
        out["ai_credits_remaining"] = credits  # paid by the owner; the run never spends them
    return out


def antigravity(now: float) -> dict:
    return {
        "plan": None,
        "windows": {},
        "error": (
            "Antigravity's usage is read live only (agy -p /usage); watch its hand-offs for quota "
            "errors (see references/routing.md, Fast helpers) and stop using a model group for "
            "its window after one"
        ),
    }


def copilot_live(now: float) -> dict:
    """Copilot's monthly premium budget, as GitHub reports it to its own clients."""
    gh = shutil.which("gh") or "/opt/homebrew/bin/gh"
    proc = subprocess.run(
        [gh, "api", "/copilot_internal/user"], capture_output=True, text=True, timeout=LIVE_TIMEOUT
    )
    if proc.returncode:
        raise RuntimeError(f"gh api /copilot_internal/user failed: {(proc.stderr or proc.stdout).strip()[:160]}")
    info = json.loads(proc.stdout)
    premium = (info.get("quota_snapshots") or {}).get("premium_interactions")
    if not premium:
        raise RuntimeError("GitHub reported no premium quota for this account")
    reset = info.get("quota_reset_date_utc")
    out = {
        "plan": info.get("access_type_sku") or info.get("copilot_plan"),
        "windows": {},
        "observed_at": premium.get("timestamp_utc") or iso(now),
        "source": "live: gh api /copilot_internal/user",
    }
    if premium.get("unlimited"):
        out["unlimited"] = True
        return out
    out["windows"]["monthly"] = window(
        100 - float(premium.get("percent_remaining", 0)), stamp_seconds(reset) if reset else None, now
    )
    out["units_entitled"] = premium.get("entitlement")
    out["units_remaining"] = premium.get("quota_remaining")
    if premium.get("overage_permitted"):
        out["overage_permitted"] = True  # billed to the owner past the budget; the run never relies on it
    return out


def copilot(now: float) -> dict:
    """What this machine's Copilot sessions spent this month; the budget left needs the live read."""
    home = Path(os.environ.get("COPILOT_HOME", Path.home() / ".copilot")) / "session-state"
    month = datetime.fromtimestamp(now, timezone.utc).replace(day=1, hour=0, minute=0, second=0, microsecond=0)
    used, sessions = 0.0, 0
    for path in home.glob("*/events.jsonl"):
        if path.stat().st_mtime < month.timestamp():
            continue
        for line in reversed(tail_lines(path)):  # the newest checkpoint that parses
            if '"session.usage_checkpoint"' not in line:
                continue
            try:
                units = json.loads(line).get("data", {}).get("totalNanoAiu", 0) / 1e9
            except (ValueError, TypeError, AttributeError):
                continue
            used += units
            sessions += 1
            break
    return {
        "plan": None,
        "windows": {},
        "local_units_used_this_month": round(used, 2),
        "local_sessions_this_month": sessions,
        "source": str(home),
        "error": "Copilot's remaining budget is read live only (gh api /copilot_internal/user)",
    }


def with_fallback(live, cached, use_live: bool):
    def read(now: float) -> dict:
        if not use_live:
            return cached(now)
        try:
            return live(now)
        except Exception as exc:  # fall back to the logs, never crash the orchestrator
            out = cached(now)
            out["live_error"] = f"{type(exc).__name__}: {exc}"
            return out
    return read


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--cached", action="store_true", help="skip the live queries and read local logs only")
    args = parser.parse_args()
    now = datetime.now(timezone.utc).timestamp()
    report = {"generated_at": iso(now), "providers": {}}
    readers = (
        ("claude", with_fallback(claude_live, claude, not args.cached)),
        ("codex", with_fallback(codex_live, codex, not args.cached)),
        ("antigravity", with_fallback(antigravity_live, antigravity, not args.cached)),
        ("copilot", with_fallback(copilot_live, copilot, not args.cached)),
    )
    for name, reader in readers:
        try:
            report["providers"][name] = reader(now)
        except Exception as exc:  # report, never crash the orchestrator
            report["providers"][name] = {"error": f"{type(exc).__name__}: {exc}"}
    json.dump(report, sys.stdout, indent=2)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
