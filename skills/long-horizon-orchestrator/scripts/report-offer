#!/usr/bin/env python3
"""Turn a run's facts file and final report into what the orchestrator hands OrbOS at the finish:
the report as a reading to listen to later, with a tour of the run that waits with it
(`offer_reading` with its `tour`), and offer it through OrbOS's own command. All are JSON
arguments for the tools, held to their limits, so they pass unchanged.

references/final-report.md ("Offer it to listen to, with its tour") says when to use them.

Usage:
  report-offer <facts.json> <report.md> [--repo <integration checkout>] [--pictures <run folder>]
               [--out <folder>] [--no-files] [--ask-for-tour] [--words <n>]
               [--no-offer] [--read-aloud <command>] [--harness <name>] [--timeout <seconds>]

Writes into the output folder (the report's folder unless given):

  reading.json        the offer_reading arguments: kind "report", a title, the text to read (plain
                      speech, outcome first, then what was built and what needs the user, about two
                      minutes, no code, paths or IDs; it ends by naming Tour), the whole report as
                      its original, and the tour as `tour`.
  reading-alone.json  the same without the tour, for an OrbOS that can't keep one; with
                      --ask-for-tour it ends by saying how to ask for the tour.
  tour.json           the same tour as a live walkthrough: {"offer": <the walkthrough offer, its
                      first notes queued>, "calls": [<step calls, in order>], "end": <the end call>,
                      "steps": [<every step in order, to send one again after a Back>]}
  offered.json        what the offer came to (unless --no-offer): offered, its id, the steps of the
                      tour it kept, the steps OrbOS refused and OrbOS's answer.

The tour: an opening note, then per task a note (what it built, in two sentences) and, with
--repo, a file step at its key change and a picture step for a picture its commits put in the
repository; a closing note with the open decisions. At most 50 steps and about 8 pictures.

Then it offers the reading with its tour itself, as a short MCP client of OrbOS's bundled command
(`read-aloud --harness <name> --mcp --pictures <run folder>`, the user's own OrbOS), so that the
tour also shows the tasks' own pictures from the run folder, which the orchestrator's own OrbOS
server can't read. A step OrbOS refuses is left out and the offer made again; an OrbOS that can't
keep a tour gets reading-alone.json. Exit 0: offered (it says whether with its tour), or written
with --no-offer; exit 3: written but not offered (no command, offer_reading off, a refusal, no
answer to the handshake), so offer reading.json with your own offer_reading; exit 4: the offer
went out but its answer didn't come within --timeout, so it may wait already: don't offer again.

The report is the one the skill's template describes ("## What was built" with "**1. Name
(Task A)**" items, "## Open decisions" with numbered "**Label.**" items, and so on).

Facts it reads, besides run-charts' (`run-charts --help`), all optional:
  a task's "commits": ["dd8d3157", ...]   its merged commits; with --repo, the key change is the
                                          largest added block of the file it changed most
  a task's "key_change": {"path": "Sources/Retry.swift", "lines": [42, 58], "say": "..."}
                                          the key change, chosen by the orchestrator; "say" is
                                          the narration (what the change does, never the code)
  a task's "pictures": [{"src": ..., "caption": ...}]
                                          with --pictures, those in the run folder (PNG or JPEG)
                                          are shown, with their captions; src relative to the
                                          facts file, or absolute

File and picture steps name paths relative to the repository, which must be the folder the
orchestrator's harness runs in (OrbOS's server reads them in its own workspace), and report-offer
starts OrbOS's command there too. The run's own pictures are relative to the run folder and only
in the tour report-offer offers itself. --no-files leaves out the repository's file and picture
steps (a harness started elsewhere); with --pictures the run's own pictures still show, and
OrbOS's command then starts in the run folder.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import unicodedata
from datetime import datetime
from pathlib import Path

# The tools' limits, as OrbOS has them at commit a91810c8 (2026-10-24): OfferReading.swift's
# OfferLimits, WalkthroughCall.swift's WalkthroughLimits, TourLimits, docs/assistants.md; and an
# offer's `tour` at 6632a4fd (2026-10-26): OfferTour.swift's OfferTourLimits, the walkthrough's
# tour steps, at most 50 and 8 MB. A field over its limit is refused, never cut, so every text
# here is cut to fit before it is written.
READING = {"title": 80, "text": 10_000, "original": 50_000, "source": 160}
WALK = {"title": 80, "about": 300, "note": 200, "steps": 50, "queued": 20,
        "step_title": 60, "caption": 140, "narration": 400}
TOUR_LINES = 24              # lines marked in a file step (OrbOS takes up to 300)
FILE_BYTES = 1_000_000       # a file step's file: at most 1 MB of UTF-8 text
PICTURE_BYTES = 8_000_000    # a picture step's: a PNG or JPEG of at most 8 MB and 40 million pixels
PICTURE_PIXELS = 40_000_000
PATH_CHARACTERS = 300        # a file or picture step's path
SHOWN_LINES = 300            # the most lines a file step marks
WORDS = 320                  # about two minutes: the offer card counts 160 words a minute
TOUR_PICTURES = 8            # pictures in a tour: OrbOS scales each to at most 700 KB, and a waiting tour holds 8 MB

# Names that hold secrets by convention, which OrbOS's server refuses (WorkspaceFile.isSecret, at
# the same commit); left out here so a tour never trips a safety refusal.
SECRET_FOLDERS = {".git", ".ssh", ".aws", ".gnupg", ".docker", ".kube"}
SECRET_NAMES = {".env", ".envrc", ".netrc", "_netrc", ".npmrc", ".pypirc", ".yarnrc.yml", ".pgpass", ".git-credentials",
                ".htpasswd", ".dockercfg", ".zsh_history", ".bash_history", ".sh_history", ".history", ".python_history",
                ".node_repl_history", ".mysql_history", ".psql_history", ".lesshst", "authorized_keys", "known_hosts"}
SECRET_PREFIXES = (".env.", "id_rsa", "id_dsa", "id_ecdsa", "id_ed25519", "credentials", "secrets.")
SECRET_SUFFIXES = (".env", ".pem", ".key", ".p12", ".pfx", ".p8", ".keychain", ".keychain-db", ".ppk", ".jks", ".keystore",
                   ".mobileprovision", ".kdbx", ".tfstate", ".tfstate.backup", "-credentials.json", "_credentials.json",
                   "_history")


def secret_file(path: str) -> bool:
    parts = [p.lower() for p in path.split("/") if p not in ("", ".")]
    if any(p in SECRET_FOLDERS for p in parts) or any(a == ".config" and b == "gh" for a, b in zip(parts, parts[1:])):
        return True
    name = parts[-1] if parts else ""
    return name in SECRET_NAMES or name.startswith(SECRET_PREFIXES) or name.endswith(SECRET_SUFFIXES)
TEST_PATH = re.compile(r"(^|/)(tests?|spec|__tests__|Tests)(/|$)|(_test|\.test|\.spec|Tests?)\.\w+$")
ASIDE_PATH = re.compile(r"(^|/)(experiments?|examples?|samples?|fixtures?|benchmarks?|demos?|spikes?)/", re.I)
DOC_PATH = re.compile(r"\.(md|mdx|rst|txt|adoc)$", re.I)
PICTURE_PATH = re.compile(r"\.(png|jpe?g)$", re.I)
SKIP_PATH = re.compile(r"(^|/)(package-lock\.json|yarn\.lock|pnpm-lock\.yaml|Package\.resolved|Cargo\.lock|"
                       r"poetry\.lock|uv\.lock|go\.sum)$|\.(svg|gif|ico|pdf|zip|mp4|mov|lock)$", re.I)

# Words that ask for a secret, as OrbOS's SecretRequest checks a walkthrough's words: a secret's
# name and a word asking for it in one sentence makes OrbOS refuse the step (three refusals stop a
# walkthrough). A sentence that would be refused is left out.
SECRETS = [["password"], ["passcode"], ["passphrase"], ["pin", "code"], ["pin", "number"], ["otp"],
           ["one-time", "code"], ["one", "time", "code"], ["one-time", "password"], ["verification", "code"],
           ["authentication", "code"], ["2fa", "code"], ["login", "code"], ["sign-in", "code"],
           ["recovery", "phrase"], ["recovery", "code"], ["recovery", "key"], ["seed", "phrase"], ["seed", "words"],
           ["mnemonic", "phrase"], ["private", "key"], ["secret", "key"], ["api", "key"], ["access", "token"],
           ["auth", "token"], ["bearer", "token"], ["card", "number"], ["credit", "card"], ["security", "code"],
           ["cvv"], ["cvc"], ["social", "security", "number"]]
ASKS = [["type"], ["types"], ["typing"], ["typed"], ["retype"], ["enter"], ["enters"], ["entering"], ["entered"],
        ["re-enter"], ["paste"], ["pastes"], ["pasting"], ["give"], ["gives"], ["giving"], ["share"], ["shares"],
        ["sharing"], ["provide"], ["provides"], ["providing"], ["fill", "in"], ["fills", "in"], ["filling", "in"],
        ["fill", "out"], ["tell"], ["tells"], ["telling"], ["input"], ["submit"], ["send", "me"], ["send", "us"]]


def has_phrase(words: list[str], phrases: list[list[str]], plurals: bool) -> bool:
    for phrase in phrases:
        for start in range(len(words) - len(phrase) + 1):
            if all(words[start + i] == p or (plurals and i == len(phrase) - 1 and words[start + i] in (p + "s", p + "es"))
                   for i, p in enumerate(phrase)):
                return True
    return False


LOOKALIKES = str.maketrans({
    "а": "a", "е": "e", "о": "o", "р": "p", "с": "c", "у": "y", "х": "x", "і": "i", "ј": "j", "ѕ": "s", "ԁ": "d",
    "ԛ": "q", "ԝ": "w", "һ": "h", "ӏ": "l", "к": "k", "м": "m", "т": "t", "в": "b", "н": "h", "ո": "n",
    "А": "A", "В": "B", "Е": "E", "К": "K", "М": "M", "Н": "H", "О": "O", "Р": "P", "С": "C", "Т": "T", "Х": "X", "І": "I",
    "α": "a", "ε": "e", "ο": "o", "ρ": "p", "τ": "t", "υ": "u", "ν": "v", "κ": "k", "ι": "i", "ω": "w", "χ": "x",
    "Α": "A", "Β": "B", "Ε": "E", "Ζ": "Z", "Η": "H", "Ι": "I", "Κ": "K", "Μ": "M", "Ν": "N", "Ο": "O", "Ρ": "P", "Τ": "T",
    "Υ": "Y", "Χ": "X"})


def folded(text: str) -> str:
    """As OrbOS reads words for secrets: format characters left out, lookalikes and fullwidth as Latin."""
    text = "".join(c for c in text if unicodedata.category(c) != "Cf").translate(LOOKALIKES)
    return "".join(chr(ord(c) - 0xFEE0) if 0xFF01 <= ord(c) <= 0xFF5E else c for c in text)


def asks_for_secret(sentence: str) -> bool:
    words = []
    word = ""
    for c in folded(sentence) + " ":
        if c.isalnum() or c in "-'’":
            word += c
        else:
            if word.strip("-'’"):
                words.append(word.strip("-'’"))
            word = ""
    lower = [w.lower() for w in words]
    secret = has_phrase(lower, SECRETS, True) or any(w in ("PIN", "PINs") for w in words)
    return secret and has_phrase(lower, ASKS, False)


# ---------------------------------------------------------------------------------------------
# Speech: plain words, no code, paths or IDs

UUID = re.compile(r"\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b")
HEX_ID = re.compile(r"\b(?=[0-9a-f]*\d)(?=[0-9a-f]*[a-f])[0-9a-f]{7,40}\b")
EXTENSIONS = (r"md|mdx|rst|txt|py|swift|ts|tsx|js|jsx|mjs|cjs|json|jsonl|ndjson|sh|zsh|bash|toml|yaml|yml|ini|cfg|conf|env|"
              r"tsv|csv|xml|html|css|scss|plist|mmd|svg|png|jpe?g|gif|mp4|mov|log|rs|go|rb|java|kt|kts|c|h|cc|cpp|hpp|m|mm|"
              r"sql|lock|gradle|xcconfig|entitlements|strings|resolved|pbxproj|xcodeproj|app|zip|tar|gz|pdf|lua|php|cs")
# A path: from the root, the home folder, a variable or "./", or relative with two folders or more,
# or a name with a file's ending. "and/or" and "read/write" stay words.
PATHLIKE = re.compile(rf"(?:(?<![\w/])(?:~|\$\{{?\w+\}}?|\.{{1,2}})?/[\w.@~-]+(?:/[\w.@~-]+)*/?)"
                      rf"|(?<![\w/])[\w.@-]+(?:/[\w.@-]+){{2,}}/?"
                      rf"|(?<![\w/])[\w.@-]+/[\w@-][\w.@-]*\.(?:{EXTENSIONS})\b"
                      rf"|(?<![\w/.])[\w-]+(?:\.[\w-]+)*\.(?:{EXTENSIONS})\b(?![\w/])")
TASK_REF = re.compile(r"\s*\((?:[Tt]ask\s+)?[A-Z]{1,2}\d?(?:\s*(?:,|and)\s*[A-Z]{1,2}\d?)*\)|\s*\(\d+ above\)")


GONE = "\x00"  # where code or an ID was left out, until the words around it are tidied


NAMING_WORDS = {"file", "files", "note", "notes", "guide", "document", "page", "script", "folder", "doc", "docs"}


def path_said(path: str, before: str) -> str:
    """A path as words: "the walkthroughs note", "the Sync file", "the Logs folder"; only its name
    after a word that already says what it is ("the file Sync")."""
    name = path.rstrip("/").rsplit("/", 1)[-1]
    stem = re.sub(r"[._-]+", " ", re.sub(r"\.[^.]+$", "", name) if "." in name.lstrip(".") else name).strip() or "a"
    previous = re.findall(r"[\w']+", before[-40:])
    if previous and previous[-1].lower() in NAMING_WORDS:
        return stem
    kind = "note" if DOC_PATH.search(name) else "file" if "." in name.lstrip(".") else "folder"
    return f"the {stem} {kind}"


def code_span(match: re.Match) -> str:
    inner = match.group(1).strip()
    if PATHLIKE.fullmatch(inner):
        return path_said(inner, match.string[:match.start()])
    if (re.search(r"[(){}\[\]=<>;$\\|]|::|->|--|\w\.\w|\s-\w|^-", inner) or HEX_ID.fullmatch(inner)
            or UUID.fullmatch(inner)):
        return GONE
    return inner.replace("_", " ")


def speakable(text: str) -> str:
    """Markdown as plain speech: no pictures, links, emphasis, code, paths, commit IDs or task IDs."""
    text = re.sub(r"!\[[^\]]*\]\([^)]*\)", "", text)
    text = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", text)
    text = re.sub(r"<(https?://[^>]+)>|https?://\S+", "", text)
    text = re.sub(r"`([^`]*)`", code_span, text)
    text = re.sub(r"\*\*|__|(?<!\w)[*_](?=\S)|(?<=\S)[*_](?!\w)", "", text)
    text = TASK_REF.sub("", text)
    if TASK_IDS:
        ids = "|".join(re.escape(i) for i in sorted(TASK_IDS, key=len, reverse=True))
        text = re.sub(rf"\b(?:[Tt]ask\s+)?(?:{ids})['’]s\b", "another task's", text)
        text = re.sub(rf"\b[Tt]ask\s+(?:{ids})\b", "a task", text)
    text = UUID.sub(GONE, text)
    text = HEX_ID.sub(GONE, text)
    text = re.sub(rf"{GONE}(\s*(→|->|\.\.)\s*{GONE})+", GONE, text)
    text = re.sub(rf"\s*\(\s*{GONE}\s*\)", "", text).replace(GONE, "")
    text = PATHLIKE.sub(lambda m: path_said(m.group(0), m.string[:m.start()]), text)
    text = re.sub(r"\b(the|a|an)\s+the\b", "the", text, flags=re.I)
    text = re.sub(r"[\"“”]", "", text)
    text = re.sub(r"\s*(→|->)\s*", " to ", text)
    text = re.sub(r"(\d)\s*[–-]\s*(\d)", r"\1 to \2", text)
    text = re.sub(r"\s+[–—]\s+", ", ", text)
    text = re.sub(r"~\s*(\d)", r"about \1", text)
    text = re.sub(r"(\d)\s*×|×\s*(\d)", lambda m: (m.group(1) or "") + " times " + (m.group(2) or ""), text)
    text = text.replace("&", "and").replace("…", "...")
    text = re.sub(r"\s+·\s+", ", ", text)
    text = re.sub(r"\(\s*[,;:]?\s*\)|\(\s*,\s*", lambda m: "" if m.group(0).endswith(")") else "(", text)
    text = re.sub(r"\s+([,.;:!?])", r"\1", text)
    text = re.sub(r"([,;:])(?=[,.;:])", "", text)
    text = re.sub(r"\b(and|or)\s+(?:and|or)\b", r"\1", text)
    text = re.sub(r"(^|[.!?:;,]\s*)(?:and|or)\s*(?=[.!?,;]|$)", r"\1", text)
    text = re.sub(r"\s{2,}", " ", text).strip()
    return capitalized(text)


def capitalized(text: str) -> str:
    return re.sub(r"(^|[.!?]\s+)([a-z])", lambda m: m.group(1) + m.group(2).upper(), text)


STARTERS = {"a", "an", "the", "there", "it", "its", "this", "these", "that", "those", "both", "each", "every", "all",
            "you", "your", "one", "two", "three", "some", "most", "no", "now", "when", "with", "for", "in", "on"}
# The run's task IDs, so "B's marks" is said as "another task's marks"; set from the facts.
TASK_IDS: set[str] = set()


def lowered(text: str) -> str:
    """The first letter small, as after a colon, unless the first word is a name ("OrbOS", "I")."""
    first = text.split(" ", 1)[0]
    return text[0].lower() + text[1:] if first.lower() in STARTERS and first[:1].isupper() else text


def sentences(text: str) -> list[str]:
    parts = re.split(r"(?<=[.!?])\s+(?=[A-Z0-9\"“(])", text.strip())
    return [p.strip() for p in parts if p.strip()]


def ended(text: str) -> str:
    text = text.strip().rstrip(":;,")
    return text if not text or text[-1] in ".!?" else text + "."


def fit(text: str, limit: int) -> str:
    """At most `limit` characters: whole sentences when they fit, else whole words and an ellipsis."""
    text = re.sub(r"\s+", " ", text).strip()
    if len(text) <= limit:
        return text
    kept = ""
    for sentence in sentences(text):
        if len(kept) + len(sentence) + (1 if kept else 0) > limit:
            break
        kept = f"{kept} {sentence}".strip()
    if kept:
        return kept
    plain = re.sub(r"\s*\([^()]*\)", "", text)
    if plain != text:
        return fit(plain, limit)
    cut = text[: limit - 1].rsplit(" ", 1)[0].rstrip(",;:—–- ")
    return cut + "…"


def safe(text: str) -> str:
    """The sentences OrbOS would show: those that don't ask for a secret."""
    return " ".join(s for s in sentences(text) if not asks_for_secret(s))


def names(items: list[dict], limit: int) -> str:
    """The items' labels for speech, the first `limit` of them, then how many more."""
    said = [speakable(i["label"] or i["text"]).strip(" ,;:.") for i in items]
    said = [n for n in said if n]
    shown, rest = said[:limit], len(said) - min(len(said), limit)
    return "; ".join(shown) + (f"; and {count(rest, 'more', 'more')}" if rest else "")


def said_item(item: dict) -> str:
    """An item as one spoken sentence: its label and the words that go on from it."""
    label, raw = speakable(item["label"]).strip(" ,;:."), item["text"].strip()
    text = speakable(raw)
    if not label:
        return ended(sentences(text)[0]) if text else ""
    if text and raw and (raw[0] in ",;:—–(" or raw[0].islower()):
        text = text[0].lower() + text[1:] if raw[0].islower() else text
        return ended(sentences(f"{label}{'' if text[0] in ',;:' else ' '}{text}")[0])
    return ended(label)


def decisions_said(decisions: list[dict], limit: int) -> str:
    """The open decisions: those that need the user, each in a sentence; the defaults taken counted."""
    defaults = [d for d in decisions if "default" in d.get("group", "")]
    needed = [d for d in decisions if d not in defaults]
    out = []
    if needed:
        out.append(capitalized(f"{count(len(needed), 'open decision')} for you" if not defaults
                               else f"{count(len(needed), 'decision')} need{'s' if len(needed) == 1 else ''} you") + ".")
        out += [said_item(d) for d in needed[:limit]]
        if len(needed) > limit:
            out.append(capitalized(f"{count(len(needed) - limit, 'more')} in the report."))
    if defaults:
        out.append(capitalized(f"{count(len(defaults), 'more', 'more') if needed else count(len(defaults), 'decision')} "
                               f"{'are defaults' if len(defaults) != 1 else 'is a default'} I took; say if you disagree."))
    out.append("The report recommends an answer to each.")
    return " ".join(x for x in out if x)


def caption_of(sentence: str) -> str:
    """A caption: the sentence, or its first clause when the whole is longer than a caption."""
    if len(sentence) <= WALK["caption"]:
        return sentence
    clause = re.match(r"^(.{20,}?)[:;—]\s", sentence)
    return ended(clause.group(1)) if clause and len(clause.group(1)) < WALK["caption"] else sentence


def words(text: str) -> int:
    return len(text.split())


def duration(minutes: int) -> str:
    hours, rest = divmod(max(0, minutes), 60)
    parts = []
    if hours:
        parts.append(f"{hours} hour" + ("s" if hours != 1 else ""))
    if rest or not hours:
        parts.append(f"{rest} minute" + ("s" if rest != 1 else ""))
    return " and ".join(parts)


NUMBERS = ["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve"]


def count(n: int, thing: str, plural: str | None = None) -> str:
    name = thing if n == 1 else (plural or thing + "s")
    return f"{NUMBERS[n] if n < len(NUMBERS) else n} {name}"


# ---------------------------------------------------------------------------------------------
# The report

def report_sections(markdown: str) -> dict[str, str]:
    found: dict[str, list[str]] = {"": []}
    current = ""
    for line in markdown.splitlines():
        heading = re.match(r"^##\s+(.+?)\s*$", line)
        if heading:
            current = heading.group(1).strip().lower()
            found.setdefault(current, [])
        else:
            found[current].append(line)
    return {k: "\n".join(v).strip() for k, v in found.items()}


def section(parts: dict[str, str], *names: str) -> str:
    for key, body in parts.items():
        if any(key.startswith(n) for n in names):
            return body
    return ""


def is_picture_line(line: str) -> bool:
    return bool(re.match(r"^\s*!\[", line) or re.match(r"^\s*[^:]{1,120}:\s+/.+\.(png|jpe?g)\s*$", line, re.I))


def prose(lines: list[str]) -> str:
    """A block's lines as sentences: bullets become sentences, pictures and sub-headings go."""
    out = []
    for line in lines:
        line = line.strip()
        if not line or is_picture_line(line) or re.fullmatch(r"\*\*[^*]+:\*\*", line) or line.startswith("#"):
            continue
        line = re.sub(r"^[-*]\s+|^\d+\.\s+", "", line)
        line = re.sub(r"^\*\*([^*]+?)[:.]\*\*\s*", r"\1: ", line)
        out.append(ended(line))
    return " ".join(out)


def built_items(body: str) -> list[dict]:
    items: list[dict] = []
    for line in body.splitlines():
        head = re.match(r"^\*\*\s*\d+\.\s+(.+?)\s*\*\*\s*$", line.strip())
        if head:
            name = head.group(1)
            ref = re.search(r"\((?:[Tt]ask\s+)?([A-Za-z]{1,2}\d?)\)\s*$", name)
            items.append({"name": re.sub(r"\s*\([^)]*\)\s*$", "", name).strip(), "id": ref.group(1) if ref else None,
                          "lines": []})
        elif items:
            items[-1]["lines"].append(line)
    for item in items:
        item["text"] = prose(item["lines"])
    return items


def listed(body: str) -> list[dict]:
    """Numbered or bulleted items, each a bold label and its words; "Recommended:" kept apart."""
    items: list[dict] = []
    group = ""
    for line in body.splitlines():
        stripped = line.strip()
        heading = re.fullmatch(r"\*\*([^*]+?)[:.]?\*\*", stripped)
        if heading and not line.startswith((" ", "\t")):
            group = heading.group(1).strip().lower()   # "These need you", "Defaults I took. Say if you disagree"
            continue
        start = re.match(r"^(?:\d+\.|[-*])\s+(?:\*\*(.+?)\*\*)?\s*(.*)$", stripped)
        if start and not line.startswith((" ", "\t")):
            label = (start.group(1) or "").strip().rstrip(".:")
            items.append({"label": label, "text": start.group(2).strip(), "recommended": "", "group": group})
        elif items and stripped:
            rec = re.match(r"^\*\*Recommended:?\*\*:?\s*(.*)$", stripped)
            if rec:
                items[-1]["recommended"] = rec.group(1)
            elif not re.fullmatch(r"\*\*[^*]+:\*\*", stripped):
                items[-1]["text"] += " " + stripped
    return items


# ---------------------------------------------------------------------------------------------
# The run's facts

def clock(value: str) -> datetime | None:
    for form in ("%Y-%m-%d %H:%M", "%H:%M"):
        try:
            return datetime.strptime(value, form)
        except (TypeError, ValueError):
            pass
    return None


def run_line(facts: dict, outcome: bool = True) -> str:
    tasks = [t for t in facts.get("tasks", []) if isinstance(t, dict) and t.get("status") != "replaced"]
    if not tasks:
        return "The run had no tasks."
    run = facts.get("run") or {}
    start, end = clock(run.get("start", "")), clock(run.get("end", ""))
    merged = sum(1 for t in tasks if t.get("status", "merged") == "merged")
    others = {}
    for t in tasks:
        status = t.get("status", "merged")
        if status != "merged":
            others[status] = others.get(status, 0) + 1
    def number(n: int) -> str:
        return NUMBERS[n] if n < len(NUMBERS) else str(n)
    said = (f"all {count(merged, 'task')} merged" if merged == len(tasks) and merged > 1
               else f"{number(merged)} of the {count(len(tasks), 'task')} merged" if len(tasks) > 1
               else ("the task merged" if merged else "the task didn't merge"))
    if others:
        said += ", " + ", ".join(f"{number(n)} {OUTCOME_WORDS.get(s, s)}" for s, n in sorted(others.items()))
    if start and end and end >= start:
        took = duration(int((end - start).total_seconds() // 60))
        return ended(f"The run took {took}, and {said}") if outcome else f"It took {took}."
    return ended(capitalized(said)) if outcome else ""


def task_lookup(facts: dict, items: list[dict]) -> list[dict]:
    """Each report item with its task's facts, matched by the item's task ID, else its name, else order."""
    tasks = [t for t in facts.get("tasks", []) if isinstance(t, dict) and t.get("status") != "replaced"]
    used: set[int] = set()

    def free(match) -> dict | None:
        return next((t for n, t in enumerate(tasks) if n not in used and match(t)), None)
    joined = []
    for item in items:
        task = (free(lambda t: item["id"] is not None and str(t.get("id")) == item["id"])
                or free(lambda t: str(t.get("name", "")).lower() == item["name"].lower()) or free(lambda t: True))
        if task is not None:
            used.add(next(n for n, t in enumerate(tasks) if t is task))
        joined.append({"item": item, "task": task or {}})
    for n, task in enumerate(tasks):  # a task the report didn't list gets its own entry from the facts
        if n not in used:
            joined.append({"item": {"name": str(task.get("name") or task.get("id") or f"Task {n + 1}"),
                                    "text": str(task.get("summary") or ""), "id": task.get("id")}, "task": task})
    return joined


# ---------------------------------------------------------------------------------------------
# The reading

def reading(facts: dict, markdown: str, budget: int = WORDS, ask_for_tour: bool = False, with_tour: bool = False) -> dict:
    """The offer_reading arguments. `with_tour`: the tour comes with it, so it ends by naming Tour;
    `ask_for_tour`: it doesn't, and it ends by saying how to ask for one."""
    TASK_IDS.update(str(t.get("id")) for t in facts.get("tasks", []) if isinstance(t, dict) and t.get("id"))
    parts = report_sections(markdown)
    intro = speakable(prose(parts.get("", "").splitlines()))
    built = task_lookup(facts, built_items(section(parts, "what was built")))
    unfinished = listed(section(parts, "not finished"))
    checking = listed(section(parts, "worth checking"))
    decisions = listed(section(parts, "open decisions"))

    def item_sentences(entry: dict, n: int) -> str:
        said = sentences(speakable(entry["item"].get("text", "")))[:n]
        name = speakable(entry["item"]["name"])
        status = entry["task"].get("status", "merged")
        tail = "" if status in ("merged", "") else f" It is {OUTCOME_WORDS.get(status, status)}."
        return ended(f"{name}: " + lowered(" ".join(said))) + tail if said else ended(name) + tail

    def compose(intro_n: int, per_item: int, limit: int, with_checks: bool) -> str:
        opening = " ".join(sentences(intro)[:intro_n])
        paragraphs = [opening or run_line(facts)]
        if opening:
            paragraphs.append(run_line(facts, outcome=not re.search(r"\bmerged\b", opening)))
        if built:
            paragraphs.append("What was built.\n" + "\n".join(item_sentences(e, per_item) for e in built))
        if unfinished:
            paragraphs.append("Not finished: " + ended(names(unfinished, limit)))
        if decisions:
            paragraphs.append(decisions_said(decisions, min(limit, 3)))
        if checking and with_checks:
            paragraphs.append(capitalized(f"{count(len(checking), 'thing')} worth checking yourself, in the report."))
        paragraphs.append("The whole report is in the chat, and it's under Full Text here."
                          + (" For a tour of the run, card by card, press Tour." if with_tour else
                             " For a tour of the run, card by card, ask me to walk you through the run." if ask_for_tour else ""))
        return "\n\n".join(p for p in paragraphs if p)

    text = ""
    for intro_n, per_item, limit, with_checks in [(3, 2, 6, True), (2, 2, 5, True), (2, 1, 5, True), (2, 1, 4, False),
                                                  (1, 1, 3, False), (1, 0, 3, False), (1, 0, 2, False)]:
        text = compose(intro_n, per_item, limit, with_checks)
        if words(text) <= budget:
            break
    title = facts.get("title") or "The run"
    original = markdown.strip()
    if len(original) > READING["original"]:
        tail = "\n\n… The rest is in the chat."
        original = original[: READING["original"] - len(tail)].rsplit("\n\n", 1)[0] + tail
    return {"action": "offer", "kind": "report", "title": fit(f"Run report: {speakable(title)}", READING["title"]),
            "text": fit(text, READING["text"]) if len(text) > READING["text"] else text,
            "original": original, "source": "The run's final report, in this chat"}


OUTCOME_WORDS = {"blocked": "blocked", "failed": "failed", "stopped": "stopped, with nothing merged",
                 "ready": "ready but not merged", "parked": "parked, never started"}


# ---------------------------------------------------------------------------------------------
# The repository: a task's key change and its pictures

EMPTY_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"
# Plain diffs whatever the user's git settings: no colour, no external diff tool or text filter.
DIFF = ("--no-color", "--no-ext-diff", "--no-textconv", "--no-renames")


def run_git(repo: Path, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-c", "core.quotePath=false", "--literal-pathspecs", "-C", str(repo), *args],
                          capture_output=True, text=True, errors="replace")


def git(repo: Path, *args: str) -> str:
    done = run_git(repo, *args)
    return done.stdout if done.returncode == 0 else ""


def hunks(diff: str) -> list[tuple[int, int, int, int]]:
    """A unified diff's hunks as (old start, old count, new start, new count)."""
    out = []
    for m in re.finditer(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@", diff, re.M):
        out.append((int(m.group(1)), int(m.group(2) or 1), int(m.group(3)), int(m.group(4) or 1)))
    return out


def moved(lines: tuple[int, int], later: list[tuple[int, int, int, int]]) -> tuple[int, int]:
    """Lines of a file at the task's last commit, as they are after the later changes `later`."""
    first, last = lines
    shift_first = shift_last = 0
    for old_start, old_count, new_start, new_count in later:
        old_end = old_start + max(old_count, 1) - 1
        delta = new_count - old_count
        if old_end < first or (old_count == 0 and old_start < first):
            shift_first += delta
        if old_end < last or (old_count == 0 and old_start < last):
            shift_last += delta
    return max(1, first + shift_first), max(1, last + shift_last)


def inside(repo: Path, path: str) -> Path | None:
    """The file at `path` when OrbOS's server would show it: relative, inside the repository once
    links are followed, no name that holds secrets, at most 300 characters."""
    if (not isinstance(path, str) or not path or len(path) > PATH_CHARACTERS or path.startswith(("/", "~"))
            or ".." in path.split("/") or any(unicodedata.category(c) in ("Cc", "Cf") for c in path) or secret_file(path)):
        return None
    full = (repo / path).resolve()
    try:
        within = full.relative_to(repo.resolve())
    except ValueError:
        return None
    return full if full.is_file() and not secret_file(within.as_posix()) else None


def text_file(full: Path) -> int | None:
    """Its number of lines when it is UTF-8 text OrbOS shows, else None."""
    if full.stat().st_size > FILE_BYTES:
        return None
    try:
        return max(1, full.read_text(encoding="utf-8").count("\n") + (0 if full.read_bytes().endswith(b"\n") else 1))
    except (UnicodeDecodeError, OSError):
        return None


def picture_size(full: Path) -> tuple[int, int] | None:
    data = full.read_bytes()[:65536] if full.stat().st_size <= PICTURE_BYTES else b""
    if data.startswith(b"\x89PNG\r\n\x1a\n") and len(data) >= 24:
        return int.from_bytes(data[16:20], "big"), int.from_bytes(data[20:24], "big")
    if data.startswith(b"\xff\xd8"):
        i = 2
        while i + 9 < len(data):
            if data[i] != 0xFF:
                i += 1
                continue
            marker = data[i + 1]
            if marker in (0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF):
                return int.from_bytes(data[i + 7:i + 9], "big"), int.from_bytes(data[i + 5:i + 7], "big")
            if marker in (0xD8, 0x01) or 0xD0 <= marker <= 0xD7:
                i += 2
                continue
            i += 2 + int.from_bytes(data[i + 2:i + 4], "big")
    return None


def given_change(repo: Path, task: dict) -> dict | None:
    """The key change the orchestrator named (`key_change`), when OrbOS would show it."""
    given = task.get("key_change")
    if not isinstance(given, dict) or not inside(repo, given.get("path")):
        return None
    total = text_file(inside(repo, given["path"]))
    if not total:
        return None
    say = given.get("say") if isinstance(given.get("say"), str) else ""
    lines = given.get("lines")
    if (isinstance(lines, list) and len(lines) == 2 and all(isinstance(n, int) and not isinstance(n, bool) for n in lines)
            and 1 <= lines[0] <= lines[1]):
        first = min(lines[0], total)
        return {"path": given["path"], "lines": [first, min(lines[1], total, first + SHOWN_LINES - 1)], "say": say}
    return {"path": given["path"], "lines": None, "say": say}


def task_commits(repo: Path, task: dict) -> list[str]:
    """A merged task's commits that are in HEAD's history, oldest first."""
    if task.get("status", "merged") != "merged":
        return []
    found = []
    for commit in task.get("commits") or []:
        if not isinstance(commit, str) or not re.fullmatch(r"[0-9a-fA-F]{4,40}", commit):
            continue
        full = git(repo, "rev-parse", "--verify", "--quiet", commit + "^{commit}").strip()
        if full and full not in found and run_git(repo, "merge-base", "--is-ancestor", full, "HEAD").returncode == 0:
            found.append(full)
    return sorted(found, key=lambda c: int(git(repo, "rev-list", "--count", c).strip() or 0))


def parent(repo: Path, commit: str) -> str:
    return git(repo, "rev-parse", "--verify", "--quiet", commit + "^1").strip() or EMPTY_TREE


def changes(repo: Path, task: dict, shown: set[str] = frozenset()) -> tuple[dict | None, str | None]:
    """The task's key change (path and lines at HEAD) and a picture its commits put in the repository.
    Each of the task's own commits counts on its own, so other tasks' commits between them don't."""
    key = given_change(repo, task)
    if key and key["path"] in shown:
        key = None
    commits = task_commits(repo, task)
    if not commits:
        return key, None
    added: dict[str, int] = {}
    for commit in commits:
        fields = git(repo, "diff", "--numstat", "-z", *DIFF, parent(repo, commit), commit).split("\0")
        for field in fields:
            parts = field.split("\t")
            if len(parts) == 3 and parts[2]:
                added[parts[2]] = added.get(parts[2], 0) + (0 if parts[0] == "-" else int(parts[0]))
    picture = next((p for p in sorted(added) if PICTURE_PATH.search(p) and p not in shown and inside(repo, p)
                    and (size := picture_size(inside(repo, p))) and size[0] * size[1] <= PICTURE_PIXELS), None)
    if key is None:
        def rank(path: str) -> tuple[int, int]:
            kind = 3 if TEST_PATH.search(path) else 2 if ASIDE_PATH.search(path) else 1 if DOC_PATH.search(path) else 0
            return kind, -added[path]
        candidates = sorted((p for p, n in added.items() if n > 0 and p not in shown and not SKIP_PATH.search(p)
                             and not PICTURE_PATH.search(p)
                             and inside(repo, p) and text_file(inside(repo, p))), key=rank)
        for path in candidates:
            # The largest block one of its commits added, then where those lines are at HEAD.
            blocks = [(commit, h) for commit in commits
                      for h in hunks(git(repo, "diff", "-U0", *DIFF, parent(repo, commit), commit, "--", path)) if h[3] > 0]
            if not blocks:
                continue
            commit, (_, _, start, size) = max(blocks, key=lambda b: b[1][3])
            lines = (start, start + min(size, TOUR_LINES) - 1)
            first, last = moved(lines, hunks(git(repo, "diff", "-U0", *DIFF, commit, "HEAD", "--", path)))
            total = text_file(inside(repo, path)) or last
            first = min(first, total)
            last = min(max(last, first), total, first + TOUR_LINES - 1)
            key = {"path": path, "lines": [first, last], "say": ""}
            break
    return key, picture


# ---------------------------------------------------------------------------------------------
# The tour

def words_fit(text: str, limit: int, fallback: str) -> str:
    return fit(safe(text), limit) or fit(fallback, limit)


def labelled(name: str, what: str) -> str:
    """A step's title: the task's name and what the step shows, or only what it shows when that's too long."""
    room = WALK["step_title"] - len(what) - 2
    short = name if len(name) <= room else name[: room - 1].rsplit(" ", 1)[0].rstrip(",;:- ") + "…"
    title = safe(f"{short}: {what}")
    return title if title and len(short) > 1 else capitalized(what)


def note(title: str, caption: str, narration: str = "") -> dict:
    step = {"kind": "note", "title": words_fit(title, WALK["step_title"], "A task"),
            "caption": words_fit(caption, WALK["caption"], "More in the report.")}
    if narration:
        said = words_fit(narration, WALK["narration"], "")
        if said and said != step["caption"]:
            step["narration"] = said
    return step


def run_pictures(task: dict, folder: Path, base: Path, shown: set[str]) -> list[dict]:
    """The task's own pictures (its `pictures` in the facts) that are in the run's pictures folder and
    that OrbOS's server would show from there: PNG or JPEG, no name that holds secrets, nothing
    through a link out of the folder; each with its path relative to the folder and its caption."""
    found = []
    root = folder.resolve()
    for picture in task.get("pictures") or []:
        src = picture.get("src") if isinstance(picture, dict) else picture if isinstance(picture, str) else None
        if not isinstance(src, str) or not src or not PICTURE_PATH.search(src):
            continue
        # Its folder's real path and its own name (a link there is followed only below, to see where it leads).
        given = Path(src) if Path(src).is_absolute() else base / src
        full = Path(os.path.realpath(given.parent)) / given.name
        if not full.is_relative_to(root) or full == root:
            continue
        relative = full.relative_to(root).as_posix()
        if (relative in shown or len(relative) > PATH_CHARACTERS or secret_file(relative) or ".." in relative.split("/")
                or any(unicodedata.category(c) in ("Cc", "Cf") for c in relative)):
            continue
        real = (root / relative).resolve()
        try:
            within = real.relative_to(root).as_posix()
        except ValueError:
            continue
        if not real.is_file() or secret_file(within) or not PICTURE_PATH.search(within):
            continue
        size = picture_size(real)
        if not size or size[0] * size[1] > PICTURE_PIXELS:
            continue
        caption = picture.get("caption", "") if isinstance(picture, dict) else ""
        found.append({"path": relative, "caption": caption if isinstance(caption, str) else ""})
        shown.add(relative)
    return found


def tour(facts: dict, markdown: str, repo: Path | None, pictures: Path | None = None, base: Path = Path("."),
         without: frozenset[str] = frozenset()) -> dict:
    """The tour's steps (and the calls of a live walkthrough). With `pictures`, the run folder an
    offer's server was started with (`--pictures`), the tasks' own pictures there are shown too.
    `without`: files and pictures to leave out (those OrbOS refused), the notes counting without them."""
    TASK_IDS.update(str(t.get("id")) for t in facts.get("tasks", []) if isinstance(t, dict) and t.get("id"))
    parts = report_sections(markdown)
    intro = sentences(speakable(prose(parts.get("", "").splitlines())))
    built = task_lookup(facts, built_items(section(parts, "what was built")))
    decisions = listed(section(parts, "open decisions"))
    unfinished = listed(section(parts, "not finished"))
    title = speakable(facts.get("title") or "") or "the run"

    steps: list[dict] = []
    opening = " ".join(intro[:2]) or run_line(facts)
    steps.append(note("How the run went", intro[0] if intro else run_line(facts),
                      f"{opening} I'll show each task in turn, then what needs you."))

    groups: list[dict] = []
    shown: set[str] = set(without)   # files and pictures an earlier task showed, or left out
    for entry in built:
        item, task = entry["item"], entry["task"]
        name = speakable(item["name"]) or speakable(str(task.get("name", ""))) or "A task"
        group = {"name": name, "task": task, "file": None, "candidates": [], "pictures": [],
                 "said": sentences(speakable(item.get("text", ""))) or sentences(speakable(str(task.get("summary", ""))))}
        if repo is not None and task:
            key, picture = changes(repo, task, shown)
            if key:
                step = {"kind": "file", "title": labelled(name, "key change"), "path": key["path"]}
                if key["lines"]:
                    step["lines"] = key["lines"]
                step["narration"] = words_fit(speakable(key["say"]) if key["say"] else
                                              "The marked lines are the largest block it added, in the file it changed most.",
                                              WALK["narration"], "The marked lines are this task's key change.")
                group["file"] = step
                shown.add(key["path"])
            if picture:
                group["candidates"].append({"path": picture, "own": False})
                shown.add(picture)
        if pictures is not None and task:
            group["candidates"][:0] = [dict(p, own=True) for p in run_pictures(task, pictures, base, shown)]
        groups.append(group)

    # About 8 pictures in all (each is up to 700 KB once OrbOS scales it, and a waiting tour holds
    # 8 MB): one from each task in turn, its own pictures before the project's.
    picked = 0
    for round_ in range(max((len(g["candidates"]) for g in groups), default=0)):
        for group in groups:
            if picked < TOUR_PICTURES and round_ < len(group["candidates"]):
                group["pictures"].append(group["candidates"][round_])
                picked += 1

    def picture_step(group: dict, n: int, picture: dict) -> dict:
        what = "a picture" if n == 0 else f"picture {n + 1}"
        if not picture["own"]:
            return {"kind": "picture", "title": labelled(group["name"], what), "path": picture["path"],
                    "narration": "A picture this task added to the project."}
        caption = words_fit(ended(speakable(picture["caption"])), WALK["caption"], "")
        step = {"kind": "picture", "title": labelled(group["name"], what), "path": picture["path"]}
        return dict(step, caption=caption) if caption else dict(step, narration="A picture this task took of its work.")

    per_task = [[{"kind": "note", "group": n}] + ([g["file"]] if g["file"] else [])
                + [picture_step(g, i, p) for i, p in enumerate(g["pictures"])] for n, g in enumerate(groups)]

    closing = []
    if unfinished:
        closing.append("Not finished: " + names(unfinished, 3) + ".")
    needed = [d for d in decisions if "default" not in d.get("group", "")]
    if decisions:
        closing.append(decisions_said(decisions, 3))
    caption = (capitalized(f"{count(len(needed), 'decision')} need{'s' if len(needed) == 1 else ''} you; "
                           "the report recommends an answer to each.") if needed
               else "Only defaults I took; say if you disagree." if decisions else "Nothing needs your decision.")
    final = note("What needs you", caption, " ".join(closing) or caption)

    # At most 50 steps: pictures go first, then file steps from the last task backwards, then tasks.
    def total() -> int:
        return 2 + sum(len(g) for g in per_task)
    for kind in ("picture", "file"):
        for group in reversed(per_task):
            if total() <= WALK["steps"]:
                break
            group[:] = [s for s in group if s["kind"] != kind]
    if total() > WALK["steps"]:
        keep = WALK["steps"] - 3
        rest = len(per_task) - keep
        per_task = per_task[:keep] + [[note(f"{count(rest, 'more task')}", f"{count(rest, 'more task')} in the report.")]]

    # Each task's note, once its pictures are known: what it built, and how many pictures it left.
    for group_steps in per_task:
        if "group" not in group_steps[0]:
            continue
        group = groups[group_steps[0]["group"]]
        task, said = group["task"], group["said"]
        status = task.get("status", "merged")
        state = "" if status in ("merged", "") else f"It is {OUTCOME_WORDS.get(status, status)}."
        left = len(task.get("pictures") or [])
        here = sum(1 for s in group_steps if s["kind"] == "picture" and s["path"] in
                   {p["path"] for p in group["pictures"] if p["own"]})
        seen = ""
        if left:
            seen = f"It left {count(left, 'picture')}, under its item in the report"
            seen += ("." if not here else "; the tour shows them." if here >= left
                     else f"; the tour shows {count(here, 'of them', 'of them')}.")
        caption = " ".join(x for x in [caption_of(said[0]) if said else "", state] if x) or group["name"]
        narration = " ".join(x for x in [" ".join(said[:2]), state, seen] if x)
        group_steps[0] = note(group["name"], caption, narration)
    steps += [s for g in per_task for s in g] + [final]

    # Calls: notes queue (up to 20 a call), file and picture steps go one to a call. The offer
    # carries the notes before the first file step, so Start goes straight into them.
    calls: list[list[dict]] = []
    for step in steps:
        if step["kind"] == "note" and calls and calls[-1][-1]["kind"] == "note" and len(calls[-1]) < WALK["queued"]:
            calls[-1].append(step)
        else:
            calls.append([step])
    # OrbOS heads the card "Walk me through:", so the title is what is walked through.
    offer = {"action": "offer", "title": fit(safe(title) or "the run", WALK["title"]), "mode": "guided",
             "about": fit(safe(capitalized(f"{count(len(built), 'task')}, one card each: what it built"
                               + (" and its key change" if any(s["kind"] == "file" for s in steps) else "")
                               + ". Then what needs you.")), WALK["about"]),
             "estimated_steps": min(len(steps), WALK["steps"])}
    if calls and all(s["kind"] == "note" for s in calls[0]):
        offer["steps"] = calls.pop(0)
    rest = [{"action": "step", "step": c[0]} if len(c) == 1 else {"action": "step", "steps": c} for c in calls]
    end = {"action": "end", "note": fit("The whole report is in the chat.", WALK["note"])}
    # Every step in order, numbered as OrbOS numbers them, for a `back` to send one again.
    return {"offer": offer, "calls": rest, "end": end, "steps": steps}


# ---------------------------------------------------------------------------------------------
# Offering it through OrbOS's bundled command: a short MCP client of `read-aloud --mcp`

PROTOCOL = "2025-06-18"
HANDSHAKE_SECONDS = 30       # the command opens OrbOS when it isn't running and waits up to 20 s for it
TOUR_ATTEMPTS = 10           # offers with a step left out each time OrbOS refuses one


def bundled_command(given: str | None) -> str | None:
    """OrbOS's command: the one given, else `read-aloud` on the PATH or in ~/bin (OrbOS links it there),
    else the app's in the Applications folders; only one bundled in an app (…/Contents/MacOS/read-aloud)."""
    if given:
        return given if os.path.isfile(given) and os.access(given, os.X_OK) else None
    home = Path.home()
    for candidate in (shutil.which("read-aloud"), home / "bin" / "read-aloud",
                      Path("/Applications/OrbOS.app/Contents/MacOS/read-aloud"),
                      home / "Applications" / "OrbOS.app" / "Contents" / "MacOS" / "read-aloud"):
        if not candidate or not os.access(candidate, os.X_OK):
            continue
        real = Path(candidate).resolve()
        if (real.name == "read-aloud" and real.parent.name == "MacOS" and real.parent.parent.name == "Contents"
                and real.parent.parent.parent.suffix == ".app" and (real.parent.parent / "Info.plist").is_file()):
            return str(real)
    return None


def pictures_folder(folder: str | None) -> Path | None:
    """The run folder as the server's pictures folder, when OrbOS takes it as one: a folder, not `/`,
    the home folder or a folder above it, nor one whose path holds a secrets' folder."""
    if not folder:
        return None
    real = Path(folder).resolve()
    home = Path.home().resolve()
    if not real.is_dir() or real == Path("/") or real == home or home.is_relative_to(real):
        return None
    parts = [p.lower() for p in real.parts[1:]]
    if any(p in SECRET_FOLDERS for p in parts) or any(a == ".config" and b == "gh" for a, b in zip(parts, parts[1:])):
        return None
    return real


class Server:
    """`read-aloud --mcp` on stdio: one JSON-RPC message a line, every wait with a deadline."""

    def __init__(self, argv: list[str], cwd: Path):
        self.errors = tempfile.TemporaryFile()
        self.process = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=self.errors,
                                        cwd=str(cwd), start_new_session=True)
        os.set_blocking(self.process.stdin.fileno(), False)   # a write waits only as long as the deadline allows
        self.buffer = b""
        self.next_id = 0

    def send(self, message: dict, deadline: float | None = None) -> None:
        """Writes one message under a deadline: a command that stopped reading would fill the pipe and
        hold a plain write for ever. Too late counts as the command not answering, as a read does."""
        if deadline is None:
            deadline = time.monotonic() + HANDSHAKE_SECONDS
        pending = memoryview((json.dumps(message, ensure_ascii=False) + "\n").encode())
        fd = self.process.stdin.fileno()
        while pending:
            left = deadline - time.monotonic()
            if left <= 0 or not select.select([], [fd], [], left)[1]:
                raise TimeoutError("OrbOS's command didn't take the message in time")
            try:
                pending = pending[os.write(fd, pending):]
            except BlockingIOError:
                continue

    def line(self, deadline: float) -> bytes:
        while b"\n" not in self.buffer:
            left = deadline - time.monotonic()
            if left <= 0 or not select.select([self.process.stdout], [], [], left)[0]:
                raise TimeoutError("OrbOS's command didn't answer in time")
            chunk = os.read(self.process.stdout.fileno(), 1 << 16)
            if not chunk:
                raise EOFError("OrbOS's command ended" + (f": {self.complaint()}" if self.complaint() else ""))
            self.buffer += chunk
        line, self.buffer = self.buffer.split(b"\n", 1)
        return line

    def request(self, method: str, params: dict, seconds: float, written=None) -> dict:
        """Sends a request and waits for its answer; written() is called once the whole request is in the
        pipe (a write that times out partway leaves a line the command never parses)."""
        self.next_id += 1
        deadline = time.monotonic() + seconds
        self.send({"jsonrpc": "2.0", "id": self.next_id, "method": method, "params": params}, deadline)
        if written:
            written()
        while True:
            try:
                message = json.loads(self.line(deadline))
            except ValueError:
                continue
            if not isinstance(message, dict):
                continue
            if "method" in message and "id" in message:   # the server asks something (a ping): answer it
                self.send({"jsonrpc": "2.0", "id": message["id"], "result": {}} if message["method"] == "ping" else
                          {"jsonrpc": "2.0", "id": message["id"], "error": {"code": -32601, "message": "not supported"}},
                          deadline)
            elif message.get("id") == self.next_id:
                return message

    def complaint(self) -> str:
        self.errors.seek(0)
        lines = self.errors.read().decode(errors="replace").strip().splitlines()
        return lines[-1][:300] if lines else ""

    def close(self) -> None:
        try:
            self.process.stdin.close()
            self.process.wait(timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            for sig in (signal.SIGTERM, signal.SIGKILL):
                try:
                    os.killpg(self.process.pid, sig)
                    self.process.wait(timeout=3)
                    break
                except (OSError, subprocess.TimeoutExpired):
                    continue
        self.errors.close()


def call_text(answer: dict) -> tuple[str, bool]:
    if "error" in answer:
        return f"error: {answer['error'].get('message', answer['error'])}", True
    result = answer.get("result") or {}
    content = result.get("content") or [{}]
    return str(content[0].get("text", "")), bool(result.get("isError"))


def offer(command: str, harness: str, cwd: Path, pictures: Path | None, with_tour: dict, alone: dict,
          seconds: float, rebuilt=None, record=lambda done: None) -> dict:
    """Offers the reading with its tour through OrbOS's own command, as the run's own MCP client (with
    the user's own OrbOS, whose socket the command finds as always). A step OrbOS refuses is left
    out and the offer made again (`rebuilt(paths)` makes the tour again without those files and
    pictures); an OrbOS that can't keep a tour gets the reading alone. `uncertain`: the call went
    out but no answer came, so the offer may have arrived; `record(done)` keeps it once each call is written
    (a call that never went out whole can't have arrived), so a run stopped from outside still says so."""
    argv = [command, "--harness", harness, "--mcp"] + (["--pictures", str(pictures)] if pictures else [])
    done = {"offered": False, "uncertain": False, "id": None, "tour": 0, "steps": [], "answer": "", "left_out": [],
            "command": command, "pictures": str(pictures) if pictures else None}
    deadline = time.monotonic() + seconds
    server = None
    try:
        server = Server(argv, cwd)
        def handshake() -> float:
            return max(0.5, min(HANDSHAKE_SECONDS, deadline - time.monotonic()))
        server.request("initialize", {"protocolVersion": PROTOCOL, "capabilities": {},
                                      "clientInfo": {"name": "report-offer", "version": "1"}}, handshake())
        server.send({"jsonrpc": "2.0", "method": "notifications/initialized"}, deadline)
        tools = (server.request("tools/list", {}, handshake()).get("result") or {}).get("tools") or []
        tool = next((t for t in tools if isinstance(t, dict) and t.get("name") == "offer_reading"), None)
        if tool is None:
            done["answer"] = "OrbOS's offer_reading isn't on for this assistant"
            return done
        takes_tour = "tour" in ((tool.get("inputSchema") or {}).get("properties") or {})
        tour = list(with_tour.get("tour") or []) if takes_tour else []
        refused_paths: set[str] = set()
        refused_words: list[dict] = []   # steps refused for their words: a note, left out as it is
        while True:
            arguments = dict(with_tour, tour=tour) if tour else alone
            left = deadline - time.monotonic()
            if left <= 0:
                raise TimeoutError("OrbOS's command didn't answer in time")
            def written():
                done["uncertain"] = True   # from here the offer may have arrived, whatever happens next
                record(done)
            text, failed = call_text(server.request("tools/call", {"name": "offer_reading", "arguments": arguments},
                                                    left, written))
            done["uncertain"] = False
            done["answer"] = text
            offered = re.match(r"offered: (\w+)", text)
            if offered and not failed:
                kept = re.search(r"with its tour of (\d+) step", text)
                done.update(offered=True, id=offered.group(1), tour=int(kept.group(1)) if kept and tour else 0,
                            steps=tour if kept else [])
                return done
            refused_step = re.match(r"refused: the tour's step (\d+):", text, re.I)
            if tour and refused_step and 1 <= int(refused_step.group(1)) <= len(tour) \
                    and len(done["left_out"]) < TOUR_ATTEMPTS:
                step = tour[int(refused_step.group(1)) - 1]
                done["left_out"].append({"step": step.get("title") or step.get("kind"), "path": step.get("path"),
                                         "why": text})
                if step.get("path") in refused_paths:
                    tour = []   # refused again: the reading alone
                elif step.get("path") and rebuilt:
                    refused_paths.add(step["path"])
                    tour = [s for s in rebuilt(frozenset(refused_paths))
                            if s not in refused_words and s.get("path") not in refused_paths]
                else:
                    refused_words.append(step)
                    tour = [s for s in tour if s is not step]
                continue
            if tour and (re.search(r"\btour", text, re.I) or text.startswith("refused:")):
                # this OrbOS can't keep a tour, holds as many as it can, or refuses its words: the reading alone
                tour = []
                continue
            return done
    except (OSError, TimeoutError, EOFError) as error:
        done["answer"] = str(error)
        return done
    finally:
        if server:
            server.close()


# ---------------------------------------------------------------------------------------------

def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="report-offer", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("facts")
    parser.add_argument("report")
    parser.add_argument("--repo", help="the integration checkout, which is the harness's working folder")
    parser.add_argument("--out", help="the folder for the files it writes (the report's folder by default)")
    parser.add_argument("--no-files", action="store_true", help="no file or picture steps")
    parser.add_argument("--ask-for-tour", action="store_true",
                        help="end the reading without a tour by saying how to ask for one (when you have the walkthrough tool)")
    parser.add_argument("--words", type=int, default=WORDS, help=f"the reading's most words (default {WORDS}, about two minutes)")
    parser.add_argument("--pictures", metavar="RUN", help="the run folder: show the tasks' own pictures in it in the tour it offers")
    parser.add_argument("--no-offer", action="store_true",
                        help="only write the files; you offer reading.json with your own offer_reading")
    parser.add_argument("--read-aloud", metavar="COMMAND", help="OrbOS's command (found in the app by default)")
    parser.add_argument("--harness", default="claude-code", help="the assistant the offer comes from (default claude-code)")
    parser.add_argument("--timeout", type=float, default=90, help="the most seconds the offer may take (default 90)")
    args = parser.parse_args(argv)
    facts = json.loads(Path(args.facts).read_text(errors="replace"))
    if not isinstance(facts, dict) or not isinstance(facts.get("tasks", []), list):
        raise SystemExit("report-offer: the facts file must be an object with a list of tasks")
    markdown = Path(args.report).read_text(errors="replace")
    repo = None
    if args.repo and not args.no_files:
        repo = Path(args.repo).resolve()
        if not git(repo, "rev-parse", "--git-dir"):
            raise SystemExit(f"report-offer: {repo} isn't a git repository")
    out = Path(args.out) if args.out else Path(args.report).resolve().parent
    out.mkdir(parents=True, exist_ok=True)

    walked = tour(facts, markdown, repo)
    alone = reading(facts, markdown, args.words, ask_for_tour=args.ask_for_tour)
    offered = dict(reading(facts, markdown, args.words, with_tour=True), tour=walked["steps"])
    (out / "reading.json").write_text(json.dumps(offered, ensure_ascii=False, indent=2) + "\n")
    (out / "reading-alone.json").write_text(json.dumps(alone, ensure_ascii=False, indent=2) + "\n")
    (out / "tour.json").write_text(json.dumps(walked, ensure_ascii=False, indent=2) + "\n")

    def described(steps: list[dict]) -> str:
        kinds = {k: sum(1 for s in steps if s["kind"] == k) for k in ("note", "file", "picture")}
        return f"{len(steps)} steps ({kinds['note']} notes, {kinds['file']} files, {kinds['picture']} pictures)"
    n = words(offered["text"])
    print(f"report-offer: wrote {out / 'reading.json'}: {n} words (about {max(1, round(n / 160))} min), "
          f"{len(offered['text']):,} characters; original {len(offered['original']):,} characters; "
          f"with its tour of {described(walked['steps'])}")
    print(f"report-offer: wrote {out / 'reading-alone.json'}: the same without the tour, for an OrbOS that can't keep one")
    print(f"report-offer: wrote {out / 'tour.json'}: the same tour as a live walkthrough, "
          f"{1 + len(walked['calls']) + 1} calls with the offer and the end")
    for s in walked["steps"]:
        if s["kind"] != "note":
            where = s["path"] + (f" lines {s['lines'][0]}–{s['lines'][1]}" if s.get("lines") else "")
            print(f"  {s['kind']}: {where}")
    if args.no_offer:
        return 0

    command = bundled_command(args.read_aloud)
    if not command:
        print("report-offer: not offered: OrbOS's command isn't here; offer reading.json with your own offer_reading")
        return 3
    folder = pictures_folder(args.pictures)
    if args.pictures and not folder:
        print(f"report-offer: {args.pictures} can't be the pictures folder; the tour shows the project's pictures only")
    def rebuilt(without: frozenset[str]) -> list[dict]:
        return tour(facts, markdown, repo, folder, Path(args.facts).resolve().parent, without)["steps"]
    with_tour = dict(offered, tour=rebuilt(frozenset()) if folder else walked["steps"])
    def record(done: dict) -> None:
        (out / "offered.json").write_text(json.dumps(done, ensure_ascii=False, indent=2) + "\n")
    done = offer(command, args.harness, repo or folder or Path.cwd(), folder, with_tour, alone, args.timeout, rebuilt, record)
    record(done)
    for left_out in done["left_out"]:
        print(f"report-offer: left out {left_out['step']}: {left_out['why']}")
    if done["uncertain"]:
        print(f"report-offer: may have offered: the offer went to OrbOS, but no answer came ({done['answer']}). "
              "Don't offer it again: it may wait in the notch already.")
        return 4
    if not done["offered"]:
        print(f"report-offer: not offered: {done['answer']}. Offer reading.json with your own offer_reading "
              "(reading-alone.json if it takes no tour).")
        return 3
    if done["tour"]:
        print(f"report-offer: offered {done['id']}, with its tour of {done['tour']} steps: it waits in the notch, "
              "and Tour plays it without you. No live tour is needed.")
    else:
        print(f"report-offer: offered {done['id']} without a tour (this OrbOS can't keep one): give the live tour from "
              "tour.json when the user is at the computer, or when they ask.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
