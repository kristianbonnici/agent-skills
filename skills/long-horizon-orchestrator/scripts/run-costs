#!/usr/bin/env python3
"""What a run's tokens would have cost at API list prices: per thread, by model, for the orchestrator,
each task, each task's reviewers and its helpers. An estimate of what the same tokens would cost on the
API, not what the subscriptions cost: most of the work runs on flat-rate plans or free tiers.

Usage: run-costs <run directory> [--orchestrator <thread ID>] [--from <ISO time>] [--to <ISO time>]
                 [--task <task ID>=<thread ID>]... [--computer <name>] [--json <file>] [--markdown <file>]

The run: <run directory>/watch.json gives the tasks' thread IDs ("tasks": {"A": {"thread": ...}}), the
run's start ("started") and, when the orchestrator recorded them, its own thread ("orchestrator_thread")
and the run's end ("finished"). --orchestrator, --from and --to override them; the end defaults to now.
Only tokens used between the start and the end count, since one orchestrator thread may serve several
runs. --task names a task's thread instead, for a computer without the run's watch.json: on a run's
other computer, its finish steps run run-costs with --from, --task for each task that ran there and
--json <run directory>/costs.json, and share-usage sends that file to the orchestrator's computer.

Several computers: each line says which computer its thread ran on (--computer, else watch.json's
"computer", else this computer's LocalHostName). On the orchestrator's computer, every
<run directory>/computers/<name>/costs.json that share-usage fetch wrote is added: its lines replace
this computer's empty ones for the tasks that ran there (watch.json's "computer" of each task), so the
total counts every task and its reviewers and helpers. A computer that tasks ran on but whose file
didn't arrive is named, and those tasks are listed as not counted ("ran on <name>, whose costs didn't
arrive"), and so is a task whose computer's file leaves it out ("ran on <name>, whose costs leave it out").

Where the numbers come from (T3 Code's records; T3_USERDATA moves its folder, ~/.t3/userdata by default):
  - the threads: T3's statev2.sqlite, read only: each thread's title, model and parent (a reviewer or
    helper a task started with delegate_task hangs under the task's thread), and the provider's own
    session or thread ID for it;
  - Claude (Claude Code under T3): the result lines T3 logs for each turn (logs/provider/events.*.log),
    with each model's tokens since the last result, subagents included (1-hour cache writes apart);
    Claude Code's own cost figure on those lines is kept as a cross-check;
  - Codex: T3's logged "thread/tokenUsage/updated" events, cumulative per Codex thread: the rise inside
    the run's span, priced by the price table;
  - OpenCode: OpenCode's own database (~/.local/share/opencode/opencode.db, OPENCODE_DB moves it),
    each assistant message's tokens and model inside the span (a T3 thread is one session), priced by
    the price table; a session with no per-message records counts by its totals only when it lies
    inside the run; its free models cost the owner $0, and
    the estimate is their list-price equivalent;
  - Antigravity: Antigravity's local SQLite conversation databases under T3's folder
    (providers/antigravity/*/antigravity-acp/conversations/<nativeId>.db, read only;
    ANTIGRAVITY_CONVERSATIONS_DIR moves the folder), decoding protobuf usage records from
    gen_metadata and steps, deduplicating across both tables and across threads in the run,
    and pricing orchestrators, workers, Claude variants and stacked effort suffixes by the
    price table;
  - Copilot keeps no token counts this script can read: its threads are listed as
    "not counted" (as is any Antigravity thread whose conversation database is missing or
    unreadable). A Claude Code subagent that T3 mirrors as a thread of its own is in its
    parent's figures already, and is listed as such.
The price table is LiteLLM's model price list, as T3 Code caches it (usage-model-rates.json, with the
time it fetched it), or a copy given as RUN_COSTS_PRICES. A model is priced by its own entry, else its
maker's (deepseek/, zai/, gemini/), else Azure AI's listing, and the source is named. T3's provider logs
rotate (four files per thread), so a long, busy thread can lose its oldest turns: the report says when a
thread's first logged turn comes after its start.

It prints a Markdown table and a "Cost at API prices (estimate)" paragraph, and with --json writes the
numbers for run-charts (facts' "costs": {"file": ...}). Exit 0; 2 for a usage error or when T3's records
can't be read (a run outside T3).
"""

from __future__ import annotations

import sys

if sys.version_info < (3, 9):    # the oldest Python its checks run on: macOS's own /usr/bin/python3
    print(f"run-costs: needs Python 3.9 or newer, and {sys.executable} is {sys.version.split()[0]}: run it with a newer "
          "python3 (on a Mac, Homebrew's), and over SSH through the login shell (zsh -l)", file=sys.stderr)
    sys.exit(69)

import argparse
import json
import os
import re
import sqlite3
import stat
import sys
import time
from collections import defaultdict
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import quote, unquote

REVIEW = re.compile(r"review|critique|re-look", re.I)
MAKERS = ("deepseek/", "zai/", "gemini/", "openai/", "anthropic/", "azure_ai/")
FREE = re.compile(r"(^|/)opencode/.*-free$|-free$")
# Antigravity schema, aliases and model IDs confirmed against Antigravity 1.5.14 on 2026-11-22;
# see docs/skills/long-horizon-orchestrator/evidence.md.
GEMINI_EFFORT_SUFFIX = re.compile(r"-(?:extra-low|extra-high|low|medium|high|xhigh|max)$")
EFFORT_SUFFIX = re.compile(r"-(?:extra-low|extra-high|low|medium|high|xhigh|max|tiered|control|thinking|agent|orchestrator)$")
ANTIGRAVITY_MODEL_ALIASES = {
    "gemini-pro-orchestrator-neon": "gemini-4-neon",
    "gemini-4-hydrogen-orchestrator": "gemini-4-hydrogen",
    "gemini-flash-worker-agy": "gemini-4-hydrogen",
    "gemini-pro-orchestrator-argon": "gemini-4-argon",
    "gemini-pro-orchestrator-carbon": "gemini-4-carbon",
    "gemini-pro-orchestrator": "gemini-4-carbon",
    "gemini-3.8-flash-n": "gemini-3.8-flash",
}
ANTIGRAVITY_MODEL_IDS = {
    1320: "gemini-3.8-flash",
    1402: "claude-opus-5-5",
    1405: "claude-sonnet-5-5",
    1525: "gemini-4-hydrogen",
    1530: "gemini-4-hydrogen",
    1532: "gemini-4-neon",
    1535: "gemini-4-neon",
    1537: "gemini-pro-orchestrator-neon",
    1669: "gemini-4-hydrogen-orchestrator",
}
ANTIGRAVITY_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
CONCRETE_MODEL = re.compile(r"^(?:gemini-\d|claude-(?:sonnet|opus|haiku|fable)-\d|gpt-)")


def userdata() -> Path:
    return Path(os.environ.get("T3_USERDATA", Path.home() / ".t3" / "userdata"))


def stamp(value) -> float | None:
    if value is None:
        return None
    if isinstance(value, (int, float)):
        return value / 1000 if value > 1e11 else float(value)
    try:
        moment = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except ValueError:
        return None
    return (moment if moment.tzinfo else moment.replace(tzinfo=timezone.utc)).timestamp()


def connect(path: Path) -> sqlite3.Connection:
    return sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=10)


# ------------------------------------------------------------------------------------------ threads

def load_threads(db: Path) -> tuple[dict, dict, dict]:
    """thread ID -> {title, model, instance, parent, created}; thread ID -> [(native driver, native ID)];
    thread ID -> [(requested time, model)] for its runs, oldest first."""
    con = connect(db)
    threads, natives, runs = {}, defaultdict(list), defaultdict(list)
    for tid, payload in con.execute("select thread_id, payload_json from orchestration_v2_projection_threads"):
        try:
            p = json.loads(payload)
        except (TypeError, ValueError):
            continue
        lineage = p.get("lineage") or {}
        threads[tid] = {"title": p.get("title") or "", "model": (p.get("modelSelection") or {}).get("model"),
                        "instance": p.get("providerInstanceId"), "parent": lineage.get("parentThreadId"),
                        "created": stamp(p.get("createdAt"))}
    for tid, payload in con.execute("select thread_id, payload_json from orchestration_v2_projection_provider_threads"):
        try:
            ref = json.loads(payload).get("nativeThreadRef") or {}
        except (TypeError, ValueError):
            continue
        if ref.get("nativeId"):
            natives[tid].append((ref.get("driver"), ref["nativeId"]))
    for tid, requested, payload in con.execute("select thread_id, requested_at, payload_json from orchestration_v2_projection_runs"):
        try:
            model = (json.loads(payload).get("modelSelection") or {}).get("model")
        except (TypeError, ValueError):
            model = None
        if model:
            runs[tid].append((stamp(requested) or 0, model))
    con.close()
    for v in runs.values():
        v.sort()
    return threads, natives, runs


def model_at(tid: str, at: float, threads: dict, runs: dict) -> str | None:
    found = [m for t, m in runs.get(tid, []) if t <= at + 1]
    return found[-1] if found else threads.get(tid, {}).get("model")


# ------------------------------------------------------------------------------------------ prices

def load_prices() -> tuple[dict, str]:
    path = Path(os.environ.get("RUN_COSTS_PRICES", userdata() / "usage-model-rates.json"))
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}, f"no price table ({path} unreadable)"
    doc = data.get("document", data) if isinstance(data, dict) else {}
    fetched = data.get("fetchedAtMs") if isinstance(data, dict) else None
    when = datetime.fromtimestamp(fetched / 1000).strftime("%Y-%m-%d") if isinstance(fetched, (int, float)) else "date unknown"
    return doc, f"LiteLLM's model price list as T3 Code cached it on {when}"


def _lookup_price(name: str, doc: dict) -> tuple[dict | None, str]:
    if name in doc:
        return doc[name], name
    for prefix in MAKERS:
        if prefix + name in doc:
            return doc[prefix + name], prefix + name
    tails = sorted(k for k in doc if k.split("/")[-1] == name)
    return (doc[tails[0]], tails[0]) if tails else (None, "")


def price_of(model: str, doc: dict) -> tuple[dict | None, str]:
    """The price entry for a model ID, and the entry's name; OpenCode's prefixes, -free,
    stacked Gemini/Claude effort/routing suffixes and Antigravity orchestrator aliases resolved."""
    name = re.sub(r"^(opencode-go|opencode)/", "", model or "")
    name = re.sub(r"-free$", "", name)
    if name.startswith("gemini-"):
        name = GEMINI_EFFORT_SUFFIX.sub("", name)
    entry, key = _lookup_price(name, doc)
    if entry is not None:
        return entry, key
    if name.startswith(("gemini-", "claude-")):
        stripped = name
        seen = {stripped}
        while True:
            aliased = ANTIGRAVITY_MODEL_ALIASES.get(stripped, stripped)
            if aliased != stripped:
                stripped = aliased
                entry, key = _lookup_price(stripped, doc)
                if entry is not None:
                    return entry, key
                if stripped in seen:
                    break
                seen.add(stripped)
                continue
            nxt = EFFORT_SUFFIX.sub("", stripped)
            if nxt == stripped or nxt in seen:
                break
            stripped = nxt
            seen.add(stripped)
            entry, key = _lookup_price(stripped, doc)
            if entry is not None:
                return entry, key
    return None, ""


def priced(tokens: dict, entry: dict) -> float:
    def rate(key, fallback=0.0):
        v = entry.get(key)
        return float(v) if isinstance(v, (int, float)) else fallback
    inp = rate("input_cost_per_token")
    write = rate("cache_creation_input_token_cost", inp)
    return (tokens["input"] * inp + tokens["cache_read"] * rate("cache_read_input_token_cost", inp)
            + tokens["cache_write"] * write + tokens.get("cache_write_1h", 0) * rate("cache_creation_input_token_cost_above_1hr", write)
            + tokens["output"] * rate("output_cost_per_token"))


# ------------------------------------------------------------------------------------------ tokens

def zero() -> dict:
    return {"input": 0, "cache_read": 0, "cache_write": 0, "cache_write_1h": 0, "output": 0}


def num(value) -> int:
    """A token count, or 0 for anything that isn't a non-negative number (a malformed field)."""
    ok = isinstance(value, (int, float)) and not isinstance(value, bool) and value >= 0 and value == value and value != float("inf")
    return int(value) if ok else 0


def counts(record: dict, required: tuple, optional: tuple = ()) -> bool:
    """Whether each required field, and each optional one present, is a token count num() would take."""
    good = lambda v: isinstance(v, (int, float)) and not isinstance(v, bool) and num(v) == v
    return all(k in record and good(record[k]) for k in required) and all(good(record[k]) for k in optional if k in record)


def log_order(path: Path) -> tuple:
    """Rotated files hold older lines: events.x.log.3 before .log.2, .log.1 and events.x.log."""
    m = re.search(r"\.log(?:\.(\d+))?$", path.name)
    return (path.name[: m.start()] if m else path.name, -(int(m.group(1)) if m and m.group(1) else 0))


def scan_t3_logs(wanted: set[str], codex_natives: dict) -> dict:
    """From T3's provider logs, every relevant record, whatever its time (the span is applied later, and
    Codex needs the last cumulative count before the run): Claude results per app thread, Codex
    cumulative counts per native thread, each app thread's earliest logged line in the files it appears
    in, and how many records were malformed."""
    folder = userdata() / "logs" / "provider"
    claude, codex, file_first, malformed = [], defaultdict(list), {}, 0
    seen: set = set()
    for path in sorted(folder.glob("events.*.log*"), key=log_order):
        try:
            handle = path.open("rb")
        except OSError:
            continue
        first_at, apps = None, set()
        with handle:
            for n, raw in enumerate(handle):
                if n == 0:
                    m = re.match(rb"\[([^\]]+)\]", raw)
                    first_at = stamp(m.group(1).decode(errors="replace")) if m else None
                is_claude = b'"total_cost_usd"' in raw
                is_codex = b'thread/tokenUsage/updated' in raw
                if not (is_claude or is_codex):
                    continue
                text = raw.decode("utf-8", errors="replace")
                m = re.match(r"\[([^\]]+)\]", text)
                at = stamp(m.group(1)) if m else None
                brace = text.find("{")
                try:
                    record = json.loads(text[brace:]) if at is not None and brace >= 0 else None
                    payload = record["event"]["payload"]
                    if not isinstance(payload, dict):
                        raise TypeError
                except (ValueError, KeyError, TypeError):
                    malformed += 1
                    continue
                if is_codex:
                    params = payload.get("params") if isinstance(payload.get("params"), dict) else {}
                    usage = (params.get("tokenUsage") or {}).get("total") if isinstance(params.get("tokenUsage"), dict) else None
                    native = params.get("threadId")
                    if isinstance(native, str) and native in codex_natives:
                        if not isinstance(usage, dict):
                            malformed += 1
                            continue
                        codex[native].append((stamp(payload.get("emittedAtMs")) or at, usage))
                        apps.add(codex_natives[native])
                    continue
                session = str(record.get("providerSessionId") or "")
                sm = re.search(r":thread:(.+):[^:]+$", session)
                app = unquote(sm.group(1)) if sm else None
                if app not in wanted:
                    continue
                key = (session, payload.get("uuid"))
                if payload.get("uuid") and key in seen:
                    continue   # the same result logged twice
                seen.add(key)
                apps.add(app)
                claude.append((at, app, session, payload))
        for app in apps:
            if first_at is not None:
                file_first[app] = min(file_first.get(app, first_at), first_at)
    return {"claude": claude, "codex": codex, "file_first": file_first, "malformed": malformed}


CLAUDE_KEYS = (("inputTokens", "input"), ("cacheReadInputTokens", "cache_read"), ("outputTokens", "output"))


def claude_usage(records: list, start: float, end: float) -> tuple[dict, int]:
    """(app thread, model) -> {tokens, usd} inside the span, from results in time order. A result's own
    since-last-result figures are used; one without them counts the rise of its session's cumulative
    figures, which every result (of either kind) moves forward."""
    out: dict = defaultdict(lambda: {"tokens": zero(), "usd": 0.0})
    cumulative: dict = {}
    malformed = 0
    for at, app, session, payload in sorted(records, key=lambda r: r[0]):
        try:
            totals = payload.get("modelUsage") if isinstance(payload.get("modelUsage"), dict) else {}
            since = payload.get("model_usage_since_last_result")
            if not isinstance(since, dict):
                since = {}
                for name, u in totals.items():
                    before = cumulative.get((session, name))
                    since[name] = {k: max(0, num(u.get(k)) - num((before or {}).get(k))) if before else num(u.get(k))
                                   for k in ("inputTokens", "outputTokens", "cacheReadInputTokens", "cacheCreationInputTokens",
                                             "cacheCreationEphemeral1hInputTokens")}
                    since[name]["costUSD"] = max(0.0, float(u.get("costUSD") or 0) - float((before or {}).get("costUSD") or 0))
            for name, u in totals.items():
                if isinstance(u, dict):
                    cumulative[(session, name)] = u
            if not (start <= at <= end):
                continue
            for name, u in since.items():
                if not isinstance(u, dict):
                    malformed += 1
                    continue
                slot = out[(app, name)]
                for src, dst in CLAUDE_KEYS:
                    slot["tokens"][dst] += num(u.get(src))
                hour = num(u.get("cacheCreationEphemeral1hInputTokens"))   # 1-hour cache writes cost more
                slot["tokens"]["cache_write"] += max(0, num(u.get("cacheCreationInputTokens")) - hour)
                slot["tokens"]["cache_write_1h"] += hour
                cost = u.get("costUSD")
                slot["usd"] += float(cost) if isinstance(cost, (int, float)) and not isinstance(cost, bool) else 0.0
        except (TypeError, ValueError, AttributeError):
            malformed += 1
    return out, malformed


def codex_usage(series: list, start: float, end: float, model_of, skip_first: bool = False) -> tuple[dict, bool]:
    """model -> tokens: the rise of a Codex thread's cumulative counts inside the span, each rise under
    the model its thread ran at that time (a fall is a new session); and whether a count before the
    span was seen. Without one, the first count in the span is taken whole, or, with skip_first (a
    thread older than the run, whose earlier counts rotated away), only used as the baseline."""
    out: dict = defaultdict(zero)
    prev, baseline = None, False
    for i, (at, total) in enumerate(sorted(series, key=lambda x: x[0])):
        cur = {"input": num(total.get("inputTokens")), "cached": num(total.get("cachedInputTokens")),
               "write": num(total.get("cacheWriteInputTokens")), "output": num(total.get("outputTokens"))}
        delta = cur if prev is None or cur["input"] < prev["input"] else {k: max(0, cur[k] - prev[k]) for k in cur}
        prev = cur
        if at < start:
            baseline = True
            continue
        if at > end:
            break
        if skip_first and not baseline and i == 0:
            continue   # its count holds what the thread did before the run: a baseline, not this run's use
        slot = out[model_of(at)]
        slot["input"] += max(0, delta["input"] - delta["cached"] - delta["write"])
        slot["cache_read"] += delta["cached"]
        slot["cache_write"] += delta["write"]
        slot["output"] += delta["output"]
    return out, baseline


def opencode_usage(sessions: set[str], start: float, end: float) -> tuple[dict, set, set, set]:
    """OpenCode session ID -> {model: tokens} for its assistant messages inside the span, each under its
    own model (session_message, else the older message table); the sessions counted by their whole-session
    totals (no per-message records, and the session lies inside the run); those left out (no
    per-message records, and the session reaches outside the run); and those with records it couldn't
    read."""
    path = Path(os.environ.get("OPENCODE_DB", Path.home() / ".local/share/opencode/opencode.db"))
    out: dict = defaultdict(lambda: defaultdict(zero))
    whole: set = set()
    outside: set = set()
    unreadable: set = set()
    if not sessions or not path.exists():
        return out, whole, outside, unreadable
    con = connect(path)
    marks = ",".join("?" * len(sessions))
    found: set = set()
    for query in (f"select session_id, data, {{when}} from session_message where type = 'assistant' and session_id in ({marks})",
                  f"select session_id, data, {{when}} from message where session_id in ({marks})"):
        rows = None
        for when in ("time_created", "null"):   # the row's own time, where the table keeps one
            try:
                rows = con.execute(query.format(when=when), tuple(sessions)).fetchall()
                break
            except sqlite3.Error:
                continue
        if rows is None:
            continue
        for sid, data, row_at in rows:
            if sid in found and "from message" in query:
                continue   # already read from session_message
            try:
                d = json.loads(data)
                if not isinstance(d, dict):
                    raise TypeError
            except (TypeError, ValueError):
                row_time = stamp(row_at) if isinstance(row_at, (int, float)) and not isinstance(row_at, bool) else None
                if row_time is not None and not (start <= row_time <= end):
                    continue   # a record it can't read, but from outside the run: it changes nothing here
                unreadable.add(sid)   # a record it can't read: the session's figure is partial
                continue
            if "session_message" in query:
                found.add(sid)   # it has readable per-message records, whatever each one holds
            if "tokens" not in d:
                continue   # a message with no usage, such as a failed request
            try:
                at = stamp((d.get("time") or {}).get("created"))
                if at is None:
                    raise TypeError
            except (TypeError, ValueError, AttributeError):
                unreadable.add(sid)   # a usage record with no readable time: the session's figure is partial
                continue
            if not (start <= at <= end):
                continue   # outside the run, readable or not: it changes nothing here
            try:
                t = d["tokens"]
                m = d.get("model") if isinstance(d.get("model"), dict) else {"id": d.get("modelID"), "providerID": d.get("providerID")}
                name = f"{m.get('providerID')}/{m.get('id')}" if m.get("id") else "unknown"
                cache = t.get("cache", {})
                # every count a number: one stored as text, or a cache object without its counts, is no zero
                if not counts(t, ("input", "output"), ("reasoning",)) or "cache" in t and not (
                        isinstance(cache, dict) and counts(cache, ("read", "write"))):
                    raise TypeError
            except (TypeError, ValueError, KeyError, AttributeError):
                unreadable.add(sid)   # usage it can't read: the session's figure is partial
                continue
            slot = out[sid][name]
            slot["input"] += num(t.get("input"))
            slot["cache_read"] += num(cache.get("read"))
            slot["cache_write"] += num(cache.get("write"))
            slot["output"] += num(t.get("output")) + num(t.get("reasoning"))
    for sid in found - set(out):   # per-message records, none with tokens in the span: it used nothing then
        out[sid] = {}
    for sid in sessions - found - set(out):   # no per-message records: the session's totals, if it lies inside the run
        try:
            row = con.execute("select model, tokens_input, tokens_output, tokens_reasoning, tokens_cache_read, tokens_cache_write, "
                              "time_created, time_updated from session_v2 where id = ?", (sid,)).fetchone()
        except sqlite3.Error:
            row = None
        if row and not (start <= (stamp(row[6]) or 0) and (stamp(row[7]) or float("inf")) <= end):
            outside.add(sid)   # its totals can't be bounded to the run: not counted
            continue
        if row:
            try:
                m = json.loads(row[0]) if row[0] else {}
                name = f"{m.get('providerID')}/{m.get('id')}"
            except (TypeError, ValueError, AttributeError):
                name = "unknown"
            out[sid][name] = {"input": num(row[1]), "cache_read": num(row[4]), "cache_write": num(row[5]), "cache_write_1h": 0,
                              "output": num(row[2]) + num(row[3])}
            whole.add(sid)
    con.close()
    return out, whole, outside, unreadable


# ------------------------------------------------------------------------------------------ antigravity

def _read_varint(buf: bytes, pos: int, end: int) -> tuple[int, int] | None:
    val, shift = 0, 0
    while pos < end and shift < 70:
        b = buf[pos]
        pos += 1
        val |= (b & 0x7F) << shift
        if not (b & 0x80):
            return val, pos
        shift += 7
    return None


def _skip_group(buf: bytes, pos: int, end: int, group_field: int, depth: int) -> int | None:
    if depth > 16:
        return None
    while pos < end:
        res = _read_varint(buf, pos, end)
        if res is None:
            return None
        tag, pos = res
        fnum, wtype = tag >> 3, tag & 0x07
        if fnum == 0:
            return None
        if wtype == 4:
            return pos if fnum == group_field else None
        if wtype == 0:
            res = _read_varint(buf, pos, end)
            if res is None:
                return None
            pos = res[1]
        elif wtype == 1:
            if pos + 8 > end:
                return None
            pos += 8
        elif wtype == 2:
            res = _read_varint(buf, pos, end)
            if res is None:
                return None
            ln, pos = res
            if ln < 0 or pos + ln > end:
                return None
            pos += ln
        elif wtype == 3:
            pos = _skip_group(buf, pos, end, fnum, depth + 1)
            if pos is None:
                return None
        elif wtype == 5:
            if pos + 4 > end:
                return None
            pos += 4
        else:
            return None
    return None


def _parse_proto(raw, depth: int = 0) -> tuple[dict[int, list[tuple[int, object]]], bool]:
    """Decode one protobuf binary message into {field_number: [(wire_type, value), ...]}."""
    if isinstance(raw, memoryview):
        buf = raw.tobytes()
    elif isinstance(raw, bytearray):
        buf = bytes(raw)
    elif isinstance(raw, bytes):
        buf = raw
    else:
        return {}, False
    if depth > 16:
        return {}, False
    fields: dict[int, list[tuple[int, object]]] = defaultdict(list)
    pos, end = 0, len(buf)
    while pos < end:
        res = _read_varint(buf, pos, end)
        if res is None:
            return fields, False
        tag, pos = res
        fnum, wtype = tag >> 3, tag & 0x07
        if fnum == 0:
            return fields, False
        if wtype == 0:
            res = _read_varint(buf, pos, end)
            if res is None:
                return fields, False
            val, pos = res
            fields[fnum].append((0, val))
        elif wtype == 1:
            if pos + 8 > end:
                return fields, False
            fields[fnum].append((1, buf[pos:pos + 8]))
            pos += 8
        elif wtype == 2:
            res = _read_varint(buf, pos, end)
            if res is None:
                return fields, False
            ln, pos = res
            if ln < 0 or pos + ln > end:
                return fields, False
            fields[fnum].append((2, buf[pos:pos + ln]))
            pos += ln
        elif wtype == 3:
            nxt = _skip_group(buf, pos, end, fnum, depth + 1)
            if nxt is None:
                return fields, False
            pos = nxt
        elif wtype == 5:
            if pos + 4 > end:
                return fields, False
            fields[fnum].append((5, buf[pos:pos + 4]))
            pos += 4
        else:
            return fields, False
    return fields, True


def _proto_uint(fields: dict, num: int) -> int | None:
    vals = [v for wt, v in fields.get(num, ()) if wt == 0 and isinstance(v, int)]
    if not vals:
        return None
    v = vals[-1]
    return v if 0 <= v < (1 << 63) else None


def _proto_has_negative(fields: dict, nums: tuple[int, ...]) -> bool:
    for n in nums:
        for wt, v in fields.get(n, ()):
            if wt == 0 and isinstance(v, int) and v >= (1 << 63):
                return True
    return False


def _proto_strs(fields: dict, num: int) -> list[str]:
    out = []
    for wt, v in fields.get(num, ()):
        if wt != 2 or not isinstance(v, bytes):
            continue
        try:
            s = v.decode("utf-8").strip()
        except UnicodeDecodeError:
            continue
        if s:
            out.append(s)
    return out


def _proto_ts(blob: bytes) -> float | None:
    fields, ok = _parse_proto(blob)
    if not ok:
        return None
    secs = _proto_uint(fields, 1)
    if secs is None or secs <= 0:
        return None
    if _proto_has_negative(fields, (2,)):
        return None
    nanos = _proto_uint(fields, 2) or 0
    if nanos >= 1_000_000_000:
        return None
    return secs + nanos / 1e9


def _normalize_ag_model(raw: str) -> str:
    s = raw.strip().lower()
    if not s:
        return ""
    m = re.search(r"(?:\s*\([^()]+\))+\s*$", s)
    if m:
        tail = re.findall(r"\(([^()]+)\)", m.group(0))
        s = s[:m.start()] + "".join("-" + t.strip() for t in tail if t.strip())
    s = re.sub(r"\s+", "-", s)
    s = re.sub(r"-{2,}", "-", s).strip("-")
    s = re.sub(
        r"^claude-(\d+(?:[.-]\d+)*)-(opus|sonnet|haiku|fable)(?=(-|$))",
        lambda m: f"claude-{m.group(2)}-{m.group(1).replace('.', '-')}",
        s,
    )
    s = re.sub(
        r"^claude-(opus|sonnet|haiku|fable)-(\d+(?:\.\d+)+)(?=(-|$))",
        lambda m: f"claude-{m.group(1)}-{m.group(2).replace('.', '-')}",
        s,
    )
    return s


def _ag_model_rank(name: str) -> int:
    if not name:
        return -1
    if CONCRETE_MODEL.match(name):
        return 3
    if name.startswith(("gemini-", "claude-")):
        return 2
    if not name.startswith(("model_", "model-")) and name not in ("unknown", "default"):
        return 1
    return 0


def _better_model(a: str, b: str) -> str:
    return b if _ag_model_rank(b) > _ag_model_rank(a) else a


def _pick_model(candidates: list[str]) -> str:
    best = ""
    for raw in candidates:
        best = _better_model(best, _normalize_ag_model(raw))
    return best


def _parse_ag_usage(blob: bytes) -> tuple[dict | None, bool]:
    fields, ok = _parse_proto(blob)
    if not ok or _proto_has_negative(fields, (2, 3, 4, 5, 9, 10)):
        return None, False
    mid = _proto_uint(fields, 1)
    model_id = mid if mid else None
    inp = _proto_uint(fields, 2) or 0
    out3 = _proto_uint(fields, 3) or 0
    cache_write = _proto_uint(fields, 4) or 0
    cache_read = _proto_uint(fields, 5) or 0
    reasoning = _proto_uint(fields, 9) or 0
    completion = _proto_uint(fields, 10) or 0
    keys = [(k, s) for k in (11, 12, 7) for s in _proto_strs(fields, k)]
    return {"model_id": model_id, "input": inp, "cache_read": cache_read, "cache_write": cache_write,
            "output": max(out3, reasoning + completion), "keys": keys}, True


def _is_plain_dir(path: Path) -> tuple[bool, bool]:
    """(is_non_symlink_dir, saw_error_or_symlink) without propagating OSError."""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return False, False
    except OSError:
        return False, True
    if stat.S_ISLNK(st.st_mode):
        return False, True
    return stat.S_ISDIR(st.st_mode), False


def _ag_conv_dirs() -> tuple[list[Path], bool]:
    """Conversation folders to search, and whether a symlink or unreadable folder was seen."""
    override = os.environ.get("ANTIGRAVITY_CONVERSATIONS_DIR")
    if override:
        folder = Path(override)
        ok, bad = _is_plain_dir(folder)
        if not ok:
            print(f"run-costs: ANTIGRAVITY_CONVERSATIONS_DIR ({override}) isn't a usable folder", file=sys.stderr)
            return [], True
        return [folder], False
    root = userdata() / "providers" / "antigravity"
    ok, bad = _is_plain_dir(root)
    if not ok:
        return [], bad
    dirs, saw_bad = [], False
    try:
        entries = sorted(root.iterdir())
    except OSError:
        return [], True
    for entry in entries:
        ok, err = _is_plain_dir(entry)
        if err:
            saw_bad = True
        if not ok:
            continue
        acp = entry / "antigravity-acp"
        ok, err = _is_plain_dir(acp)
        if err:
            saw_bad = True
        if not ok:
            continue
        conv = acp / "conversations"
        ok, err = _is_plain_dir(conv)
        if err:
            saw_bad = True
        if ok:
            dirs.append(conv)
    return dirs, saw_bad


def _find_ag_db(native_id: str, dirs: list[Path], saw_bad_dir: bool) -> tuple[Path | None, str | None]:
    if not isinstance(native_id, str) or not ANTIGRAVITY_ID.fullmatch(native_id):
        return None, "Antigravity conversation database couldn't be read"
    saw_bad = False
    for folder in dirs:
        cand = folder / f"{native_id}.db"
        try:
            st = os.lstat(cand)
        except FileNotFoundError:
            continue
        except OSError:
            saw_bad = True
            continue
        if not stat.S_ISREG(st.st_mode):
            saw_bad = True
            continue
        return cand, None
    if saw_bad or (saw_bad_dir and not dirs):
        return None, "Antigravity conversation database couldn't be read"
    return None, "Antigravity conversation database not found"


def _sidecars_ok(path: Path) -> tuple[bool, float]:
    """Verify any SQLite sidecar files (-wal, -shm, -journal) are plain regular files; return (ok, wal_mtime)."""
    wal_mtime = 0.0
    for suffix in ("-wal", "-shm", "-journal"):
        side = Path(f"{path}{suffix}")
        try:
            st = os.lstat(side)
        except FileNotFoundError:
            continue
        except OSError:
            return False, 0.0
        if not stat.S_ISREG(st.st_mode):
            return False, 0.0
        if suffix == "-wal":
            wal_mtime = st.st_mtime
    return True, wal_mtime


def _open_ag_db(path: Path) -> tuple[sqlite3.Connection | None, float | None]:
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
    try:
        fd = os.open(path, flags)
    except OSError:
        return None, None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return None, None
        dev_ino = (st.st_dev, st.st_ino)
        mtime = st.st_mtime
    finally:
        os.close(fd)
    ok_side, wal_mtime = _sidecars_ok(path)
    if not ok_side:
        return None, None
    mtime = max(mtime, wal_mtime)
    try:
        con = sqlite3.connect(f"file:{quote(str(path), safe='/')}?mode=ro", uri=True, timeout=10)
    except sqlite3.Error:
        return None, None
    # Re-verify path identity and sidecars after open to narrow any swap window.
    try:
        st2 = os.lstat(path)
        ok_side2, _ = _sidecars_ok(path)
        if not stat.S_ISREG(st2.st_mode) or (st2.st_dev, st2.st_ino) != dev_ino or not ok_side2:
            con.close()
            return None, None
    except OSError:
        con.close()
        return None, None
    return con, mtime


def _read_ag_db(path: Path, db_key: str) -> dict:
    """Read one Antigravity conversation SQLite DB (read-only) into raw usage observations."""
    con, mtime = _open_ag_db(path)
    if con is None or mtime is None:
        return {"ok": False, "records": [], "malformed": 0, "error": "Antigravity conversation database couldn't be read"}
    records: list[dict] = []
    learned: dict[int, str] = {}
    malformed = 0
    traj_ts: float | None = None
    has_gm, has_st = False, False
    try:
        try:
            for (blob,) in con.execute("select data from trajectory_metadata_blob").fetchall():
                if blob is None:
                    continue
                fields, ok = _parse_proto(blob)
                if not ok:
                    malformed += 1
                    continue
                for wt, v in fields.get(2, ()):
                    if wt == 2 and isinstance(v, bytes):
                        ts = _proto_ts(v)
                        if ts is not None:
                            traj_ts = ts if traj_ts is None else min(traj_ts, ts)
                            break
        except sqlite3.OperationalError as e:
            if "no such table" not in str(e).lower():
                return {"ok": False, "records": [], "malformed": 0, "error": "Antigravity conversation database couldn't be read"}
        except sqlite3.Error:
            return {"ok": False, "records": [], "malformed": 0, "error": "Antigravity conversation database couldn't be read"}

        def add_usage(src: str, idx, slot: str, ublob: bytes, row_mid: int | None, row_name: str, row_ts: float | None) -> None:
            nonlocal malformed
            usage, uok = _parse_ag_usage(ublob)
            if not uok or usage is None:
                malformed += 1
                return
            u_mid = usage["model_id"]
            if u_mid and row_mid and u_mid != row_mid:
                eff_mid, eff_name = u_mid, ""
            else:
                eff_mid = u_mid or row_mid
                eff_name = row_name
                if eff_mid and eff_name:
                    learned[eff_mid] = _better_model(learned.get(eff_mid, ""), eff_name)
            ts_pri, ts_val = ((3, row_ts) if row_ts is not None else (2, traj_ts) if traj_ts is not None else (1, mtime))
            keys = usage["keys"] or [("row", db_key, src, idx, slot)]
            records.append({"model_id": eff_mid, "model": eff_name, "input": usage["input"], "cache_read": usage["cache_read"],
                            "cache_write": usage["cache_write"], "output": usage["output"], "ts_pri": ts_pri, "ts": ts_val,
                            "keys": keys})

        try:
            gm_rows = con.execute("select idx, data from gen_metadata").fetchall()
            has_gm = True
        except sqlite3.OperationalError as e:
            if "no such table" not in str(e).lower():
                return {"ok": False, "records": [], "malformed": 0, "error": "Antigravity conversation database couldn't be read"}
            gm_rows = []
        except sqlite3.Error:
            return {"ok": False, "records": [], "malformed": 0, "error": "Antigravity conversation database couldn't be read"}

        for idx, blob in gm_rows:
            if blob is None:
                continue
            root, ok = _parse_proto(blob)
            if not ok:
                malformed += 1
                continue
            for gi, (_, dblob) in enumerate((wt, v) for wt, v in root.get(1, ()) if wt == 2 and isinstance(v, bytes)):
                d, dok = _parse_proto(dblob)
                if not dok:
                    malformed += 1
                    continue
                row_mid = _proto_uint(d, 3) or None
                row_name = _pick_model(_proto_strs(d, 19) + _proto_strs(d, 21))
                if row_mid and row_name:
                    learned[row_mid] = _better_model(learned.get(row_mid, ""), row_name)
                row_ts = None
                for wt9, f9 in d.get(9, ()):
                    if wt9 == 2 and isinstance(f9, bytes):
                        m9, m9ok = _parse_proto(f9)
                        if not m9ok:
                            continue
                        for wt4, f4 in m9.get(4, ()):
                            if wt4 == 2 and isinstance(f4, bytes):
                                ts = _proto_ts(f4)
                                if ts is not None:
                                    row_ts = ts
                                    break
                        if row_ts is not None:
                            break
                for pi, (_, ublob) in enumerate((wt, v) for wt, v in d.get(4, ()) if wt == 2 and isinstance(v, bytes)):
                    add_usage("gm", idx, f"g{gi}.p{pi}", ublob, row_mid, row_name, row_ts)
                for ri, (_, rblob) in enumerate((wt, v) for wt, v in d.get(17, ()) if wt == 2 and isinstance(v, bytes)):
                    rm, rok = _parse_proto(rblob)
                    if not rok:
                        malformed += 1
                        continue
                    for ui, (_, ublob) in enumerate((wt, v) for wt, v in rm.get(2, ()) if wt == 2 and isinstance(v, bytes)):
                        add_usage("gm", idx, f"g{gi}.r{ri}.{ui}", ublob, row_mid, row_name, row_ts)

        try:
            st_rows = con.execute("select idx, metadata from steps where metadata is not null").fetchall()
            has_st = True
        except sqlite3.OperationalError as e:
            if "no such table" not in str(e).lower():
                return {"ok": False, "records": [], "malformed": 0, "error": "Antigravity conversation database couldn't be read"}
            st_rows = []
        except sqlite3.Error:
            return {"ok": False, "records": [], "malformed": 0, "error": "Antigravity conversation database couldn't be read"}

        for idx, blob in st_rows:
            if blob is None:
                continue
            d, ok = _parse_proto(blob)
            if not ok:
                malformed += 1
                continue
            m_names: list[str] = []
            row_mid = None
            for wt24, mblob in d.get(24, ()):
                if wt24 == 2 and isinstance(mblob, bytes):
                    mobj, mok = _parse_proto(mblob)
                    if not mok:
                        malformed += 1
                        continue
                    m_names += _proto_strs(mobj, 12) + _proto_strs(mobj, 8)
                    mid = _proto_uint(mobj, 1)
                    if mid:
                        row_mid = mid
            row_name = _pick_model(m_names)
            if row_mid and row_name:
                learned[row_mid] = _better_model(learned.get(row_mid, ""), row_name)
            row_ts = None
            for tfield in (8, 1):
                for wt, tblob in d.get(tfield, ()):
                    if wt == 2 and isinstance(tblob, bytes):
                        ts = _proto_ts(tblob)
                        if ts is not None:
                            row_ts = ts
                            break
                if row_ts is not None:
                    break
            for pi, (_, ublob) in enumerate((wt, v) for wt, v in d.get(9, ()) if wt == 2 and isinstance(v, bytes)):
                add_usage("st", idx, f"p{pi}", ublob, row_mid, row_name, row_ts)
            for ri, (_, rblob) in enumerate((wt, v) for wt, v in d.get(28, ()) if wt == 2 and isinstance(v, bytes)):
                rm, rok = _parse_proto(rblob)
                if not rok:
                    malformed += 1
                    continue
                for ui, (_, ublob) in enumerate((wt, v) for wt, v in rm.get(2, ()) if wt == 2 and isinstance(v, bytes)):
                    add_usage("st", idx, f"r{ri}.{ui}", ublob, row_mid, row_name, row_ts)
    finally:
        con.close()

    if not has_gm and not has_st:
        return {"ok": False, "records": [], "malformed": 0, "error": "Antigravity conversation database couldn't be read"}

    for rec in records:
        mid = rec["model_id"]
        if mid:
            rec["model"] = _better_model(rec["model"], learned.get(mid, ""))
            if _ag_model_rank(rec["model"]) <= 1:
                rec["model"] = _better_model(rec["model"], ANTIGRAVITY_MODEL_IDS.get(mid, ""))
    return {"ok": True, "records": records, "malformed": malformed, "error": None}


def antigravity_usage(rows: list[dict], natives: dict, start: float, end: float) -> dict:
    """Read Antigravity conversation DBs for the run's threads, deduplicate by merge IDs across tables
    and threads in deterministic order, and return usage plus completeness flags."""
    out: dict = defaultdict(lambda: defaultdict(zero))
    ok_threads: set[str] = set()
    errors: dict[str, list[str]] = defaultdict(list)
    malformed_threads: set[str] = set()
    approx_in: set[str] = set()
    approx_out: set[str] = set()
    shared: dict[str, str] = {}
    total_malformed = 0

    per_row: list[tuple[int, str, list[str]]] = []
    for order, r in enumerate(rows):
        tid = r["thread"]
        seen_nids: set[str] = set()
        ag_nids: list[str] = []
        for driver, nid in natives.get(tid, []):
            if driver != "antigravity":
                continue
            if not isinstance(nid, str):
                msg = "Antigravity conversation database couldn't be read"
                if msg not in errors[tid]:
                    errors[tid].append(msg)
                continue
            if nid not in seen_nids:
                seen_nids.add(nid)
                ag_nids.append(nid)
        if ag_nids:
            per_row.append((order, tid, ag_nids))

    if not per_row:
        return {"usage": out, "ok": ok_threads, "errors": errors, "malformed_threads": malformed_threads,
                "malformed_total": total_malformed, "approx_in": approx_in, "approx_out": approx_out, "shared": shared}

    dirs, saw_bad_dir = _ag_conv_dirs()
    observations: list[dict] = []
    cached: dict[Path, dict] = {}
    db_owner: dict[Path, str] = {}
    seq = 0

    for order, tid, ag_nids in per_row:
        for nid in ag_nids:
            path, err = _find_ag_db(nid, dirs, saw_bad_dir)
            if err or path is None:
                msg = err or "Antigravity conversation database not found"
                if msg not in errors[tid]:
                    errors[tid].append(msg)
                continue
            try:
                key = path.resolve()
            except OSError:
                msg = "Antigravity conversation database couldn't be read"
                if msg not in errors[tid]:
                    errors[tid].append(msg)
                continue
            if key in cached:
                res = cached[key]
                if not res["ok"]:
                    msg = res["error"] or "Antigravity conversation database couldn't be read"
                    if msg not in errors[tid]:
                        errors[tid].append(msg)
                elif db_owner[key] != tid:
                    shared.setdefault(tid, db_owner[key])
                else:
                    ok_threads.add(tid)
                continue
            res = _read_ag_db(path, str(key))
            cached[key] = res
            db_owner[key] = tid
            total_malformed += res["malformed"]
            if not res["ok"]:
                msg = res["error"] or "Antigravity conversation database couldn't be read"
                if msg not in errors[tid]:
                    errors[tid].append(msg)
                continue
            for rec in res["records"]:
                observations.append(dict(rec, owner_order=order, owner_thread=tid, seq=seq))
                seq += 1
            ok_threads.add(tid)
            if res["malformed"]:
                malformed_threads.add(tid)

    if not observations:
        return {"usage": out, "ok": ok_threads, "errors": errors, "malformed_threads": malformed_threads,
                "malformed_total": total_malformed, "approx_in": approx_in, "approx_out": approx_out, "shared": shared}

    parent = list(range(len(observations)))

    def find(i: int) -> int:
        while parent[i] != i:
            parent[i] = parent[parent[i]]
            i = parent[i]
        return i

    def union(a: int, b: int) -> None:
        ra, rb = find(a), find(b)
        if ra != rb:
            if ra < rb:
                parent[rb] = ra
            else:
                parent[ra] = rb

    key_owner: dict[tuple, int] = {}
    for i, obs in enumerate(observations):
        for k in obs["keys"]:
            if k in key_owner:
                union(i, key_owner[k])
            else:
                key_owner[k] = i

    clusters: dict[int, list[dict]] = defaultdict(list)
    for i, obs in enumerate(observations):
        clusters[find(i)].append(obs)

    for cluster in clusters.values():
        cluster.sort(key=lambda o: (o["owner_order"], o["seq"]))
        owner_tid = cluster[0]["owner_thread"]
        best_ts_pri, best_ts = -1, float("inf")
        model = ""
        inp = cache_read = cache_write = output = 0
        for o in cluster:
            if o["ts_pri"] > best_ts_pri or (o["ts_pri"] == best_ts_pri and o["ts"] < best_ts):
                best_ts_pri, best_ts = o["ts_pri"], o["ts"]
            model = _better_model(model, o["model"])
            inp = max(inp, o["input"])
            cache_read = max(cache_read, o["cache_read"])
            cache_write = max(cache_write, o["cache_write"])
            output = max(output, o["output"])
        if inp + cache_read + cache_write + output == 0:
            continue
        in_span = start <= best_ts <= end
        if best_ts_pri < 3:
            if in_span:
                approx_in.add(owner_tid)
            else:
                approx_out.add(owner_tid)
                continue
        elif not in_span:
            continue
        slot = out[owner_tid][model]
        slot["input"] += inp
        slot["cache_read"] += cache_read
        slot["cache_write"] += cache_write
        slot["output"] += output

    return {"usage": out, "ok": ok_threads, "errors": errors, "malformed_threads": malformed_threads,
            "malformed_total": total_malformed, "approx_in": approx_in, "approx_out": approx_out, "shared": shared}


# ------------------------------------------------------------------------------------------ the run

def harness_of(instance: str | None) -> str:
    i = (instance or "").lower()
    return ("claude-api" if "claude_api" in i else "claude" if i.startswith("claude") else "codex" if i.startswith("codex")
            else "opencode" if i.startswith("opencode") else "antigravity" if i.startswith("antigravity")
            else "copilot" if "copilot" in i else i or "unknown")


def collect(run_dir: Path, orchestrator: str | None, start: float, end: float, tasks: dict) -> dict:
    threads, natives, runs = load_threads(userdata() / "statev2.sqlite")
    children = defaultdict(list)
    for tid, t in threads.items():
        if t["parent"]:
            children[t["parent"]].append(tid)
    rows = []   # one per thread: who it belongs to and its role
    task_threads, added = set(tasks.values()), set()

    def add(tid: str, owner: str, role: str):
        if tid in added:
            return
        added.add(tid)
        t = threads.get(tid, {"title": "", "model": None, "instance": None, "created": None})
        rows.append({"thread": tid, "owner": owner, "role": role, "title": t["title"], "harness": harness_of(t["instance"]),
                     "model": t["model"]})
        for child in sorted(children.get(tid, []), key=lambda c: (threads[c]["created"] or 0, c)):
            if child in task_threads:
                continue   # a task launched with delegate_task: counted as its own task, not as a helper
            created = threads[child]["created"]
            if created is not None and not (start - 60 <= created <= end):
                continue   # a thread from another run on the same parent
            add(child, owner, "reviewer" if REVIEW.search(threads[child]["title"]) else "helper")

    if orchestrator:
        add(orchestrator, "orchestrator", "orchestrator")
    for task_id, tid in sorted(tasks.items()):
        add(tid, task_id, "task")

    wanted = {r["thread"] for r in rows}
    codex_natives = {n: r["thread"] for r in rows for d, n in natives.get(r["thread"], []) if d == "codex"}
    scan = scan_t3_logs(wanted, codex_natives)
    claude, malformed = claude_usage(scan["claude"], start, end)
    malformed += scan["malformed"]
    oc_sessions = {n: r["thread"] for r in rows for d, n in natives.get(r["thread"], []) if d == "opencode"}
    opencode, whole, outside, unreadable = opencode_usage(set(oc_sessions), start, end)
    ag = antigravity_usage(rows, natives, start, end)
    malformed += ag["malformed_total"]

    def flag(l: dict, why: str) -> None:
        """Add a reason the line's figure is partial, keeping the ones it has."""
        if why not in (l.get("missing") or "").split("; "):
            l["missing"] = f"{l['missing']}; {why}" if l.get("missing") else why
    doc, price_source = load_prices()

    def line(r, model, tokens, reported=None):
        entry, name = price_of(model, doc)
        usd = round(priced(tokens, entry), 4) if entry else None
        basis = f"price list: {name}" if entry else "no price for this model"
        if FREE.search(model or ""):
            basis += "; free tier, $0 billed"
        elif (model or "").startswith("opencode-go/"):
            basis += "; OpenCode Go, flat rate"
        out = dict(r, model=model, tokens=tokens, usd=usd, basis=basis, billed=r["harness"] == "claude-api")
        if reported is not None:
            out["reported_usd"] = round(reported, 4)
        if usd is None:
            out["missing"] = f"no price for {model}"
        return out

    lines = []   # one per (thread, model)
    for r in rows:
        mine = []
        for (app, model), slot in claude.items():
            if app == r["thread"]:
                mine.append(line(r, model, slot["tokens"], slot["usd"]))
        for native, app in codex_natives.items():
            if app == r["thread"] and scan["codex"].get(native):
                created = threads.get(app, {}).get("created")
                older = created is not None and created < start - 60
                by_model, baseline = codex_usage(scan["codex"][native], start, end,
                                                 lambda at, app=app: model_at(app, at, threads, runs) or r["model"] or "unknown",
                                                 skip_first=older)
                for model, tokens in by_model.items():
                    mine.append(line(r, model, tokens))
                if older and not baseline:
                    for l in mine:
                        flag(l, "no count from before the run's start (rotated away): its first turn in the run isn't counted")
        for sid, app in oc_sessions.items():
            if app == r["thread"] and opencode.get(sid):
                for model, tokens in opencode[sid].items():
                    mine.append(line(r, r["model"] if model == "unknown" else model, dict(tokens)))
                    if sid in whole:
                        flag(mine[-1], "OpenCode kept only the session's totals (the session lies inside the run)")
                    if sid in unreadable:
                        flag(mine[-1], "some of OpenCode's records for it couldn't be read")
        for model, tokens in ag["usage"].get(r["thread"], {}).items():
            inferred = not model
            chosen = (r["model"] or "unknown") if inferred else model
            mine.append(line(r, chosen, dict(tokens)))
            if inferred and r["model"]:
                flag(mine[-1], "model inferred from the thread's selection")
        if mine:
            for err in ag["errors"].get(r["thread"], []):
                for l in mine:
                    flag(l, err)
            if r["thread"] in ag["malformed_threads"]:
                for l in mine:
                    flag(l, "some of Antigravity's records for it couldn't be read")
            if r["thread"] in ag["approx_in"]:
                for l in mine:
                    flag(l, "Antigravity kept no time for some records: placed by the conversation's start or file time")
            if r["thread"] in ag["approx_out"]:
                for l in mine:
                    flag(l, "some Antigravity records had no time of their own and fell outside the run by conversation or file time")
            if r["thread"] in ag["shared"]:
                for l in mine:
                    flag(l, f"some Antigravity records were already counted under {ag['shared'][r['thread']]}")
        first = scan["file_first"].get(r["thread"])
        created = threads.get(r["thread"], {}).get("created")
        if mine and first is not None and first > max(start, created or start) + 60:
            for l in mine:
                flag(l, "T3's logs for it begin after the run's start (rotated away): earlier turns are missing")
        if not mine and any(app == r["thread"] and sid in opencode and not opencode[sid] and sid not in unreadable for sid, app in oc_sessions.items()):
            lines.append(dict(r, model=r["model"] or "unknown", tokens=zero(), usd=0.0, basis="no tokens used in the run", billed=False))
            continue
        if (not mine and r["thread"] in ag["ok"] and not ag["errors"].get(r["thread"])
                and r["thread"] not in ag["malformed_threads"] and r["thread"] not in ag["approx_out"]
                and r["thread"] not in ag["shared"]):
            lines.append(dict(r, model=r["model"] or "unknown", tokens=zero(), usd=0.0, basis="no tokens used in the run", billed=False))
            continue
        if not mine and any(app == r["thread"] and sid in outside for sid, app in oc_sessions.items()):
            why = "OpenCode kept only its session's totals, which reach outside the run"
            lines.append(dict(r, tokens=None, usd=None, basis="not counted: " + why, missing=why, billed=False))
            continue
        if mine:
            lines += mine
        elif r["thread"].startswith("thread:provider:claudeAgent:native-thread:"):
            # a subagent Claude Code ran inside a task: T3 mirrors it as a thread, and its tokens are
            # already in its parent's result figures
            lines.append(dict(r, tokens=None, usd=None, included=True, basis="in its parent's Claude figures (a Claude Code subagent)", billed=False))
        else:
            why = ("its harness keeps no token counts that can be read" if r["harness"] == "copilot"
                   else "; ".join(ag["errors"][r["thread"]]) if ag["errors"].get(r["thread"])
                   else "Antigravity's records for it couldn't be read" if r["thread"] in ag["malformed_threads"]
                   else f"its conversation's records are counted under {ag['shared'][r['thread']]}" if r["thread"] in ag["shared"]
                   else "Antigravity kept no timestamp for its records and the conversation's start or file time fell outside the run" if r["thread"] in ag["approx_out"]
                   else "Antigravity conversation database not found" if r["harness"] == "antigravity"
                   else "OpenCode's records for it couldn't be read" if any(app == r["thread"] and sid in unreadable for sid, app in oc_sessions.items())
                   else "no usage logged in the span")
            lines.append(dict(r, tokens=None, usd=None, basis="not counted: " + why, missing=why, billed=False))
    return {"run": run_dir.name, "from": datetime.fromtimestamp(start).astimezone().isoformat(timespec="minutes"),
            "to": datetime.fromtimestamp(end).astimezone().isoformat(timespec="minutes"), "price_source": price_source,
            "lines": lines, "malformed": malformed}


def totals(data: dict) -> dict:
    by_model, by_role, by_owner = defaultdict(float), defaultdict(float), defaultdict(float)
    owners: dict = defaultdict(lambda: {"total": 0.0, "roles": defaultdict(float), "models": defaultdict(float), "incomplete": set(), "computers": set()})
    counted, uncounted, reasons = defaultdict(int), defaultdict(int), defaultdict(set)
    by_computer = defaultdict(float)
    for l in data["lines"]:
        if l.get("included"):
            continue
        if l.get("computer"):
            owners[l["owner"]]["computers"].add(l["computer"])
        for why in (l.get("missing") or "").split("; ") if l.get("missing") else []:
            plain = l["usd"] is not None or why.startswith(("no price", "ran on "))
            reasons[why + ("" if plain else f" ({l['harness']})")].add(l["thread"])
            owners[l["owner"]]["incomplete"].add(why)
        if l["usd"] is None:
            uncounted[l["harness"]] += 1
            continue
        counted[l["harness"]] += 1
        by_model[l["model"]] += l["usd"]
        by_role[l["role"]] += l["usd"]
        by_owner[l["owner"]] += l["usd"]
        if l.get("computer"):
            by_computer[l["computer"]] += l["usd"]
        o = owners[l["owner"]]
        o["total"] += l["usd"]
        o["roles"][l["role"]] += l["usd"]
        o["models"][l["model"]] += l["usd"]
    total = sum(by_model.values())
    reported = sum(l.get("reported_usd") or 0 for l in data["lines"])
    return {"total": round(total, 2), "by_model": {k: round(v, 2) for k, v in sorted(by_model.items(), key=lambda kv: -kv[1])},
            "by_role": {k: round(v, 2) for k, v in by_role.items()}, "by_owner": {k: round(v, 2) for k, v in by_owner.items()},
            "owners": {k: {"total": round(v["total"], 2), "roles": {r: round(x, 2) for r, x in v["roles"].items()},
                           "models": {m: round(x, 2) for m, x in sorted(v["models"].items(), key=lambda kv: -kv[1])},
                           "incomplete": sorted(v["incomplete"]), "computers": sorted(v["computers"])} for k, v in owners.items()},
            "threads_counted": dict(counted), "threads_not_counted": dict(uncounted), "claude_reported": round(reported, 2),
            "incomplete": {k: len(v) for k, v in reasons.items()}, "malformed": data.get("malformed", 0),
            "orchestrator_counted": data.get("orchestrator_counted", True),
            "by_computer": {k: round(v, 2) for k, v in by_computer.items()},
            "computers_missing": data.get("computers_missing", {})}


def several(data: dict) -> bool:
    """Whether the run's threads ran on more than one computer, or a computer's costs didn't arrive."""
    return len({l.get("computer") for l in data["lines"] if l.get("computer")}) > 1 or bool(data.get("computers_missing"))


def money(v: float) -> str:
    return f"${v:,.0f}" if v >= 100 else f"${v:,.2f}"


def markdown(data: dict, t: dict) -> str:
    owners = ["orchestrator"] + sorted({l["owner"] for l in data["lines"]} - {"orchestrator"})
    out = [f"| | Total | " + " | ".join(t["by_model"]) + " |", "|---|---|" + "---|" * len(t["by_model"])]
    for owner in owners:
        for role in ("orchestrator", "task", "reviewer", "helper"):
            sel = [l for l in data["lines"] if l["owner"] == owner and l["role"] == role and l["usd"] is not None]
            if not sel:
                continue
            per = defaultdict(float)
            for l in sel:
                per[l["model"]] += l["usd"]
            label = ("Orchestrator" if role == "orchestrator" else f"Task {owner}" if role == "task" else
                     f"Orchestrator's {role}s" if owner == "orchestrator" else f"{owner} {role}s")
            where = sorted({l["computer"] for l in sel if l.get("computer")})
            if several(data) and where:
                label += f" ({', '.join(where)})"
            out.append(f"| {label} | {money(sum(per.values()))} | " + " | ".join(money(per[m]) if per.get(m) else "–" for m in t["by_model"]) + " |")
    out.append(f"| **All** | **{money(t['total'])}** | " + " | ".join(f"**{money(v)}**" for v in t["by_model"].values()) + " |")
    roles = ", ".join(f"{k}s {money(t['by_role'][k])}" if k != "orchestrator" else f"orchestrator {money(t['by_role'][k])}"
                      for k in ("orchestrator", "task", "reviewer", "helper") if t["by_role"].get(k))
    models = ", ".join(f"{m} {money(v)}" for m, v in t["by_model"].items())
    gaps = [f"{why}: {n} thread{'s' if n != 1 else ''}" for why, n in t["incomplete"].items()]
    if t.get("malformed"):
        gaps.append(f"{t['malformed']} malformed log record(s) skipped")
    paragraph = (f"Cost at API prices (estimate): {money(t['total'])} — what the run's tokens would have cost at the providers' "
                 f"API list prices, not what the subscriptions cost. By role: {roles}. By model: {models}."
                 + (" By computer: " + ", ".join(f"{c} {money(v)}" for c, v in sorted(t["by_computer"].items(), key=lambda kv: -kv[1])) + "."
                    if several(data) and t.get("by_computer") else "")
                 + "".join(f" {c}'s costs didn't arrive, so task{'s' if len(ids) > 1 else ''} {', '.join(ids)} and {'their' if len(ids) > 1 else 'its'}"
                           f" reviewers and helpers aren't counted." for c, ids in sorted((t.get("computers_missing") or {}).items()))
                 + (" Incomplete: " + "; ".join(gaps) + "." if gaps else " Every thread was counted.")
                 + ("" if data.get("orchestrator_counted", True) else " The orchestrator's own tokens are not counted (no thread given).")
                 + f" Prices: {data['price_source']}, for every provider, as T3 Code prices its usage"
                 + (f" (Claude Code's own figure for the Claude tokens: {money(t['claude_reported'])})." if t.get("claude_reported") else "."))
    return "\n".join(out) + "\n\n" + paragraph + "\n"


NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")


def this_computer() -> str | None:
    import subprocess
    for command in (["scutil", "--get", "LocalHostName"], ["hostname", "-s"]):
        try:
            out = subprocess.run(command, capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.SubprocessError):
            continue
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout.strip()
    return None


def costs_line(l) -> bool:
    """Whether l has what the totals and the table read, of the right kinds: text for who and where, a model's
    name or none, and dollars as a number or none (not counted)."""
    text = lambda v: isinstance(v, str) and v != ""
    usd = l.get("usd") if isinstance(l, dict) else None
    reported = l.get("reported_usd") if isinstance(l, dict) else None
    money = lambda v: v is None or isinstance(v, (int, float)) and not isinstance(v, bool) and v == v and abs(v) != float("inf")
    return (isinstance(l, dict) and all(text(l.get(k)) for k in ("owner", "thread", "role", "harness")) and "usd" in l
            and "model" in l and (isinstance(l["model"], str) and l["model"] != "" or l["model"] is None and usd is None)
            and money(usd) and money(reported)
            and (l.get("missing") is None or isinstance(l["missing"], str)))


def merge_computers(data: dict, run_dir: Path, own: str | None, watch: dict) -> None:
    """Adds each other computer's costs (<run directory>/computers/<name>/costs.json) to data: its lines
    replace this computer's for the tasks that ran there and for the threads it counted, and a computer
    tasks ran on whose file didn't arrive is named in data["computers_missing"] with those tasks."""
    placed = {str(k): v.get("computer") for k, v in (watch.get("tasks") or {}).items()
              if isinstance(v, dict) and isinstance(v.get("computer"), str) and v.get("computer") != own}
    arrived: dict[str, list] = {}
    folder = run_dir / "computers"
    for path in sorted(folder.glob("*/costs.json")) if folder.is_dir() else []:
        name = path.parent.name
        if not NAME.fullmatch(name) or name == own:
            continue
        try:
            other = json.loads(path.read_text())
            lines = other.get("lines") if isinstance(other, dict) else None
            if not isinstance(lines, list) or not all(costs_line(l) for l in lines):
                raise ValueError("its lines aren't run-costs lines")
        except (OSError, ValueError) as e:
            print(f"run-costs: can't read {path} ({e}); {name}'s costs are left out", file=sys.stderr)
            continue
        arrived[name] = [dict(l, computer=name) for l in lines]
        data["malformed"] = data.get("malformed", 0) + (other.get("malformed") or 0 if isinstance(other.get("malformed"), int) else 0)
    theirs = {l["thread"] for lines in arrived.values() for l in lines}
    # a task counts as brought over only when its computer's file has it: a file made without one of its
    # --task options leaves that task named, not dropped
    # (from whichever computer's folder: a name spelled otherwise than in watch.json still counts)
    sent_by = {l["owner"]: name for name, lines in arrived.items() for l in lines}
    moved = {task for task in placed if task in sent_by}
    data["lines"] = [l for l in data["lines"] if l["thread"] not in theirs and l["owner"] not in moved]
    for lines in arrived.values():
        data["lines"] += lines
    missing: dict[str, list] = {}
    for task, name in sorted(placed.items()):
        if task in moved:
            continue
        if name in arrived:
            why = f"ran on {name}, whose costs leave it out"
            for l in data["lines"]:
                if l["owner"] == task:
                    l.update(computer=name, tokens=None, usd=None, basis="not counted: " + why, missing=why)
                    l.pop("reported_usd", None)
            continue
        missing.setdefault(name, []).append(task)
        why = f"ran on {name}, whose costs didn't arrive"
        for l in data["lines"]:
            if l["owner"] == task:
                l.update(computer=name, tokens=None, usd=None, basis="not counted: " + why, missing=why)
                l.pop("reported_usd", None)
    data["computers_missing"] = missing
    if arrived:
        data["computers"] = sorted({own or "this computer", *arrived})


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="run-costs", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("run")
    parser.add_argument("--orchestrator")
    parser.add_argument("--from", dest="start")
    parser.add_argument("--to", dest="end")
    parser.add_argument("--task", action="append", default=[], metavar="ID=THREAD")
    parser.add_argument("--computer")
    parser.add_argument("--json")
    parser.add_argument("--markdown")
    args = parser.parse_args(argv)
    run_dir = Path(args.run)
    named = {}
    for pair in args.task:
        task, _, thread = pair.partition("=")
        if not task or not thread:
            print(f"run-costs: --task takes <task ID>=<thread ID>, not {pair!r}", file=sys.stderr)
            return 2
        named[task] = thread
    try:
        watch = json.loads((run_dir / "watch.json").read_text())
    except (OSError, ValueError) as e:
        if not named:
            print(f"run-costs: can't read {run_dir / 'watch.json'}: {e}", file=sys.stderr)
            return 2
        watch = {}   # a run's other computer: its tasks come from --task
    if not isinstance(watch, dict):
        print(f"run-costs: {run_dir / 'watch.json'} doesn't hold a JSON object", file=sys.stderr)
        return 2
    start = stamp(args.start or watch.get("started"))
    end = stamp(args.end or watch.get("finished")) or time.time()
    if start is None:
        print("run-costs: no start: give --from or watch.json's started", file=sys.stderr)
        return 2
    orchestrator = args.orchestrator or watch.get("orchestrator_thread")
    tasks = named or {str(k): v.get("thread") for k, v in (watch.get("tasks") or {}).items() if isinstance(v, dict) and v.get("thread")}
    own = args.computer or (watch.get("computer") if isinstance(watch.get("computer"), str) else None) or this_computer()
    try:
        data = collect(run_dir, orchestrator, start, end, tasks)
    except (sqlite3.Error, OSError) as e:
        print(f"run-costs: T3 Code's records at {userdata()} can't be read ({e}); this works only for a run under T3", file=sys.stderr)
        return 2
    data["computer"] = own
    for l in data["lines"]:
        l["computer"] = own
    merge_computers(data, run_dir, own, watch)
    data["orchestrator_counted"] = bool(orchestrator)
    data["totals"] = totals(data)
    text = markdown(data, data["totals"])
    data["table"], data["paragraph"] = text.split("\n\n", 1)[0], text.split("\n\n", 1)[1].strip()
    if args.json:
        Path(args.json).write_text(json.dumps(data, indent=1) + "\n")
    if args.markdown:
        Path(args.markdown).write_text(text)
    print(text, end="")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
