#!/usr/bin/env python3
"""The orchestrator's first check on every wake: reads files and processes only (no model, no
network) and prints one line per finding, nothing when all is well. SKILL.md ("On every wake",
step 2) says what to do with each line.

Usage: run-watch <run directory> [--watch <file>]

It reads <run directory>/watch.json (or --watch), which the orchestrator writes in Prepare and
adds each task to at launch:

  {"started": "<the run's start, ISO 8601>", "repo": "<integration checkout>",
   "integration_branch": "main", "keep_awake_pid": 123, "sampler_pid": 456,
   "tasks": {"A": {"worktree": "<path>", "harness": "claude-code|codex|<other>",
                   "session": "<optional session ID>", "session_log": "<optional log path>",
                   "thread": "<T3 thread or agent ID>", "branch": "task/a-x",
                   "launched": "<ISO 8601>", "status": "running"}}}

Only tasks whose "status" is "running" (or absent) are checked for hangs and quiet; the times
below are printed for every task.

Each line starts with a word saying what it is:

  hang <task>      a running task's tool call with no result for over 6 minutes whose own
                   processes (those started with the call, and what they started) used no CPU
                   over those 6 minutes, are idle now (no CPU or GPU in ps's last-minute average
                   and a 2-second sample), started nothing and wrote nothing, and hold no network
                   connection; it names the call, its process IDs and the kill that stops them
                   (no kill when calls that started together share the processes)
  idle <task>      the same call idle now, with nothing written or started for 6 minutes, but it
                   used CPU earlier in that time or holds a network connection: look, don't stop it
                   yet; the next wake says hang if it stays idle
  approval <task>  a running task's shell call open over 6 minutes with no process for it: an
                   approval prompt, or a hang before the command started
  quiet <task>     a running task whose session log, worktree and run folder haven't changed for
                   20 minutes and whose processes are idle
  blind <task>     (once per task) a running task whose session log this script can't read (a
                   harness it doesn't know, or a log it didn't find): it sees only that task's
                   processes and files
  hog <pid>        a process started since the run began, not the run's, above 80% of a core for
                   10 minutes
  disk / swap      free disk fell 10 GB within 5 minutes, or is below 20 GB; swap above 20 GB
  dialog           a password dialog (SecurityAgent) is up
  keep-awake / sampler   the recorded keep-awake or usage sampler isn't running
  commit / merged / report <task> <time>   the exact time of each new commit made in a task's
                   worktree, of each merge of its branch into the integration branch, and of each
                   report-back it sent, once each, for the ledger
  note             watch.json is missing or unreadable (the machine checks still ran)

What it reads:
  - a task's session log: watch.json's "session_log" when given (a Claude Code subagent's
    <session>/subagents/agent-<agent ID>.jsonl), else Claude Code's ~/.claude/projects/<worktree path, every character but
    letters and digits as "-">/<session>.jsonl (the session is watch.json's "session", else the
    --session-id or --resume of a `claude` process working in the worktree, which is how T3 starts
    one, else the first log made there after the launch), with its subagents' logs; Codex's
    ~/.codex/sessions rollout whose session_meta names the worktree (not one of `codex exec`,
    which reviewers use). CLAUDE_CONFIG_DIR and CODEX_HOME move these.
  - processes (ps, lsof for working folders, ioreg for each process's GPU time, sysctl for swap)
  - files' modification times under the worktree (with its git folder), the task's run folder
    and its session folder, never their contents
  - git reflogs: the worktree's HEAD for commits, the integration branch's for merges
  - <run directory>/usage/machine.jsonl, when the usage sampler writes it, for the disk's fall

A shell call is one the harness runs a command for: Claude Code's Bash (and a Bash call the
harness moved to the background when it timed out, until its notification arrives); Codex's
shell, exec_command or exec. Waits are never a hang: calls that wait on a thread, an agent or a
task (t3_thread_wait, delegate_task, wait_agent, Agent…), a call whose `lease` still waits for its
turn (one that holds it and runs a command is judged by that command), a call running an agent's
command line (a reviewer: codex, claude, opencode, gemini, agy, copilot), and a call that keeps
starting processes (a sleep loop) or writes files.

It writes only its state file, <run directory>/run-watch.state.json, to compare with its last
run (CPU samples for the hog check, the disk's recent readings, the times it already printed). It exits 0 (2 for a
usage error), whether or not it printed anything. For tests, RUN_WATCH_HANG_MINUTES,
RUN_WATCH_QUIET_MINUTES, RUN_WATCH_HOG_MINUTES, RUN_WATCH_SAMPLE_SECONDS, RUN_WATCH_CALL_START_SECONDS, RUN_WATCH_PS, RUN_WATCH_IOREG,
RUN_WATCH_SWAP_GB and RUN_WATCH_DISK_FREE_GB change its thresholds and inputs.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone

HANG_MIN = float(os.environ.get("RUN_WATCH_HANG_MINUTES", 6))
QUIET_MIN = float(os.environ.get("RUN_WATCH_QUIET_MINUTES", 20))
HOG_MIN = float(os.environ.get("RUN_WATCH_HOG_MINUTES", 10))
HOG_SHARE = 0.8              # of one core
IDLE_SHARE = 0.02            # a call's processes below 2% of a core count as using no CPU
BUSY_SHARE = 0.05            # a task's processes at 5% of a core or more are working
CALL_START_S = float(os.environ.get("RUN_WATCH_CALL_START_SECONDS", 60))  # a call's own processes start this soon
SAMPLE_S = float(os.environ.get("RUN_WATCH_SAMPLE_SECONDS", 2))
DISK_DROP_GB, DISK_DROP_MIN, DISK_LOW_GB, SWAP_GB = 10, 5, 20, 20
KEEP_SAMPLES_S = 2 * 3600

WAIT_TOOL = re.compile(r"(^|__)(t3_thread_wait|t3_background_wait|delegate_task|task_status|wait_agent|"
                       r"wait|Agent|Task|TaskOutput|Workflow|spawn_agent|resume_agent)$")
CLAUDE_SHELL = {"Bash"}
CODEX_SHELL = {"shell", "shell_command", "exec_command", "exec", "local_shell", "container.exec",
               "unified_exec"}
AGENT_CLIS = {"codex", "claude", "opencode", "gemini", "agy", "copilot", "cursor-agent", "ccs"}
REPORT = "[long-horizon-orchestrator]"
DIALOG = "SecurityAgent"


def now() -> float:
    return time.time()


def iso(t: float) -> str:
    return datetime.fromtimestamp(t).astimezone().isoformat(timespec="seconds")


def hm(t: float) -> str:
    return datetime.fromtimestamp(t).astimezone().strftime("%H:%M:%S")


def parse_time(s) -> float | None:
    if not s:
        return None
    try:
        return datetime.fromisoformat(str(s).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def run(cmd: list[str], timeout: float = 10) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                              env=dict(os.environ, LC_ALL="C")).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def short(text: str, n: int = 90) -> str:
    text = " ".join(str(text).split())
    return text if len(text) <= n else text[: n - 1] + "…"


# ---------------------------------------------------------------- processes

def cpu_seconds(s: str) -> float:
    days = 0
    if "-" in s:
        d, s = s.split("-", 1)
        days = int(d)
    parts = [float(p) for p in s.split(":")]
    secs = 0.0
    for p in parts:
        secs = secs * 60 + p
    return days * 86400 + secs


def processes() -> dict:
    """pid -> {ppid, pcpu, cpu (seconds), start (epoch), args}"""
    ps = os.environ.get("RUN_WATCH_PS", "ps")
    out = run([ps, "-axww", "-o", "pid=,ppid=,pcpu=,time=,lstart=,args="])
    procs = {}
    for line in out.splitlines():
        f = line.split(None, 9)
        if len(f) < 9:
            continue
        try:
            pid, ppid, pcpu, cpu = int(f[0]), int(f[1]), float(f[2]), cpu_seconds(f[3])
            start = time.mktime(time.strptime(" ".join(f[4:9]), "%a %b %d %H:%M:%S %Y"))
        except ValueError:
            continue
        args = f[9] if len(f) > 9 else ""
        procs[pid] = {"ppid": ppid, "pcpu": pcpu, "cpu": cpu, "start": start, "args": args,
                      "exe": os.path.basename(args.split(" ", 1)[0])}
    for line in run([ps, "-axww", "-o", "pid=,comm="]).splitlines():
        f = line.strip().split(None, 1)
        if len(f) == 2 and f[0].isdigit() and int(f[0]) in procs:
            procs[int(f[0])]["exe"] = os.path.basename(f[1])
    return procs


def key(pid: int, p: dict) -> str:
    return f"{pid}@{int(p['start'])}"


def working_folders() -> dict:
    """pid -> working folder, from lsof (about a second for every process)."""
    out = run(["lsof", "-a", "-d", "cwd", "-Fpn"], timeout=40)
    cwd, pid = {}, None
    for line in out.splitlines():
        if line.startswith("p"):
            pid = int(line[1:]) if line[1:].isdigit() else None
        elif line.startswith("n") and pid is not None:
            cwd[pid] = line[1:]
    return cwd


def gpu_times() -> dict:
    """pid -> GPU time used so far (ns), summed over its Metal clients (ioreg's AppUsage)."""
    out = run([os.environ.get("RUN_WATCH_IOREG", "ioreg"), "-r", "-k", "AppUsage", "-w0", "-d1"])
    times, block = {}, []
    for line in out.splitlines() + ["+-o"]:
        if "+-o" in line and block:
            text = "\n".join(block)
            m = re.search(r'"IOUserClientCreator" = "pid (\d+),', text)
            if m:
                total = sum(int(x) for x in re.findall(r'"accumulatedGPUTime"=(\d+)', text))
                times[int(m.group(1))] = times.get(int(m.group(1)), 0) + total
            block = []
        block.append(line)
    return times


def agent_cli(p: dict) -> bool:
    """An agent's command line (a reviewer), run directly or by its interpreter (node …/codex)."""
    words = p["args"].split()[:2]
    return exe(p) in AGENT_CLIS or any(os.path.basename(w) in AGENT_CLIS for w in words)


def children_map(procs: dict) -> dict:
    kids = {}
    for pid, p in procs.items():
        kids.setdefault(p["ppid"], []).append(pid)
    return kids


def descendants(roots, kids: dict) -> set:
    seen, todo = set(), list(roots)
    while todo:
        pid = todo.pop()
        if pid in seen:
            continue
        seen.add(pid)
        todo.extend(kids.get(pid, []))
    return seen


def inside(path: str, folder: str) -> bool:
    return bool(folder) and (path == folder or path.startswith(folder.rstrip("/") + "/"))


def exe(p) -> str:
    """A process's program name (its executable's file name)."""
    return p.get("exe", "") if isinstance(p, dict) else os.path.basename(str(p).split(" ", 1)[0])


# ---------------------------------------------------------------- session logs

def claude_home() -> str:
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")


def codex_home() -> str:
    return os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex")


def claude_project(worktree: str) -> str:
    return os.path.join(claude_home(), "projects", re.sub(r"[^A-Za-z0-9]", "-", worktree))


def session_from_process(worktree: str, procs: dict, cwd: dict) -> str | None:
    for pid, p in procs.items():
        if exe(p) != "claude" or not inside(cwd.get(pid, ""), worktree):
            continue
        m = re.search(r"--(?:session-id|resume)[= ]([0-9a-f-]{36})", p["args"])
        if m:
            return m.group(1)
    return None


def first_time(path: str) -> float | None:
    try:
        with open(path, errors="replace") as f:
            for _, line in zip(range(50), f):
                m = re.search(r'"timestamp":\s*"([^"]+)"', line)
                if m:
                    return parse_time(m.group(1))
    except OSError:
        pass
    return None


def find_claude_log(task: dict, launched: float, procs: dict, cwd: dict, remembered: str | None):
    folder = claude_project(task["worktree"])
    session = task.get("session") or session_from_process(task["worktree"], procs, cwd)
    if session:
        path = os.path.join(folder, session + ".jsonl")
        if os.path.exists(path):
            return path
    if remembered and os.path.exists(remembered):
        return remembered
    try:
        logs = [os.path.join(folder, n) for n in os.listdir(folder) if n.endswith(".jsonl")]
    except OSError:
        return None
    dated = [(first_time(p), p) for p in logs if os.path.getmtime(p) >= launched - 60]
    dated = [(t, p) for t, p in dated if t is not None and t >= launched - 120]
    return min(dated)[1] if dated else None


def find_codex_log(task: dict, launched: float, remembered: str | None):
    if remembered and os.path.exists(remembered):
        return remembered
    root = os.path.join(codex_home(), "sessions")
    want = os.path.realpath(task["worktree"])
    found = []
    day = launched - 86400
    while day <= now() + 86400:
        folder = os.path.join(root, time.strftime("%Y/%m/%d", time.localtime(day)))
        day += 86400
        try:
            names = os.listdir(folder)
        except OSError:
            continue
        for name in names:
            path = os.path.join(folder, name)
            if not name.endswith(".jsonl") or os.path.getmtime(path) < launched - 60:
                continue
            if task.get("session") and task["session"] not in name:
                continue
            try:
                with open(path, errors="replace") as f:
                    meta = json.loads(f.readline()).get("payload", {})
            except (OSError, ValueError):
                continue
            cwd = meta.get("cwd")
            if not cwd or os.path.realpath(cwd) != want or meta.get("originator") == "codex_exec":
                continue
            started = parse_time(meta.get("timestamp")) or os.path.getmtime(path)
            if started >= launched - 120:
                found.append((started, path))
    return min(found)[1] if found else None


def claude_calls(path: str) -> tuple[dict, list]:
    """Open calls (id -> call) and report-backs in a Claude Code log."""
    calls, reports, backgrounded, notified = {}, [], {}, set()
    try:
        f = open(path, errors="replace")
    except OSError:
        return {}, []
    with f:
        for line in f:
            if '"tool_' not in line and "task-notification" not in line:
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            t = parse_time(e.get("timestamp"))
            content = (e.get("message") or {}).get("content")
            if isinstance(content, str):
                notified.update(re.findall(r"<tool-use-id>([^<]+)</tool-use-id>", content))
                continue
            if not isinstance(content, list):
                continue
            for c in content:
                if not isinstance(c, dict):
                    continue
                if c.get("type") == "tool_use" and t:
                    inp = c.get("input") or {}
                    text = inp.get("command") or inp.get("description") or inp.get("prompt") or json.dumps(inp)
                    calls[c.get("id")] = {"start": t, "tool": c.get("name", ""), "text": str(text),
                                          "shell": c.get("name") in CLAUDE_SHELL,
                                          "bg": bool(inp.get("run_in_background"))}
                    blob = json.dumps(inp)
                    if REPORT in blob:
                        m = re.search(r"status=(\w+)", blob)
                        reports.append((c.get("id"), t, m.group(1) if m else "?"))
                elif c.get("type") == "tool_result":
                    cid = c.get("tool_use_id")
                    call = calls.get(cid)
                    body = c.get("content")
                    body = body if isinstance(body, str) else json.dumps(body)
                    if call and call["shell"] and not call["bg"] and body.startswith("Command running in background"):
                        out = re.search(r"written to: (\S+?\.output)", body)
                        call["output"] = out.group(1) if out else None
                        backgrounded[cid] = call          # moved to the background on its timeout
                    calls.pop(cid, None)
                    if isinstance(c.get("content"), list) or isinstance(c.get("content"), str):
                        notified.update(re.findall(r"<tool-use-id>([^<]+)</tool-use-id>", body))
    for cid, call in backgrounded.items():
        if cid not in notified:
            calls[cid] = call
    return calls, reports


def codex_calls(path: str) -> tuple[dict, list]:
    calls, reports = {}, []
    try:
        f = open(path, errors="replace")
    except OSError:
        return {}, []
    with f:
        for line in f:
            if "call" not in line:
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            p = e.get("payload") or {}
            kind, t = p.get("type", ""), parse_time(e.get("timestamp"))
            if kind in ("function_call", "custom_tool_call", "local_shell_call") and t:
                name = p.get("name") or "local_shell"
                text = p.get("arguments") or p.get("input") or json.dumps(p.get("action") or {})
                cmd = re.search(r'"(?:cmd|command)"\s*:\s*("(?:[^"\\]|\\.)*"|\[[^\]]*\])', str(text))
                calls[p.get("call_id")] = {"start": t, "tool": name, "text": cmd.group(1) if cmd else str(text),
                                           "shell": name in CODEX_SHELL, "bg": False}
                if REPORT in str(text):
                    m = re.search(r"status=(\w+)", str(text))
                    reports.append((p.get("call_id"), t, m.group(1) if m else "?"))
            elif kind.endswith("_output"):
                calls.pop(p.get("call_id"), None)
    return calls, reports


# ---------------------------------------------------------------- files

def git_dir(worktree: str) -> str | None:
    try:
        with open(os.path.join(worktree, ".git")) as f:
            line = f.read().strip()
        if line.startswith("gitdir:"):
            return line.split(":", 1)[1].strip()
    except OSError:
        pass
    return None


def changed_within(paths, seconds: float, skip=()) -> bool:
    """Whether anything under the paths was modified in the last `seconds` (find, quick)."""
    paths = [p for p in paths if p and os.path.lexists(p)]
    if not paths:
        return False
    cmd = ["find"] + paths
    for path in skip:
        if path:
            cmd += ["-path", path, "-prune", "-o"]
    cmd += ["-mtime", f"-{max(1, int(seconds))}s", "-print", "-quit"]
    return bool(run(cmd, timeout=30).strip())


# ---------------------------------------------------------------- state

def load_json(path: str):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save_state(path: str, state: dict) -> None:
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.replace(tmp, path)


def rate_since(samples: list, cpu_now: float, t_now: float, window_s: float):
    """CPU share over the newest sample at least window_s old, or None."""
    old = [s for s in samples if t_now - s[0] >= window_s]
    if not old:
        return None
    t0, c0 = old[-1][0], old[-1][1]
    return max(0.0, cpu_now - c0) / max(1.0, t_now - t0)


# ---------------------------------------------------------------- the checks

def main(argv: list[str]) -> int:
    args = list(argv)
    watch_path = None
    if "--watch" in args:
        i = args.index("--watch")
        if i + 1 >= len(args):
            print(__doc__.split("\n\n")[1], file=sys.stderr)
            return 2
        watch_path = args[i + 1]
        del args[i:i + 2]
    if len(args) != 1 or args[0].startswith("-") or not os.path.isdir(args[0]):
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    run_dir = os.path.abspath(args[0])
    watch_path = watch_path or os.path.join(run_dir, "watch.json")
    state_path = os.path.join(run_dir, "run-watch.state.json")
    state = load_json(state_path) or {}
    watch = load_json(watch_path)
    lines: list[str] = []
    t0 = now()

    if not isinstance(watch, dict):
        lines.append(f"note: no readable {watch_path}: tasks aren't watched (launch adds them); the machine checks ran")
        watch = {}
    tasks = {k: v for k, v in (watch.get("tasks") or {}).items() if isinstance(v, dict) and v.get("worktree")}
    started = parse_time(watch.get("started"))
    if started is None:
        try:
            started = parse_time(open(os.path.join(run_dir, "usage", "run-start")).read().strip())
        except OSError:
            pass
    if started is None:
        st = os.stat(run_dir)
        started = getattr(st, "st_birthtime", st.st_mtime)

    procs = processes()
    gpu = gpu_times()
    kids = children_map(procs)
    cwd = working_folders() if tasks else {}
    if tasks and not cwd:
        lines.append("note: lsof gave no working folders (timed out?), so the tasks' calls weren't judged this time; run it again")
    samples = state.get("samples", {})
    me = {os.getpid()}

    # Every task's processes: those working in its worktree or run folder, and what they started.
    run_paths = [run_dir] + [v["worktree"] for v in tasks.values()]
    if watch.get("repo"):
        run_paths.append(watch["repo"])
    task_procs = {}
    for tid, task in tasks.items():
        folders = (task["worktree"], os.path.join(run_dir, tid))
        roots = [pid for pid, c in cwd.items() if any(inside(c, f) for f in folders) and pid in procs]
        task_procs[tid] = descendants(roots, kids)
    runs_own = set().union(*task_procs.values()) if task_procs else set()
    for pid, p in procs.items():
        if any(path in p["args"] for path in run_paths if path) or any(inside(cwd.get(pid, ""), path) for path in run_paths if path):
            runs_own.add(pid)
    for name in ("keep_awake_pid", "sampler_pid"):
        if isinstance(watch.get(name), int):
            runs_own.add(watch[name])
    runs_own = descendants(runs_own, kids) | me

    # Per task: its log, its open calls, its files.
    findings = {}
    sessions = state.get("sessions", {})
    blind_told = set(state.get("blind", []))
    reports_by_task = {}
    for tid, task in tasks.items():
        launched = parse_time(task.get("launched")) or started
        harness = str(task.get("harness", "")).lower()
        kind = "claude" if "claude" in harness else "codex" if "codex" in harness else None
        log = task.get("session_log") if os.path.isfile(str(task.get("session_log") or "")) else None
        if log:
            pass
        elif kind == "claude":
            log = find_claude_log(task, launched, procs, cwd, sessions.get(tid))
        elif kind == "codex":
            log = find_codex_log(task, launched, sessions.get(tid))
        running = task.get("status", "running") == "running"
        if log:
            sessions[tid] = log
        elif tid not in blind_told and task.get("status", "running") == "running":
            why = "no session log this script reads" if kind is None else "its session log wasn't found (give its session_log in watch.json)"
            lines.append(f"blind {tid} ({task.get('harness') or 'unknown harness'}): {why}; "
                         "it sees only the task's processes and files, so read its thread for stuck calls")
            blind_told.add(tid)
        calls, reports, logs = {}, [], []
        if log:
            logs = [log]
            sub = os.path.join(os.path.splitext(log)[0], "subagents")
            if kind == "claude" and os.path.isdir(sub) and "/subagents/" not in log:
                logs += [os.path.join(sub, n) for n in os.listdir(sub) if n.endswith(".jsonl")]
            for path in logs:
                c, r = (claude_calls if kind == "claude" else codex_calls)(path)
                calls.update(c)
                reports += r
        reports_by_task[tid] = reports
        if kind == "codex" and log:
            # T3 starts a `codex app-server` per thread; its commands are its descendants, whatever
            # folder they cd into.
            opened = first_time(log) or launched
            servers = [pid for pid, p in procs.items() if exe(p) == "codex" and " app-server" in p["args"]
                       and (abs(p["start"] - opened) <= 30 or task_procs[tid] & descendants([pid], kids))]
            task_procs[tid] |= descendants(servers, kids)
        if not running:
            continue
        session_dir = os.path.splitext(log)[0] if log else None
        gdir = git_dir(task["worktree"])
        watched = [task["worktree"], os.path.join(run_dir, tid), session_dir, gdir]
        watched += [c.get("output") for c in calls.values() if c.get("output")]
        log_time = max((os.path.getmtime(p) for p in logs if os.path.exists(p)), default=0.0)
        wrote = changed_within(watched, HANG_MIN * 60, skip=[log])
        quiet = not wrote and now() - log_time > QUIET_MIN * 60 and not changed_within(watched, QUIET_MIN * 60, skip=[log])
        findings[tid] = {"calls": calls, "wrote": wrote, "quiet": quiet, "log": log_time, "kind": kind}

    # Calls old enough to judge, and whether a second look at the CPU is needed.
    t_now = now()
    hang_s, quiet_s = HANG_MIN * 60, QUIET_MIN * 60
    need_sample = False
    for tid, f in findings.items():
        f["old"] = [(cid, c) for cid, c in f["calls"].items()
                    if t_now - c["start"] > hang_s and not WAIT_TOOL.search(c["tool"])]
        need_sample |= bool(f["old"]) or f["quiet"]
    procs2, gpu2 = procs, gpu
    if need_sample and SAMPLE_S > 0:
        time.sleep(SAMPLE_S)
        procs2, gpu2 = processes(), gpu_times()
    t_now2 = now()
    kids2 = children_map(procs2)

    def recent_cpu(pid: int) -> float:
        """A live process's CPU share now: ps's average over about the last minute, and what it
        used in the short sample just taken. (An older sample can't show it was busy lately: it
        would count work from before a hang.)"""
        p, p2 = procs.get(pid), procs2.get(pid)
        if not p or not p2 or p2["start"] != p["start"]:
            return 0.0
        short_share = max(0.0, p2["cpu"] - p["cpu"]) / max(0.1, t_now2 - t_now) if procs2 is not procs else 0.0
        return max(short_share, p2["pcpu"] / 100 if p2["pcpu"] >= 1 else 0.0)

    def gpu_moved(pid: int) -> bool:
        return pid in gpu and gpu2.get(pid, 0) > gpu[pid]

    def call_processes(c: dict, tp: set) -> set:
        """The processes of one call: those of the task started within a minute of the call (the
        topmost of them), and everything they started since. A process of another call, started
        earlier or later, isn't counted."""
        near = {pid for pid in tp if c["start"] - 5 <= procs[pid]["start"] <= c["start"] + CALL_START_S}
        roots = [pid for pid in near if procs[pid]["ppid"] not in near]
        return descendants(roots, kids) & set(procs)

    def is_lease(pid: int) -> bool:
        return exe(procs[pid]) == "lease" or bool(re.search(r"/lease\s+(acquire|run)\b", procs[pid]["args"]))

    def idle_all_window(pid: int) -> bool:
        """Whether the process used (almost) no CPU over the whole hang window: from an earlier
        sample at least that old, else from all it used since it started."""
        p = procs[pid]
        share = rate_since(samples.get(key(pid, p), []), p["cpu"], t_now, hang_s)
        if share is None:
            share = p["cpu"] / max(1.0, t_now - p["start"] - 1)
        return share < IDLE_SHARE

    def on_network(pids) -> bool:
        out = run(["lsof", "-a", "-nP", "-iTCP", "-sTCP:ESTABLISHED", "-p", ",".join(map(str, pids))], timeout=15)
        return len(out.splitlines()) > 1

    for tid, f in findings.items() if cwd else []:
        tp = task_procs.get(tid, set())
        hung_or_waiting = False
        judged = []
        for cid, c in sorted(f["old"], key=lambda x: x[1]["start"]):
            mins = (t_now - c["start"]) / 60
            if not c["shell"]:
                if not f["wrote"]:
                    lines.append(f"hang {tid}: {c['tool']} call open {mins:.0f} min (since {hm(c['start'])}), nothing written for "
                                 f"{HANG_MIN:g} min: {short(c['text'])} (no process of its own; read its thread, and interrupt the turn if it is stuck)")
                    hung_or_waiting = True
                continue
            mine = call_processes(c, tp)
            if not mine:
                lines.append(f"approval {tid}: {c['tool']} call open {mins:.0f} min (since {hm(c['start'])}) with no process running for it: "
                             f"{short(c['text'])} (an approval prompt or a hang before it started; read its thread's pending request, "
                             "interrupt the turn and tell the task how to finish without it)")
                hung_or_waiting = True
                continue
            # A lease still waiting for its turn, or a reviewer's command line, is a wait with its own
            # limit. A lease that holds its turn and runs a command is judged by that command.
            leases = [pid for pid in mine if is_lease(pid)]
            waiting = [pid for pid in leases if not [k for k in kids.get(pid, []) if k in procs
                                                     and "grace, ends, margin" not in procs[k]["args"]]]
            if waiting or any(agent_cli(procs[pid]) for pid in mine):
                hung_or_waiting = True
                continue
            work = {pid for pid in mine if not is_lease(pid) and "grace, ends, margin" not in procs[pid]["args"]}
            later = descendants([pid for pid in work if pid in procs2], kids2)
            if any(t_now - procs[pid]["start"] < hang_s for pid in work) or \
                    any(t_now - procs2[pid]["start"] < hang_s for pid in later if pid in procs2):
                continue                    # it keeps starting processes: a loop that is working
            if f["wrote"]:
                continue                    # something was written
            if sum(recent_cpu(pid) for pid in work) >= IDLE_SHARE or any(gpu_moved(pid) for pid in work):
                continue
            alive = sorted(pid for pid in work if pid in procs2)
            if alive:
                judged.append((c, alive, mins))
        claimed = {}
        for c, alive, _ in judged:
            for pid in alive:
                claimed[pid] = claimed.get(pid, 0) + 1
        for c, alive, mins in judged:
            names = short(", ".join(exe(procs[p]) for p in alive), 60)
            head = (f"{c['tool']} call open {mins:.0f} min (since {hm(c['start'])}): {short(c['text'])}; "
                    f"pids {' '.join(map(str, alive))} ({names})")
            network = on_network(alive)
            if network or not all(idle_all_window(pid) for pid in alive):
                why = "it holds a network connection" if network else "it used CPU earlier in that time"
                lines.append(f"idle {tid}: {head}: idle now and nothing written or started for {HANG_MIN:g} min, but {why}: "
                             "look at the call and its thread; don't stop it yet (a later wake says hang if it stays idle)")
            elif any(claimed[pid] > 1 for pid in alive):
                lines.append(f"hang {tid}: {head}: no CPU, no new process and nothing written for {HANG_MIN:g} min, but calls that started "
                             "together share these processes: find which is stuck (ps -p <pid> -o command=) before you stop it, then tell the task")
            else:
                top = [pid for pid in alive if procs[pid]["ppid"] not in alive]
                lines.append(f"hang {tid}: {head}: no CPU, no new process and nothing written for {HANG_MIN:g} min; "
                             f"stop with: kill {' '.join(map(str, top))} (check each with ps -p <pid> -o command= first), then tell the task")
            hung_or_waiting = True
        if f["quiet"] and not hung_or_waiting:
            busy = sum(recent_cpu(pid) for pid in tp) >= BUSY_SHARE or any(gpu_moved(pid) for pid in tp)
            if not busy:
                lines.append(f"quiet {tid}: its session log, worktree and run folder haven't changed for over {QUIET_MIN:g} min"
                             f"{' (log last written ' + hm(f['log']) + ')' if f['log'] else ''}, and its processes are idle: "
                             "read its thread (waiting on reviewers, stuck, or ended without reporting)")

    # Processes not the run's that hog a core.
    hog_s = HOG_MIN * 60
    runs_own |= set().union(*task_procs.values()) if task_procs else set()
    hogs_told = {k for k in state.get("hogs", []) if int(k.split("@")[0]) in procs}
    for pid, p in sorted(procs.items()):
        if pid in runs_own or p["start"] < started:
            continue
        age = t_now - p["start"]
        if age < hog_s:
            continue
        share = rate_since(samples.get(key(pid, p), []), p["cpu"], t_now, hog_s)
        if share is None:
            share = p["cpu"] / max(1.0, age - 1)     # ps gives the start to the second
        if share >= HOG_SHARE and key(pid, p) not in hogs_told:
            hogs_told.add(key(pid, p))
            lines.append(f"hog {pid} {short(exe(p), 40)}: {share * 100:.0f}% of a core for {HOG_MIN:g}+ min, started {hm(p['start'])}, "
                         "not the run's: don't stop it; find what a task does that drives it (and note it in the ledger)")

    # The disk and swap.
    if "RUN_WATCH_DISK_FREE_GB" in os.environ:
        free = float(os.environ["RUN_WATCH_DISK_FREE_GB"])
    else:
        free = shutil.disk_usage("/System/Volumes/Data" if os.path.isdir("/System/Volumes/Data") else "/").free / 1024 ** 3
    disk = [s for s in state.get("disk", []) if t_now - s[0] <= 3600]
    machine = os.path.join(run_dir, "usage", "machine.jsonl")
    since = max(state.get("disk_told", 0), t_now - 3600)
    readings = list(disk)
    if os.path.exists(machine):
        try:
            with open(machine, "rb") as fh:
                fh.seek(max(0, os.path.getsize(machine) - 200_000))
                for line in fh.read().decode(errors="replace").splitlines()[1:]:
                    try:
                        e = json.loads(line)
                    except ValueError:
                        continue
                    t = parse_time(e.get("t"))
                    if t and t_now - t <= 3600 and isinstance(e.get("disk_free_gb"), (int, float)):
                        readings.append([t, float(e["disk_free_gb"])])
        except OSError:
            pass
    readings.append([t_now, free])
    readings.sort()
    worst = None
    for i, (ta, fa) in enumerate(readings):
        for tb, fb in readings[i + 1:]:
            if tb - ta > DISK_DROP_MIN * 60:
                break
            if ta >= since and fa - fb >= DISK_DROP_GB and (worst is None or fa - fb > worst[1] - worst[3]):
                worst = (ta, fa, tb, fb)
    if worst:
        ta, fa, tb, fb = worst
        lines.append(f"disk: free disk fell {fa - fb:.1f} GB in {(tb - ta) / 60:.1f} min ({hm(ta)} {fa:.1f} GB → {hm(tb)} {fb:.1f} GB; now "
                     f"{free:.1f} GB): find what writes it (downloads, builds, a model)")
        state["disk_told"] = tb
    if free < DISK_LOW_GB:
        lines.append(f"disk: {free:.1f} GB free, below {DISK_LOW_GB} GB: pause what fills it and clear the run's scratch")
    disk.append([t_now, round(free, 2)])
    state["disk"] = disk[-40:]
    if "RUN_WATCH_SWAP_GB" in os.environ:
        swap = float(os.environ["RUN_WATCH_SWAP_GB"])
    else:
        m = re.search(r"used = ([\d.]+)([MG])", run(["sysctl", "-n", "vm.swapusage"]))
        swap = (float(m.group(1)) / (1024 if m.group(2) == "M" else 1)) if m else 0.0
    if swap > SWAP_GB:
        lines.append(f"swap: {swap:.1f} GB in swap, above {SWAP_GB} GB: one large model at a time; stop what holds memory")

    # A password dialog, the keep-awake and the sampler.
    dialogs = [pid for pid, p in procs.items() if exe(p) == DIALOG]
    if dialogs:
        lines.append(f"dialog: a password dialog is up ({DIALOG} pid {' '.join(map(str, dialogs))}): nobody will answer it; "
                     "find the command that asked, stop it by its pid, and tell the task")
    pid = watch.get("keep_awake_pid")
    if isinstance(pid, int) and "caffeinate" not in procs.get(pid, {}).get("args", ""):
        lines.append(f"keep-awake: caffeinate pid {pid} isn't running: start it again and record the new pid in watch.json and the ledger")
    pid = watch.get("sampler_pid")
    if not isinstance(pid, int):
        try:
            pid = int(open(os.path.join(run_dir, "usage", "sampler.pid")).read().strip())
        except (OSError, ValueError):
            pid = None
    if isinstance(pid, int):
        if "usage-sampler" not in procs.get(pid, {}).get("args", ""):
            lines.append(f"sampler: the usage sampler (pid {pid}) isn't running: start it again on the same folder and record its pid")
    elif os.path.exists(machine) and t_now - os.path.getmtime(machine) > 180:
        lines.append(f"sampler: the usage sampler's last sample is {(t_now - os.path.getmtime(machine)) / 60:.0f} min old: "
                     "start it again on the same folder and record its pid")

    # Exact times for the ledger: commits, merges and report-backs not printed before.
    told = state.get("told", {})
    for tid, task in tasks.items():
        seen = set(told.get(tid, []))
        launched = parse_time(task.get("launched")) or started
        out = []
        if os.path.isdir(task["worktree"]):
            log = run(["git", "-C", task["worktree"], "log", "-g", "--date=iso-strict", "--format=%H%x09%gd%x09%gs", "HEAD"])
            for line in log.splitlines():
                f = line.split("\t", 2)
                if len(f) < 3 or not f[2].startswith("commit"):
                    continue
                t = parse_time(re.sub(r"^.*@\{(.*)\}$", r"\1", f[1]))
                if t and t >= launched - 60 and "c" + f[0] not in seen:
                    subject = f[2].split(":", 1)[1].strip() if ":" in f[2] else f[2]
                    out.append((t, "c" + f[0], f"commit {tid} {iso(t)} {f[0][:10]} {short(subject, 70)}"))
        repo, branch = watch.get("repo"), watch.get("integration_branch")
        if repo and branch and task.get("branch") and os.path.isdir(repo):
            log = run(["git", "-C", repo, "log", "-g", "--date=iso-strict", "--format=%H%x09%gd%x09%gs", "refs/heads/" + branch])
            for line in log.splitlines():
                f = line.split("\t", 2)
                if len(f) < 3 or not re.match(r"merge " + re.escape(task["branch"]) + r"\b", f[2]):
                    continue
                t = parse_time(re.sub(r"^.*@\{(.*)\}$", r"\1", f[1]))
                if t and t >= launched - 60 and "m" + f[0] not in seen:
                    out.append((t, "m" + f[0], f"merged {tid} {iso(t)} {f[0][:10]} into {branch}"))
        for cid, t, status in reports_by_task.get(tid, []):
            if "r" + str(cid) not in seen:
                out.append((t, "r" + str(cid), f"report {tid} {iso(t)} status={status}"))
        for t, k, line in sorted(out):
            lines.append(line)
            seen.add(k)
        told[tid] = sorted(seen)

    # Keep samples of processes started since the run began, for the next run's comparisons.
    keep = {}
    for pid, p in procs.items():
        if p["start"] < started - 60:
            continue
        k = key(pid, p)
        old = [s for s in samples.get(k, []) if t_now - s[0] <= KEEP_SAMPLES_S]
        keep[k] = (old + [[round(t_now, 1), round(p["cpu"], 2)]])[-8:]
    state.update({"last_run": iso(t0), "samples": keep, "sessions": sessions,
                  "blind": sorted(blind_told), "told": told,
                  "hogs": sorted(hogs_told)})
    for line in lines:
        print(line)
    try:
        save_state(state_path, state)
    except OSError as e:
        print(f"note: couldn't write {state_path}: {e}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
