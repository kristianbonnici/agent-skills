#!/usr/bin/env python3
"""A whole idle heartbeat in one call: run-watch, the integration branch, the Mac and usage, with one
line added to the ledger. An idle wake is then this one tool call and a one-line reply, instead of five
to twelve calls that each re-read the orchestrator's large context.

Usage: heartbeat <run directory> [--live | --no-live] [--no-ledger]

It reads <run directory>/watch.json, as run-watch does, and prints:

  heartbeat HH:MM: nothing to act on. <the summary>     when run-watch flagged nothing and no task
                                                         committed, merged or reported since last time
  heartbeat HH:MM: act on the lines below. <the summary>
  <run-watch's lines, each as it printed it>             otherwise

A task run-watch can't read (its "blind" list) is named on every wake and keeps it from being idle, since
only its thread shows an approval prompt or a turn that ended; Antigravity tasks whose conversation DB
run-watch found leave "blind" (their activity and 20-minute `quiet` checks read the DB and its `-wal`,
while immediate approval detection on Antigravity still relies on T3's `pendingRequestCount` check in
`references/host-t3.md`). A virtual machine or a leftover process
already reported is a reminder in the summary ("VMs still running", "leftovers still running"), not a
finding. run-watch also checks each other computer that watch.json's "machines" reaches over SSH, in
the same call; its lines name that computer, and the summary gives that computer's free disk, swap, load,
password dialogs (when there are any), keep-awake and sampler ("den-mac: disk 120 GB free, …, keep-awake
up, sampler up"), read from run-watch's state file (disk, swap, load, keep-awake or sampler "unknown" when
that computer couldn't take or send it), or
"den-mac not reached over SSH", which comes with an "unreachable" line, or "den-mac not checked this wake"
when this heartbeat's run-watch didn't finish (its "run-watch failed" note says why), so no earlier reading
passes for this one; every computer watch.json's "machines" reaches over SSH is named, a first wake's too.

In T3 it also reads T3's state database read-only (<T3_USERDATA, default ~/.t3/userdata>/statev2.sqlite), so
no thread needs a tool read to find an approval: each pending request on a running task's thread or on any
thread under it (reviewers, helpers and theirs, by their parent links) is a line,

  approval-task <task> <thread> <kind> since HH:MM       on the task's own thread
  approval-subagent <task> <thread> <kind> since HH:MM   on a thread under it

and a database or table it can't read (missing while watch.json's "host" is "t3", locked, a schema it doesn't
know) is "t3-state unreadable: <why>", which is never idle: read the subagents with the tools then. A running
task on another computer, whose database isn't here, is named in the summary ("read with the tools on
den-mac: B") and keeps the wake from being idle. Runs one at a time per run directory (heartbeat.lock), so
a scheduled heartbeat and scripts/watch-wait never read run-watch's state together.

The summary: the running tasks, the integration branch's head and how many tracked files are changed
in its checkout, free disk, swap and the load, password dialogs, whether the keep-awake and the usage
sampler run, and each subscription's windows used. A window to act on is a line of its own and makes the
wake not idle: a 5-hour window past 85%, any window at 95% or more, and any window at or past its mark in
watch.json's "usage_marks" ({"claude.weekly": 34, "claude.weekly_fable": 21}: the readings at which the
run's Claude and Fable budgets are used, which the orchestrator keeps up to date, also after a reset). Usage comes from the sampler's last readings
(<run directory>/usage/providers.jsonl, no new process); with --live, or when a running task's
"model" in watch.json names Fable (whose weekly window is read live only), from a live
provider-usage call (about 20 seconds, no model tokens); --no-live never reads live, a Fable task's
budget included. Without readings either way it says so.

It appends "- HH:MM heartbeat: <the summary>" to the ledger (<run directory>.md) unless
--no-ledger. It exits 0, or 2 for a usage error. For tests, HEARTBEAT_RUN_WATCH and
HEARTBEAT_PROVIDER_USAGE replace the two scripts it runs, and HEARTBEAT_PS the ps it lists processes with.
"""

import sys

if sys.version_info < (3, 9):    # the oldest Python its checks run on: macOS's own /usr/bin/python3
    print(f"heartbeat: needs Python 3.9 or newer, and {sys.executable} is {sys.version.split()[0]}: run it with a newer "
          "python3 (on a Mac, Homebrew's), and over SSH through the login shell (zsh -l)", file=sys.stderr)
    sys.exit(69)

import fcntl
import json
import os
import re
import shutil
import socket
import sqlite3
import subprocess
import sys
import time
import uuid
from datetime import datetime
from urllib.parse import quote

HERE = os.path.dirname(os.path.realpath(__file__))
EVENT = re.compile(r"^(commit|merged|report|slept) ")
REMINDER = re.compile(r"^(vm|leftover) \d+ .*: still running")
DIALOG_PATH = "/System/Library/Frameworks/Security.framework/Versions/A/MachServices/SecurityAgent.bundle/Contents/MacOS/SecurityAgent"


def run(cmd, timeout=60):
    try:
        done = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return done.stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def near_limits(providers: dict, key_used: str, marks: dict) -> list[str]:
    """Windows to act on: a 5-hour window past 85%, any window at 95% or more, and any window at or past
    the mark watch.json's "usage_marks" sets for it ("claude.weekly": the reading at which the run's
    Claude budget is used)."""
    out = []
    for name, p in sorted(providers.items()):
        windows = p.get("windows") if isinstance(p, dict) else None
        for key, w in sorted(windows.items()) if isinstance(windows, dict) else []:
            used = w.get(key_used) if isinstance(w, dict) else None
            if not isinstance(used, (int, float)):
                continue
            mark = marks.get(f"{name}.{key}")
            if isinstance(mark, (int, float)) and used >= mark:
                out.append(f"usage: {name} {key} at {used:g}%, at or past the run's mark of {mark:g}%: its budget is used")
            elif used >= 95 or (key == "five_hour" and used >= 85):
                out.append(f"usage: {name} {key} at {used:g}%: schedule the resume wake if work depends on it")
    return out


def windows_line(providers: dict, key_used: str) -> str:
    parts = []
    for name, p in sorted(providers.items()):
        if not isinstance(p, dict) or not isinstance(p.get("windows"), dict):
            continue
        shown = []
        for key, w in sorted(p["windows"].items()):
            if isinstance(w, dict) and isinstance(w.get(key_used), (int, float)):
                shown.append(f"{key} {w[key_used]:g}%")
        if shown:
            parts.append(f"{name} " + ", ".join(shown))
        elif name == "claude_api" and isinstance(p.get("left_usd"), (int, float)):
            parts.append(f"Claude API credits ${p['left_usd']:.0f} left (estimate)")
    return "; ".join(parts)


def usage(run_dir: str, live: bool, marks: dict, fable: bool = False) -> tuple[str, list[str]]:
    if live:
        out = run([os.environ.get("HEARTBEAT_PROVIDER_USAGE", os.path.join(HERE, "provider-usage"))], timeout=120)
        try:
            providers = json.loads(out).get("providers") or {}
            line = windows_line(providers, "used_percent")
            limits = near_limits(providers, "used_percent", marks)
            if not line:
                limits.append("usage: the live reading had no windows: read provider-usage yourself")
            elif fable and "weekly_fable" not in ((providers.get("claude") or {}).get("windows") or {}):
                limits.append("usage: no live Fable reading while a Fable task runs: the run's Fable budget can't be checked")
            return (("live: " + line) if line else "usage: no live reading"), limits
        except (ValueError, AttributeError):
            return "usage: the live reading failed", ["usage: the live reading failed: read provider-usage yourself"]
    path = os.path.join(run_dir, "usage", "providers.jsonl")
    try:
        with open(path, "rb") as fh:
            fh.seek(max(0, os.path.getsize(path) - 300_000))
            rows = fh.read().decode(errors="replace").splitlines()
    except OSError:
        return "usage: no sampler readings", []
    latest: dict = {}
    when = ""
    for row in rows:
        try:
            record = json.loads(row)
        except ValueError:
            continue
        if isinstance(record, dict) and isinstance(record.get("providers"), dict):
            latest.update(record["providers"])
            when = str(record.get("t", ""))[11:16]
    line = windows_line(latest, "used")
    return ((f"sampled {when}: " + line) if line else "usage: no sampler readings"), near_limits(latest, "used", marks)


def t3_pending(watch: dict, running: list, here: str) -> tuple[list, list]:
    """Pending requests in T3's state database (read-only) on a running task's thread or any thread under it:
    a reviewer, helper or Antigravity task waiting on an approval or a question nobody will answer. Returns
    (lines, summary bits). A task on another computer, whose T3 database isn't here, keeps the tool reads."""
    tasks = watch.get("tasks") if isinstance(watch.get("tasks"), dict) else {}
    mine, away = {}, {}
    for t in running:
        v = tasks[t]
        if not isinstance(v.get("thread"), str):
            continue
        if v.get("computer") and str(v["computer"]).casefold() != here:
            away.setdefault(str(v["computer"]), []).append(t)
        else:
            mine[v["thread"]] = t
    bits = [f"read with the tools on {c}: {', '.join(ts)}" for c, ts in sorted(away.items())]
    if not mine:
        return [], bits
    db = os.path.join(os.environ.get("T3_USERDATA") or os.path.expanduser("~/.t3/userdata"), "statev2.sqlite")
    if not os.path.isfile(db):
        if watch.get("host") == "t3":
            return [f"t3-state unreadable: no T3 state database at {db}: read the running tasks' subagents with the tools"], bits
        return [], bits
    uri = f"file:{quote(os.path.abspath(db), safe='/')}?mode=ro"
    why = ""
    for suffix in ("", "&immutable=1"):   # immutable: when a read-only folder keeps the WAL's index from opening
        con = None
        try:
            con = sqlite3.connect(uri + suffix, uri=True, timeout=2)
            cols = {t: {r[1] for r in con.execute(f"PRAGMA table_info({t})")} for t in
                    ("orchestration_v2_projection_runtime_requests", "orchestration_v2_projection_threads",
                     "orchestration_v2_projection_subagents")}
            req, thr, sub = cols.values()
            if not {"thread_id", "status", "created_at"} <= req:
                return ["t3-state unreadable: T3's database has no runtime requests table it knows (its schema changed): "
                        "read the running tasks' subagents with the tools"], bits
            if not {"thread_id", "payload_json"} <= thr:
                return ["t3-state unreadable: T3's database has no threads table it knows (its schema changed): "
                        "read the running tasks' subagents with the tools"], bits
            pending = con.execute("SELECT thread_id, " + ("kind" if "kind" in req else "''") + ", created_at FROM "
                                  "orchestration_v2_projection_runtime_requests WHERE status = 'pending'").fetchall()
            parent = {}
            if pending:
                for child, up in con.execute("SELECT thread_id, json_extract(payload_json, '$.lineage.parentThreadId') FROM "
                                             "orchestration_v2_projection_threads WHERE json_valid(payload_json)"):
                    if isinstance(up, str) and up:
                        parent[child] = up
                if {"thread_id", "child_thread_id"} <= sub:
                    for up, child in con.execute("SELECT thread_id, child_thread_id FROM orchestration_v2_projection_subagents "
                                                 "WHERE child_thread_id IS NOT NULL"):
                        parent.setdefault(child, up)
            break
        except sqlite3.Error as e:
            why = str(e)
            continue
        finally:
            if con is not None:
                con.close()
    else:
        return [f"t3-state unreadable: {why[:120]}: read the running tasks' subagents with the tools"], bits
    out = []
    for thread, kind, created in sorted(pending, key=lambda r: str(r[2])):
        task, seen, at = None, set(), thread
        while at and at not in seen and len(seen) < 50:
            if at in mine:
                task = mine[at]
                break
            seen.add(at)
            at = parent.get(at)
        if task is None:
            continue
        t = parse_iso(created)
        launched = parse_iso(tasks[task].get("launched"))
        if t is not None and launched is not None and t < launched - 60:
            continue   # older than the task: another run's, left pending
        since = time.strftime("%H:%M", time.localtime(t)) if t is not None else "?"
        out.append(f"approval-{'task' if thread == tasks[task]['thread'] else 'subagent'} {task} {thread} "
                   f"{kind or 'request'} since {since}")
    return out, bits


def parse_iso(s):
    if not isinstance(s, str) or not s:
        return None
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def main(argv):
    args = [a for a in argv if not a.startswith("--")]
    flags = {a for a in argv if a.startswith("--")}
    if len(args) != 1 or not os.path.isdir(args[0]) or flags - {"--live", "--no-live", "--no-ledger"} or {"--live", "--no-live"} <= flags:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    run_dir = os.path.abspath(args[0])
    # one at a time per run (a scheduled heartbeat and watch-wait's loop), so run-watch's state stays whole
    lock = open(os.path.join(run_dir, "heartbeat.lock"), "a+")
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        watch = json.load(open(os.path.join(run_dir, "watch.json")))
        watch = watch if isinstance(watch, dict) else {}
    except (OSError, ValueError):
        watch = {}
    tasks = watch.get("tasks") if isinstance(watch.get("tasks"), dict) else {}
    running = sorted(t for t, v in tasks.items() if isinstance(v, dict) and v.get("status", "running") == "running")
    fable = any(re.search(r"fable", str(tasks[t].get("model", "")), re.I) for t in running)

    invocation = uuid.uuid4().hex   # run-watch keeps it with each other computer's reading: this run's, no other's
    try:
        done = subprocess.run([os.environ.get("HEARTBEAT_RUN_WATCH", os.path.join(HERE, "run-watch")), run_dir],
                              capture_output=True, text=True, timeout=180, env=dict(os.environ, RUN_WATCH_INVOCATION=invocation))
        watch_lines = [l for l in done.stdout.splitlines() if l.strip()]
        if done.returncode != 0:
            watch_lines.append(f"note: run-watch failed (exit {done.returncode}): {done.stderr.strip()[-200:]}; run it yourself")
    except (OSError, subprocess.TimeoutExpired) as e:
        watch_lines = [f"note: run-watch didn't run ({e}); run it yourself"]
    flagged = [l for l in watch_lines if not EVENT.match(l) and not REMINDER.match(l)]
    reminders = {"vm": [], "leftover": []}
    for l in watch_lines:
        if REMINDER.match(l):
            reminders[l.split(" ", 1)[0]].append(l.split(":", 1)[0].split(" ", 1)[1] + l.split("still running", 1)[1])
    # tasks run-watch can't read (it names each once): their threads need a look on every wake; and what
    # its SSH check found on each other computer
    try:
        state = json.load(open(os.path.join(run_dir, "run-watch.state.json")))
        state = state if isinstance(state, dict) else {}
    except (OSError, ValueError):
        state = {}
    blind = set(state.get("blind") or []) if isinstance(state.get("blind"), list) else set()
    machines = state.get("machines") if isinstance(state.get("machines"), dict) else {}
    blind_running = sorted(t for t in running if t in blind)
    events = {}
    for l in watch_lines:
        if EVENT.match(l):
            parts = l.split()
            word, who = parts[:2]
            if word == "slept":   # a time, not a task: said as its clock time
                who = (re.search(r"T(\d\d:\d\d)", who) or re.match("(.*)", who)).group(1)
            if parts[2:3] == ["on"] and len(parts) > 3:   # another computer's, checked over SSH
                who += f" on {parts[3]}"
            events.setdefault(word, []).append(who)

    repo, branch = watch.get("repo"), watch.get("integration_branch")
    head = dirty = None
    if repo and branch and os.path.isdir(repo):
        head = run(["git", "-C", repo, "log", "-1", "--format=%h %s", branch]).strip()[:70]
        dirty = len([l for l in run(["git", "-C", repo, "status", "--porcelain", "--untracked-files=no"]).splitlines() if l.strip()])
    free = shutil.disk_usage("/System/Volumes/Data" if os.path.isdir("/System/Volumes/Data") else "/").free / 1024 ** 3
    swap = re.search(r"used = ([\d.]+)([MG])", run(["sysctl", "-n", "vm.swapusage"]))
    swap_gb = (float(swap.group(1)) / (1024 if swap.group(2) == "M" else 1)) if swap else None
    load = os.getloadavg()[0]
    ps_cmd = os.environ.get("HEARTBEAT_PS", "ps")
    ps = run([ps_cmd, "-axo", "pid=,comm="])
    # only the system's own SecurityAgent, by its path: a test's stand-in elsewhere is no dialog
    dialogs = len([l for l in ps.splitlines() if l.strip().split(None, 1)[1:] == [DIALOG_PATH]])
    alive = []
    for name in ("keep_awake_pid", "sampler_pid"):
        pid = watch.get(name)
        if isinstance(pid, int):
            alive.append(f"{name.split('_pid')[0].replace('_', '-')} {'up' if run([ps_cmd, '-p', str(pid), '-o', 'pid=']).strip() else 'DOWN'}")

    now = time.strftime("%H:%M")
    bits = [f"running {', '.join(running) or 'none'}"]
    if events:
        bits.append("; ".join(f"{word} {' '.join(who)}" for word, who in sorted(events.items())))
    if head:
        bits.append(f"{branch} {head}" + (f", {dirty} tracked files changed in the checkout" if dirty else ""))
    bits.append(f"disk {free:.0f} GB free, swap {swap_gb:.1f} GB, load {load:.1f}" if swap_gb is not None else f"disk {free:.0f} GB free, load {load:.1f}")
    if dialogs:
        bits.append(f"{dialogs} password dialog(s)")
    if alive:
        bits.append(", ".join(alive))
    if reminders["vm"]:
        bits.append("VMs still running: " + "; ".join(reminders["vm"]))
    if reminders["leftover"]:
        bits.append("leftovers still running: " + "; ".join(reminders["leftover"]))
    # every computer watch.json reaches over SSH, so one this wake's run-watch never got to is still named
    here = str(watch.get("computer") or os.environ.get("RUN_WATCH_COMPUTER")   # this computer, as run-watch names it
               or run(["scutil", "--get", "LocalHostName"], timeout=10).strip() or socket.gethostname().split(".")[0]
               ).casefold() if watch.get("machines") else ""
    expected = {str(n) for n, e in (watch.get("machines") or {}).items() if isinstance(e, dict) and isinstance(e.get("reach"), str)
                and e["reach"].split()[:1] == ["ssh"] and str(n).casefold() != here} if isinstance(watch.get("machines"), dict) else set()
    for name in sorted(expected | set(machines)):
        m = machines.get(name)
        fresh = isinstance(m, dict) and m.get("invocation") == invocation   # written by this heartbeat's run-watch
        if not isinstance(m, dict) or not fresh:   # an earlier wake's: this one's run-watch didn't finish
            bits.append(f"{name} not checked this wake")
            continue
        if not m.get("reached"):
            bits.append(f"{name} not reached over SSH")
            continue
        def number(k):   # a reading run-watch couldn't take or read there is "unknown", never left out
            v = m.get(k)
            return v if isinstance(v, (int, float)) and not isinstance(v, bool) and 0 <= v < 1e6 else None
        there = [f"disk {number('disk_free_gb'):.0f} GB free" if number("disk_free_gb") is not None else "disk unknown",
                 f"swap {number('swap_gb'):.1f} GB" if number("swap_gb") is not None else "swap unknown",
                 f"load {number('load'):.1f}" if number("load") is not None else "load unknown"]
        if isinstance(m.get("dialogs"), int) and m["dialogs"]:
            there.append(f"{m['dialogs']} password dialog(s)")
        there += [f"{word} {m.get(k) or 'unknown'}" for word, k in (("keep-awake", "keep_awake"), ("sampler", "sampler"))]
        bits.append(f"{name}: " + ", ".join(there))
    if blind_running:
        bits.append(f"blind, read their threads: {', '.join(blind_running)}")
    # T3's pending requests: an approval a reviewer, helper or Antigravity task waits on
    away = [t for t in running if tasks[t].get("computer")]
    here_name = str(watch.get("computer") or os.environ.get("RUN_WATCH_COMPUTER")
                    or run(["scutil", "--get", "LocalHostName"], timeout=10).strip() or socket.gethostname().split(".")[0]
                    ).casefold() if away else ""
    pending, tool_reads = t3_pending(watch, running, here_name)
    bits += tool_reads
    marks = watch.get("usage_marks") if isinstance(watch.get("usage_marks"), dict) else {}
    live = "--live" in flags or (fable and "--no-live" not in flags)
    usage_line, limits = usage(run_dir, live, marks, fable and live)
    bits.append(usage_line)
    summary = ". ".join(bits) + "."
    flagged += pending + limits
    watch_lines += pending + limits
    if dialogs and not any(l.startswith("dialog") for l in flagged):
        flagged.append(f"dialog: {dialogs} password dialog(s) on the screen")
        watch_lines.append(flagged[-1])
    idle = not flagged and not events and not blind_running and not tool_reads
    print(f"heartbeat {now}: {'nothing to act on' if idle else 'act on the lines below'}. {summary}")
    for l in watch_lines:
        if not idle:
            print(l)
    if "--no-ledger" not in flags:
        ledger = run_dir.rstrip("/") + ".md"
        if os.path.isfile(ledger):
            try:
                with open(ledger, "a", encoding="utf-8") as fh:
                    note = f" Flags: {len(flagged)}." if flagged else ""
                    fh.write(f"- {now} heartbeat: {summary}{note}\n")
            except OSError as e:
                print(f"note: couldn't add to the ledger: {e}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
