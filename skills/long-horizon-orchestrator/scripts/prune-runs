#!/usr/bin/env python3
"""Keep the orchestrator's run folders small: delete a merged task's scratch folder, and shrink
finished older runs to their write-ups.

SKILL.md ("Prepare", "On every wake", "Finish") says when to use it, and machine.md ("Disk")
what it keeps.

Usage:
  prune-runs [--older-than <days>] [--apply]
  prune-runs --scratch <run folder>/<task ID>
  prune-runs --harness-temp <worktree> [<run folder>/<task ID> ...] [--apply]
  prune-runs --size <run folder>

The root is the folder of ledgers and run folders, always
${XDG_STATE_HOME:-~/.local/state}/agent-skills/long-horizon-orchestrator, where SKILL.md puts them
(a check sets XDG_STATE_HOME to a folder of its own; there is no option to point it elsewhere). A run is a folder there
with a ledger of the same name beside it (<name>.md).

Older runs (the first form). Only a run whose ledger says "Status: finished" and hasn't changed
for --older-than days (7 unless given) is touched. A folder holding a file named KEEP, the run's
own or a task's (the orchestrator puts one in each unmerged task's folder at the finish), is left
whole. Without
--apply it only lists what it would remove; with --apply it removes it and adds a line to the
run's pruned.txt saying what went. It keeps:
  - everything in report/ (the final report, run map, charts and their pictures) and in stopped/
    (a stopped task's saved patches), and every folder named evidence/ (where the briefs put
    evidence that isn't a small text file: a large log, a recording a handoff cites);
  - text files up to 10 MB: notes, handoffs, briefs, measurements, logs, data, the tasks' own
    small scripts and probes (by their extension: .md, .json, .tsv, .csv, .log, .txt, .swift,
    .py, .sh and the like);
  - pictures up to 10 MB in a folder named pictures/ (where the briefs put the report's);
  - symbolic links outside the folders it removes whole (a link is never followed: removing a
    folder removes the links in it, never what they point to), and any git worktree inside the
    run, left whole.
It removes everything else: whole scratch/ folders, copies of other projects (any folder inside a
task's folder holding a .git folder, unless a worktree was made from it), builds (.app, .build, DerivedData, node_modules and the like), downloads,
recordings, renders and screenshots that aren't in pictures/, archives, binaries, traces.

A merged task's scratch (the second form): removes <task folder>/scratch, where the briefs put
what can be made again. The task folder must be a folder (not a link) in a run folder under the
root, and not report/, stopped/ or evidence/. A task folder holding KEEP, and a git worktree
inside scratch/, are left alone. It doesn't know whether the task merged: the orchestrator
calls it only for a merged task whose processes have stopped. Use it only once the task and everything it started have stopped.

A task's harness temp folders (the third form): Claude Code keeps a temporary folder for each
working folder a session ran in, ${CLAUDE_CODE_TMPDIR:-/tmp}/claude-<uid>/<the folder's path, every
character but letters and digits as "-"; a name over 200 characters is cut there and given a hash>/,
with a folder per session in it (scratchpad/, tasks/). It outlives the worktree and is never cleaned,
so builds and downloads a task put in its scratchpad stay. This form finds the folders of the paths
given: each path's own (exactly that path, since another worktree's or task's name may begin with it),
and for a task's folder in a run under the root, its scratch/ folder's and every folder's inside that
(a session a task started in its scratch), unless another folder or watch.json task of the run could
own that name too (a task S4-scratch beside S4): an ambiguous folder stays. Without --apply it lists them with their sizes; with it, it removes them,
each folder by folder without following a link. It refuses the home folder, the folder it runs in, a
folder above either, a repository's main checkout (a .git folder), and a
run folder or the root itself; with --apply, a call naming a task folder that holds KEEP removes
nothing. Codex, OpenCode and Antigravity keep their sessions' logs and state
in their own folders, not a folder per working folder, so this form leaves them alone. Use it only
once the task and everything it started have stopped.

--size prints a run folder's size on disk, for the report's closing line, and, on a second line, the
harness temp folders still left for its tasks (the worktrees and task folders its watch.json names),
when there are any.

Every removal goes folder by folder from
the root without following a link, so a folder swapped for a link meanwhile is refused, not
followed.

Exit 0: done (or listed); 1: something couldn't be removed (it says what); 64: a mistake in the
command or a folder that isn't a run's.
"""

import argparse
import json
import math
import os
import re
import stat
import sys
import time

TEXT_LIMIT = 10 * 1024 * 1024
TEXT = {
    ".md", ".markdown", ".txt", ".json", ".jsonl", ".ndjson", ".tsv", ".csv", ".log", ".yaml", ".yml",
    ".toml", ".mmd", ".html", ".htm", ".css", ".svg", ".patch", ".diff", ".xml", ".plist", ".ini",
    ".cfg", ".conf", ".swift", ".py", ".sh", ".zsh", ".bash", ".js", ".mjs", ".cjs",
    ".ts", ".tsx", ".jsx", ".c", ".h", ".m", ".mm", ".cpp", ".hpp", ".rs", ".go", ".rb", ".java",
    ".kt", ".sql", ".applescript", ".metal",
}
PICTURES = {".png", ".jpg", ".jpeg", ".gif", ".webp"}
KEPT_WHOLE = {"report", "stopped"}           # top-level folders of a run kept as they are
EVIDENCE = "evidence"                        # a folder of that name is kept as it is, at any depth
BUILDS = {".build", "DerivedData", "node_modules", "__pycache__", ".venv", "venv", ".swiftpm",
          "Pods", ".gradle", ".next", "dist-newstyle", "checkouts"}
BUNDLES = (".app", ".xcarchive", ".dSYM", ".framework", ".bundle", ".trace", ".xcresult", ".appex")


def default_root():
    state = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(state, "agent-skills", "long-horizon-orchestrator")


def usage_error(message):
    print(f"prune-runs: {message}", file=sys.stderr)
    sys.exit(64)


def disk_size(st):
    blocks = getattr(st, "st_blocks", None)
    return blocks * 512 if blocks is not None else st.st_size


def tree_size(path):
    """Size on disk of a file or folder, links counted as links and never followed."""
    try:
        st = os.lstat(path)
    except OSError:
        return 0
    if not stat.S_ISDIR(st.st_mode):
        return disk_size(st)
    total = disk_size(st)
    for top, dirs, files in os.walk(path, followlinks=False):
        for name in dirs + files:
            try:
                total += disk_size(os.lstat(os.path.join(top, name)))
            except OSError:
                pass
    return total


def human(n):
    for unit, size in (("GB", 1 << 30), ("MB", 1 << 20), ("KB", 1 << 10)):
        if n >= size:
            return f"{n / size:.1f} {unit}"
    return f"{n} B"


def is_worktree(path):
    """A linked git worktree: its .git is a file pointing at the repository that owns it."""
    return os.path.isfile(os.path.join(path, ".git")) and not os.path.islink(os.path.join(path, ".git"))


def removed_whole(name, path, depth):
    if name == "scratch" or name in BUILDS or name.endswith(BUNDLES):
        return True
    if depth == 0:
        return False                               # a task's own folder is sorted file by file
    return is_clone(path)                          # a copy of another project


def is_clone(path):
    git = os.path.join(path, ".git")
    return os.path.isdir(git) and not os.path.islink(git)


def has_linked_worktrees(path):
    """A clone a worktree was made from: the worktree's commits live in its .git."""
    try:
        return bool(os.listdir(os.path.join(path, ".git", "worktrees")))
    except OSError:
        return False


def kept_file(path, name, in_pictures):
    try:
        st = os.lstat(path)
    except OSError:
        return True
    if stat.S_ISLNK(st.st_mode):
        return True
    if not stat.S_ISREG(st.st_mode):
        return False
    lower = name.lower()
    ext = os.path.splitext(lower)[1]
    if st.st_size > TEXT_LIMIT:
        return False
    if ext in TEXT or lower in {"readme", "license", "makefile", "dockerfile", "pruned.txt"}:
        return True
    return in_pictures and ext in PICTURES


def plan_run(run):
    """What pruning the run would remove: [(path, size, whole)], and worktrees left alone."""
    remove, worktrees = [], []

    def walk(folder, in_pictures, depth):
        try:
            entries = sorted(os.scandir(folder), key=lambda e: e.name)
        except OSError:
            return
        for entry in entries:
            path = entry.path
            if entry.is_symlink():
                continue
            if entry.is_dir(follow_symlinks=False):
                if depth == 0 and entry.name in KEPT_WHOLE:
                    continue
                if os.path.lexists(os.path.join(path, "KEEP")) or entry.name == EVIDENCE:
                    continue
                if is_worktree(path) or (is_clone(path) and has_linked_worktrees(path)):
                    worktrees.append(path)
                    continue
                if entry.name == ".git":               # a task folder that is itself a clone: its history goes
                    remove.append((path, tree_size(path), True))
                    continue
                if removed_whole(entry.name, path, depth) and not holds_protected(path):
                    remove.append((path, tree_size(path), True))
                    continue
                walk(path, in_pictures or entry.name == "pictures", depth + 1)
            elif not kept_file(path, entry.name, in_pictures):
                remove.append((path, tree_size(path), False))

    walk(run, False, 0)
    return remove, worktrees


def holds_protected(path):
    """Whether the folder holds what pruning keeps: a git worktree, a clone one was made from, KEEP or
    an evidence/ folder. Such a folder is never removed whole; its contents are sorted one by one."""
    for top, dirs, files in os.walk(path, followlinks=False):
        if "KEEP" in files or "KEEP" in dirs or EVIDENCE in dirs:
            return True
        if ".git" in files and is_worktree(top):
            return True
        if ".git" in dirs and has_linked_worktrees(top):
            return True
    return False


DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW


def remove_at(parent_fd, name):
    """Removes name in the open folder parent_fd, a folder with everything in it, never following a link."""
    st = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    if not stat.S_ISDIR(st.st_mode):
        os.unlink(name, dir_fd=parent_fd)
        return
    fd = os.open(name, DIR_FLAGS, dir_fd=parent_fd)
    try:
        for child in os.listdir(fd):
            remove_at(fd, child)
    finally:
        os.close(fd)
    os.rmdir(name, dir_fd=parent_fd)


def open_parent(root, path):
    """Opens the folder holding path, component by component from the root, refusing links."""
    parts = os.path.relpath(path, root).split(os.sep)
    if not parts or parts[0] in (os.pardir, os.curdir, ""):
        raise OSError(f"not under {root}")
    fd = os.open(root, DIR_FLAGS)
    try:
        for part in parts[:-1]:
            next_fd = os.open(part, DIR_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = next_fd
    except BaseException:
        os.close(fd)
        raise
    return fd, parts[-1]


def delete(root, path):
    """Removes a file or a whole folder under root (links inside removed as links). Returns an error or None."""
    try:
        fd, name = open_parent(root, path)
        try:
            remove_at(fd, name)
        finally:
            os.close(fd)
        return None
    except OSError as error:
        return f"{path}: {error.strerror or error}"


def append_note(root, run, text):
    """Adds a line to the run's pruned.txt, never through a link."""
    try:
        fd, name = open_parent(root, os.path.join(run, "pruned.txt"))
        try:
            out = os.open(name, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o644, dir_fd=fd)
        finally:
            os.close(fd)
        with os.fdopen(out, "a", encoding="utf-8") as f:
            f.write(text)
        return None
    except OSError as error:
        return f"{run}/pruned.txt: {error.strerror or error}"


def remove_emptied_folders(root, run, removed):
    """Removes the folders the removals left empty, up to the run's own; no other empty folder."""
    for path in sorted(removed, key=len, reverse=True):
        folder = os.path.dirname(path)
        while folder != run and folder.startswith(run + os.sep):
            try:
                fd, name = open_parent(root, folder)
                try:
                    os.rmdir(name, dir_fd=fd)      # fails, and stops the climb, when not empty
                finally:
                    os.close(fd)
            except OSError:
                break
            folder = os.path.dirname(folder)


def ledger_status(ledger):
    try:
        with open(ledger, encoding="utf-8", errors="replace") as f:
            for _, line in zip(range(20), f):
                if line.startswith("Status:"):
                    return line[len("Status:"):].strip()
    except OSError:
        return None
    return ""


def runs_in(root):
    for name in sorted(os.listdir(root)):
        path = os.path.join(root, name)
        if name.startswith(".") or os.path.islink(path) or not os.path.isdir(path):
            continue
        yield name, path, os.path.join(root, name + ".md")


def safe_root(root):
    real = os.path.realpath(root)
    if not os.path.isdir(real):
        return None                                # no run has been made on this computer yet
    if real in {os.path.realpath("/"), os.path.realpath(os.path.expanduser("~"))}:
        usage_error(f"refusing {root}")
    return real


def prune_old(root, days, apply):
    now = time.time()
    total_now = total_removable = total_freed = 0
    touched, problems = 0, []
    for name, run, ledger in runs_in(root):
        if not os.path.isfile(ledger):
            print(f"{name}: skipped, no ledger beside it")
            continue
        status = ledger_status(ledger)
        if not (status or "").startswith("finished"):
            print(f"{name}: skipped, not finished (Status: {status or 'none'})")
            continue
        age = (now - os.path.getmtime(ledger)) / 86400
        if age < days:
            print(f"{name}: skipped, finished {age:.1f} days ago")
            continue
        if os.path.lexists(os.path.join(run, "KEEP")):
            print(f"{name}: skipped, it holds KEEP")
            continue
        size = tree_size(run)
        remove, worktrees = plan_run(run)
        removable = sum(s for _, s, _ in remove)
        total_now += size
        total_removable += removable
        for wt in worktrees:
            print(f"{name}: leaves {os.path.relpath(wt, run)} whole (a git worktree, or a clone one was made from)")
        if not remove:
            print(f"{name}: {human(size)}, nothing to remove")
            continue
        verb = "removing" if apply else "would remove"
        print(f"{name}: {human(size)}, {verb} {human(removable)} in {len(remove)} items, keeps {human(size - removable)}")
        if not apply:
            continue
        failed, freed, tops, removed = [], 0, {}, []
        for path, s, _ in remove:
            error = delete(root, path)
            if error:
                failed.append(error)
                continue
            freed += s
            removed.append(path)
            top = os.path.relpath(path, run).split(os.sep)[0]
            tops[top] = tops.get(top, 0) + s
        problems += failed
        total_freed += freed
        remove_emptied_folders(root, run, removed)
        touched += 1
        if failed:
            print(f"{name}: freed {human(freed)}; couldn't remove {len(failed)} items")
        biggest = ", ".join(f"{t} {human(s)}" for t, s in sorted(tops.items(), key=lambda x: -x[1])[:8])
        error = append_note(root, run,
                            f"{time.strftime('%Y-%m-%d %H:%M %Z')}: prune-runs removed {human(freed)} in {len(remove) - len(failed)} items "
                            f"(builds, downloads, copies of other projects, scratch, renders and recordings; the write-ups, "
                            f"report/, stopped/, text files, pictures/ and folders holding KEEP kept). Most from: {biggest or 'nothing'}."
                            + (f" Couldn't remove {len(failed)}." if failed else "") + "\n")
        if error:
            problems.append(error)
    gone, verb = (total_freed, "removed") if apply else (total_removable, "removable")
    print(f"Total: {human(gone)} {verb} of {human(total_now)} in finished runs older than {days:g} days"
          + (f", {touched} runs pruned" if apply else ""))
    for p in problems:
        print(f"couldn't remove {p}", file=sys.stderr)
    return 1 if problems else 0


def prune_scratch(root, task):
    real = os.path.realpath(task)
    run = os.path.dirname(real)
    if (os.path.islink(task.rstrip(os.sep)) or os.path.dirname(run) != root or not os.path.isfile(run + ".md")
            or not os.path.isdir(real) or os.path.basename(real) in KEPT_WHOLE | {EVIDENCE}):
        usage_error(f"{task} isn't a task's folder in a run folder under {root}")
    scratch = os.path.join(real, "scratch")
    if os.path.lexists(os.path.join(real, "KEEP")):
        print(f"{os.path.basename(real)}: holds KEEP; scratch left alone")
        return 0
    if os.path.islink(scratch) or not os.path.isdir(scratch):
        print(f"{os.path.basename(real)}: no scratch folder, nothing to remove")
        return 0
    if is_worktree(scratch) or holds_protected(scratch):
        print(f"{os.path.basename(real)}: scratch holds a git worktree, a clone one was made from, KEEP or "
              f"evidence/; left alone", file=sys.stderr)
        return 1
    size = tree_size(scratch)
    error = delete(root, scratch)
    if error:
        print(f"couldn't remove {error}", file=sys.stderr)
        return 1
    print(f"{os.path.basename(real)}: removed scratch, {human(size)}")
    return 0


CLAUDE_NAME_LIMIT = 200   # Claude Code cuts a longer folder name there and adds a hash


def claude_temp_root():
    """Claude Code's temporary folder for this user: ${CLAUDE_CODE_TMPDIR:-/tmp}/claude-<uid>."""
    base = os.environ.get("CLAUDE_CODE_TMPDIR") or "/tmp"
    return os.path.join(os.path.realpath(base), f"claude-{os.getuid()}")


def claude_hash(text):
    """Claude Code's hash for a cut name: a 32-bit string hash over UTF-16 units, its absolute value in base 36."""
    h = 0
    data = text.encode("utf-16-le", "surrogatepass")
    for i in range(0, len(data), 2):
        h = (h * 31 + int.from_bytes(data[i:i + 2], "little")) & 0xFFFFFFFF
    n, digits = abs(h - (1 << 32) if h >= 1 << 31 else h), ""
    while True:
        n, d = divmod(n, 36)
        digits = "0123456789abcdefghijklmnopqrstuvwxyz"[d] + digits
        if not n:
            return digits


def claude_name(path):
    """The name of Claude Code's folder for sessions in path: every character but letters and digits as
    "-", and over 200 characters, the first 200 and the path's hash."""
    name = re.sub(r"[^A-Za-z0-9]", "-", path)
    return name if len(name) <= CLAUDE_NAME_LIMIT else f"{name[:CLAUDE_NAME_LIMIT]}-{claude_hash(path)}"


def harness_temp_folders(root, paths):
    """[(folder, size)] of Claude Code's temp folders for the paths: each path's own, and for a task's
    folder in a run under the root, those of its scratch/ and the folders inside it too (a session a
    task started there). Never a sibling's whose name begins the same, such as task S4-fix's for S4: a
    folder for scratch/ or inside it is taken only when no other folder or watch.json task of the run
    could own its name too (a task S4-scratch beside S4), and none when the run can't be listed."""
    temp = claude_temp_root()
    try:
        entries = sorted(os.scandir(temp), key=lambda e: e.name)
    except OSError:
        return []
    exact, scratch, others, unknown = set(), [], set(), False
    for path in paths:
        inside_root = root is not None and os.path.realpath(path).startswith(root + os.sep)
        for form in {os.path.abspath(path), os.path.realpath(path)}:   # the session may have named either
            exact.add(claude_name(form))
            if not inside_root:
                continue
            scratch.append(re.sub(r"[^A-Za-z0-9]", "-", os.path.join(form, "scratch")))
            run, task = os.path.split(form.rstrip(os.sep))
            try:   # the run's other folders and tasks, whose sessions' names may begin the same
                names = set(os.listdir(run)) | set(run_task_ids(run))
            except OSError:
                unknown = True   # no inventory: nothing under scratch/ is taken
                continue
            others |= {re.sub(r"[^A-Za-z0-9]", "-", os.path.join(run, n)) for n in names if n != task}
    found = []
    for entry in entries:
        if entry.is_symlink() or not entry.is_dir(follow_symlinks=False):
            continue
        under_scratch = not unknown and any(entry.name == s or entry.name.startswith(s + "-") for s in scratch) \
            and not any(entry.name == o or entry.name.startswith(o + "-") for o in others)
        if entry.name in exact or under_scratch:
            found.append((entry.path, tree_size(entry.path)))
    return found


def refused_path(root, path):
    """Why a path can't be given to --harness-temp, or None."""
    if not os.path.isabs(path):
        return "isn't an absolute path"
    real = os.path.realpath(path)
    home = os.path.realpath(os.path.expanduser("~"))
    if real == os.sep or home == real or home.startswith(real.rstrip(os.sep) + os.sep):
        return "is the home folder or a folder above it"
    if root is not None and (real == root or os.path.dirname(real) == root or root.startswith(real + os.sep)):
        return f"is {root}, a run folder in it, or a folder above it: name a task's folder"
    here = os.path.realpath(os.getcwd())
    if here == real or here.startswith(real.rstrip(os.sep) + os.sep):
        return "is the folder this runs in, or a folder above it (its sessions may still be working)"
    if os.path.isdir(os.path.join(real, ".git")):
        return "is a repository's main checkout, not a task's worktree"
    return None


def prune_harness_temp(root, paths, apply):
    for path in paths:
        why = refused_path(root, path)
        if why:
            usage_error(f"--harness-temp: {path} {why}")
    kept = [p for p in paths if root is not None and os.path.realpath(p).startswith(root + os.sep)
            and os.path.lexists(os.path.join(os.path.realpath(p), "KEEP"))]
    if kept and apply:   # an unmerged task's: its worktree, given beside it, is kept with it
        print(f"{', '.join(kept)} holds KEEP; its harness temp folders, and those of the other paths given, left alone")
        return 0
    temp = claude_temp_root()
    found = harness_temp_folders(root, paths)
    if not found:
        print(f"No harness temp folders for {', '.join(paths)} in {temp}")
        return 0
    failed, total = [], 0
    for folder, size in found:
        if not apply:
            print(f"would remove {folder} ({human(size)})")
            total += size
            continue
        error = delete(temp, folder)
        if error:
            failed.append(error)
            continue
        total += size
        print(f"removed {folder} ({human(size)})")
    print(f"Total: {human(total)} in {len(found) - len(failed)} harness temp folders "
          + ("removed" if apply else "(a dry run: --apply removes them)"))
    for error in failed:
        print(f"couldn't remove {error}", file=sys.stderr)
    return 1 if failed else 0


def run_task_ids(run):
    """The task IDs the run's watch.json names (none when it can't be read)."""
    try:
        with open(os.path.join(run, "watch.json"), encoding="utf-8") as f:
            tasks = (json.load(f) or {}).get("tasks") or {}
    except (OSError, ValueError, AttributeError):
        return []
    return [str(t) for t in tasks] if isinstance(tasks, dict) else []


def run_tasks_paths(run):
    """The worktrees and task folders the run's watch.json names."""
    try:
        with open(os.path.join(run, "watch.json"), encoding="utf-8") as f:
            tasks = (json.load(f) or {}).get("tasks") or {}
    except (OSError, ValueError, AttributeError):
        return []
    paths = []
    for tid, task in tasks.items() if isinstance(tasks, dict) else []:
        if isinstance(task, dict) and isinstance(task.get("worktree"), str) and os.path.isabs(task["worktree"]):
            paths.append(task["worktree"])
        if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", str(tid)):
            paths.append(os.path.join(os.path.abspath(run), str(tid)))   # its real path is tried too
    return paths


def main():
    parser = argparse.ArgumentParser(prog="prune-runs", add_help=True,
                                     description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--older-than", type=float, default=7.0, metavar="DAYS")
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--scratch", metavar="TASK_FOLDER")
    parser.add_argument("--size", metavar="RUN_FOLDER")
    parser.add_argument("--harness-temp", nargs="+", metavar="PATH")
    try:
        args = parser.parse_args()
    except SystemExit as exit_:
        sys.exit(0 if exit_.code == 0 else 64)
    if sum(bool(x) for x in (args.scratch, args.size, args.harness_temp)) > 1:
        usage_error("give one of --scratch, --harness-temp and --size")
    if args.size:
        if not os.path.isdir(args.size):
            usage_error(f"no such folder: {args.size}")
        print(human(tree_size(args.size)))
        left = harness_temp_folders(safe_root(default_root()), run_tasks_paths(args.size))
        if left:
            print(f"plus {human(sum(s for _, s in left))} in {len(left)} harness temp folders of its tasks "
                  f"(prune-runs --harness-temp lists them)")
        return 0
    if args.harness_temp:
        return prune_harness_temp(safe_root(default_root()), args.harness_temp, args.apply)
    if not math.isfinite(args.older_than) or args.older_than < 0:
        usage_error("--older-than takes days, 0 or more")
    root = safe_root(default_root())
    if root is None:
        if args.scratch:
            usage_error(f"no state folder at {default_root()}")
        print("No run folders yet: nothing to prune.")
        return 0
    if args.scratch:
        if args.apply:
            usage_error("--scratch removes at once; leave out --apply")
        return prune_scratch(root, args.scratch)
    return prune_old(root, args.older_than, args.apply)


if __name__ == "__main__":
    sys.exit(main())
