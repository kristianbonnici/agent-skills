#!/usr/bin/env python3
"""Wait for something new to act on, without model tokens: heartbeat's checks every few minutes, in a loop that
exits as soon as one finds something not delivered yet, so the orchestrator is woken only then.

Usage: watch-wait <run directory> [--every <seconds, default 300>] [--max <seconds, default 1440>] [--live] [--now]

It sleeps --every first (--now checks at once), then runs scripts/heartbeat <run directory> --no-ledger
(run-watch, the integration branch, the computer, the usage sampler's last readings and T3's pending requests)
each loop. It exits 0, printing one line and then heartbeat's output, once a check has an actionable line
that it hasn't delivered yet: a task's report or merge, an approval, a hang/idle/quiet/hog/disk/swap/dialog/
keep-awake/sampler/vm/slept/settings/next-run/watcher/blind/t3-state/leftover/unreachable line, or a usage
warning/mark crossed for the first time or changed. `commit <task>` lines alone never wake it: any seen while
waiting are carried in <run directory>/watch-wait.state.json and printed alongside the next real exit.
It remembers lasting non-usage lines in <run directory>/watch-wait.seen.json across restarts, by each line
less the readings that change while its condition lasts (minutes, sizes, low disk's folder sizing; a request's
time, a task and a thread stay), so a lasting non-usage condition (a quiet task, low disk) wakes the
orchestrator once and then every 30 minutes, not on every restart. Per-window usage warnings are tracked by
window state in <run directory>/watch-wait.state.json and do not wake again until that window resets, recovers
below its threshold, or crosses a new threshold or mark. Reminders
("vm … still running", "leftover … still running") never count. Tasks heartbeat says to read with the tools
(blind, or on another computer), and a "t3-state unreadable" line, bring it out once every 15 minutes, so
those threads are read that often. A stop by signal or a heartbeat's 5-minute limit ends that heartbeat's
whole process group, run-watch with it. It
also exits at --max, saying nothing new needed acting on; each heartbeat may take up to 5 minutes, so give the
host's limit room: run it with Claude Code's timeout 7200000 and --max 6600 (the default fits the default 30
minutes). Either way it adds one line to the ledger (<run directory>.md), never one a loop.

It reads usage live only when it must: with --live, or while a running task's "model" names Fable (whose week
is read live only) or an Antigravity task runs (which the sampler reads hourly), at most every 15 minutes;
otherwise heartbeat runs with --no-live.

Start it in Claude Code (also in T3) as a background command, whose exit starts the orchestrator's next turn
(run_in_background). Only one runs for a run directory: a second exits 3 at once, naming the first's process
ID. It keeps <run directory>/watch-wait.pid while it runs, which run-watch reads when watch.json has
"watcher" (its "watcher" line says one isn't running). It exits 1 when heartbeat itself fails, 2 for a usage
error, and quietly with 0 when watch.json says the run is "finished". For tests, WATCH_WAIT_HEARTBEAT
replaces the heartbeat it runs.
"""

import sys

if sys.version_info < (3, 9):    # the oldest Python its checks run on: macOS's own /usr/bin/python3
    print(f"watch-wait: needs Python 3.9 or newer, and {sys.executable} is {sys.version.split()[0]}: run it with a newer "
          "python3 (on a Mac, Homebrew's)", file=sys.stderr)
    sys.exit(69)

import fcntl
import json
import os
import re
import signal
import subprocess
import time
from datetime import datetime

HERE = os.path.dirname(os.path.realpath(__file__))
LIVE_EVERY_S = 900
STOP = {"starting": False, "held": 0}
REMIND_S = 1800          # a lasting non-usage line already delivered comes again after this long
READ_EVERY_S = 900       # blind tasks or tasks on another computer: their threads are read this often
CARRIED_CAP = 200
RESET_TOLERANCE_S = 300
IDLE = re.compile(r"^heartbeat \d\d:\d\d: nothing to act on\.")
REMINDER = re.compile(r"^(vm|leftover) \d+ .*: still running")
COMMIT = re.compile(r"^commit ")
# said once by run-watch (as its one_time() says, here or "on <computer>"), or once a value: always new
ONCE = re.compile(r"^((merged|report|settings|blind|hog|vm|leftover) |disk(?: on \S+)?: free disk fell |"
                  r"slept \S+(?: on \S+)? (?!- )\S+ \()")
TOOL_READS = re.compile(r"blind, read their threads|read with the tools on ")
SOON = re.compile(r"^t3-state ")   # the tools read what it can't, as often as blind tasks
USAGE_MARK = re.compile(r"^usage: (\S+) (\S+) at ([\d.]+)%, at or past the run's mark of ([\d.]+)%:")
USAGE_BUILTIN = re.compile(r"^usage: (\S+) (\S+) at ([\d.]+)%: schedule the resume wake")
LEGACY_USAGE_MARK = re.compile(r"^usage: (\S+) (\S+) at #%, at or past the run's mark of ([\d.]+)%:")
LEGACY_USAGE_BUILTIN = re.compile(r"^usage: (\S+) (\S+) at #%: schedule the resume wake")
NO_USAGE_READING = re.compile(r"usage: (?:the live reading failed|no live reading|no sampler readings)")


def option(args: list, name: str, default: float):
    if name not in args:
        return default
    i = args.index(name)
    try:
        value = float(args[i + 1])
    except (IndexError, ValueError):
        return None
    del args[i:i + 2]
    return value if value > 0 else None


def load_json(path: str) -> dict:
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_json_atomic(path: str, data: dict) -> tuple[bool, str]:
    tmp = f"{path}.{os.getpid()}.tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(data, fh)
        os.replace(tmp, path)
        return True, ""
    except OSError as e:
        try:
            os.remove(tmp)
        except OSError:
            pass
        return False, str(e)


def parse_iso(s):
    if not isinstance(s, str) or not s:
        return None
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def same_reset_window(prev_resets, cur_resets) -> bool:
    if not prev_resets or not cur_resets or prev_resets == cur_resets:
        return True
    t_prev, t_cur = parse_iso(prev_resets), parse_iso(cur_resets)
    if t_prev is not None and t_cur is not None:
        return abs(t_cur - t_prev) <= RESET_TOLERANCE_S
    return False


def window_span_seconds(wkey: str):
    win = wkey.split(".", 1)[1] if "." in wkey else ""
    if win == "five_hour" or win.endswith("_five_hour"):
        return 5 * 3600
    if win == "weekly" or win.endswith("_weekly"):
        return 7 * 86400
    return None


def legacy_matches_window(legacy_at, wkey: str, cur_resets) -> bool:
    """True only when positive evidence ties a 5.20.0 delivery timestamp to the current reset window."""
    span = window_span_seconds(wkey)
    t_reset = parse_iso(cur_resets)
    if span is None or t_reset is None or not isinstance(legacy_at, (int, float)) or isinstance(legacy_at, bool):
        return False
    return t_reset - span + 60 <= legacy_at <= t_reset + 60


def parse_usage_line(line: str):
    """Parse a per-window usage warning into (ckey, wkey, state, threshold), or None for non-window/error lines.
    Configured marks and built-in thresholds use separate channels so an active mark never masks >= 95%."""
    m = USAGE_MARK.match(line)
    if m:
        wkey = f"{m.group(1)}.{m.group(2)}"
        mark = float(m.group(4))
        return f"{wkey}:mark", wkey, f"mark:{mark:g}", mark
    m = USAGE_BUILTIN.match(line)
    if m:
        wkey = f"{m.group(1)}.{m.group(2)}"
        used = float(m.group(3))
        if used >= 95:
            return f"{wkey}:builtin", wkey, "builtin:95", 95.0
        return f"{wkey}:builtin", wkey, "builtin:85", 85.0
    return None


def migrate_legacy_usage(seen: dict) -> dict:
    """Seed per-window usage state from a 5.20.0 watch-wait.seen.json when watch-wait.state.json is absent."""
    migrated = {}
    for k, ts in seen.items():
        if not isinstance(k, str) or not isinstance(ts, (int, float)) or isinstance(ts, bool):
            continue
        m = LEGACY_USAGE_MARK.match(k)
        if m:
            wkey = f"{m.group(1)}.{m.group(2)}"
            mark = float(m.group(3))
            migrated[f"{wkey}:mark"] = {"state": f"mark:{mark:g}", "threshold": mark, "resets_at": None, "legacy_at": float(ts)}
            continue
        m = LEGACY_USAGE_BUILTIN.match(k)
        if m:
            wkey = f"{m.group(1)}.{m.group(2)}"
            is_5h = m.group(2) == "five_hour"
            migrated[f"{wkey}:builtin"] = {
                "state": "builtin:85" if is_5h else "builtin:95",
                "threshold": 85.0 if is_5h else 95.0,
                "resets_at": None,
                "legacy_at": float(ts),
            }
    return migrated


def summary_usage(first: str) -> dict:
    """Parse current per-window percentages from heartbeat's summary line."""
    m = re.search(r"(?:\.\s+|^)(?:live|sampled \d\d:\d\d): (.+?)\.?$", first)
    if not m:
        return {}
    readings = {}
    for chunk in m.group(1).split(";"):
        parts = chunk.strip().split(" ", 1)
        if len(parts) != 2:
            continue
        prov, rest = parts
        for wm in re.finditer(r"(\S+) ([\d.]+)%", rest):
            try:
                readings[f"{prov}.{wm.group(1)}"] = float(wm.group(2))
            except ValueError:
                pass
    return readings


def live_needed(watch: dict) -> bool:
    tasks = watch.get("tasks") if isinstance(watch.get("tasks"), dict) else {}
    for v in tasks.values():
        if isinstance(v, dict) and v.get("status", "running") == "running" and (
                re.search(r"fable", str(v.get("model", "")), re.I) or "antigravity" in str(v.get("harness", "")).lower()
                or str(v.get("session_log", "")).endswith(".db")):
            return True
    return False


def line_key(line: str) -> str:
    """A line as it stays while its condition lasts: the readings that change from one check to the next (minutes,
    sizes, a usage reading, low disk's folder sizing) taken out, and every name, number and time that tells one
    finding from another (a task, a thread, a request's time, a mark) kept."""
    if line.startswith(("approval-task ", "approval-subagent ")):
        return line[:300]   # one request: its task, thread, kind and time
    if re.match(r"disk(?: on \S+)?: [\d.]+ GB free, below ", line):
        line = line.split(";", 1)[0]
    line = re.sub(r"\bat [\d.]+%", "at #%", line)   # usage: the reading, never the mark
    return re.sub(r"\b[\d.]+ ?(min|GB|MB|KB|s)\b", r"# \1", line)[:300]


def check(heartbeat: str, run_dir: str, live: bool) -> subprocess.CompletedProcess:
    """One heartbeat, in a process group of its own: a stop or a timeout ends run-watch with it, before run-watch
    saves a state it read earlier (over a change made meanwhile) or marks lines told that nobody saw."""
    STOP["starting"] = True   # a stop while it starts is held until it can be cleaned up (stop() below)
    try:
        proc = subprocess.Popen([heartbeat, run_dir, "--no-ledger", "--live" if live else "--no-live"],
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True)
    finally:
        STOP["starting"] = False
    try:
        if STOP["held"]:
            raise SystemExit(128 + STOP["held"])
        out, err = proc.communicate(timeout=300)
    except BaseException:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            pass
        proc.wait()
        raise
    return subprocess.CompletedProcess(proc.args, proc.returncode, out, err)


def ledger_line(run_dir: str, text: str) -> None:
    ledger = run_dir.rstrip("/") + ".md"
    if os.path.isfile(ledger):
        try:
            with open(ledger, "a", encoding="utf-8") as fh:
                fh.write(f"- {time.strftime('%H:%M')} watch-wait: {text}\n")
        except OSError as e:
            print(f"note: couldn't add to the ledger: {e}")


def main(argv: list) -> int:
    args = list(argv)
    every, most = option(args, "--every", 300), option(args, "--max", 1440)
    live_wanted, now_first = "--live" in args, "--now" in args
    args = [a for a in args if a not in ("--live", "--now")]
    if every is None or most is None or len(args) != 1 or args[0].startswith("-") or not os.path.isdir(args[0]):
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    run_dir = os.path.abspath(args[0])
    lock = open(os.path.join(run_dir, "watch-wait.lock"), "a+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        try:
            other = open(os.path.join(run_dir, "watch-wait.pid")).read().split()[0]
        except (OSError, IndexError):
            other = "unknown"
        print(f"watch-wait: already running for this run (pid {other}): nothing started")
        return 3
    pid_path = os.path.join(run_dir, "watch-wait.pid")
    seen_path = os.path.join(run_dir, "watch-wait.seen.json")
    state_path = os.path.join(run_dir, "watch-wait.state.json")
    hb_state_path = os.path.join(run_dir, "heartbeat.state.json")
    with open(pid_path, "w") as fh:
        fh.write(f"{os.getpid()}\n")

    def stop(signum, _frame):
        if STOP["starting"]:
            STOP["held"] = signum
            return
        raise SystemExit(128 + signum)

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, stop)
    heartbeat = os.environ.get("WATCH_WAIT_HEARTBEAT", os.path.join(HERE, "heartbeat"))
    t0 = time.time()
    deadline = t0 + most
    checks, last_live, first = 0, None, ""
    try:
        if not now_first:
            time.sleep(min(every, most))
        while True:
            watch = load_json(os.path.join(run_dir, "watch.json"))
            if watch.get("finished"):
                print("watch-wait: the run is finished; nothing to watch")
                return 0
            live = (live_wanted or live_needed(watch)) and (last_live is None or time.time() - last_live >= LIVE_EVERY_S)
            if live:
                last_live = time.time()
            try:
                done = check(heartbeat, run_dir, live)
            except (OSError, subprocess.TimeoutExpired) as e:
                print(f"watch-wait {time.strftime('%H:%M')}: heartbeat didn't run ({e}): run it yourself, then start watch-wait again")
                ledger_line(run_dir, f"heartbeat didn't run ({e})")
                return 1
            checks += 1
            out = [l for l in done.stdout.splitlines() if l.strip()]
            if done.returncode != 0 or not out:
                print(f"watch-wait {time.strftime('%H:%M')}: heartbeat failed (exit {done.returncode}): "
                      f"{done.stderr.strip()[-200:]}; run it yourself, then start watch-wait again")
                ledger_line(run_dir, f"heartbeat failed (exit {done.returncode})")
                return 1
            first = out[0]
            summary = first.split(". ", 1)[1] if ". " in first else first
            minutes = (time.time() - t0) / 60
            t_now = time.time()
            seen = {k: v for k, v in load_json(seen_path).items()
                    if isinstance(v, (int, float)) and not isinstance(v, bool) and t_now - v < 6 * 3600}
            if os.path.exists(state_path):
                raw_state = load_json(state_path)
                carried = [l for l in (raw_state.get("carried_commits") if isinstance(raw_state.get("carried_commits"), list) else [])
                           if isinstance(l, str) and COMMIT.match(l)][-CARRIED_CAP:]
                usage_state = {
                    k: dict(v) for k, v in (raw_state.get("usage") if isinstance(raw_state.get("usage"), dict) else {}).items()
                    if isinstance(k, str) and isinstance(v, dict) and isinstance(v.get("state"), str)
                }
                state_dirty = False
            else:
                carried = []
                usage_state = migrate_legacy_usage(seen)
                state_dirty = bool(usage_state)
            hb_state = load_json(hb_state_path)
            hb_usage = hb_state.get("usage_delivered") if isinstance(hb_state.get("usage_delivered"), dict) else None
            commits = [l for l in out[1:] if COMMIT.match(l)]
            act = [] if IDLE.match(first) else [l for l in out[1:] if not REMINDER.match(l) and not COMMIT.match(l)]
            active_usage = {}
            new = []
            for l in act:
                parsed = parse_usage_line(l)
                if parsed is not None:
                    ckey, wkey, ustate, threshold = parsed
                    active_usage[ckey] = (wkey, ustate, threshold)
                    hb_entry = hb_usage.get(ckey) if isinstance(hb_usage, dict) and isinstance(hb_usage.get(ckey), dict) else None
                    cur_resets = (hb_entry.get("resets_at") if hb_entry and isinstance(hb_entry.get("resets_at"), str)
                                  and hb_entry.get("resets_at") else None)
                    cur_did = (hb_entry.get("delivered_id") if hb_entry and isinstance(hb_entry.get("delivered_id"), str)
                               and hb_entry.get("delivered_id") else None)
                    prev = usage_state.get(ckey)
                    if isinstance(prev, dict) and "legacy_at" in prev:
                        if prev.get("state") == ustate and legacy_matches_window(prev.get("legacy_at"), wkey, cur_resets):
                            entry = {"state": ustate, "threshold": threshold, "resets_at": cur_resets}
                            if cur_did:
                                entry["hb_delivered_id"] = cur_did
                            usage_state[ckey] = entry
                            state_dirty = True
                        else:
                            new.append(l)
                    else:
                        prev_state = prev.get("state") if isinstance(prev, dict) else None
                        prev_resets = (prev.get("resets_at") if isinstance(prev, dict) and isinstance(prev.get("resets_at"), str)
                                       and prev.get("resets_at") else None)
                        prev_did = (prev.get("hb_delivered_id") if isinstance(prev, dict) and isinstance(prev.get("hb_delivered_id"), str)
                                    and prev.get("hb_delivered_id") else None)
                        if (prev_state != ustate or not same_reset_window(prev_resets, cur_resets)
                                or (cur_did and cur_did != prev_did)):
                            new.append(l)
                        elif not prev_resets and cur_resets:
                            usage_state[ckey]["resets_at"] = cur_resets
                            state_dirty = True
                elif ONCE.match(l) or t_now - seen.get(line_key(l), 0) >= (READ_EVERY_S if SOON.match(l) else REMIND_S):
                    new.append(l)
            if not NO_USAGE_READING.search(first):
                readings = summary_usage(first)
                hb_has_usage = os.path.exists(hb_state_path) and isinstance(hb_usage, dict)
                for ckey in list(usage_state):
                    if ckey in active_usage:
                        continue
                    wkey = ckey.rsplit(":", 1)[0]
                    if hb_has_usage:
                        if ckey not in hb_usage:
                            del usage_state[ckey]
                            state_dirty = True
                    else:
                        thresh = usage_state[ckey].get("threshold")
                        below_summary = (wkey in readings and isinstance(thresh, (int, float))
                                         and not isinstance(thresh, bool) and readings[wkey] < thresh)
                        standin_gone = wkey not in readings
                        if below_summary or standin_gone:
                            del usage_state[ckey]
                            state_dirty = True
            reads = not IDLE.match(first) and TOOL_READS.search(first) and t_now - seen.get("\0reads", 0) >= READ_EVERY_S
            if new or reads:
                seen = {k: v for k, v in seen.items()
                        if not (LEGACY_USAGE_MARK.match(k) or LEGACY_USAGE_BUILTIN.match(k))}
                for l in act:
                    if parse_usage_line(l) is None:
                        seen[line_key(l)] = t_now
                if reads or TOOL_READS.search(first):
                    seen["\0reads"] = t_now
                for ckey, (wkey, ustate, threshold) in active_usage.items():
                    hb_entry = hb_usage.get(ckey) if isinstance(hb_usage, dict) and isinstance(hb_usage.get(ckey), dict) else None
                    cur_resets = (hb_entry.get("resets_at") if hb_entry and isinstance(hb_entry.get("resets_at"), str)
                                  and hb_entry.get("resets_at") else None)
                    cur_did = (hb_entry.get("delivered_id") if hb_entry and isinstance(hb_entry.get("delivered_id"), str)
                               and hb_entry.get("delivered_id") else None)
                    prev_entry = usage_state.get(ckey) if isinstance(usage_state.get(ckey), dict) else {}
                    prev_resets = (prev_entry.get("resets_at") if "legacy_at" not in prev_entry
                                   and isinstance(prev_entry.get("resets_at"), str) else None)
                    stored_resets = (cur_resets if cur_resets and (not prev_resets or not same_reset_window(prev_resets, cur_resets))
                                     else (prev_resets or cur_resets))
                    entry = {"state": ustate, "threshold": threshold, "resets_at": stored_resets}
                    if cur_did:
                        entry["hb_delivered_id"] = cur_did
                    usage_state[ckey] = entry
                all_commits = list(carried)
                for c in commits:
                    if c not in all_commits:
                        all_commits.append(c)
                emit = [out[0]] + [l for l in out[1:] if not COMMIT.match(l)] + all_commits
                save_json_atomic(seen_path, seen)
                if os.path.exists(state_path) or usage_state or carried or state_dirty:
                    saved, save_err = save_json_atomic(state_path, {"carried_commits": [], "usage": usage_state})
                    if not saved:
                        emit.append(f"note: couldn't save watch-wait.state.json ({save_err})")
                why = (f"act on heartbeat's lines below ({len(new)} new of {len(act)})" if new
                       else "read the threads heartbeat names (blind, or on another computer)")
                print(f"watch-wait {time.strftime('%H:%M')}: {why}, after {minutes:.0f} min and {checks} checks; "
                      "then start watch-wait again")
                print("\n".join(emit))
                ledger_line(run_dir, f"woke after {minutes:.0f} min, {checks} checks: {summary}")
                return 0
            if commits:
                for c in commits:
                    if c not in carried:
                        carried.append(c)
                carried = carried[-CARRIED_CAP:]
                state_dirty = True
            if state_dirty:
                saved, save_err = save_json_atomic(state_path, {"carried_commits": carried, "usage": usage_state})
                if not saved and carried:
                    note = f"note: couldn't save watch-wait.state.json ({save_err})"
                    print(f"watch-wait {time.strftime('%H:%M')}: act on heartbeat's lines below (1 new of 1), "
                          f"after {minutes:.0f} min and {checks} checks; then start watch-wait again")
                    print("\n".join([out[0], note] + carried))
                    ledger_line(run_dir, f"woke after {minutes:.0f} min, {checks} checks: {summary}")
                    return 0
            left = deadline - time.time()
            if left <= 0:
                print(f"watch-wait {time.strftime('%H:%M')}: nothing new to act on in {minutes:.0f} min ({checks} checks): "
                      f"start it again. {first}")
                ledger_line(run_dir, f"nothing new to act on in {minutes:.0f} min, {checks} checks: {summary}")
                return 0
            time.sleep(min(every, left))
    finally:
        try:
            if open(pid_path).read().split()[:1] == [str(os.getpid())]:
                os.remove(pid_path)
        except (OSError, IndexError):
            pass


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
