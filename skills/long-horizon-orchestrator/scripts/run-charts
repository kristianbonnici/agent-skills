#!/usr/bin/env python3
"""Write the final report's run map (run-map.html, run-map.svg, run-map-t3.html), its two Mermaid
charts (graph.mmd, timeline.mmd) and its run-time line (summary.txt) from a run's facts.

The run map is the report's picture of the run in T3, where html_render shows it: the
orchestrator and its tasks as a tree of cards you can pan, zoom and rearrange, with each task's
sub-agents, what it waited for, its pictures, and a timeline with a lane per agent.
The Mermaid charts are the same picture for hosts that can't show HTML. Both follow
references/final-report.md ("Run map", "Run charts"), coloured by each task's reasoning level at
launch.

Facts file (JSON):

  {
    "harness": "Claude Code (T3) · Opus 5.5",       # optional: say it once when every task used it
    "orchestrator": "Claude Code (T3) · Opus 5.5 (Extra High)",
    "integration": {"branch": "main", "head": "4e1c2a7"},
    "run": {                                         # optional: the whole run, from the user's approval
      "start": "00:50", "end": "07:35",              # to the final report
      "level": "xhigh",                              # the orchestrator's reasoning level
      "worked_minutes": 25, "wakes": 18              # the orchestrator's own turns in that time
    },
    "pauses": [{"start": "04:17", "end": "05:55", "reason": "Claude limit", "which": "all tasks"}],
    "tasks": [
      {
        "id": "A", "name": "Settings screen",
        "level": "high",              # "above" (Max, Ultracode…), "xhigh", or "high" (high or lower)
        "level_label": "",            # optional, named in the timeline, e.g. "Ultracode → Extra High";
                                      # Max, Ultracode, Medium and Low are named without it
        "agent": "",                  # optional second line when tasks ran on different harnesses
        "note": "",                   # optional line the reader must notice: "1 screen check left for you"
        "first_wave": true,           # launched without waiting for another task
        "needs": [],                  # task IDs whose code it needed
        "took_place_of": "",          # task ID whose finish made room for it
        "replaces": "",               # task ID of the attempt this one relaunched
        "qa": false,                  # tested the integration branch and merged its own fixes
        "helpers": [{"label": "Codex · GPT-6.1 Terra (High)", "did": "screen check ×1"}],
        "status": "merged",           # merged, ready, blocked, failed, stopped, parked, replaced
        "launched": "01:00", "ended": "01:35",   # "HH:MM", or "YYYY-MM-DD HH:MM" for runs past midnight
        "worked_minutes": 30
      }
    ]
  }

Only for the run map, all optional:

  "title": "OrbOS · night run", "date": "Sun 18 Oct",
  "integration": {..., "ci": "passed"},             # or "failed"
  "run": {..., "summary": "<the run's goal in one line>",
          "turns": [["00:50", "01:02"], ...],      # the orchestrator's own turns
          "helpers": [...]},                       # as a task's
  a task's "summary": "<what it did or what you can now do, in one line>",
           "turns": [["01:00", "01:20"], ...],     # its own turns, from the host's per-turn records
           "pictures": [{"src": "A/pictures/settings.png", "caption": "The new settings screen"}],
                                                   # relative to the facts file, or absolute
  a helper's "status": "done" (or failed, cancelled), "role": "review" or "research",
             "count": 2                            # when "did" doesn't end with ×2

  a task's, a helper's or the run's "maker": "moonshotai"  # when the model's name doesn't say it

  "usage": {"folder": "<run directory>/usage"}     # the folder scripts/usage-sampler wrote (absolute, or
                                                   # relative to the facts file): machine.jsonl and
                                                   # providers.jsonl. Adds a usage panel under the timeline, usage.mmd and
                                                   # usage-mac.mmd, and a line in summary.txt. Without it, nothing changes.

A pause's "which" names the tasks it stopped ("F only", "A, C"); without task IDs it covers every
task running then. Each card's mark is its model's maker, found from "maker" or the model's name,
else, for a model named only "default" or "auto", its harness's, else a letter: assets/marks/marks.json.

Usage:
  run-charts <facts.json> <output folder> [--render] [--puppeteer-config <file>]

run-map-t3.html is the page to paste into html_render in T3: a few thousand characters, because
it only loads run-map.svg (the whole map, carried as an image that html_render inlines) and the
marks and pictures, all by absolute path. Keep the output folder where it is until the report has
been rendered. run-map.html is the same map on its own, to open in a browser.

summary.txt gets the report's run-time line: how long the run took, how much of it was paused,
how long the orchestrator and the tasks worked, and how many tasks ran at once at most. With a
usage folder, a second line says each subscription's use from start to end and the Mac's peaks.

The usage panel sits under the timeline on the same time axis: each subscription's weekly window
(Copilot's monthly one), for each subscription the run used, as the percent left, a smooth line falling from 100% as it is used,
and a separate limit in use during the run (Antigravity's Gemini 4 Argon) as a dashed line, in its maker's colour
(assets/marks/marks.json), with window resets dotted (a reading of a window that has reset since it was
read is no point: the line holds to the reset and goes on from the next reading taken after it); its 5-hour window is left out, and so are
quota pauses, which the timeline hatches on the lanes they stopped; then the Mac's CPU and GPU busy, memory in use and free disk, as the average per minute with its
peak behind it. In run-map.html hovering shows the values at that minute and the tasks working then.

--render also draws each chart on a white and on a black background with the Mermaid command
line (mmdc), when it is installed, so you can look at them before posting.
"""

from __future__ import annotations

import argparse
import base64
import json
import math
import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from xml.sax.saxutils import escape

FONT = "Helvetica Neue, Helvetica, Arial, sans-serif"
GRAPH_INIT = (
    '%%{init: {"theme": "base", "fontFamily": "' + FONT + '", "themeVariables": {"titleColor": "#71717a", '
    '"textColor": "#71717a", "lineColor": "#8a8a93"}, "flowchart": {"curve": "basis", "nodeSpacing": 16, '
    '"rankSpacing": 46}}}%%'
)
TIMELINE_INIT = """%%{init: {"theme": "base", "themeCSS": ".grid .tick line { stroke-opacity: 0.25; }", "fontFamily": "Helvetica Neue, Helvetica, Arial, sans-serif", "themeVariables": {
  "titleColor": "#71717a", "textColor": "#71717a",
  "sectionBkgColor": "#ef4444", "altSectionBkgColor": "#71717a", "sectionBkgColor2": "#f59e0b",
  "gridColor": "#808080",
  "taskBkgColor": "#2563eb", "taskBorderColor": "#1d4ed8", "taskTextColor": "#ffffff", "taskTextLightColor": "#ffffff", "taskTextDarkColor": "#ffffff", "taskTextOutsideColor": "#71717a",
  "activeTaskBkgColor": "#7c3aed", "activeTaskBorderColor": "#6d28d9",
  "doneTaskBkgColor": "#0d9488", "doneTaskBorderColor": "#0f766e",
  "critBkgColor": "#991b1b", "critBorderColor": "#dc2626"
}, "gantt": {"barHeight": 22, "barGap": 6, "topPadding": 56, "leftPadding": 120, "fontSize": 13, "sectionFontSize": 13, "numberSectionStyles": 3}}}%%"""
CLASS_DEFS = [
    "classDef orch fill:#52525b,stroke:#3f3f46,color:#ffffff",
    "classDef above fill:#7c3aed,stroke:#6d28d9,color:#ffffff",
    "classDef xhigh fill:#2563eb,stroke:#1d4ed8,color:#ffffff",
    "classDef high fill:#0d9488,stroke:#0f766e,color:#ffffff",
    "classDef helper fill:transparent,stroke:#8a8a93,color:#71717a",
    "classDef parked fill:transparent,stroke:#8a8a93,stroke-dasharray:4 3,color:#71717a",
    "classDef blocked stroke:#dc2626,stroke-width:3px",
    "classDef failed stroke:#f59e0b,stroke-width:3px",
    "classDef replaced stroke-dasharray:5 4",
]
EDGE_STYLES = {
    "launch": "stroke:#8a8a93,stroke-width:1px,stroke-opacity:0.6",
    "helper": "stroke:#8a8a93,stroke-width:1px,stroke-dasharray:2 3",
    "place": "stroke:#8a8a93,stroke-width:1.5px",
    "code": "stroke:#f59e0b,stroke-width:2.5px",
    "merge": "stroke:#8a8a93,stroke-width:1px,stroke-opacity:0.35",
}
LEVELS = {"above": "above", "max": "above", "ultra": "above", "ultracode": "above", "ultrathink": "above",
          "xhigh": "xhigh", "extra high": "xhigh", "high": "high", "medium": "high", "low": "high"}
# Levels the colour alone doesn't pin down, so the timeline names them.
NAMED_LEVELS = {"max", "ultra", "ultracode", "ultrathink", "medium", "low"}
OUTCOME = {"blocked": "blocked", "failed": "failed", "stopped": "stopped, nothing merged",
           "ready": "ready, not merged", "replaced": "replaced"}


def node(task_id: str) -> str:
    return "T_" + re.sub(r"\W", "_", task_id)


def label(text: str) -> str:
    return text.replace('"', "#quot;")


def level(task: dict) -> str:
    value = str(task.get("level", "high")).strip().lower()
    if value not in LEVELS:
        raise SystemExit(f"run-charts: task {task['id']} has an unknown level {task.get('level')!r}")
    return LEVELS[value]


def span(minutes: int) -> str:
    hours, rest = divmod(max(0, minutes), 60)
    return f"{hours}h {rest:02d}m" if hours else f"{rest}m"


class Clock:
    """Reads "HH:MM" or "YYYY-MM-DD HH:MM", whichever the facts use, consistently."""

    def __init__(self, values: list[str]):
        dated = [" " in v for v in values]
        if any(dated) and not all(dated):
            raise SystemExit("run-charts: use either HH:MM or YYYY-MM-DD HH:MM for every time, not both")
        self.dated = bool(values) and all(dated)
        self.format = "%Y-%m-%d %H:%M" if self.dated else "%H:%M"
        self.mermaid = "YYYY-MM-DD HH:mm" if self.dated else "HH:mm"

    def minutes(self, start: str, end: str) -> int:
        delta = datetime.strptime(end, self.format) - datetime.strptime(start, self.format)
        if delta.total_seconds() < 0:
            raise SystemExit(f"run-charts: {end} is before {start}; give dates for a run past midnight")
        return int(delta.total_seconds() // 60)


def graph(facts: dict) -> str:
    tasks = facts["tasks"]
    branch = facts.get("integration", {}).get("branch", "main")
    head = facts.get("integration", {}).get("head", "")
    statuses = {t.get("status", "merged") for t in tasks}

    legend = []
    if facts.get("harness"):
        legend.append(f"All tasks: {facts['harness']}")
    if any(t.get("needs") for t in tasks):
        legend.append("amber = needed its code")
    if any(t.get("took_place_of") for t in tasks):
        legend.append("grey dotted = took a finished task's place")
    if any(t.get("helpers") for t in tasks):
        legend.append("grey pill = helper")
    legend.append(f"faint = merged into {branch}")
    if any(t.get("qa") for t in tasks):
        legend.append(f"two-way = QA tested {branch}, then merged its fixes")
    if statuses & {"stopped", "parked"}:
        legend.append("dashed outline = stopped or never started, nothing merged")
    if "blocked" in statuses:
        legend.append("red border = blocked")
    if "failed" in statuses:
        legend.append("amber border = failed")
    bands = {level(t) for t in tasks}
    names = [("above", "violet above Extra High"), ("xhigh", "blue Extra High"), ("high", "teal High or lower")]
    legend.append(" · ".join(text for key, text in names if key in bands) + " (effort at launch)")

    orchestrator = facts.get("orchestrator", "Orchestrator")
    lines_o = ["Orchestrator", orchestrator]
    run = facts.get("run")
    if run and run.get("start") and run.get("end"):
        clock = Clock(times_of(facts))
        total = clock.minutes(run["start"], run["end"])
        worked = run.get("worked_minutes")
        lines_o.append(f"whole run {span(total)}" + (f", worked {span(min(int(worked), total))}" if worked is not None else ""))
    for pause in facts.get("pauses", []):
        lines_o.append(f"paused {pause['start']}–{pause['end']}" + (f" · {pause['reason']}" if pause.get("reason") else ""))

    lines = ["---", f'title: "{label(" · ".join(legend))}"', "---", GRAPH_INIT, "flowchart TB",
             f'  O(["{label("<br/>".join(lines_o))}"]):::orch']
    classes: dict[str, list[str]] = {}
    for t in tasks:
        status = t.get("status", "merged")
        text = [f"{t['id']} · {t['name']}"] + [x for x in (t.get("agent"), t.get("note")) if x]
        style = "parked" if status in ("parked", "stopped") else level(t)
        lines.append(f'  {node(t["id"])}["{label("<br/>".join(text))}"]:::{style}')
        if status in ("blocked", "failed", "replaced"):
            classes.setdefault(status, []).append(node(t["id"]))
    helper_nodes = []
    for t in tasks:
        for n, h in enumerate(t.get("helpers") or [], 1):
            hid = f"H_{node(t['id'])[2:]}_{n}"
            text = "<br/>".join(x for x in (h.get("label"), h.get("did")) if x)
            lines.append(f'  {hid}(["{label(text)}"]):::helper')
            helper_nodes.append((t["id"], hid))
    lines.append(f'  MAIN[("{label(branch)}' + (f"<br/>{label(head)}" if head else "") + '")]:::orch')

    edges: list[tuple[str, str]] = []
    for t in tasks:
        if t.get("first_wave") or not (t.get("needs") or t.get("took_place_of") or t.get("replaces") or t.get("qa")):
            edges.append((f"  O --> {node(t['id'])}", "launch"))
    for task_id, hid in helper_nodes:
        edges.append((f"  {node(task_id)} -.- {hid}", "helper"))
    for t in tasks:
        if t.get("replaces"):
            edges.append((f"  {node(t['replaces'])} --> {node(t['id'])}", "launch"))
    for t in tasks:
        for need in t.get("needs") or []:
            edges.append((f"  {node(need)} ==> {node(t['id'])}", "code"))
    for t in tasks:
        if t.get("took_place_of"):
            edges.append((f"  {node(t['took_place_of'])} -.-> {node(t['id'])}", "place"))
    for t in tasks:
        if t.get("status", "merged") == "merged" and not t.get("qa"):
            arrow = "--->" if t.get("first_wave") else "-->"
            edges.append((f"  {node(t['id'])} {arrow} MAIN", "merge"))
    for t in tasks:
        if t.get("qa") and t.get("status", "merged") == "merged":
            edges.append((f"  MAIN <==> {node(t['id'])}", "code"))
    lines += [text for text, _ in edges]
    lines += ["  " + c for c in CLASS_DEFS]
    for status, ids in classes.items():
        lines.append(f"  class {','.join(ids)} {status}")
    for kind, style in EDGE_STYLES.items():
        indexes = [str(i) for i, (_, k) in enumerate(edges) if k == kind]
        if indexes:
            lines.append(f"  linkStyle {','.join(indexes)} {style}")
    return "\n".join(lines) + "\n"


def times_of(facts: dict) -> list[str]:
    times = [p[k] for p in facts.get("pauses", []) for k in ("start", "end")]
    times += [t[k] for t in facts["tasks"] if t.get("launched") and t.get("ended") for k in ("launched", "ended")]
    run = facts.get("run") or {}
    times += [run[k] for k in ("start", "end") if run.get(k)]
    return times


def timed(tasks: list[dict]) -> list[dict]:
    return [t for t in tasks if t.get("launched") and t.get("ended") and t.get("status") != "parked"]


def timeline(facts: dict) -> str:
    tasks = facts["tasks"]
    pauses = facts.get("pauses", [])
    clock = Clock(times_of(facts))
    run = facts.get("run") or {}
    bands = {level(t) for t in tasks}
    names = [("above", "violet above Extra High"), ("xhigh", "blue Extra High"), ("high", "teal High or lower")]
    if run.get("start") and run.get("end"):
        bands.add(level({"id": "orchestrator", "level": run.get("level", "high")}))
    title = ("Bar = launch to merge or stop" + (" · last bar = whole run, approval to report" if run.get("start") else "")
             + " · " + " · ".join(text for key, text in names if key in bands)
             + " (effort at launch)" + (" · red = quota pause" if pauses else ""))
    lines = [TIMELINE_INIT, "gantt", "  todayMarker off", f"  title {title}",
             f"  dateFormat {clock.mermaid}", "  axisFormat %H:%M"]
    if pauses:
        lines.append("  section Quota pauses")
        for n, p in enumerate(pauses, 1):
            text = f"Paused {span(clock.minutes(p['start'], p['end']))}" + (f" · {p['which']}" if p.get("which") else "")
            lines.append(f"    {text.replace(':', '')} :crit, p{n}, {p['start']}, {p['end']}")
    used: set[str] = set()
    for title_, first in (("First wave", True), ("Launched later", False)):
        rows = [t for t in timed(tasks) if bool(t.get("first_wave")) == first]
        if not rows:
            continue
        lines.append(f"  section {title_}")
        for t in rows:
            parts = [f"{t['id']} · {t['name']}"]
            raw = str(t.get("level", "")).strip().lower()
            named = t.get("level_label") or (raw.title() if raw in NAMED_LEVELS else "")
            if named:
                parts.append(named)
            why = ""
            if t.get("qa"):
                why = " (after the others merged)"
            elif t.get("needs"):
                why = f" (needed {', '.join(t['needs'])})"
            elif t.get("took_place_of"):
                why = f" (took {t['took_place_of']}'s place)"
            parts[0] += why
            outcome = OUTCOME.get(t.get("status", "merged"))
            if outcome:
                parts.append(outcome)
            total = clock.minutes(t["launched"], t["ended"])
            parts.append(f"{span(total)}, worked {span(min(int(t.get('worked_minutes', total)), total))}")
            tag = {"above": "active, ", "xhigh": "", "high": "done, "}[level(t)]
            gid = re.sub(r"\W", "_", t["id"].lower())
            while gid in used or gid.startswith("p") and gid[1:].isdigit():
                gid += "_"
            used.add(gid)
            text = " · ".join(parts).replace(":", "").replace("#", "")
            lines.append(f"    {text} :{tag}{gid}, {t['launched']}, {t['ended']}")
    if run.get("start") and run.get("end"):
        total = clock.minutes(run["start"], run["end"])
        text = f"Orchestrator · {span(total)}"
        if run.get("worked_minutes") is not None:
            text += f", worked {span(min(int(run['worked_minutes']), total))}"
        tag = {"above": "active, ", "xhigh": "", "high": "done, "}[level({"id": "orchestrator", "level": run.get("level", "high")})]
        gid = "whole_run"
        while gid in used:
            gid += "_"
        lines += ["  section Whole run", f"    {text.replace(':', '')} :{tag}{gid}, {run['start']}, {run['end']}"]
    return "\n".join(lines) + "\n"


def summary(facts: dict) -> str:
    """The report's run-time line, so nobody adds up durations by hand."""
    tasks = timed(facts["tasks"])
    clock = Clock(times_of(facts))
    run = facts.get("run") or {}
    if run.get("start") and run.get("end"):
        start, end = run["start"], run["end"]
    elif tasks:
        start, end = min(t["launched"] for t in tasks), max(t["ended"] for t in tasks)
    else:
        return ""
    short = (lambda v: v.split(" ")[1]) if clock.dated else (lambda v: v)
    # only a pause that stopped every task running then is the run's own; one that names its tasks
    # left the others working, so it names them instead of counting as the run's paused time
    ids = [t["id"] for t in facts["tasks"]]   # a parked task can have paused too
    named = lambda p: [i for i in re.findall(r"[A-Za-z0-9_-]+", p.get("which", "")) if i in ids]
    paused = sum(clock.minutes(p["start"], p["end"]) for p in facts.get("pauses", []) if not named(p))
    some = list(dict.fromkeys(i for p in facts.get("pauses", []) for i in named(p)))
    text = f"Run time: {span(clock.minutes(start, end))} ({short(start)}–{short(end)})"
    if paused:
        text += f", including {span(paused)} paused for quota"
    if some:
        text += (" and " if paused else ", with ") + (", ".join(some[:-1]) + " and " + some[-1] if len(some) > 1 else some[0]) + " paused for quota at times"
    text += "."
    worked = sum(min(int(t.get("worked_minutes", clock.minutes(t["launched"], t["ended"]))),
                     clock.minutes(t["launched"], t["ended"])) for t in tasks)
    events = sorted([(clock.minutes(start, t["launched"]), 1) for t in tasks]
                    + [(clock.minutes(start, t["ended"]), -1) for t in tasks])
    running = most = 0
    for _, step in events:  # an end at the same minute as a launch counts first
        running += step
        most = max(most, running)
    parts = []
    if run.get("worked_minutes") is not None:
        wakes = f" over {run['wakes']} wakes" if run.get("wakes") else ""
        parts.append(f"the orchestrator worked {span(int(run['worked_minutes']))}{wakes}")
    if tasks:
        parts.append(f"the tasks worked {span(worked)} together, with at most {most} running at once")
    if parts:
        joined = "; ".join(parts)
        text += " " + joined[0].upper() + joined[1:] + "."
    if not (run.get("start") and run.get("end")):
        text += " (From the first launch to the last finish; the run's own start and end weren't given.)"
    return text


def render(folder: Path, puppeteer_config: str | None) -> None:
    mmdc = shutil.which("mmdc")
    if not mmdc:
        print("run-charts: mmdc isn't installed (npm i -g @mermaid-js/mermaid-cli); charts written, not rendered")
        return
    for name in [n for n in ("graph", "timeline", "usage", "usage-mac") if (folder / f"{n}.mmd").exists()]:
        for background in ("white", "black"):
            command = [mmdc, "-i", str(folder / f"{name}.mmd"), "-o", str(folder / f"{name}-{background}.png"),
                       "-b", background, "-s", "2", "-w", "1600"]
            if puppeteer_config:
                command += ["-p", puppeteer_config]
            result = subprocess.run(command, capture_output=True, text=True)
            print(f"run-charts: {name}-{background}.png " + ("written" if result.returncode == 0 else
                                                              f"failed: {result.stderr.strip()[:300]}"))


# --- usage: the samples scripts/usage-sampler wrote, drawn under the timeline -------------------

PROVIDER_NAMES = {"claude": "Claude", "codex": "Codex", "antigravity": "Antigravity", "copilot": "Copilot"}
NEUTRAL = "#8a8a93"


def read_lines(path: Path) -> list[dict]:
    """The sampler's JSON lines; a line cut off by a sampler still writing, or not JSON, is skipped."""
    out = []
    try:
        text = path.read_text(errors="replace")   # a byte that isn't UTF-8 spoils its own line only
    except OSError:
        return out
    for line in text.splitlines():
        try:
            record = json.loads(line)
        except ValueError:
            continue
        if isinstance(record, dict) and isinstance(record.get("t"), str):
            out.append(record)
    return out


def is_number(value) -> bool:
    """A finite number that isn't a boolean."""
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)


def local_time(value, zone=None):
    """A sampler time as the local wall clock it was written in (the facts' own clock), else None."""
    try:
        moment = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except ValueError:
        return None
    if zone is not None and moment.tzinfo is not None:
        moment = moment.astimezone(zone)
    return moment.replace(tzinfo=None)


def window_name(key: str) -> str:
    if key == "five_hour":
        return "5-hour"
    if key in ("weekly", "monthly"):
        return key.capitalize()
    base, _, kind = re.sub(r"_(five_hour|weekly|monthly)$", r"|\1", key).partition("|")
    base = re.sub(r"_models$", "", base)   # Antigravity's "gemini_models": every Gemini model, "Gemini"
    words = [w.upper() if w == "gpt" else w if w == "and" else w.capitalize() for w in base.split("_")]
    return " ".join(words) + " " + {"five_hour": "5-hour", "weekly": "weekly", "monthly": "monthly"}.get(kind, "")


def line_colour(entry: dict | None) -> str | None:
    """A provider's line colour from its maker's entry: "line", else a solid ink, else a gradient's
    first colour, else None (the page draws it neutral)."""
    if not entry:
        return None
    for value in (entry.get("line"), entry.get("ink")):
        found = re.search(r"#[0-9a-fA-F]{6}", value or "")
        if found:
            return found.group(0)
    return None


def usage_data(folder: Path, dated: bool, first, span: tuple[float, float] | None, makers: list[dict], mark_of) -> dict | None:
    """The usage panel's data: minutes on the facts' own axis (as the map's times), the Mac's samples
    aggregated per minute (average and peak), and each subscription's weekly or monthly windows as runs
    of points in percent left (its 5-hour window isn't drawn).
    span is the timeline's (start, end) in minutes, or None; mark_of(entry) gives a mark's file index."""
    machine = read_lines(folder / "machine.jsonl")
    reads = read_lines(folder / "providers.jsonl")
    stamps = [local_time(r["t"]) for r in machine + reads]
    stamps = [s for s in stamps if s]
    if not stamps:
        return None
    day = None
    if not dated:  # clock times only: the day with most samples
        days = [s.date() for s in stamps]
        day = max(set(days), key=days.count)

    def minute(moment):
        if moment is None:
            return None
        if dated:
            return (moment - first.replace(hour=0, minute=0, second=0)).total_seconds() / 60
        return moment.hour * 60 + moment.minute + moment.second / 60 if moment.date() == day else None

    seen = [m for m in (minute(s) for s in stamps) if m is not None]
    if not seen:
        return None
    t0, t1 = span if span else (min(seen), max(min(seen) + 1, max(seen)))
    start, count = int(t0 // 1), int(t1 // 1) - int(t0 // 1) + 1

    # the Mac: per minute, the average and the peak of the samples in it
    buckets: dict[int, list[dict]] = {}
    for record in machine:
        m = minute(local_time(record["t"]))
        if m is not None and t0 <= m < t1 + 1:
            buckets.setdefault(int(m // 1) - start, []).append(record)

    def series(key: str, peak=max) -> tuple[list, list]:
        avg: list = [None] * count
        top: list = [None] * count
        for i, records in buckets.items():
            values = [r[key] for r in records if is_number(r.get(key))]
            if values and 0 <= i < count:
                avg[i], top[i] = round(sum(values) / len(values), 1), round(peak(values), 1)
        return avg, top

    mac = None
    if buckets:
        mac = {}
        for key, name, peak in (("cpu", "cpu", max), ("gpu", "gpu", max), ("mem_used_gb", "mem", max), ("disk_free_gb", "disk", min)):
            mac[name], mac[name + "_pk"] = series(key, peak)
        totals = [r["mem_total_gb"] for rs in buckets.values() for r in rs if is_number(r.get("mem_total_gb"))]
        mac["mem_total"] = totals[-1] if totals else None
        mac["samples"] = sum(len(v) for v in buckets.values())
        for name in ("cpu", "gpu", "mem", "disk"):
            if not any(v is not None for v in mac[name]):
                mac.pop(name), mac.pop(name + "_pk")
        if not any(k in mac for k in ("cpu", "gpu", "mem", "disk")):
            mac = None

    # the subscriptions: the weekly or monthly window as runs of points, one run per reset period
    found: dict[str, dict] = {}
    newest: dict[str, datetime] = {}
    for record in reads:
        moment = local_time(record["t"])
        m = minute(moment)
        if m is None or not (t0 - 10 <= m <= t1 + 10):
            continue
        try:
            zone = datetime.fromisoformat(record["t"].replace("Z", "+00:00")).tzinfo
        except ValueError:
            continue
        providers_now = record.get("providers")
        if not isinstance(providers_now, dict):   # a record of the wrong shape is skipped
            continue
        for name, p in providers_now.items():
            if not isinstance(p, dict) or not isinstance(p.get("windows"), dict):
                continue
            try:  # a cached reading older than one already taken is a harness log that went stale: left out
                seen_at = datetime.fromisoformat(str(p.get("observed_at")).replace("Z", "+00:00"))
                seen_at = seen_at if seen_at.tzinfo else seen_at.replace(tzinfo=zone)
            except ValueError:
                seen_at = None
            if seen_at is not None:
                if name in newest and seen_at < newest[name]:
                    continue
                newest[name] = seen_at
            for key, w in p["windows"].items():
                if not isinstance(w, dict) or not is_number(w.get("used")):
                    continue
                resets = local_time(w.get("resets_at"), zone)
                # A window that has reset since it was read says nothing about its use now: kept as a
                # reset only, with no value, until a reading from after the reset comes.
                over = bool(w.get("reset")) or (resets is not None and resets <= moment)
                found.setdefault(name, {"plan": p.get("plan"), "windows": {}})["windows"].setdefault(key, []).append(
                    (m, float(w["used"]), minute(resets), over))
    providers = []
    for name, info in found.items():
        entry = next((e for e in makers if e.get("harnesses") and re.search(e["harnesses"], name, re.I)), None)
        def slot_of(key: str) -> dict:
            """A window as runs of points, one run per reset period, in percent left (100 at a reset)."""
            points = sorted(info["windows"][key])
            runs: list[list[list[float]]] = []
            resets: list[float] = []
            group = prior = None
            gaps = sorted(b[0] - a[0] for a, b in zip(points, points[1:]))
            # a gap this long is a sampler that wasn't running; a weekly window hardly moves in an hour, so the
            # hourly live readings alone (a harness's log gone stale) still make one line
            longest = max(75.0, 3 * gaps[len(gaps) // 2]) if gaps else 75.0
            previous = None
            lapsed = None   # where a window reset with no reading since: the next run begins there, at zero
            for m, used, reset_at, over in points:
                if over:
                    # the window reset since it was read: no point (its use now is unknown), but the period
                    # before holds its value to the reset, which is marked
                    if runs and prior is not None and runs[-1][-1][0] < prior <= m:
                        runs[-1].append([round(prior, 2), runs[-1][-1][1]])
                        resets.append(round(prior, 2))
                        lapsed = round(prior, 2)
                    continue
                same = runs and over == group[1] and (reset_at == group[0] or (
                    reset_at is not None and group[0] is not None and abs(reset_at - group[0]) <= 5))  # a reset time corrected by a minute
                if same and m - previous <= longest:
                    runs[-1].append([round(m, 2), used])
                    previous = m
                    continue
                previous = m
                if same:  # the same window after a gap: a new run, with no reset in between
                    runs.append([[round(m, 2), used]])
                    group, prior = (reset_at, over), reset_at
                    continue
                begin = []
                # the period before held its value until its window reset, and this one began at zero
                if runs and prior is not None and runs[-1][-1][0] < prior <= m:
                    runs[-1].append([round(prior, 2), runs[-1][-1][1]])
                    begin = [[round(prior, 2), 0.0]]
                    resets.append(round(prior, 2))
                elif lapsed is not None:   # held and marked above, when its reset showed in a stale reading
                    begin = [[lapsed, 0.0]]
                lapsed = None
                runs.append(begin + [[round(m, 2), used]])
                group, prior = (reset_at, over), reset_at
            # a reset just after the last reading, inside the run, is marked too (later ones would be a guess)
            last, tail = points[-1][0], points[-1][2]
            if runs and tail is not None and not points[-1][3] and last <= tail <= last + 10 and t0 <= tail <= t1:
                resets.append(round(tail, 2))
            resets = sorted({r for r in resets if t0 <= r <= t1})
            segs = [[[m, round(100 - used, 1)] for m, used in run] for run in runs]
            return {"id": key, "label": window_name(key), "segs": segs, "resets": resets}

        def moved(slot: dict) -> bool:
            """Whether the run used the window: it changed during the run, or reset."""
            return bool(slot["resets"]) or len({v for run in slot["segs"] for m, v in run if t0 <= m <= t1}) > 1

        # the weekly or monthly windows: the plan's own first (a key of just "weekly" or "monthly", else
        # the one read most often), then each separate limit (a model's own, as Antigravity's Gemini 4
        # Argon) that the run used; a subscription none of whose windows moved isn't shown at all, and
        # the 5-hour windows aren't drawn
        longs = [k for k in info["windows"] if k.endswith(("weekly", "monthly"))]
        picked = {}
        if longs:
            main = next((k for k in longs if k in ("weekly", "monthly")), None) or max(longs, key=lambda k: len(info["windows"][k]))
            more = [slot for slot in (slot_of(k) for k in longs if k != main) if moved(slot)]
            first = slot_of(main)
            if not first["segs"]:   # only stale readings of it: nothing to draw, so the next window leads
                first, more = (more[0], more[1:]) if more else (None, [])
            if first and (more or moved(first)):
                picked["long"] = first
            if more:
                picked["more"] = more
        if picked:
            mark, ink = mark_of(entry) if entry else (None, None)
            providers.append({"id": name, "name": PROVIDER_NAMES.get(name, name.title()), "plan": info["plan"],
                              "colour": line_colour(entry), "mark": mark, "ink": ink, **picked})
    if not mac and not providers:
        return None
    data = {"t0": t0, "t1": t1, "start": start, "count": count, "providers": providers, "mac": mac}
    if mac:
        data["peaks"] = {
            "cpu": max((v for v in mac.get("cpu_pk", []) if v is not None), default=None),
            "gpu": max((v for v in mac.get("gpu_pk", []) if v is not None), default=None),
            "mem": max((v for v in mac.get("mem_pk", []) if v is not None), default=None),
            "mem_total": mac.get("mem_total"),
            "disk_first": next((v for v in mac.get("disk", []) if v is not None), None),
            "disk_last": next((v for v in reversed(mac.get("disk", [])) if v is not None), None),
            "disk_lowest": min((v for v in mac.get("disk_pk", []) if v is not None), default=None),
        }
    return data


def pct(value: float) -> str:
    return f"{value:.1f}".rstrip("0").rstrip(".") + "%"


def said(slot: dict) -> str:
    """A window's name inside a sentence: "weekly", "monthly", "Gemini weekly", "Gemini 4 Argon weekly"."""
    label = slot["label"]
    return label.lower() if label in ("Weekly", "Monthly") else label


def window_ends(slot: dict, t0: float, t1: float) -> tuple[float, float, int]:
    """A window's use at the start and at the end of the run, and the resets between."""
    points = [p for run in slot["segs"] for p in run]
    inside = [p for p in points if t0 <= p[0] <= t1] or points
    return inside[0][1], inside[-1][1], len(slot["resets"])


def usage_line(usage: dict) -> str:
    """The report's usage line for summary.txt: each subscription's windows from start to end, in percent
    left, and the Mac's peaks."""
    parts = []
    for p in usage["providers"]:
        bits = []
        for slot in [p["long"]] + p.get("more", []) if p.get("long") else []:
            a, b, resets = window_ends(slot, usage["t0"], usage["t1"])
            bits.append(f"{said(slot)} {pct(a)} → {pct(b)} left"
                        + (f" (reset {resets}×)" if resets else ""))
        if bits:
            parts.append(f"{p['name']} " + ", ".join(bits))
    text = "Usage: " + "; ".join(parts) + "." if parts else "Usage:"
    peaks = usage.get("peaks")
    if peaks:
        bits = []
        if peaks["cpu"] is not None:
            bits.append(f"{peaks['cpu']:g}% CPU")
        if peaks["gpu"] is not None:
            bits.append(f"{peaks['gpu']:g}% GPU")
        if peaks["mem"] is not None:
            bits.append(f"{peaks['mem']:g}" + (f" of {peaks['mem_total']:g}" if peaks["mem_total"] else "") + " GB memory")
        sentence = "The Mac peaked at " + (", ".join(bits[:-1]) + " and " + bits[-1] if len(bits) > 1 else "".join(bits)) if bits else ""
        if peaks["disk_first"] is not None and peaks["disk_last"] is not None:
            disk = f"free disk went from {peaks['disk_first']:g} to {peaks['disk_last']:g} GB"
            if peaks["disk_lowest"] is not None and peaks["disk_lowest"] < peaks["disk_last"]:
                disk += f" (lowest {peaks['disk_lowest']:g})"
            sentence = f"{sentence}, and {disk}" if sentence else f"On the Mac, {disk}"
        if sentence:
            text += " " + sentence + "."
    return text


def clock_text(m: float) -> str:
    return f"{int(m // 60) % 24:02d}:{int(m % 60):02d}"


def usage_mermaid(usage: dict, facts: dict) -> dict[str, str]:
    """The fallback for hosts that can't show HTML: usage.mmd (the subscriptions' weekly or monthly windows, % left) and
    usage-mac.mmd (CPU, GPU and memory, the peak in each stretch), as xychart-beta line charts."""
    t0, t1 = usage["t0"], usage["t1"]
    width = next((w for w in (5, 10, 15, 30, 60, 120, 180, 240) if (t1 - t0) / w <= 24), 360)
    starts = [t0 + i * width for i in range(int((t1 - t0) // width) + 1)]
    labels = ", ".join(f'"{clock_text(s)}"' for s in starts)
    axis = "%%{init: {\"theme\": \"base\", \"fontFamily\": \"" + FONT + "\", \"themeVariables\": {\"xyChart\": {\"backgroundColor\": \"transparent\", \"titleColor\": \"#71717a\", " \
        "\"xAxisLabelColor\": \"#71717a\", \"xAxisTitleColor\": \"#71717a\", \"xAxisTickColor\": \"#8a8a93\", \"xAxisLineColor\": \"#8a8a93\", " \
        "\"yAxisLabelColor\": \"#71717a\", \"yAxisTitleColor\": \"#71717a\", \"yAxisTickColor\": \"#8a8a93\", \"yAxisLineColor\": \"#8a8a93\", " \
        "\"plotColorPalette\": \"PALETTE\"}}}}%%"
    out = {}

    colour_names = {"#D97757": "orange", "#10a37f": "green", "#8957e5": "purple", "#3186FF": "blue", NEUTRAL: "grey"}
    lines, colours, names = [], [], []
    for p, slot in [(p, slot) for p in usage["providers"] if p.get("long") for slot in [p["long"]] + p.get("more", [])]:
        points = sorted((pt for run in slot["segs"] for pt in run))
        values = []
        for s in starts:  # the last reading at or before the stretch's end, else the first one
            before = [v for m, v in points if m <= s + width]
            values.append(round(before[-1] if before else points[0][1], 1))
        colour = p["colour"] or NEUTRAL
        lines.append("    line [" + ", ".join(f"{v:g}" for v in values) + "]")
        colours.append(colour)
        a, b, _ = window_ends(slot, t0, t1)
        names.append(f"{p['name']} {colour_names.get(colour, colour)} {said(slot)} {pct(a)} → {pct(b)} left")
    if lines:
        title = "Subscriptions' weekly or monthly windows, % left at the end of each " \
                f"{span(width)} · " + " · ".join(names)
        out["usage.mmd"] = "\n".join([axis.replace("PALETTE", ", ".join(colours)), "xychart-beta", f'    title "{label(title)}"', f"    x-axis [{labels}]",
                                      '    y-axis "% left" 0 --> 100'] + lines) + "\n"

    mac = usage.get("mac")
    if mac:
        lines, colours, names = [], [], []
        last = max((i for key in ("cpu_pk", "gpu_pk", "mem_pk") for i, v in enumerate(mac.get(key, [])) if v is not None), default=0)
        cut = [s for s in starts if s <= usage["start"] + last] or starts[:1]
        total = mac.get("mem_total") or 0
        for key, name, colour, scale in (("cpu_pk", "CPU", "#2563eb", 1), ("gpu_pk", "GPU", "#7c3aed", 1),
                                         ("mem_pk", "memory" + (f" (% of {total:g} GB)" if total else ""), "#0d9488", 100 / total if total else 0)):
            if key not in mac or not scale:
                continue
            values = []
            for s in cut:
                inside = [v for i, v in enumerate(mac[key]) if v is not None and s <= usage["start"] + i < s + width]
                values.append(round(max(inside) * scale, 1) if inside else 0)
            lines.append("    line [" + ", ".join(f"{v:g}" for v in values) + "]")
            colours.append(colour)
            names.append(f"{name} {({'#2563eb': 'blue', '#7c3aed': 'violet', '#0d9488': 'teal'})[colour]}")
        peaks = usage["peaks"]
        disk = f" · free disk {peaks['disk_first']:g} → {peaks['disk_last']:g} GB" if peaks["disk_first"] is not None else ""
        if lines:
            title = f"The Mac, the highest reading in each {span(width)} · " + " · ".join(names) + disk
            out["usage-mac.mmd"] = "\n".join([axis.replace("PALETTE", ", ".join(colours)), "xychart-beta", f'    title "{label(title)}"',
                                              "    x-axis [" + ", ".join(f'"{clock_text(c)}"' for c in cut) + "]",
                                              '    y-axis "% busy" 0 --> 100'] + lines) + "\n"
    return out


ASSETS = Path(__file__).resolve().parent.parent / "assets"
EFFORTS = {"above": "Above Extra High", "max": "Max", "ultra": "Ultra", "ultracode": "Ultracode",
           "ultrathink": "Ultrathink", "xhigh": "Extra High", "extra high": "Extra High", "high": "High",
           "medium": "Medium", "low": "Low"}
AGENT = re.compile(r"^(?:(?P<harness>.+?) · )?(?P<model>.+?)(?: \((?P<effort>[^()]+)\))?$")
STUB = """<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Run map</title></head>
<body>
<div class="rm" id="rm"><p style="color:#71717a;font:13px -apple-system,sans-serif">Loading the run map…</p></div>
<script>
// html_render inlines these absolute paths: the map's marks and pictures, and the map itself.
window.RUN_MAP_FILES = %(files)s;
fetch(%(page)s).then(r => r.text()).then(svg => {
  const text = new DOMParser().parseFromString(svg, "image/svg+xml").querySelector("desc").textContent;
  const page = new DOMParser().parseFromString(text, "text/html");
  page.querySelectorAll("style").forEach(s => document.head.append(s));
  document.getElementById("rm").replaceChildren();
  const run = document.createElement("script");
  run.textContent = page.querySelector("script").textContent;
  document.body.append(run);
}).catch(e => { document.getElementById("rm").textContent = "The run map didn't load: " + e; console.error("run map failed: " + e); });
</script>
</body>
</html>
"""


def map_data(facts: dict, base: Path) -> tuple[dict, list[str], list[str]]:
    """The run map's data, with every time in minutes from the start of the run's first day, and
    the files it draws (marks, pictures) by index: once as the standalone page loads them, once as
    absolute paths for html_render."""
    run = facts.get("run") or {}
    turn_times = [v for item in [run, *facts["tasks"]] for turn in item.get("turns") or [] for v in turn]
    values = times_of(facts) + turn_times
    clock = Clock(values)
    first = min((datetime.strptime(v, clock.format) for v in values), default=None) if clock.dated else None

    def minute(value):
        if not value:
            return None
        if clock.dated:
            return int((datetime.strptime(value, clock.format) - first.replace(hour=0, minute=0)).total_seconds() // 60)
        hours, minutes = value.split(":")
        return int(hours) * 60 + int(minutes)

    inline: list[str] = []
    paths: list[str] = []
    marks: dict[str, int] = {}

    def add(path: Path, data: str) -> int:
        inline.append(data)
        paths.append(str(path))
        return len(paths) - 1

    makers = json.loads((ASSETS / "marks" / "marks.json").read_text())

    def mark_of(chosen: dict | None) -> tuple[int | None, str | None]:
        """The file index of a maker's mark (added once) and its ink; None when it has no mark file."""
        if not chosen or not (ASSETS / "marks" / chosen["file"]).exists():
            return None, None
        path = ASSETS / "marks" / chosen["file"]
        if path.name not in marks:
            marks[path.name] = add(path, "data:image/svg+xml;base64," + base64.b64encode(path.read_bytes()).decode())
        return marks[path.name], chosen.get("ink")

    def who(agent: str | None, level_value=None, level_label=None, maker: str | None = None) -> dict:
        found = AGENT.match(agent.strip()) if agent else None
        harness, model, effort = (found.group("harness"), found.group("model"), found.group("effort")) if found else (None, None, None)
        raw = str(level_value or "").strip().lower()
        effort = effort or level_label or EFFORTS.get(raw)
        band = LEVELS.get(raw) or LEVELS.get(str(effort or "").strip().lower()) or "high"
        entry = {"harness": harness, "model": model, "effort": effort, "band": band,
                 "mark": None, "ink": None, "letter": (model or harness or "?").strip()[:1].upper()}
        # the model's maker (from "maker", or the model's name); for a model with no real name, the
        # harness's own mark; else a letter, rather than a mark that would claim the wrong maker
        named = f"{maker or ''} {model or ''}".strip()
        chosen = next((m for m in makers if m.get("models") and named and re.search(m["models"], named, re.I)), None)
        if not chosen and not maker and re.fullmatch(r"(default|auto)?", (model or "").strip(), re.I):
            chosen = next((m for m in makers if m.get("harnesses") and harness and re.search(m["harnesses"], harness, re.I)), None)
        mark, ink = mark_of(chosen)
        if mark is not None:
            entry.update(mark=mark, ink=ink)
        return entry

    def helpers(items) -> list[dict]:
        out = []
        for h in items or []:
            entry = who(h.get("label"), maker=h.get("maker"))
            did = h.get("did", "")
            role = str(h.get("role", "")).strip().lower()
            title = {"review": "Reviewer", "reviewer": "Reviewer", "research": "Researcher", "researcher": "Researcher"}.get(
                role, role.capitalize() if role else ("Reviewer" if re.search(r"review", did, re.I) else "Helper"))
            times = re.search(r"×\s*(\d+)\s*$", did)
            count = int(h.get("count") or (times.group(1) if times else 1))
            if count > 1 and not times:
                title += f" ×{count}"
            entry.update(title=title, did=did, count=count, status=h.get("status", "done"))
            out.append(entry)
        return out

    def turns(item) -> list[list[int]]:
        return [[minute(a), minute(b)] for a, b in item.get("turns") or []]

    ids = [t["id"] for t in facts["tasks"]]
    pauses = []
    for p in facts.get("pauses", []):
        start, end = minute(p["start"]), minute(p["end"])
        named = [i for i in re.findall(r"[A-Za-z0-9_-]+", p.get("which", "")) if i in ids]
        if not named:  # every task running then
            named = [t["id"] for t in timed(facts["tasks"]) if minute(t["launched"]) < end and minute(t["ended"]) > start]
        pauses.append({"start": start, "end": end, "reason": p.get("reason", ""), "which": p.get("which", ""), "tasks": named})

    tasks = []
    for t in facts["tasks"]:
        launched, ended = minute(t.get("launched")), minute(t.get("ended"))
        worked = t.get("worked_minutes")
        if worked is not None and launched is not None and ended is not None:
            worked = min(int(worked), ended - launched)
        pictures = []
        for picture in t.get("pictures") or []:
            path = Path(picture["src"]).expanduser()
            path = (path if path.is_absolute() else base / path).resolve()
            if not path.exists():
                print(f"run-charts: task {t['id']}'s picture {path} doesn't exist; left out of the map", file=sys.stderr)
                continue
            pictures.append({"file": add(path, str(path)), "caption": picture.get("caption", "")})
        paused = [p for p in pauses if t["id"] in p["tasks"] and "pause" not in t.get("note", "").lower()]
        tasks.append({
            "id": t["id"], "name": t["name"], "summary": t.get("summary", ""), "status": t.get("status", "merged"),
            "note": t.get("note", ""), "qa": bool(t.get("qa")), "needs": t.get("needs") or [],
            "place": t.get("took_place_of") or None, "replaces": t.get("replaces") or None,
            "launched": launched, "ended": ended, "worked": worked, "turns": turns(t), "pictures": pictures,
            "paused": " · ".join(f"{span(p['end'] - p['start'])}" + (f" · {p['reason']}" if p["reason"] else "") for p in paused),
            "helpers": helpers(t.get("helpers")),
            **who(t.get("agent") or facts.get("harness"), t.get("level"), t.get("level_label"), t.get("maker")),
        })
    orch = {"name": "Orchestrator", "summary": run.get("summary", ""), "status": "done",
            "start": minute(run.get("start")), "end": minute(run.get("end")), "worked": run.get("worked_minutes"),
            "wakes": run.get("wakes"), "turns": turns(run), "helpers": helpers(run.get("helpers")),
            **who(facts.get("orchestrator"), run.get("level"), maker=run.get("maker"))}
    data = {"title": facts.get("title", ""), "date": facts.get("date", ""), "integration": facts.get("integration", {}),
            "orch": orch, "pauses": pauses, "tasks": tasks, "files": inline,
            "turns_missing": any(not t.get("turns") for t in timed(facts["tasks"]))}
    folder = (facts.get("usage") or {}).get("folder")
    if folder:
        folder = Path(folder).expanduser()
        folder = folder if folder.is_absolute() else base / folder
        ends = [orch["start"], orch["end"]] if orch["start"] is not None and orch["end"] is not None else []
        ends += [v for t in tasks if t["launched"] is not None and t["ended"] is not None for v in (t["launched"], t["ended"])]
        has_timeline = any(t["launched"] is not None and t["ended"] is not None for t in tasks)
        span_ = (min(ends), max(min(ends) + 1, *ends)) if ends and has_timeline else None
        usage = usage_data(folder, clock.dated, first, span_, makers, lambda entry: mark_of(entry))
        if usage:
            data["usage"] = usage
        else:
            print(f"run-charts: no usage samples for the run in {folder}; the usage panel is left out", file=sys.stderr)
    return data, inline, paths


def run_map(facts: dict, data: dict, paths: list[str], folder: Path) -> tuple[int, int]:
    """Writes run-map.html, run-map.svg and run-map-t3.html; returns the T3 page's length and the
    height to give html_render."""
    template = (ASSETS / "run-map.html").read_text()
    page = template.replace("/*DATA*/null", json.dumps(data, ensure_ascii=False).replace("</", "<\\/"))
    (folder / "run-map.html").write_text(page)
    carried = re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f]", "", page)
    (folder / "run-map.svg").write_text('<svg xmlns="http://www.w3.org/2000/svg" width="1" height="1"><desc>'
                                        + escape(carried) + "</desc></svg>\n")
    stub = STUB % {"files": json.dumps(paths, ensure_ascii=False), "page": json.dumps(str((folder / "run-map.svg").resolve()))}
    (folder / "run-map-t3.html").write_text(stub)
    lanes = sum(1 for t in facts["tasks"] if not t.get("replaces")) + (1 if (facts.get("run") or {}).get("start") else 0)
    extra = 0
    if data.get("usage"):  # the usage panel: its subscriptions band, the Mac's three and its frame
        extra = 140 + (190 if data["usage"]["providers"] else 0) + (250 if data["usage"]["mac"] else 0)
    return len(stub), 900 + 46 * lanes + extra  # the canvas, then a lane per agent; generous: html_render shrinks the frame to the page


def check_time(value, where: str) -> None:
    """Stops with one sentence unless value is "HH:MM" or "YYYY-MM-DD HH:MM" and a real time."""
    if isinstance(value, str):
        for form in ("%H:%M", "%Y-%m-%d %H:%M"):
            try:
                datetime.strptime(value, form)
                return
            except ValueError:
                pass
    raise SystemExit(f"run-charts: {where} is {value!r}, which isn't a time (HH:MM, or YYYY-MM-DD HH:MM for a run past midnight)")


def check_facts(facts) -> None:
    """Stops with one sentence naming the problem when the facts' shape or times can't be drawn."""
    if not isinstance(facts, dict):
        raise SystemExit("run-charts: the facts file must hold a JSON object")
    tasks = facts.get("tasks")
    if not isinstance(tasks, list):
        raise SystemExit('run-charts: the facts need a "tasks" list')

    def objects(owner: str, items, key: str) -> list[dict]:
        if items is None:
            return []
        if not isinstance(items, list) or not all(isinstance(i, dict) for i in items):
            raise SystemExit(f"run-charts: {owner}'s {key!r} must be a list of objects")
        return items

    def pairs(owner: str, item: dict) -> None:
        for turn in item.get("turns") or []:
            if not isinstance(turn, list) or len(turn) != 2:
                raise SystemExit(f"run-charts: {owner}'s turns must each be a [start, end] pair")
            for value in turn:
                check_time(value, f"a turn of {owner}")

    def minutes(owner: str, key: str, value) -> None:
        if value is not None and not (is_number(value) and value >= 0):
            raise SystemExit(f"run-charts: {owner}'s {key} must be a number of minutes, 0 or more")

    for n, t in enumerate(tasks, 1):
        if not isinstance(t, dict):
            raise SystemExit(f"run-charts: task {n} must be an object")
        for key in ("id", "name"):
            if not isinstance(t.get(key), str) or not t[key].strip():
                raise SystemExit(f'run-charts: task {n} needs a text "{key}"')
        owner = f"task {t['id']}"
        for key in ("launched", "ended"):
            if t.get(key):
                check_time(t[key], f"{owner}'s {key}")
        minutes(owner, "worked_minutes", t.get("worked_minutes"))
        if not isinstance(t.get("needs") or [], list):
            raise SystemExit(f'run-charts: {owner}\'s "needs" must be a list of task IDs')
        pairs(owner, t)
        objects(owner, t.get("helpers"), "helpers")
        for picture in objects(owner, t.get("pictures"), "pictures"):
            if not isinstance(picture.get("src"), str):
                raise SystemExit(f'run-charts: a picture of {owner} needs a "src"')
    for n, p in enumerate(objects("the run", facts.get("pauses"), "pauses"), 1):
        for key in ("start", "end"):
            check_time(p.get(key), f"pause {n}'s {key}")
    run = facts.get("run")
    if run is not None:
        if not isinstance(run, dict):
            raise SystemExit('run-charts: "run" must be an object')
        for key in ("start", "end"):
            if run.get(key):
                check_time(run[key], f"the run's {key}")
        minutes("the run", "worked_minutes", run.get("worked_minutes"))
        pairs("the run", run)
        objects("the run", run.get("helpers"), "helpers")
    for key in ("integration", "usage"):
        if facts.get(key) is not None and not isinstance(facts[key], dict):
            raise SystemExit(f'run-charts: "{key}" must be an object')
    integration = facts.get("integration") or {}
    for key in ("branch", "head", "ci"):
        if integration.get(key) is not None and not isinstance(integration[key], str):
            raise SystemExit(f'run-charts: integration "{key}" must be text')


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="run-charts", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("facts")
    parser.add_argument("output")
    parser.add_argument("--render", action="store_true")
    parser.add_argument("--puppeteer-config")
    args = parser.parse_args(argv)
    try:
        facts = json.loads(Path(args.facts).read_text())
    except (OSError, ValueError) as error:
        raise SystemExit(f"run-charts: can't read {args.facts}: {error}")
    check_facts(facts)
    ids = [t["id"] for t in facts["tasks"]]
    if len(ids) != len(set(ids)):
        raise SystemExit("run-charts: task IDs must be unique")
    for t in facts["tasks"]:
        for ref in (t.get("needs") or []) + [t.get("took_place_of"), t.get("replaces")]:
            if ref and ref not in ids:
                raise SystemExit(f"run-charts: task {t['id']} refers to unknown task {ref}")
    folder = Path(args.output)
    folder.mkdir(parents=True, exist_ok=True)
    data, _, paths = map_data(facts, Path(args.facts).resolve().parent)
    usage = data.get("usage")
    (folder / "graph.mmd").write_text(graph(facts))
    (folder / "timeline.mmd").write_text(timeline(facts))
    line = summary(facts)
    extra = usage_line(usage) if usage else ""
    (folder / "summary.txt").write_text(line + "\n" + (extra + "\n" if extra else ""))
    print(f"run-charts: wrote {folder / 'graph.mmd'}, {folder / 'timeline.mmd'} and {folder / 'summary.txt'}")
    charts = usage_mermaid(usage, facts) if usage else {}
    for name, text in charts.items():
        (folder / name).write_text(text)
    if charts:
        print("run-charts: wrote " + " and ".join(str(folder / name) for name in charts))
    length, height = run_map(facts, data, paths, folder.resolve())
    print(f"run-charts: wrote {folder / 'run-map.html'}, {folder / 'run-map.svg'} and {folder / 'run-map-t3.html'}"
          f" ({length:,} characters; html_render height {height})")
    if line:
        print(line)
    if extra:
        print(extra)
    if args.render:
        render(folder, args.puppeteer_config)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
