#!/usr/bin/env python3
"""Take turns at shared resources (the real screen, the GPU, a device) during a run.

Copy this script into <run directory>/bin/ and describe the resources in
<run directory>/leases.json, for example:

  {"screen": {"slots": 1, "max_minutes": 15, "wait_minutes": 45}, "gpu": {"slots": 2, "max_minutes": 30}}

Usage:
  lease acquire <resource> --owner <task ID> [--all] [--minutes N] [--wait-minutes W]
  lease release <resource> --owner <task ID>
  lease run <resource> --owner <task ID> [--all] [--minutes N] [--wait-minutes W] -- <command...>
  lease check <resource> --owner <task ID>
  lease status

  --all       take every slot of the resource (for example the whole GPU for a timing run)
  --minutes   how long the lease lasts (default 20, at most the resource's max_minutes); acquiring
              again with the same owner renews it, and a forgotten lease frees itself when it expires
  --wait-minutes  how long to wait for a turn (default: the resource's wait_minutes, else 30)
  --run       the run directory (default: the folder above this script's folder, or $LEASE_RUN_DIR)

Turns are first come, first served for each resource. A waiter that stops asking for 15 seconds
loses its place. "run" holds the lease only while the command runs. It starts the command in a
session of its own and stops it 2 seconds before the lease runs out (the lease is held a while
longer then), or when "run" is stopped (SIGTERM, SIGHUP, SIGINT, also while it waits for its turn):
SIGTERM to the command's whole process group, a few seconds to finish, then SIGKILL. The same goes
for what a command that exited on its own left running in its group. The lease is released only
once they are gone, and then only what "run" took: a lease the owner already held (an earlier
acquire) goes back to the slots and the end time it had. A small watcher process, in a session of
its own, ends the command's group if "run" itself is killed (SIGKILL), within seconds; the lease
then runs out by itself.

Asking for --all again while holding fewer slots takes the missing ones, or waits for them like a
first acquire; if the wait times out (75) the lease held so far stays as it was, not renewed.

While others wait, a holder's turn lasts at most the resource's turn_minutes (default: its
max_minutes), counted from when the first of them began waiting, or from the holder's first
acquire if that is later. Renewing never stretches a turn: a renewal after it, or one that would
leave less than a minute, releases the lease and exits 76; stop using the resource, and acquire
again to queue behind the others. With nobody waiting, renewing goes on extending the lease. A
holder that doesn't renew keeps its lease until it expires, at most max_minutes after its last
acquire.

When the user may be at the computer (an evening run), give the screen "needs_owner_away_seconds":
300. Then the first waiter in line gets the screen only once it is unlocked and nobody has touched
the keyboard, mouse or trackpad for that long (macOS's HIDIdleTime, read with ioreg; on other
systems a resource with the key is refused). The queue keeps its order while it waits, and the
wait counts toward --wait-minutes. A state that can't be read counts as not away.

Only the first acquire waits for the owner: a renewal, and a "run" command once started, don't
look again. So during its turn the holder runs "check" between steps; check says the owner is back
once the idle time drops under the resource's "owner_back_seconds" (default 30). Any input counts,
so the holder checks at a point where it has posted no events of its own for that long. On a
nonzero exit, stop at the next safe point, release, and acquire again later. "status" shows the
owner's state when a resource needs it. $LEASE_IOREG replaces /usr/sbin/ioreg, for tests; status
and the log name it when set.

Exit status: 0 done; 75 the wait timed out; 76 the turn is over and others wait (the lease is
released); 124 "run" stopped the command at the end of its lease; 127 "run" couldn't start the
command; 128 plus the signal's number when "run" was stopped by a signal; 2 usage error (an option or a leases.json value that isn't a
sensible number, too).
check: 0 you hold the lease (and the owner is away, where the resource needs that); 1 the owner is
at the computer; 2 the screen is locked, or its state can't be read; 3 you don't hold the lease;
64 usage error. Any nonzero status means stop.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import math
import os
import plistlib
import re
import signal
import subprocess
import sys
import time

DEFAULT_MINUTES = 20.0
DEFAULT_WAIT_MINUTES = 30.0
FORGET_WAITER_SECONDS = 15
POLL_SECONDS = 2.0
TURN_GRACE_SECONDS = 60
TIMED_OUT = 75
TURN_OVER = 76
DEFAULT_OWNER_BACK_SECONDS = 30
IOREG = "/usr/sbin/ioreg"
CHECK_AT_COMPUTER = 1
CHECK_LOCKED = 2
CHECK_NOT_HELD = 3
CHECK_USAGE = 64
READ_TIMEOUT_SECONDS = 3
STOP_GRACE_SECONDS = 5
LEASE_END_MARGIN_SECONDS = 2   # "run" stops its command this long before the lease runs out


class Unsupported(Exception):
    pass


class Owner:
    """Whether the user is at the computer: macOS's HIDIdleTime and screen lock, read with ioreg."""

    def __init__(self, ioreg: str | None = None, platform: str | None = None):
        self.ioreg = ioreg or os.environ.get("LEASE_IOREG") or IOREG
        injected = bool(ioreg or os.environ.get("LEASE_IOREG"))
        if not injected and (platform or sys.platform) != "darwin":
            raise Unsupported("it can only be told on macOS (ioreg's HIDIdleTime)")
        if not os.access(self.ioreg, os.X_OK):
            raise Unsupported(f"{self.ioreg} isn't there to tell it")
        self.injected = self.ioreg if injected else None

    def _ioreg(self, *args: str) -> bytes:
        try:
            return subprocess.run([self.ioreg, *args], capture_output=True,
                                  timeout=READ_TIMEOUT_SECONDS).stdout
        except (OSError, subprocess.TimeoutExpired):
            return b""

    def locked(self) -> bool | None:
        """True when a console session's screen is locked (CGSSessionScreenIsLocked), None when unreadable."""
        try:
            root = plistlib.loads(self._ioreg("-n", "Root", "-d1", "-a"))
        except Exception:
            return None

        def find(value) -> bool:
            if isinstance(value, dict):
                return value.get("CGSSessionScreenIsLocked") is True or any(find(v) for v in value.values())
            if isinstance(value, list):
                return any(find(v) for v in value)
            return False

        return find(root)

    def idle_seconds(self) -> int | None:
        """Seconds since the last keyboard, mouse or trackpad input, or None when unreadable."""
        match = re.search(rb'"HIDIdleTime" = (\d+)', self._ioreg("-c", "IOHIDSystem"))
        return int(match.group(1)) // 1_000_000_000 if match else None

    def state(self, needed: float, back: bool = False) -> tuple[int, str]:
        """(0 away, 1 at the computer, 2 locked), with a few words on why. With back, needed is how
        recent an input means the owner came back."""
        locked = self.locked()
        if locked is None:
            return CHECK_LOCKED, "the screen's lock state can't be read, so it may be locked"
        if locked:
            return CHECK_LOCKED, "the screen is locked"
        idle = self.idle_seconds()
        if idle is None:
            return CHECK_AT_COMPUTER, "the idle time can't be read, so the owner may be at the computer"
        if idle >= needed:
            return 0, f"the owner is away (idle {idle}s)"
        if back:
            return CHECK_AT_COMPUTER, f"the owner is back at the computer (idle {idle}s, under {needed:g}s)"
        return CHECK_AT_COMPUTER, f"the owner is at the computer (idle {idle}s, need {needed:g}s)"


def run_dir(arg: str | None) -> str:
    if arg:
        return arg
    if os.environ.get("LEASE_RUN_DIR"):
        return os.environ["LEASE_RUN_DIR"]
    return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


class Leases:
    def __init__(self, root: str):
        self.root = root
        self.locks = os.path.join(root, "locks")
        self.state_path = os.path.join(self.locks, "state.json")
        self.log_path = os.path.join(self.locks, "log.txt")
        config_path = os.path.join(root, "leases.json")
        try:
            with open(config_path) as f:
                self.config = json.load(f)
        except (OSError, ValueError) as error:
            raise SystemExit(f"lease: can't read {config_path}: {error}")
        if not isinstance(self.config, dict) or not all(isinstance(v, dict) for v in self.config.values()):
            raise SystemExit(f"lease: {config_path} must hold an object with one object for each resource")

    def log(self, line: str) -> None:
        os.makedirs(self.locks, exist_ok=True)
        with open(self.log_path, "a") as f:
            f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + line + "\n")

    def locked(self, change):
        """Runs change(state, now) under an exclusive lock and saves the state."""
        os.makedirs(self.locks, exist_ok=True)
        with open(os.path.join(self.locks, ".lock"), "a+") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                with open(self.state_path) as f:
                    state = json.load(f)
            except (OSError, ValueError):
                state = {}
            now = time.time()
            leases = state.setdefault("leases", {})
            for name in list(leases):
                leases[name] = [l for l in leases[name] if l["expires"] > now]
            waiting = state.setdefault("waiting", {})
            for key in list(waiting):
                if waiting[key]["seen"] < now - FORGET_WAITER_SECONDS:
                    del waiting[key]
            result = change(state, now)
            with open(self.state_path + ".new", "w") as f:
                json.dump(state, f, indent=1)
            os.replace(self.state_path + ".new", self.state_path)
            return result

    def number(self, resource: str, key: str, default: float, positive: bool = True) -> float:
        """A number from leases.json: finite, above zero (or zero or more), else a usage error."""
        value = self.config[resource].get(key, default)
        if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) \
                or value < 0 or (positive and value == 0):
            raise SystemExit(f"lease: {key} of {resource} in leases.json must be a number of minutes"
                             f"{' above zero' if positive else ''}")
        return float(value)

    def slots(self, resource: str) -> int:
        value = self.config[resource].get("slots", 1)
        if isinstance(value, bool) or not isinstance(value, int) or value < 1:
            raise SystemExit(f"lease: slots of {resource} in leases.json must be a whole number, 1 or more")
        return value

    def max_minutes(self, resource: str) -> float:
        return self.number(resource, "max_minutes", 30)

    def turn_minutes(self, resource: str) -> float:
        return self.number(resource, "turn_minutes", self.max_minutes(resource))

    def wait_minutes(self, resource: str) -> float:
        return self.number(resource, "wait_minutes", DEFAULT_WAIT_MINUTES, positive=False)

    def seconds(self, resource: str, key: str, default: float) -> float:
        value = self.config[resource].get(key, default)
        if isinstance(value, bool) or not isinstance(value, (int, float)) or value < 0:
            raise SystemExit(f"lease: {key} of {resource} in leases.json must be a number of seconds")
        return float(value)

    def owner_away_seconds(self, resource: str) -> float:
        return self.seconds(resource, "needs_owner_away_seconds", 0)

    def owner_back_seconds(self, resource: str) -> float:
        return self.seconds(resource, "owner_back_seconds", DEFAULT_OWNER_BACK_SECONDS)

    def owner(self, resource: str) -> Owner | None:
        """The owner reader for a resource that needs the owner away, else None; raises Unsupported."""
        return Owner() if self.owner_away_seconds(resource) > 0 else None

    def turn_end(self, state: dict, resource: str, owner: str, since: float) -> float | None:
        """When the holder's turn ends while others wait (epoch seconds), or None when nobody waits."""
        me = f"{resource}:{owner}"
        others = [w["since"] for k, w in state["waiting"].items() if w["resource"] == resource and k != me]
        return max(since, min(others)) + self.turn_minutes(resource) * 60 if others else None

    def try_acquire(self, resource: str, owner: str, take_all: bool, minutes: float, owner_away: bool = True):
        """Returns ("held", minutes left), ("waiting", None), ("turn over", None), or ("ready", None) when
        the lease would be taken but owner_away is False: read the owner's state, outside the lock."""
        need = self.slots(resource) if take_all else 1

        def attempt(state, now):
            held = state["leases"].setdefault(resource, [])
            expires = now + minutes * 60
            me = f"{resource}:{owner}"
            waiting = state["waiting"]
            for lease in held:
                if lease["owner"] == owner:
                    since = lease.setdefault("since", now)
                    end = self.turn_end(state, resource, owner, since)
                    if end is not None:
                        if end - now < TURN_GRACE_SECONDS:
                            held.remove(lease)
                            return "turn over", None
                        expires = min(expires, end)
                    if lease["slots"] < need:
                        # A renewal with --all while holding fewer slots: take the rest when nobody else
                        # holds any and this owner is first in line, else wait, as a first acquire does.
                        waiting.setdefault(me, {"since": now, "resource": resource})["seen"] = now
                        queue = sorted((w["since"], k) for k, w in waiting.items() if w["resource"] == resource)
                        if queue[0][1] != me or sum(l["slots"] for l in held if l is not lease) + need > self.slots(resource):
                            return "waiting", None   # still waiting: what is held isn't renewed
                        lease["slots"] = need
                    lease["expires"] = expires
                    waiting.pop(me, None)
                    return "held", (expires - now) / 60
            waiting.setdefault(me, {"since": now, "resource": resource})["seen"] = now
            queue = sorted((w["since"], k) for k, w in waiting.items() if w["resource"] == resource)
            if queue[0][1] != me:
                return "waiting", None
            if sum(l["slots"] for l in held) + need > self.slots(resource):
                return "waiting", None
            if not owner_away:
                return "ready", None
            held.append({"owner": owner, "slots": need, "expires": expires, "since": now})
            del waiting[me]
            return "held", minutes

        return self.locked(attempt)

    def acquire(self, resource: str, owner: str, take_all: bool, minutes: float, wait_minutes: float):
        """Returns (exit status, minutes the lease lasts or None)."""
        try:
            away = self.owner(resource)
        except Unsupported as error:
            print(f"lease: {resource} needs the owner away, but {error}. Remove needs_owner_away_seconds "
                  f"from leases.json to use {resource} here.", file=sys.stderr)
            return 2, None
        if away is not None and away.injected:
            self.log(f"owner read with {away.injected} for {resource} {owner}")
        deadline = time.time() + wait_minutes * 60
        announced = None
        while True:
            result, left = self.try_acquire(resource, owner, take_all, minutes, away is None)
            if result == "ready":
                code, why = away.state(self.owner_away_seconds(resource))
                result, left = ("waiting", (code, why)) if code else \
                    self.try_acquire(resource, owner, take_all, minutes, True)
            if result == "held":
                self.log(f"acquire {resource} {owner} {left:.1f}m{' all' if take_all else ''}")
                print(f"lease: {owner} holds {resource} for up to {round(left, 1):g} min")
                return 0, left
            if result == "turn over":
                self.log(f"turn over {resource} {owner}")
                print(f"lease: {owner}'s turn at {resource} is over and others are waiting, so the lease "
                      f"is released. Stop using {resource}; acquire again to queue behind them.",
                      file=sys.stderr)
                return TURN_OVER, None
            code, why = left or (0, None)
            now = time.time()
            if now >= deadline:
                self.locked(lambda state, _: state["waiting"].pop(f"{resource}:{owner}", None))
                print(f"lease: gave up waiting for {resource} after {wait_minutes:g} min" + (f": {why}" if why else ""))
                return TIMED_OUT, None
            if code != announced:
                print(f"lease: waiting for {resource} " + (f"until the owner is away: {why}" if code else "..."),
                      flush=True)
                announced = code
            time.sleep(max(0.2, min(POLL_SECONDS, deadline - now)))

    def release(self, resource: str, owner: str) -> int:
        def drop(state, _):
            held = state["leases"].get(resource, [])
            kept = [l for l in held if l["owner"] != owner]
            state["leases"][resource] = kept
            state["waiting"].pop(f"{resource}:{owner}", None)   # a stopped waiter leaves its place too
            return len(held) - len(kept)

        released = self.locked(drop)
        self.log(f"release {resource} {owner}")
        return released

    def holding(self, resource: str, owner: str):
        """(slots, expires as epoch seconds) of the owner's lease, or None."""
        def find(state, _):
            return next(((l["slots"], l["expires"]) for l in state["leases"].get(resource, [])
                         if l["owner"] == owner), None)

        return self.locked(find)

    def give_back(self, resource: str, owner: str, prior) -> None:
        """Ends what "run" took: the whole lease, or, when the owner held one before (prior, as holding
        gave it), its slots and end time again, but never past the end of its turn while others wait
        (the renewal "run" made was capped there). The owner's place in the queue goes too."""
        def drop(state, now):
            state["waiting"].pop(f"{resource}:{owner}", None)
            kept = []
            for lease in state["leases"].get(resource, []):
                if lease["owner"] == owner:
                    if prior is None:
                        continue
                    end = self.turn_end(state, resource, owner, lease.get("since", now))
                    expires = prior[1] if end is None else min(prior[1], end)
                    if expires <= now:
                        continue
                    lease["slots"], lease["expires"] = prior[0], expires
                kept.append(lease)
            state["leases"][resource] = kept

        self.locked(drop)
        self.log(f"release {resource} {owner}" + (f" (back to {prior[0]} slot(s) held before)" if prior else ""))

    def hold(self, resource: str, owner: str, need: int, seconds: float) -> None:
        """Keeps the owner's lease for at least seconds more, or takes it again when it just ran out and
        the slots are free: while "run" ends a command, nobody else may start on the resource."""
        def keep(state, now):
            held = state["leases"].setdefault(resource, [])
            mine = next((l for l in held if l["owner"] == owner), None)
            if mine is None:
                if sum(l["slots"] for l in held) + need > self.slots(resource):
                    return
                mine = {"owner": owner, "slots": need, "since": now, "expires": now}
                held.append(mine)
            mine["expires"] = max(mine["expires"], now + seconds)

        self.locked(keep)

    def check(self, resource: str, owner: str) -> int:
        """Whether the holder may go on: 0, or why it should stop (see the exit statuses)."""
        def holding(state, now):
            return next(((l["expires"] - now) / 60 for l in state["leases"].get(resource, [])
                         if l["owner"] == owner), None)

        try:
            away = self.owner(resource)
        except Unsupported as error:
            print(f"lease: {resource} needs the owner away, but {error}.", file=sys.stderr)
            return CHECK_USAGE
        left = self.locked(holding)
        if left is None:
            print(f"lease: {owner} doesn't hold {resource}; stop using it.")
            return CHECK_NOT_HELD
        if away is None:
            print(f"lease: {owner} holds {resource} for {round(left, 1):g} more min")
            return 0
        code, why = away.state(self.owner_back_seconds(resource), back=True)
        if code:
            self.log(f"owner back {resource} {owner}: {why}")
            print(f"lease: {why}. Stop at the next safe point, release {resource}, and acquire it again later.")
            return code
        print(f"lease: {owner} holds {resource} for {round(left, 1):g} more min; {why}")
        return 0

    def status(self) -> dict:
        def report(state, now):
            return {
                "leases": {
                    name: [dict(l, minutes_left=round((l["expires"] - now) / 60, 1),
                                held_minutes=round((now - l.get("since", now)) / 60, 1)) for l in held]
                    for name, held in state["leases"].items()
                    if held
                },
                "waiting": [k for _, k in sorted((w["since"], k) for k, w in state["waiting"].items())],
            }

        return self.locked(report)


def main(argv: list[str]) -> int:
    """Runs a lease command; a usage or configuration error exits 2, or 64 for check, where 2 means
    the screen is locked."""
    usage = CHECK_USAGE if argv[:1] == ["check"] else 2
    try:
        return command(argv, usage)
    except SystemExit as error:
        if isinstance(error.code, str):
            print(error.code, file=sys.stderr)
            return usage
        raise


def command(argv: list[str], usage: int) -> int:
    command_args: list[str] = []
    if "--" in argv:
        i = argv.index("--")
        argv, command_args = argv[:i], argv[i + 1:]

    class Parser(argparse.ArgumentParser):
        def error(self, message):
            self.print_usage(sys.stderr)
            self.exit(usage, f"{self.prog}: error: {message}\n")

    parser = Parser(prog="lease", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("action", choices=["acquire", "release", "run", "check", "status"])
    parser.add_argument("resource", nargs="?")
    parser.add_argument("--owner")
    parser.add_argument("--all", action="store_true", dest="take_all")
    parser.add_argument("--minutes", type=float, default=DEFAULT_MINUTES)
    parser.add_argument("--wait-minutes", type=float)
    parser.add_argument("--run")
    args = parser.parse_args(argv)

    leases = Leases(run_dir(args.run))
    if args.action == "status":
        report = leases.status()
        if any(leases.owner_away_seconds(name) > 0 for name in leases.config):
            try:
                owner = Owner()
                report["owner"] = {"locked": owner.locked(), "idle_seconds": owner.idle_seconds()}
                if owner.injected:
                    report["owner"]["reader"] = owner.injected
            except Unsupported as error:
                report["owner"] = f"unknown: {error}"
        print(json.dumps(report, indent=1))
        return 0
    if not args.resource or args.resource not in leases.config:
        known = ", ".join(sorted(leases.config)) or "none"
        print(f"lease: name a resource from leases.json ({known})", file=sys.stderr)
        return usage
    if not args.owner:
        print("lease: --owner <task ID> is required", file=sys.stderr)
        return usage
    if not math.isfinite(args.minutes) or args.minutes <= 0:
        print("lease: --minutes must be a number above zero", file=sys.stderr)
        return usage
    if args.wait_minutes is not None and (not math.isfinite(args.wait_minutes) or args.wait_minutes < 0):
        print("lease: --wait-minutes must be a number, zero or more", file=sys.stderr)
        return usage
    leases.slots(args.resource)
    leases.turn_minutes(args.resource)
    minutes = min(args.minutes, leases.max_minutes(args.resource))
    wait_minutes = args.wait_minutes if args.wait_minutes is not None else leases.wait_minutes(args.resource)

    if args.action == "release":
        print(f"lease: released {leases.release(args.resource, args.owner)} lease(s)")
        return 0
    if args.action == "check":
        return leases.check(args.resource, args.owner)
    if args.action == "acquire":
        return leases.acquire(args.resource, args.owner, args.take_all, minutes, wait_minutes)[0]
    if not command_args:
        print("lease: run needs -- <command>", file=sys.stderr)
        return 2

    class Stopped(Exception):
        pass

    # A stop signal raises Stopped once while it is safe to (also while waiting for the turn), so a stop
    # runs the cleanup below; where it isn't (the child being started and noted), it is kept in
    # state["pending"] and raised right after. Cleanup itself is never interrupted.
    state = {"raise": True, "pending": None}

    def stop(signum, _frame):
        if state["raise"]:
            state["raise"] = False
            raise Stopped(signum)
        if state["pending"] is None:
            state["pending"] = signum

    for signum in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(signum, stop)
    process = watch = None
    need = leases.slots(args.resource) if args.take_all else 1
    prior = leases.holding(args.resource, args.owner)   # what the owner held before this run

    def end_command():
        leases.hold(args.resource, args.owner, need, 2 * STOP_GRACE_SECONDS + 5)   # held while it ends
        end_group(process)

    try:
        try:
            code, left = leases.acquire(args.resource, args.owner, args.take_all, minutes, wait_minutes)
            if code:
                state["raise"] = False
                return code
            held = leases.holding(args.resource, args.owner)
            ends = held[1] if held else time.time()
            state["raise"] = False
            try:
                watch = Watch(ends)
            except OSError as error:
                print(f"lease: no watcher for the command ({error}); going on without", file=sys.stderr)
            try:
                process = start(command_args, watch)
            except OSError as error:
                print(f"lease: can't run {command_args[0]}: {error}", file=sys.stderr)
                return 127
            state["raise"] = True
            if state["pending"] is not None:
                state["raise"] = False   # one stop is being handled; a second must not interrupt its cleanup
                raise Stopped(state["pending"])
            # the lease's own end, not a count from here: stopped a little before it runs out, so the
            # lease is still ours while the command is ended
            now = time.time()
            wait = max(0.0, ends - min(LEASE_END_MARGIN_SECONDS, max(0.0, (ends - now) / 2)) - now)
            try:
                code = process.wait(timeout=wait)
            except subprocess.TimeoutExpired:
                print(f"lease: stopped the command at the end of its {round(left, 1):g} min lease", file=sys.stderr)
                end_command()
                code = 124
            state["raise"] = False
            return code
        except Stopped as stopped:
            if process is not None:
                end_command()
            return 128 + stopped.args[0]
    finally:
        state["raise"] = False
        try:
            if process is not None:
                left_behind = process.poll() is not None and group_alive(process.pid)
                if process.poll() is None or left_behind:
                    if left_behind:
                        print("lease: the command left processes running; ended them", file=sys.stderr)
                    end_command()
            leases.give_back(args.resource, args.owner, prior)
        finally:
            if watch:
                watch.done()


# A watcher in a session of its own, with a pipe from "run". The command's own child process writes its
# process group into the pipe before it runs the command (so there is no moment when the command runs
# and the watcher doesn't know it), and "run" writes "done" once it has ended the command itself. If the
# pipe closes before that, "run" was killed and couldn't clean up, so the watcher ends the group: SIGTERM,
# a grace that never reaches past the lease's end (less a margin: nothing holds the slot any more, so
# a waiter may take it then), then SIGKILL.
WATCHER = r"""
import os, signal, sys, time
grace, ends, margin = (float(v) for v in sys.argv[1:4])
pgid, pending = None, b""
while True:
    chunk = os.read(0, 4096)
    if not chunk:
        break
    pending += chunk
    while b"\n" in pending:
        line, pending = pending.split(b"\n", 1)
        if line == b"done":
            sys.exit(0)
        if line.startswith(b"pgid "):
            pgid = int(line[5:])
if pgid is None:
    sys.exit(0)
wait = min(grace, ends - margin - time.time())
for sig, seconds in ([(signal.SIGTERM, wait)] if wait > 0 else []) + [(signal.SIGKILL, 2)]:
    try:
        os.killpg(pgid, sig)
    except OSError:
        sys.exit(0)
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        try:
            os.killpg(pgid, 0)
        except OSError:
            sys.exit(0)
        time.sleep(0.05)
"""


def start(argv: list[str], watch: Watch | None) -> subprocess.Popen:
    """Starts the command in a session of its own. With a watcher, the child hands it the process group
    (its own pid) before it runs the command, through a descriptor of the watcher's pipe."""
    if watch is None:
        return subprocess.Popen(argv, start_new_session=True)
    fd = watch.process.stdin.fileno()

    def hand_off():   # in the child, after its session began and before the command
        try:
            os.write(fd, f"pgid {os.getpid()}\n".encode())
        except OSError:
            pass
        os.close(fd)   # the command mustn't hold the pipe open, or its closing would never show

    return subprocess.Popen(argv, start_new_session=True, pass_fds=(fd,), preexec_fn=hand_off)


class Watch:
    def __init__(self, ends: float):
        self.process = subprocess.Popen([sys.executable, "-I", "-c", WATCHER, str(STOP_GRACE_SECONDS),
                                         repr(ends), str(LEASE_END_MARGIN_SECONDS)],
                                        stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                        start_new_session=True)

    def send(self, line: str) -> None:
        try:
            self.process.stdin.write(line.encode())
            self.process.stdin.flush()
        except OSError:
            pass

    def done(self) -> None:
        """"run" ended the command itself: the watcher stands down."""
        self.send("done\n")
        try:
            self.process.stdin.close()
        except OSError:
            pass
        try:
            self.process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            self.process.kill()
            self.process.wait()


def group_alive(pgid: int) -> bool:
    try:
        os.killpg(pgid, 0)
    except PermissionError:
        return True
    except OSError:
        return False
    return True


def end_group(process: subprocess.Popen, grace: float = STOP_GRACE_SECONDS) -> None:
    """Stops a command started in its own session with all it started: SIGTERM to its process group,
    a few seconds to finish, then SIGKILL; returns once the command has exited and the group is gone."""
    pgid = process.pid
    process.poll()
    if not group_alive(pgid):
        return
    try:
        os.killpg(pgid, signal.SIGTERM)
    except OSError:
        pass
    deadline = time.monotonic() + grace
    while time.monotonic() < deadline:
        process.poll()   # reaps the command itself, whose zombie would keep the group alive
        if not group_alive(pgid):
            return
        time.sleep(0.05)
    try:
        os.killpg(pgid, signal.SIGKILL)
    except OSError:
        pass
    process.wait()
    deadline = time.monotonic() + grace
    while group_alive(pgid) and time.monotonic() < deadline:
        time.sleep(0.05)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
