{
  "title": "Making a sketch page",
  "subtitle": "How the sketch-infographic skill turns one source into one hand-drawn page",
  "panels": [
    {
      "id": "one",
      "heading": "One source, one page",
      "elements": [
        {
          "type": "stack",
          "id": "src",
          "x": 0,
          "y": 0,
          "width": 220,
          "height": 76,
          "offset": [
            36,
            30
          ],
          "items": [
            "article",
            "talk notes",
            "thread"
          ],
          "lines": 2
        },
        {
          "type": "window",
          "id": "page",
          "x": 420,
          "y": 10,
          "width": 180,
          "height": 150,
          "title": "page",
          "lines": 5
        },
        {
          "type": "arrow",
          "start": "src",
          "end": "page"
        }
      ],
      "takeaway": "Pick one source and say who it is from. A page that mixes three articles stops being a summary of any of them."
    },
    {
      "id": "formula",
      "heading": "The page has a formula",
      "elements": [
        {
          "type": "rectangle",
          "id": "t",
          "x": 0,
          "y": 0,
          "width": 220,
          "height": 46,
          "color": "gray",
          "label": "Title + who said it"
        },
        {
          "type": "rectangle",
          "id": "p",
          "x": 0,
          "y": 86,
          "width": 220,
          "height": 46,
          "color": "blue",
          "label": "6 or 7 panels"
        },
        {
          "type": "rectangle",
          "id": "f",
          "x": 0,
          "y": 172,
          "width": 220,
          "height": 46,
          "color": "gray",
          "label": "Source and caveats"
        },
        {
          "type": "arrow",
          "start": "t",
          "end": "p"
        },
        {
          "type": "arrow",
          "start": "p",
          "end": "f"
        },
        {
          "type": "text",
          "x": 250,
          "y": 6,
          "width": 350,
          "fontSize": 17,
          "text": "Two to five words, then one line naming the author."
        },
        {
          "type": "text",
          "x": 250,
          "y": 92,
          "width": 350,
          "fontSize": 17,
          "text": "Each makes one point: a heading, a small drawing, two sentences."
        },
        {
          "type": "text",
          "x": 250,
          "y": 178,
          "width": 350,
          "fontSize": 17,
          "text": "Where it came from, and what it isn't."
        }
      ],
      "takeaway": "The same skeleton every time means the effort goes into choosing the points, not the layout."
    },
    {
