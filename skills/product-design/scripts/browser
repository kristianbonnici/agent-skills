#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -P -- "$(dirname -- "$0")" && pwd -P)
repo_root=$(CDPATH= cd -- "$script_dir/../../.." && pwd)
browser_bin="$repo_root/runtime/playwright/node_modules/.bin/playwright-cli"

if [ ! -x "$browser_bin" ]; then
  echo "Product Design browser runtime is not installed." >&2
  echo "Run: $repo_root/scripts/bootstrap --dependencies" >&2
  exit 1
fi

# The browser writes its snapshot files into the current folder: refuse a git working tree, so
# evidence never lands in the user's repository (run from the run folder, SKILL.md).
if [ -z "${PRODUCT_DESIGN_ALLOW_REPO:-}" ] && command -v git >/dev/null 2>&1 \
  && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Run browser commands from the run folder (manage_context.py run-dir), not inside a repository." >&2
  exit 2
fi

# A session per folder: its name, cut short, plus a checksum of the whole path, so two runs with
# long similar names never share one browser.
project_name=$(basename "${PWD:-project}" | tr -cd '[:alnum:]_-' | cut -c1-24)
path_sum=$(printf '%s' "${PWD:-project}" | cksum | cut -d' ' -f1)
session=${PRODUCT_DESIGN_BROWSER_SESSION:-product-design-${project_name:-project}-$path_sum}

exec "$browser_bin" "-s=$session" "$@"
