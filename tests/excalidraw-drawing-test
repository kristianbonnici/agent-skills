#!/usr/bin/env bash
# excalidraw-drawing: every pattern in references/patterns.md, every diagram in
# references/diagrams.md and the example page build with no warnings, the outputs are a valid
# .excalidraw scene and a PNG, the checks catch what they claim to (a label too long for its box,
# text crossing another element, an element outside its panel, a character Excalifont lacks), and
# charts put every point where its numbers say.
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
skill="$repo_root/skills/excalidraw-drawing"
build="$skill/scripts/build.mjs"
work="$(mktemp -d "${TMPDIR:-/tmp}/excalidraw-drawing-test.XXXXXX")"
trap 'rm -rf "$work"' EXIT

if [ ! -d "$repo_root/runtime/excalidraw/node_modules/mcp-excalidraw-server" ]; then
  echo "excalidraw-drawing-test: runtime missing; run ./scripts/bootstrap first" >&2
  exit 1
fi

fail() { echo "excalidraw-drawing-test: $*" >&2; exit 1; }

# 1. Every pattern, one panel each, on one page.
python3 -I - "$skill/references/patterns.md" "$work/patterns.json" <<'EOF'
import json, re, sys
text = open(sys.argv[1]).read()
# One JSON block per "## " section: a section without one is an error, not merged into the next.
sections = re.split(r"^## ", text, flags=re.M)[1:]
blocks = []
for section in sections:
    title = section.splitlines()[0]
    found = re.findall(r"```json\n(.*?)```", section, re.S)
    assert len(found) == 1, f"pattern {title!r} has {len(found)} JSON blocks"
    blocks.append((title, found[0]))
assert len(blocks) >= 8, f"expected at least 8 patterns, found {len(blocks)}"
panels = [{"id": f"p{i}", "heading": title.split(":")[0], "elements": json.loads(body)}
          for i, (title, body) in enumerate(blocks)]
json.dump({"title": "Patterns", "format": "auto", "panels": panels, "footer": "test"}, open(sys.argv[2], "w"))
EOF
node "$build" "$work/patterns.json" >"$work/patterns.out" || { cat "$work/patterns.out"; fail "a pattern doesn't build cleanly"; }

# 1b. Every diagram in the catalog, one frameless full-width panel each, on one page.
python3 -I - "$skill/references/diagrams.md" "$work/diagrams.json" <<'EOF2'
import json, re, sys
text = open(sys.argv[1]).read()
panels = []
for section in re.split(r"^## ", text, flags=re.M)[1:]:
    title = section.splitlines()[0]
    found = re.findall(r"```json\n(.*?)```", section, re.S)
    # Every section but the picking table is a diagram with exactly one snippet.
    if title.startswith("Pick by"):
        continue
    assert len(found) == 1, f"diagram {title!r} has {len(found)} JSON blocks"
    if found:
        panels.append({"id": f"d{len(panels)}", "span": 2, "heading": title.split(":")[0], "elements": json.loads(found[0])})
assert len(panels) >= 10, f"expected at least 10 diagrams, found {len(panels)}"
json.dump({"title": "Diagrams", "format": "fit", "frame": False, "panels": panels}, open(sys.argv[2], "w"))
EOF2
node "$build" "$work/diagrams.json" --lint-only >"$work/diagrams.out" || { cat "$work/diagrams.out"; fail "a diagram doesn't build cleanly"; }

# 2. The example page.
cp "$skill/assets/example.json" "$work/example.json"
node "$build" "$work/example.json" >"$work/example.out" || { cat "$work/example.out"; fail "the example doesn't build cleanly"; }
[ -s "$work/example.png" ] || fail "no PNG written"
grep -q "^page 1500×2000$" "$work/example.out" || { cat "$work/example.out"; fail "the example isn't a 3:4 page"; }
python3 -I - "$work/example.excalidraw" <<'EOF'
import json, sys
scene = json.load(open(sys.argv[1]))
assert scene["type"] == "excalidraw" and scene["version"] == 2
els = scene["elements"]
ids = [e["id"] for e in els]
assert len(ids) == len(set(ids)), "duplicate ids"
idx = [e["index"] for e in els]
assert all(a < b for a, b in zip(idx, idx[1:])), "fractional indices not ascending"
assert {e["fontFamily"] for e in els if e["type"] == "text"} == {5}, "a text isn't Excalifont"
for e in els:
    if e["type"] == "text" and e.get("containerId"):
        assert any(c["id"] == e["containerId"] for c in els), "bound text without its container"
EOF
python3 -I -c 'import sys; sys.exit(open(sys.argv[1], "rb").read(8) != b"\x89PNG\r\n\x1a\n")' "$work/example.png" || fail "example.png isn't a PNG"

# 2b. A failed write leaves the earlier pair as it was.
mkdir "$work/locked"
cp "$skill/assets/example.json" "$work/locked/page.json"
node "$build" "$work/locked/page.json" >/dev/null
before=$(cksum "$work/locked/page.png" "$work/locked/page.excalidraw")
chmod 555 "$work/locked"
set +e
node "$build" "$work/locked/page.json" >"$work/locked.out" 2>&1
status=$?
set -e
chmod 755 "$work/locked"
[ "$status" -eq 1 ] && grep -q "Could not write the outputs" "$work/locked.out" || { cat "$work/locked.out"; fail "a failed write should say so and exit 1, got $status"; }
[ "$before" = "$(cksum "$work/locked/page.png" "$work/locked/page.excalidraw")" ] || fail "a failed write changed the earlier outputs"
[ -z "$(ls "$work/locked" | grep '\.tmp$')" ] || fail "a failed write left temporary files"
# A target that can't be replaced (a locked file, on macOS) leaves both earlier files as they were.
if command -v chflags >/dev/null 2>&1; then
  # A different title, so a half-replaced pair would show in the checksums.
  python3 -I -c 'import json, sys; p = json.load(open(sys.argv[1])); p["title"] = "Changed"; json.dump(p, open(sys.argv[1], "w"))' "$work/locked/page.json"
  chflags uchg "$work/locked/page.excalidraw"
  set +e
  node "$build" "$work/locked/page.json" >"$work/locked2.out" 2>&1
  status=$?
  set -e
  chflags nouchg "$work/locked/page.excalidraw"
  [ "$status" -eq 1 ] || { cat "$work/locked2.out"; fail "a locked output should fail the build, got $status"; }
  [ "$before" = "$(cksum "$work/locked/page.png" "$work/locked/page.excalidraw")" ] || fail "a locked output left a PNG and an .excalidraw from different builds"
  [ -z "$(ls "$work/locked" | grep '\.\(tmp\|bak\)$')" ] || fail "a locked output left temporary files"
fi

# 2c. Bad command lines and bad specs get a message and an exit code, not a stack trace.
expect_exit() {
  want=$1; shift
  set +e; node "$build" "$@" >"$work/cli.out" 2>&1; got=$?; set -e
  [ "$got" -eq "$want" ] || { cat "$work/cli.out"; fail "build $* should exit $want, got $got"; }
  ! grep -q "    at " "$work/cli.out" || { cat "$work/cli.out"; fail "build $* printed a stack trace"; }
}
expect_exit 2 "$work/example.json" --out-dir
expect_exit 2 "$work/example.json" --out-dir "$work/no-such-folder"
expect_exit 2 "$work/example.json" --scale
expect_exit 2 "$work/example.json" --scale 9
expect_exit 2
printf '{ not json' >"$work/broken.json"
expect_exit 1 "$work/broken.json"
printf '{ "panels": 5 }' >"$work/odd.json"
expect_exit 1 "$work/odd.json"

# 3. The checks catch what they claim to.
cat >"$work/bad.json" <<'EOF'
{ "title": "Bad", "panels": [ { "id": "b", "heading": "Broken", "elements": [
  { "type": "rectangle", "id": "small", "x": 0, "y": 0, "width": 120, "height": 40, "label": "A label far too long for a box this small" },
  { "type": "rectangle", "id": "box", "x": 200, "y": 0, "width": 200, "height": 80, "label": "Middle label" },
  { "type": "text", "x": 230, "y": 30, "text": "crossing text" },
  { "type": "rectangle", "id": "wide", "x": 500, "y": 0, "width": 300, "height": 50 },
  { "type": "text", "x": 0, "y": 120, "text": "on → off ✓" },
  { "type": "text", "x": 0, "y": 200, "text": "crossed caption" },
  { "type": "arrow", "x": 60, "y": 180, "points": [[0, 0], [0, 60]] },
  { "type": "rectangle", "id": "cyl", "x": 300, "y": 200, "width": 80, "height": 60, "group": "c" },
  { "type": "ellipse", "id": "cyltop", "x": 300, "y": 190, "width": 80, "height": 20, "group": "c" },
  { "type": "rectangle", "id": "near1", "x": 0, "y": 300, "width": 100, "height": 40 },
  { "type": "rectangle", "id": "near2", "x": 0, "y": 352, "width": 100, "height": 40 },
  { "type": "arrow", "id": "stub", "start": "near1", "end": "near2" },
  { "type": "text", "id": "outer", "x": 400, "y": 300, "text": "a long caption that sits here", "fontSize": 20 },
  { "type": "text", "id": "inner", "x": 440, "y": 302, "text": "inside", "fontSize": 16 },
  { "type": "text", "id": "longword", "x": 0, "y": 520, "width": 120, "text": "Supercalifragilisticexpialidocious" },
  { "type": "rectangle", "id": "toplong", "x": 0, "y": 440, "width": 100, "height": 40, "label": { "text": "A top label far too long for this", "valign": "top" } },
  { "type": "rectangle", "id": "leftlong", "x": 200, "y": 440, "width": 120, "height": 40, "label": { "text": "A left label far too long for this box", "align": "left" } }
] } ] }
EOF
set +e
node "$build" "$work/bad.json" --lint-only >"$work/bad.out"
status=$?
set -e
[ "$status" -eq 3 ] || { cat "$work/bad.out"; fail "a broken page should exit 3, got $status"; }
for expect in '"small" grew' 'overlap' '"wide" reaches outside' '"→" "✓" isn'"'"'t in Excalifont' 'runs through the text' '"stub" is only' 'the label of "toplong" doesn'"'"'t fit' 'the label of "leftlong" doesn'"'"'t fit' '"outer" and "inner" overlap' '"longword" has a word wider than its 120 px width'; do
  grep -q -- "$expect" "$work/bad.out" || { cat "$work/bad.out"; fail "missing warning: $expect"; }
done
! grep -q '"cyl"' "$work/bad.out" || { cat "$work/bad.out"; fail "a group's parts were reported as overlapping"; }

# 4. Content taller than the format is a warning that says how much to cut.
python3 -I - "$work/tall.json" <<'PY'
import json, sys
panel = lambda i: {"id": f"t{i}", "span": 2, "heading": "Tall", "elements": [
    {"type": "rectangle", "id": "r", "x": 0, "y": 0, "width": 200, "height": 300}]}
json.dump({"title": "Tall", "format": "square", "panels": [panel(i) for i in range(4)]}, open(sys.argv[1], "w"))
PY
set +e
node "$build" "$work/tall.json" --lint-only >"$work/tall.out"
status=$?
set -e
[ "$status" -eq 3 ] && grep -q "but square is 1500 px tall: cut" "$work/tall.out" || { cat "$work/tall.out"; fail "an overfull page should warn"; }

# 5. Elements without ids: two stacks in one panel build.
cat >"$work/noid.json" <<'JSON'
{ "title": "No ids", "format": "auto", "panels": [ { "id": "n", "heading": "Stacks", "elements": [
  { "type": "stack", "x": 0, "y": 0, "items": ["a", "b"] }, { "type": "stack", "x": 320, "y": 0, "items": ["c", "d"] } ] } ] }
JSON
node "$build" "$work/noid.json" --lint-only >"$work/noid.out" 2>&1 || { cat "$work/noid.out"; fail "two stacks without ids don't build"; }

# 6. A panel without a heading builds.
cat >"$work/nohead.json" <<'JSON'
{ "title": "No heading", "format": "auto", "panels": [ { "id": "h", "elements": [ { "type": "rectangle", "x": 0, "y": 0 } ] } ] }
JSON
node "$build" "$work/nohead.json" --lint-only >"$work/nohead.out" 2>&1 || { cat "$work/nohead.out"; fail "a panel without a heading doesn't build"; }

# 7. A page without a title builds.
cat >"$work/notitle.json" <<'JSON'
{ "title": "", "format": "auto", "panels": [ { "id": "t", "heading": "H", "elements": [ { "type": "rectangle", "x": 0, "y": 0 } ] } ] }
JSON
node "$build" "$work/notitle.json" --lint-only >"$work/notitle.out" 2>&1 || { cat "$work/notitle.out"; fail "a page without a title doesn't build"; }

# 8. A word too long for the page or panel text it sits in is a warning.
long=$(printf "Pneumonoultramicroscopicsilicovolcanoconiosis%.0s" 1 2 3 4 5 6)
cat >"$work/words.json" <<JSON
{ "title": "$long", "format": "auto", "panels": [ { "id": "w", "heading": "$long", "takeaway": "$long",
  "elements": [ { "type": "rectangle", "x": 0, "y": 0 } ] } ], "footer": "$long" }
JSON
set +e; node "$build" "$work/words.json" --lint-only >"$work/words.out" 2>&1; status=$?; set -e
[ "$status" -eq 3 ] || { cat "$work/words.out"; fail "long words should be a warning, got exit $status"; }
for expect in 'the title has a word wider' 'w: the heading has a word wider' 'w: the takeaway has a word wider' 'the footer has a word wider'; do
  grep -q "$expect" "$work/words.out" || { cat "$work/words.out"; fail "missing warning: $expect"; }
done

# 9. Arrows into one side of a box fan out, and arrows to an ellipse end on its curve, not on one point.
cat >"$work/fan.json" <<'JSON'
{ "title": "Fan", "format": "auto", "panels": [ { "id": "f", "heading": "Fan", "elements": [
  { "type": "rectangle", "id": "a", "x": 0, "y": 0, "width": 100, "height": 40 },
  { "type": "rectangle", "id": "b", "x": 0, "y": 80, "width": 100, "height": 40 },
  { "type": "rectangle", "id": "c", "x": 0, "y": 160, "width": 100, "height": 40 },
  { "type": "rectangle", "id": "box", "x": 260, "y": 60, "width": 140, "height": 80 },
  { "type": "ellipse", "id": "dot", "x": 260, "y": 220, "width": 120, "height": 120 },
  { "type": "arrow", "id": "x1", "start": "a", "end": "box" }, { "type": "arrow", "id": "x2", "start": "b", "end": "box" },
  { "type": "arrow", "id": "x3", "start": "c", "end": "box" },
  { "type": "arrow", "id": "y1", "start": "a", "end": "dot" }, { "type": "arrow", "id": "y2", "start": "c", "end": "dot" }
] } ] }
JSON
node "$build" "$work/fan.json" >/dev/null || fail "the fan page doesn't build cleanly"
python3 -I - "$work/fan.excalidraw" <<'PY'
import json, sys
els = {e["id"]: e for e in json.load(open(sys.argv[1]))["elements"]}
tip = lambda i: tuple(round(v) for v in (els[i]["x"] + els[i]["points"][-1][0], els[i]["y"] + els[i]["points"][-1][1]))
for group in (["f.x1", "f.x2", "f.x3"], ["f.y1", "f.y2"]):
    tips = [tip(i) for i in group]
    assert len(set(tips)) == len(tips), f"arrowheads share a point: {tips}"
PY

# 10. Charts put every point where its numbers say, and warn about what they can't draw.
cat >"$work/chart.json" <<'JSON'
{ "title": "", "format": "fit", "frame": false, "panels": [ { "id": "c", "span": 2, "elements": [
  { "type": "chart", "id": "ln", "x": 0, "y": 0, "width": 600, "height": 400, "labels": "none",
    "xAxis": { "min": 0, "max": 10 }, "yAxis": { "min": 0, "max": 10 },
    "series": [ { "color": "blue", "points": [[0, 0], [5, 2.5], [10, 10]] } ] },
  { "type": "chart", "kind": "bar", "id": "br", "x": 700, "y": 0, "width": 500,
    "bars": [ { "label": "a", "value": 10 }, { "label": "b", "value": 5 } ] },
  { "type": "line", "id": "cv", "x": 0, "y": 460, "curve": true, "points": [[0, 0], [60, 30], [120, 0]] },
  { "type": "chart", "id": "tk", "x": 0, "y": 560, "width": 600, "height": 300, "labels": "none",
    "yAxis": { "ticks": [0, 5, 10] }, "series": [ { "points": [[0, 0], [1, 10]] } ] }
] } ] }
JSON
node "$build" "$work/chart.json" >"$work/chart.out" || { cat "$work/chart.out"; fail "the chart page doesn't build cleanly"; }
width=$(sed -n 's/^page \([0-9]*\)×.*/\1/p' "$work/chart.out")
[ "$width" -lt 1500 ] || { cat "$work/chart.out"; fail "format fit should narrow the page, got $width px"; }
python3 -I - "$work/chart.excalidraw" <<'PY'
import json, sys
els = {e["id"]: e for e in json.load(open(sys.argv[1]))["elements"]}
assert not any(i.endswith(".card") for i in els), "a frameless panel drew a card"
s, xa, ya = els["c.ln.s0"], els["c.ln.xaxis"], els["c.ln.yaxis"]
pts = [(s["x"] + px, s["y"] + py) for px, py in s["points"]]
left, bottom = ya["x"], xa["y"]
right, top = xa["x"] + xa["points"][-1][0] - 6, ya["y"] + 6
close = lambda a, b: abs(a[0] - b[0]) < 0.5 and abs(a[1] - b[1]) < 0.5
assert close(pts[0], (left, bottom)), f"(0, 0) should sit on the origin, got {pts[0]}"
assert close(pts[2], (right, top)), f"(10, 10) should sit at the top right, got {pts[2]}"
mid = (left + (right - left) * 0.5, bottom - (bottom - top) * 0.25)
assert close(pts[1], mid), f"(5, 2.5) should sit at {mid}, got {pts[1]}"
assert s["roundness"] == {"type": 2}, "a line chart without y ticks is curved by default"
a, b = els["c.br.b0"]["width"], els["c.br.b1"]["width"]
assert abs(a - 2 * b) < 0.5, f"a bar of 10 should be twice one of 5: {a} and {b}"
assert els["c.cv"]["roundness"] == {"type": 2}, "curve: true should make a round line"
assert els["c.tk.s0"]["roundness"] is None, "a chart with y ticks draws straight segments by default"
PY
# Zero data still draws, a start label sits by its series' first point, and a zero bar has no bar.
cat >"$work/edges.json" <<'JSON'
{ "title": "", "format": "fit", "frame": false, "panels": [ { "id": "e", "span": 2, "elements": [
  { "type": "chart", "id": "z", "x": 0, "y": 0, "width": 600, "height": 300,
    "xAxis": { "min": 0, "max": 10 }, "series": [ { "label": "flat", "points": [[0, 0], [10, 0]] }, { "label": "late", "points": [[5, 0], [10, 0]] } ] },
  { "type": "chart", "id": "neg", "x": 0, "y": 360, "width": 600, "height": 300, "labels": "none",
    "series": [ { "points": [[0, -10], [1, -5]] } ] },
  { "type": "chart", "kind": "bar", "id": "b", "x": 700, "y": 0, "width": 500,
    "bars": [ { "label": "none", "value": 0 }, { "label": "all", "value": 10 } ] }
] } ] }
JSON
node "$build" "$work/edges.json" >"$work/edges.out" || { cat "$work/edges.out"; fail "zero data should build cleanly"; }
python3 -I - "$work/edges.excalidraw" <<'PY'
import json, sys
els = {e["id"]: e for e in json.load(open(sys.argv[1]))["elements"]}
assert "e.z.s0" in els and "e.z.s1" in els, "an all-zero series should still be drawn"
late, label = els["e.z.s1"], els["e.z.label1"]
assert 0 < late["x"] - (label["x"] + label["width"]) < 20, "a start label should sit just left of its series' first point"
assert "e.b.b0" not in els and "e.b.b1" in els, "a zero bar should draw no bar"
n, top = els["e.neg.s0"], els["e.neg.yaxis"]["y"] + 6
assert abs(n["y"] + n["points"][-1][1] - top) < 0.5, "the largest value of an all-negative series should sit at the top"
PY

cat >"$work/badchart.json" <<'JSON'
{ "title": "Bad chart", "format": "auto", "panels": [ { "id": "k", "span": 2, "elements": [
  { "type": "chart", "id": "out", "x": 0, "y": 0, "width": 600, "height": 300,
    "yAxis": { "min": 0, "max": 5, "ticks": [0, 5, 8] }, "series": [ { "label": "s", "points": [[0, 1], [1, 9]] } ] },
  { "type": "chart", "id": "empty", "x": 0, "y": 340, "width": 600, "height": 200, "series": [ { "points": [[0, 1]] } ] },
  { "type": "chart", "kind": "bar", "id": "neg", "x": 700, "y": 0, "bars": [ { "label": "n", "value": -2 } ] }
] } ] }
JSON
set +e; node "$build" "$work/badchart.json" --lint-only >"$work/badchart.out" 2>&1; status=$?; set -e
[ "$status" -eq 3 ] || { cat "$work/badchart.out"; fail "a broken chart should exit 3, got $status"; }
for expect in 'series "s" has a point outside the axis range' 'a y tick is outside the axis range' 'needs two or more' 'chart "empty" has no series' 'bar "n" needs a value of 0 or more'; do
  grep -q -- "$expect" "$work/badchart.out" || { cat "$work/badchart.out"; fail "missing warning: $expect"; }
done

echo "excalidraw-drawing: ok"
