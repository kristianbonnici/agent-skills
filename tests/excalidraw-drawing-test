  { "type": "text", "id": "plain", "x": 0, "y": 0, "fontSize": 24, "text": "Almost all of it is one script" },
  { "type": "text", "id": "mid", "x": 300, "y": 60, "width": 400, "align": "center", "text": "short centred" },
  { "type": "text", "id": "tight", "x": 0, "y": 120, "width": 200, "text": "a wrapped text that needs several lines here" }
