#!/bin/sh
# Checks reviewer-benchmark's bench script with a made-up set: a repository with a change and a commit
# after it, a key, models that are plain commands, and stand-ins for the four reviewer tools. setup makes
# a copy that holds the change, every tracked file of it, and nothing that came after; run saves a report
# and how it ended, skips a review already saved, stops one that passes its time, runs a failed or stale
# one again, stops its reviewer when it is stopped, and calls each tool in the form that can't wait for a
# person; blind hides the models' names, leaves out a review with no report and won't throw away unsaved
# scores; unblind refuses scores that don't fit the key and saves the rest under the models' names; totals
# adds them up and says what is partial, failed or not covered.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/reviewer-benchmark-test.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM

GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 python3 -I - "$repo_root/skills/reviewer-benchmark/scripts/bench" "$work" <<'EOF'
import json, os, signal, subprocess, sys, time
script, work = sys.argv[1], os.path.realpath(sys.argv[2])
state, cache, app, tools = (os.path.join(work, n) for n in ("agent-skills-state", "cache", "app", "tools"))
data = os.path.join(state, "reviewer-benchmark")
copies, scoring = os.path.join(cache, "reviewer-benchmark"), os.path.join(cache, "reviewer-benchmark-scoring")
env = dict(os.environ, AGENT_SKILLS_STATE=state, REVIEWER_BENCHMARK_CACHE=cache, XDG_STATE_HOME=os.path.join(work, "xdg"),
           PATH=tools + os.pathsep + os.environ["PATH"], TOOL_LOG=os.path.join(work, "tool-log"))

def bench(*args):
    return subprocess.run([sys.executable, "-I", script, *args], capture_output=True, text=True, env=env, timeout=120)

def git(folder, *args):
    done = subprocess.run(["git", "-C", folder, "-c", "user.name=t", "-c", "user.email=t@example.com", *args],
                          capture_output=True, text=True)
    assert done.returncode == 0, (args, done.stderr)
    return done.stdout.strip()

def put(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as handle:
        handle.write(text)

def load(*parts):
    return json.load(open(os.path.join(*parts)))

# A repository: a base, the change the first review read, and a later fix that no reviewer may see. The base
# tracks a file its own .gitignore names, and has a folder that is a file after the change.
os.makedirs(app)
git(app, "init", "-q", "-b", "main")
put(os.path.join(app, "count.py"), "def count(items):\n    return len(items)\n")
put(os.path.join(app, "gone.py"), "old = True\n")
put(os.path.join(app, ".gitignore"), "*.fixture\n")
put(os.path.join(app, "kept.fixture"), "tracked, though ignored\n")
put(os.path.join(app, "thing", "inside.txt"), "a folder at the base\n")
git(app, "add", "-A", "-f"); git(app, "commit", "-q", "-m", "base")
base = git(app, "rev-parse", "HEAD")
put(os.path.join(app, "count.py"), "def count(items):\n    return len(items) + 1\n")
os.remove(os.path.join(app, "gone.py"))
os.remove(os.path.join(app, "thing", "inside.txt")); os.rmdir(os.path.join(app, "thing"))
put(os.path.join(app, "thing"), "a file after the change\n")
put(os.path.join(app, "AGENTS.md"), "Rules.\n")
git(app, "add", "-A", "-f"); git(app, "commit", "-q", "-m", "the change")
head = git(app, "rev-parse", "HEAD")
put(os.path.join(app, "count.py"), "def count(items):\n    return len(items)  # THE LATER FIX\n")
git(app, "add", "-A"); git(app, "commit", "-q", "-m", "the fix, after the review")
later = git(app, "rev-parse", "HEAD")

# Without a set, every command that needs one says so; where says there is none yet.
os.makedirs(os.path.join(state, ".git"))
done = bench("where")
assert done.returncode == 0 and f"data: {data}" in done.stdout and "set: no set yet" in done.stdout, done.stdout
assert f"copies: {copies}" in done.stdout and f"scoring: {scoring}" in done.stdout, done.stdout
assert not scoring.startswith(copies + os.sep) and not copies.startswith(scoring + os.sep)
done = bench("setup")
assert done.returncode == 64 and "no set at" in done.stderr, done.stderr
# Without a private state repository the data is under the state home.
done = subprocess.run([sys.executable, "-I", script, "where"], capture_output=True, text=True,
                      env=dict(env, AGENT_SKILLS_STATE=os.path.join(work, "nowhere")))
assert "data: " + os.path.join(work, "xdg", "agent-skills", "reviewer-benchmark") in done.stdout, done.stdout

key = {"id": "one", "repo": app, "base": base, "head": head, "objective": "Count the items.", "rules": "AGENTS.md",
       "defects": [{"n": 1, "title": "Off by one", "where": "count.py", "case": "count([]) is 1", "tag": "blocker"},
                   {"n": 2, "title": "No test", "where": "count.py", "case": "nothing checks it", "tag": "follow-up"}]}
def set_keys(two_base=base):
    put(os.path.join(data, "keys", "one.json"), json.dumps(key))
    put(os.path.join(data, "keys", "two.json"), json.dumps(dict(key, id="two", base=two_base, defects=key["defects"][:1])))
set_keys()
put(os.path.join(data, "set.json"), json.dumps({"version": "1.0", "changes": ["one", "two"]}))
report = "A finding.\n" + "It says what goes wrong and when, at some length, so that it is a report.\n" * 8
own = {
    "good": {"kind": "command", "argv": ["sh", "-c", f"printf '%s' '{report}'; cat count.py; test -f gone.py && echo GONE-IS-THERE; git log --oneline"]},
    "echo": {"kind": "command", "stdin": True, "paid": True, "argv": ["sh", "-c", "cat; echo; echo {work}"]},
    "cheap": {"kind": "command", "stdin": True, "argv": ["sh", "-c", "cat"]},
    "slow": {"kind": "command", "seconds": 1, "argv": ["sh", "-c", "sleep 30.4172 & sleep 30.4172"]},
    "short": {"kind": "command", "argv": ["sh", "-c", "echo no"]},
    "flaky": {"kind": "command", "argv": ["sh", "-c", f"test -f {work}/now-it-works || {{ echo limit reached; exit 1; }}; printf '%s' '{report}'"]},
    "absent": {"kind": "command", "argv": ["no-such-reviewer-tool"]}}
def set_models(**more):
    put(os.path.join(data, "models.json"), json.dumps(dict(own, **more)))
set_models()

# setup: two commits, the change between them, every tracked file, and nothing of the later fix.
done = bench("setup")
assert done.returncode == 0 and "one: " in done.stdout and "two: " in done.stdout, (done.stdout, done.stderr)
copy = os.path.join(copies, "one")
assert git(copy, "rev-list", "--count", "HEAD") == "2"
assert open(os.path.join(copy, "count.py")).read().endswith("len(items) + 1\n") and not os.path.exists(os.path.join(copy, "gone.py"))
assert "LATER FIX" not in subprocess.run(["git", "-C", copy, "log", "-p", "--all"], capture_output=True, text=True).stdout
assert git(copy, "status", "--porcelain") == "", git(copy, "status", "--porcelain")
changed = git(copy, "diff", "--stat", "HEAD~1", "HEAD")
assert "count.py" in changed and "gone.py" in changed and "kept.fixture" not in changed, changed
# A tracked file that .gitignore names is in both commits, and a folder that became a file is the file.
assert "kept.fixture" in git(copy, "ls-tree", "-r", "--name-only", "HEAD~1") and "kept.fixture" in git(copy, "ls-tree", "-r", "--name-only", "HEAD")
assert os.path.isfile(os.path.join(copy, "thing")) and "thing/inside.txt" in git(copy, "ls-tree", "-r", "--name-only", "HEAD~1")
assert bench("setup").stdout == "", "a copy already made is left alone"
assert git(app, "status", "--porcelain") == "" and git(app, "rev-list", "--count", "HEAD") == "3", "the repository is only read"
done = bench("setup", "three")
assert done.returncode == 64 and "not in the set: three" in done.stderr, done.stderr

# run: a report and how it ended; a second run skips it; the brief names the copy, its diff and the rules.
done = bench("run", "good")
assert done.returncode == 0 and done.stdout.count('"model": "good"') == 2, (done.stdout, done.stderr)
text = open(os.path.join(data, "runs", "good", "one.md")).read()
assert text.startswith("A finding.") and "len(items) + 1" in text and "GONE-IS-THERE" not in text and "LATER" not in text, text
meta = load(data, "runs", "good", "one.json")
assert meta["timed_out"] is False and meta["returncode"] == 0 and meta["bytes"] > 400 and meta["set"] == "1.0", meta
assert meta["commits"] == [base, head] and "failed" not in meta and len(meta["id"]) == 32, meta
assert bench("run", "good").stdout == "", "a review already saved isn't run again"
done = bench("run", "echo", "one")
sent = open(os.path.join(data, "runs", "echo", "one.md")).read()
assert done.returncode == 0 and "The change: Count the items." in sent and f"Where: {copy}." in sent, sent
assert f"The project's rules: {copy}/AGENTS.md." in sent and f"git -C {copy} diff " in sent, sent
assert "You have 12 minutes" not in sent, "a paid model's brief has no time line"
assert sent.rstrip().endswith(copy), "{work} in a command is the copy's folder"
assert not os.path.exists(os.path.join(data, "runs", "echo", "two.json")), "only the change named was reviewed"
bench("run", "cheap", "one")
assert "You have 12 minutes and about 20 commands." in open(os.path.join(data, "runs", "cheap", "one.md")).read()
# A review that passes its time is stopped with what it started, recorded, and the run goes on.
done = bench("run", "slow")
metas = [load(data, "runs", "slow", c + ".json") for c in ("one", "two")]
assert done.returncode == 0 and all(m["timed_out"] and m["seconds"] < 20 for m in metas), (metas, done.stderr)
assert "sleep 30.4172" not in subprocess.run(["ps", "-axo", "command"], capture_output=True, text=True).stdout, "what a stopped reviewer started is stopped too"
bench("run", "short")
done = bench("run", "absent")
assert done.returncode == 69 and "isn't installed" in done.stderr and not os.path.exists(os.path.join(data, "runs", "absent", "one.json")), done.stderr
done = bench("run", "nobody")
assert done.returncode == 64 and "no model nobody" in done.stderr, done.stderr
# A command given as a path is looked for from the copy's folder, where it runs.
put(os.path.join(work, "outside", "tool"), "#!/bin/sh\necho ran from $(pwd)\n")
os.chmod(os.path.join(work, "outside", "tool"), 0o755)
set_models(pathed={"kind": "command", "argv": [os.path.relpath(os.path.join(work, "outside", "tool"), copy)]},
           nopath={"kind": "command", "argv": ["bin/none"]})
done = bench("run", "pathed", "one")
assert done.returncode == 0 and open(os.path.join(data, "runs", "pathed", "one.md")).read().strip() == f"ran from {copy}", done.stderr
done = bench("run", "nopath", "one")
assert done.returncode == 69 and "bin/none isn't installed" in done.stderr, done.stderr
set_models()
# A saved review with no id of its own isn't trusted: it is run again.
kept_meta = load(data, "runs", "good", "two.json")
put(os.path.join(data, "runs", "good", "two.json"), json.dumps({k: v for k, v in kept_meta.items() if k != "id"}))
done = bench("run", "good", "two")
assert '"change": "two"' in done.stdout and len(load(data, "runs", "good", "two.json")["id"]) == 32, done.stdout
# A review that ends in an error with no report is recorded as failed, and the next run does it again.
done = bench("run", "flaky", "one")
assert done.returncode == 0 and load(data, "runs", "flaky", "one.json").get("failed") is True, done.stdout
put(os.path.join(work, "now-it-works"), "")
done = bench("run", "flaky", "one")
meta = load(data, "runs", "flaky", "one.json")
assert '"model": "flaky"' in done.stdout and "failed" not in meta and meta["bytes"] > 400, (done.stdout, meta)
# Stopping bench stops its reviewer and keeps nothing of that review.
set_models(waits={"kind": "command", "argv": ["sh", "-c", "echo started; sleep 31.4172"]})
running = subprocess.Popen([sys.executable, "-I", script, "run", "waits", "one"], env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
for _ in range(100):
    time.sleep(0.1)
    if os.path.exists(os.path.join(data, "runs", "waits", "one.md")) and os.path.getsize(os.path.join(data, "runs", "waits", "one.md")):
        break
running.send_signal(signal.SIGTERM)
said = running.communicate(timeout=60)[1]
assert running.returncode == 130 and "stopped during" in said, (running.returncode, said)
assert not os.path.exists(os.path.join(data, "runs", "waits", "one.json")) and not os.path.exists(os.path.join(data, "runs", "waits", "one.md"))
assert "sleep 31.4172" not in subprocess.run(["ps", "-axo", "command"], capture_output=True, text=True).stdout
# Its terminal closing stops the reviewer the same way.
running = subprocess.Popen([sys.executable, "-I", script, "run", "waits", "one"], env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
for _ in range(100):
    time.sleep(0.1)
    if os.path.exists(os.path.join(data, "runs", "waits", "one.md")) and os.path.getsize(os.path.join(data, "runs", "waits", "one.md")):
        break
running.send_signal(signal.SIGHUP)
running.communicate(timeout=60)
assert running.returncode == 130 and "sleep 31.4172" not in subprocess.run(["ps", "-axo", "command"], capture_output=True, text=True).stdout
# A tool that ends in an error after printing a lot is failed all the same: what it printed is no report.
set_models(loud={"kind": "command", "argv": ["sh", "-c", f"printf '%s' '{report}'; exit 3"]})
bench("run", "loud", "one")
assert load(data, "runs", "loud", "one.json").get("failed") is True

# The four tools are called in the forms that can't wait for a person: each stand-in records how it was called.
for tool in ("opencode", "claude", "codex", "agy"):
    put(os.path.join(tools, tool), "#!/bin/sh\n{ echo \"TOOL " + tool + "\"; for a in \"$@\"; do echo \"ARG $a\"; done; cat > \"$TOOL_LOG.in." + tool + "\"; echo \"STDIN $(wc -c < \"$TOOL_LOG.in." + tool + "\" | tr -d ' ')\"; } >> \"$TOOL_LOG.$1$2\"\n"
        + ("[ -f \"$TOOL_LOG.no-last\" ] || while [ $# -gt 0 ]; do [ \"$1\" = --output-last-message ] && printf '%s' 'the last message' > \"$2\"; shift; done\n" if tool == "codex" else "")
        + "echo a report from " + tool + "\n")
    os.chmod(os.path.join(tools, tool), 0o755)
set_models(oc={"kind": "opencode", "model": "p/m#high"}, cl={"kind": "claude", "model": "claude-x"},
           cx={"kind": "codex", "model": "gpt-x", "paid": True, "minutes": 30}, ag={"kind": "agy", "model": "gem-x"})
for name in ("oc", "cl", "cx", "ag"):
    assert bench("run", name, "one").returncode == 0, name
def called(start):
    name = next(n for n in os.listdir(work) if n.startswith("tool-log." + start))
    lines = open(os.path.join(work, name)).read().splitlines()
    args = []
    for line in lines[1:]:
        if line.startswith("STDIN "):
            return args, int(line.split()[1])
        if line.startswith("ARG "):
            args.append(line[4:])
        else:
            args[-1] += "\n" + line       # an argument of several lines, as the brief is
args, stdin = called("run--agent")
assert args[:5] == ["run", "--agent", "plan", "-m", "p/m#high"] and args[5].startswith("You are reviewing") and stdin == 0, args[:5]
args, stdin = called("-p--model")
assert args == ["-p", "--model", "claude-x", "--effort", "high", "--permission-mode", "dontAsk", "--setting-sources", "local",
                "--allowedTools", "Read,Grep,Glob,Bash(git diff:*),Bash(git log:*),Bash(git show:*)"], args
assert stdin > 500, "claude gets its brief on standard input, and none of it as an argument"
# Its allow rules match the start of a command, so its brief gives the diff as plain "git diff", as agy's does.
brief = open(env["TOOL_LOG"] + ".in.claude").read()
assert "The diff: git diff " in brief and "run from that folder" in brief and "git -C" not in brief, brief
args, stdin = called("exec--sandbox")
assert args[:4] == ["exec", "--sandbox", "read-only", "--ephemeral"] and args[args.index("-C") + 1] == copy and stdin == 0, args
assert "You have" not in args[-1] and open(os.path.join(data, "runs", "cx", "one.md")).read() == "the last message"
# Codex without a last message left no report, whatever its session printed.
put(env["TOOL_LOG"] + ".no-last", "")
bench("run", "cx", "two")
assert load(data, "runs", "cx", "two.json")["bytes"] == 0 and open(os.path.join(data, "runs", "cx", "two.md")).read() == ""
os.remove(env["TOOL_LOG"] + ".no-last")
args, stdin = called("--modeplan")
assert args[:4] == ["--mode", "plan", "--model", "gem-x"] and "--settings" in args and args[-2] == "-p" and stdin == 0, args
assert "Run one shell command at a time" in args[-1] and "command(git diff)" in args[args.index("--settings") + 1]
assert "The diff: git diff " in args[-1] and "git -C" not in args[-1], args[-1]

# A review of other commits than the key's now names is run again, and its score is dropped.
put(os.path.join(data, "scores", "two.json"), json.dumps({"id": "two", "reports": {"echo": {"is_review": True, "known": {"1": 1}, "others": [], "nits_unchecked": 0}, "good": {"is_review": True, "known": {"1": 1}, "others": [], "nits_unchecked": 0}}}))
bench("run", "echo", "two")
set_keys(two_base=head)
done = bench("run", "echo", "two")
assert done.returncode == 64 and "run setup" in done.stderr, done.stderr
assert "two: " in bench("setup").stdout
stale = json.loads(bench("totals", "--json").stdout)
assert {r["model"]: r["stale"] for r in stale["models"]}["good"] == 1, stale
done = bench("run", "echo", "two")
assert done.returncode == 0 and load(data, "runs", "echo", "two.json")["commits"] == [head, head], done.stderr
assert sorted(load(data, "scores", "two.json")["reports"]) == ["good"], "the earlier review's score went with it"
set_keys()
assert "two: " in bench("setup").stdout
os.remove(os.path.join(data, "scores", "two.json"))
for name in ("good", "echo", "cheap"):
    assert bench("run", name).returncode == 0

# blind: letters for the reports there are, none for a review that timed out or left almost nothing.
done = bench("blind", "good", "echo", "slow", "short")
assert done.returncode == 0 and "4 reports of 2 changes" in done.stdout, (done.stdout, done.stderr)
blind = os.path.join(scoring, "blind")
mapping = load(blind, "map.json")
assert sorted(mapping["one"].values()) == ["echo", "good"] and sorted(mapping["one"]) == ["A", "B"], mapping
for letter, name in mapping["one"].items():
    assert open(os.path.join(blind, "one", letter + ".md")).read() == open(os.path.join(data, "runs", name, "one.md")).read()
assert sorted(os.listdir(os.path.join(blind, "one"))) == ["A.md", "B.md", "scores.json"]
template = load(blind, "one", "scores.json")
assert template["reports"]["A"]["known"] == {"1": 0, "2": 0} and "good" not in json.dumps(template), template
assert bench("blind", "nobody").returncode == 64 and bench("blind").returncode == 64

# unblind: scores that don't fit the key are refused, all of them named, and nothing is saved.
def fill(change, **by_model):
    path = os.path.join(blind, change, "scores.json")
    scores = json.load(open(path))
    for letter, name in mapping[change].items():
        if name in by_model:
            scores["reports"][letter] = by_model[name]
    put(path, json.dumps(scores))

fill("one", good={"is_review": True, "known": {"1": 1}, "others": [{"title": "x", "verdict": "sort of"}], "nits_unchecked": 0})
done = bench("unblind")
assert done.returncode == 64 and '"known" needs one score for each' in done.stderr and '"verdict" is one of' in done.stderr, done.stderr
assert not os.path.exists(os.path.join(data, "scores", "one.json")), "nothing is saved while a score doesn't fit"
# Scores a scorer has filled aren't thrown away by another blind, unless it says so.
done = bench("blind", "cheap")
assert done.returncode == 64 and "aren't saved yet" in done.stderr and load(blind, "map.json") == mapping, done.stderr
fill("one",
     good={"is_review": True, "known": {"1": 1, "2": 0.5}, "nits_unchecked": 3, "others": [
         {"title": "a real one", "their_tag": "follow-up", "verdict": "real", "why": "count.py"},
         {"title": "a small one", "their_tag": "follow-up", "verdict": "true-minor", "why": "count.py"},
         {"title": "an old one", "their_tag": "none", "verdict": "pre-existing", "why": "count.py"},
         {"title": "a false one", "their_tag": "blocker", "verdict": "wrong", "why": "count.py"}]},
     echo={"is_review": False, "known": {"1": 0, "2": 0}, "others": [], "nits_unchecked": 0})
fill("two", good={"is_review": True, "known": {"1": 1}, "others": [], "nits_unchecked": 0},
     echo={"is_review": True, "known": {"1": 1}, "others": [], "nits_unchecked": 1})
done = bench("unblind")
assert done.returncode == 0 and "scores of 4 reports saved" in done.stdout, (done.stdout, done.stderr)
saved = load(data, "scores", "one.json")["reports"]
assert sorted(saved) == ["echo", "good"] and saved["good"]["known"] == {"1": 1, "2": 0.5}, saved
# Another model scored later is added beside them, not in their place. A report whose file is gone is named
# before anything is thrown away.
os.rename(os.path.join(data, "runs", "cheap", "two.md"), os.path.join(work, "moved.md"))
done = bench("blind", "cheap")
assert done.returncode == 64 and "is missing" in done.stderr and load(blind, "map.json") == mapping, done.stderr
os.rename(os.path.join(work, "moved.md"), os.path.join(data, "runs", "cheap", "two.md"))
assert bench("blind", "cheap").returncode == 0
mapping = load(blind, "map.json")
fill("one", cheap={"is_review": True, "known": {"1": 0, "2": 1}, "others": [], "nits_unchecked": 0})
assert bench("blind", "--discard", "cheap").returncode == 0, "--discard throws unsaved scores away"
mapping = load(blind, "map.json")
fill("one", cheap={"is_review": True, "known": {"1": 0, "2": 1}, "others": [], "nits_unchecked": 0})
fill("two", cheap={"is_review": True, "known": {"1": 0}, "others": [], "nits_unchecked": 0})
# A change reviewed again since blind copied its report: that score is left out and named, the rest are saved,
# and blind can be run again for the new report.
kept_meta = open(os.path.join(data, "runs", "cheap", "two.json")).read()
put(os.path.join(data, "runs", "cheap", "two.json"), json.dumps(dict(json.loads(kept_meta), id="another review")))
done = bench("unblind")
assert done.returncode == 0 and "scores of 1 reports saved" in done.stdout and "not saved" in done.stdout and "two A" in done.stdout, done.stdout
assert sorted(load(data, "scores", "one.json")["reports"]) == ["cheap", "echo", "good"]
assert "cheap" not in load(data, "scores", "two.json")["reports"]
assert bench("blind", "cheap").returncode == 0, "after unblind saved what it could, blind runs again"
mapping = load(blind, "map.json")
# Only the report with no score yet is shown again: the saved score of "one" can't be replaced by an empty one.
assert mapping == {"one": {}, "two": {"A": "cheap"}}, mapping
