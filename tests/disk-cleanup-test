#!/bin/sh
# Checks disk-cleanup's scan script in a made-up home folder: it deletes nothing, finds big folders
# and what's left in their parents, build folders with their own repository's last commit, big files,
# app data with no app and LaunchAgents with a missing program, marks what's new or grew since an
# earlier day's scan, says what it was refused, keeps 12 scans, and answers the due check. Then checks
# its decisions script: two made-up computers share one decisions file through links and neither sees
# the other's entries, a new computer starts clean, and an older single list is migrated unchanged
# under the computer the owner named, and only then.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/disk-cleanup-test.XXXXXX")
trap 'chmod -R u+rwx "$work"; rm -rf "$work"' EXIT HUP INT TERM

python3 -I - "$repo_root/skills/disk-cleanup/scripts/scan" "$work" <<'EOF'
import hashlib, os, plistlib, subprocess, sys
from datetime import date, timedelta

script, work = sys.argv[1], sys.argv[2]
home = os.path.realpath(os.path.join(work, "home"))
state = os.path.join(work, "state")
scans = os.path.join(state, "agent-skills", "disk-cleanup", "scans")
env = {**os.environ, "HOME": home, "XDG_STATE_HOME": state}


def fill(path, mb):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "wb") as handle:
        for _ in range(mb):
            handle.write(os.urandom(1024 * 1024))


def run(*args):
    done = subprocess.run([script, *args], capture_output=True, text=True, env=env)
    assert done.returncode == 0, (args, done.stdout, done.stderr)
    return done.stdout


def section(text, title):
    return text.split(title, 1)[1].split("\n\n", 1)[0]


def tree():
    digest = hashlib.sha256()
    for root, dirs, files in os.walk(home):
        dirs.sort()
        for name in sorted(files):
            path = os.path.join(root, name)
            digest.update(path.encode())
            with open(path, "rb") as handle:
                digest.update(handle.read())
    return digest.hexdigest()


fill(f"{home}/Forgotten/copy/data/blob", 3)
fill(f"{home}/Code/app/node_modules/pkg/blob", 2)
fill(f"{home}/Code/crate/target/release/blob", 2)
fill(f"{home}/Code/crate/Cargo.toml", 0)
fill(f"{home}/Code/notrust/target/blob", 2)
fill(f"{home}/Big/single.bin", 4)
fill(f"{home}/Library/Caches/one-big/blob", 6)
for number in range(4):
    fill(f"{home}/Library/Caches/small-{number}/blob", 0)
    with open(f"{home}/Library/Caches/small-{number}/blob", "wb") as handle:
        handle.write(os.urandom(600 * 1024))
fill(f"{home}/Library/Application Support/com.example.gone/blob", 2)
fill(f"{home}/Library/Application Support/com.apple.system/blob", 2)
os.makedirs(f"{home}/Library/Application Support/not-a-bundle-id")
fill(f"{home}/Parent/project/node_modules/blob", 2)
subprocess.run(["git", "init", "-q", f"{home}/Parent"], check=True)
fill(f"{home}/Own/node_modules/blob", 2)
subprocess.run(["git", "init", "-q", f"{home}/Own"], check=True)
open(f"{home}/Own/file", "w").close()
subprocess.run(["git", "-C", f"{home}/Own", "add", "file"], check=True)
subprocess.run(["git", "-C", f"{home}/Own", "-c", "user.name=t", "-c", "user.email=t@example.com", "commit", "-qm", "x"], check=True)
os.makedirs(f"{home}/Library/LaunchAgents")
for name, program in (("gone", "/nonexistent/app/helper"), ("here", "/bin/sh"), ("unplugged", "/Volumes/no-such-drive/app")):
    with open(f"{home}/Library/LaunchAgents/{name}.plist", "wb") as handle:
        plistlib.dump({"Label": name, "ProgramArguments": [program, "-x"]}, handle)
with open(f"{home}/Library/LaunchAgents/list.plist", "wb") as handle:
    plistlib.dump(["not", "a", "job"], handle)
with open(f"{home}/Library/LaunchAgents/dictargs.plist", "wb") as handle:
    plistlib.dump({"Label": "x", "ProgramArguments": {"not": "a list"}}, handle)
refused = f"{home}/Locked/private"
fill(f"{refused}/blob", 1)
os.chmod(refused, 0)

# the due check before any scan
assert run("--due").startswith("due: no scan yet"), "no scan is due"
assert not os.path.exists(scans), "the due check wrote nothing"

os.chmod(refused, 0o700)
before = tree()
os.chmod(refused, 0)

first = run("--min-mb", "1", "--min-file-mb", "3")
os.chmod(refused, 0o700)
assert tree() == before, "the scan changed nothing"
os.chmod(refused, 0)

assert "Compared with: nothing, first scan" in first, first
biggest = section(first, "Biggest folders")
assert "~/Forgotten/copy/data" in biggest and "NEW" not in biggest, biggest
assert "~/Forgotten\n" not in biggest, "a parent of a listed folder isn't listed"
assert "rest of ~/Library/Caches" in biggest, "bulk under the floor in a parent stays visible"
assert "rest of ~/Forgotten" not in biggest, "a parent with nothing else in it isn't listed"
orphans = section(first, "App data whose app")
assert "com.example.gone" in orphans, orphans
assert "com.apple.system" not in orphans, "macOS's own data isn't an orphan"
builds = section(first, "Build folders")
assert "~/Code/app/node_modules" in builds, builds
assert "~/Code/crate/target" in builds, builds
assert "~/Code/notrust/target" not in builds, "target without Cargo.toml isn't a build folder"
line = next(l for l in builds.splitlines() if "~/Parent/project/node_modules" in l)
assert "not a repository" in line, "a parent repository's commit isn't this project's: " + line
line = next(l for l in builds.splitlines() if "~/Own/node_modules" in l)
assert f"last commit {date.today()}" in line, line
assert "~/Big/single.bin" in section(first, "Single files"), first
broken = section(first, "LaunchAgents")
assert "gone.plist: /nonexistent/app/helper" in broken and "here.plist" not in broken, broken
assert "unplugged.plist" not in broken, "a drive that isn't plugged in isn't a missing program"
assert "~/Locked/private" in section(first, "Refused"), first
assert os.path.exists(os.path.join(scans, f"{date.today()}.tsv")), "the scan was saved"

# compared with an earlier scan: new folders and growth are marked
os.rename(os.path.join(scans, f"{date.today()}.tsv"), os.path.join(scans, f"{date.today() - timedelta(days=30)}.tsv"))
assert run("--due").startswith("due: last scan 30 days ago"), "28 days or more is due"
with open(os.path.join(scans, f"{date.today() - timedelta(days=30)}.tsv"), "a") as handle:
    handle.write("-1048576\t~/Grown/data/more\n")  # as if it had grown by 1 GB, without writing 1 GB
fill(f"{home}/Fresh/new/data/blob", 2)
fill(f"{home}/Grown/data/more/blob", 2)
second = run("--min-mb", "1", "--min-file-mb", "5000")
biggest = section(second, "Biggest folders")
line = next(l for l in biggest.splitlines() if "~/Fresh/new/data" in l)
assert line.endswith("NEW"), line
line = next(l for l in biggest.splitlines() if "~/Grown/data/more" in l)
assert "GB" in line.rsplit("  ", 1)[1] and line.rsplit("  ", 1)[1].startswith("+"), line
assert "NEW" not in next(l for l in biggest.splitlines() if "~/Forgotten" in l), biggest
assert "  none" in section(second, "Single files"), second

# a second scan the same day still compares with the earlier day's, and a damaged line is skipped
with open(os.path.join(scans, f"{date.today() - timedelta(days=30)}.tsv"), "a") as handle:
    handle.write("<<<<<<< damaged\n\n")
fill(f"{home}/Later/same-day/data/blob", 2)
third = run("--min-mb", "1", "--min-file-mb", "5000")
assert f"Compared with: {date.today() - timedelta(days=30)}" in third, third
biggest = section(third, "Biggest folders")
assert next(l for l in biggest.splitlines() if "~/Fresh/new/data" in l).endswith("NEW"), biggest

assert run("--due").startswith("not due: last scan 0 days ago"), "a scan today isn't due"
assert run("--due", "--days", "0").startswith("due:"), "--days is honoured"
assert run("--due", "--floor-percent", "101").startswith("due:"), "under the floor is due"

# only the last 12 scans stay
for days in range(40, 60):
    with open(os.path.join(scans, f"{date.today() - timedelta(days=days)}.tsv"), "w") as handle:
        handle.write("# free_kb 1 total_kb 2\n")
run("--min-mb", "1", "--min-file-mb", "5000")
names = sorted(os.listdir(scans))
assert len(names) == 12 and names[-1] == f"{date.today()}.tsv", names

# nothing to measure
gone = {**env, "HOME": os.path.join(work, "no-such-home")}
done = subprocess.run([script], capture_output=True, text=True, env=gone)
assert done.returncode == 1 and "nothing could be measured" in done.stderr, done
print("disk-cleanup scan: ok")
EOF

python3 -I - "$repo_root/skills/disk-cleanup/scripts/decisions" "$work/decisions" <<'EOF'
import os, subprocess, sys

script, work = sys.argv[1], sys.argv[2]
shared = os.path.join(work, "repo", "disk-cleanup", "decisions.md")  # the state repository's file
os.makedirs(os.path.dirname(shared))


def state(machine):
    folder = os.path.join(work, machine, "state", "agent-skills", "disk-cleanup")
    os.makedirs(folder, exist_ok=True)
    link = os.path.join(folder, "decisions.md")
    if not os.path.islink(link):
        os.symlink(shared, link)
    return os.path.join(work, machine, "state")


def linked(machine):
    return os.path.islink(os.path.join(work, machine, "state", "agent-skills", "disk-cleanup", "decisions.md"))


def run(machine, *args, code=0):
    env = {**os.environ, "XDG_STATE_HOME": state(machine), "DISK_CLEANUP_MACHINE": machine}
    done = subprocess.run([script, *args], capture_output=True, text=True, env=env)
    assert done.returncode == code, (machine, args, done.returncode, done.stdout, done.stderr)
    return done.stdout + done.stderr


def read():
    with open(shared) as handle:
        return handle.read()


def add(machine, title, entry):
    text = read()
    start = text.index(f"## Machine: {machine}\n")
    at = text.index(f"### {title}\n", start) + len(f"### {title}\n")
    with open(shared, "w") as handle:
        handle.write(text[:at] + entry + "\n" + text[at:])


# no file yet: the first round anywhere
assert "file: none yet" in run("studio-mac", "show")
assert "created" in run("studio-mac", "init")
assert linked("studio-mac"), "init wrote through the link"
add("studio-mac", "Keep", "- `~/Studio/models` (2026-11-01): in use on studio-mac.")
add("studio-mac", "Cleared", "- `~/Library/Caches/tool` (2026-11-01): about 5 GB.")

# a second computer: no section yet, so it starts clean and the first one's entries aren't shown
out = run("travel-mac", "show")
assert "new computer: no section for travel-mac" in out, out
assert "other computers (not applied here): studio-mac" in out, out
assert "~/Studio/models" not in out and "~/Library/Caches/tool" not in out, out
before = read()
assert "added a section for travel-mac" in run("travel-mac", "init")
assert read().startswith(before.rstrip("\n")), "init only appended"
add("travel-mac", "Keep", "- `~/Travel/photos` (2026-11-02): the owner's photos.")
assert "already has a section" in run("travel-mac", "init")

studio, travel = run("studio-mac", "show"), run("travel-mac", "show")
assert "~/Studio/models" in studio and "~/Library/Caches/tool" in studio and "~/Travel/photos" not in studio, studio
assert "~/Travel/photos" in travel and "~/Studio/models" not in travel and "~/Library/Caches/tool" not in travel, travel
assert "## Every machine" in studio and "## Every machine" in travel
assert "other computers (not applied here): travel-mac" in studio, studio
laid_out = read()
assert "nothing was written" in run("studio-mac", "migrate", "--to", "studio-mac", code=2)
assert read() == laid_out, "migrate leaves a laid-out file alone"

# an older single list: shown as applying nowhere, init refuses, migrate moves it unchanged
old = """# disk-cleanup decisions

## Keep
- `~/Developer/projects/app/.git` (2026-10-31): the owner's git history.
- `~/Downloads` (2026-10-31): the owner's files.

## Undecided
- `~/Library/Containers/com.docker.docker` (2026-10-31): about 19 GB, not yet offered.

## Cleared
- Homebrew and npm caches (2026-10-31): about 17 GB.
"""
with open(shared, "w") as handle:
    handle.write(old)
assert "layout: single list" in run("travel-mac", "show")
assert "migrate it first" in run("travel-mac", "init", code=2) and read() == old, "init refuses a single list"
assert "--unassigned" in run("travel-mac", "migrate", code=1) and read() == old, "migrate needs a computer's name"
assert "moved 4 entries under studio-mac" in run("travel-mac", "migrate", "--to", "studio-mac")
assert linked("travel-mac"), "migrate wrote through the link"
new = read()
entries = [line for line in old.splitlines() if line.startswith("- ")]
assert [line for line in new.splitlines() if line.startswith("- ")] == entries, new
assert new.index("## Every machine") < new.index("## Machine: studio-mac") < new.index("### Keep") < new.index("### Undecided") < new.index("### Cleared"), new
assert "\n## Keep" not in new and new.count("## Machine: ") == 1, new
travel = run("travel-mac", "show")
assert "new computer: no section for travel-mac" in travel and not any(e in travel for e in entries), travel
studio = run("studio-mac", "show")
assert all(e in studio for e in entries), studio
assert "isn't a single list" in run("studio-mac", "migrate", "--to", "studio-mac", code=2) and read() == new, "migrating twice changes nothing"

# without the override the computer is named as the skill says, and --file names another file
command = ["scutil", "--get", "LocalHostName"] if sys.platform == "darwin" else ["hostname", "-s"]
expected = subprocess.run(command, capture_output=True, text=True, check=True).stdout.strip()
plain = {key: value for key, value in os.environ.items() if key != "DISK_CLEANUP_MACHINE"}
done = subprocess.run([script, "show", "--file", os.path.join(work, "none.md")], capture_output=True, text=True, env=plain)
assert done.returncode == 0 and done.stdout.startswith(f"machine: {expected}\n") and "file: none yet" in done.stdout, done

# a link to a missing file is refused, and nothing is made where it points
dangling = os.path.join(work, "dangling.md")
os.symlink(os.path.join(work, "not-cloned", "disk-cleanup", "decisions.md"), dangling)
for args in (("show",), ("init",), ("migrate", "--unassigned")):
    assert "which is missing" in run("studio-mac", *args, "--file", dangling, code=1), args
assert not os.path.exists(os.path.join(work, "not-cloned")), "init made no folders"

# the owner can't say where a single list was made: it moves under Unassigned, applied nowhere,
# init works again, and a later migrate gives it to the computer the owner names
with open(shared, "w") as handle:
    handle.write(old)
assert "migrate" in run("studio-mac", "migrate", "--to", "studio-mac", "--unassigned", code=1) and read() == old
assert "moved 4 entries under Unassigned" in run("travel-mac", "migrate", "--unassigned")
held = read()
assert [line for line in held.splitlines() if line.startswith("- ")] == entries, held
assert "\n## Unassigned\n" in held and "## Machine: " not in held, held
out = run("travel-mac", "show")
assert "unassigned (not applied here): 4 entries" in out and not any(e in out for e in entries), out
assert "added a section for travel-mac" in run("travel-mac", "init")
assert "already has a section" in run("travel-mac", "migrate", "--to", "travel-mac", code=2)
before = read()
assert "moved 4 unassigned entries under studio-mac" in run("travel-mac", "migrate", "--to", "studio-mac")
after = read()
assert after == before.replace("\n## Unassigned\n", "\n## Machine: studio-mac\n"), after
assert all(e in run("studio-mac", "show") for e in entries)
assert "nothing to migrate" in run("studio-mac", "migrate", "--to", "studio-mac", code=2) and read() == after

# a file it can't place is refused, not guessed
for extra in ("\n## Another machine\n- `~/b` (2026-10-31): kept.\n", "\n## Unassigned\n"):
    with open(shared, "w") as handle:
        handle.write(old + extra)
    unknown = read()
    for args in (("show",), ("init",), ("migrate", "--to", "studio-mac"), ("migrate", "--unassigned")):
        assert "fix it by hand" in run("studio-mac", *args, code=2) and read() == unknown, (extra, args)
with open(shared, "w") as handle:
    handle.write(old + "\n## Machine: studio-mac\n### Keep\n")
mixed = read()
for args in (("show",), ("init",), ("migrate", "--to", "studio-mac")):
    assert "fix it by hand" in run("studio-mac", *args, code=2) and read() == mixed, args
with open(shared, "w") as handle:
    handle.write("# disk-cleanup decisions\n\n## Every machine\n\n## Keep\n- `~/a` (2026-10-31): kept.\n")
mixed = read()
for args in (("show",), ("init",), ("migrate", "--to", "studio-mac")):
    assert "fix it by hand" in run("studio-mac", *args, code=2) and read() == mixed, args
laid = "# disk-cleanup decisions\n\n## Every machine\n- rule one (2026-11-01)\n\n## Machine: studio-mac\n\n### Keep\n"
for extra in ("\n## Machine travel-mac\n### Keep\n- `~/t` (2026-11-01): kept.\n", "\n## Every machine\n- rule two (2026-11-01)\n"):
    with open(shared, "w") as handle:
        handle.write(laid + extra)
    unknown = read()
    for args in (("show",), ("init",), ("migrate", "--to", "studio-mac")):
        assert "fix it by hand" in run("travel-mac", *args, code=2) and read() == unknown, (extra, args)
with open(shared, "w") as handle:
    handle.write(laid + "<<<<<<< HEAD\n- `~/a` (2026-11-01): kept.\n=======\n- `~/b` (2026-11-02): kept.\n>>>>>>> theirs\n")
unknown = read()
for args in (("show",), ("init",), ("migrate", "--unassigned")):
    assert "conflict markers" in run("studio-mac", *args, code=2) and read() == unknown, args
with open(shared, "wb") as handle:
    handle.write(laid.encode() + b"- `~/caf\xe9` (2026-11-01): kept.\n")
for args in (("show",), ("init",)):
    out = run("studio-mac", *args, code=1)
    assert "isn't UTF-8" in out and "Traceback" not in out, out

# a hand-edited heading with extra spaces is still this computer's section, not a new one
with open(shared, "w") as handle:
    handle.write("# disk-cleanup decisions\n\n## Every machine\n\n## Machine:  studio-mac \n\n### Keep\n- `~/a` (2026-10-31): kept.\n")
spaced = read()
out = run("studio-mac", "show")
assert "`~/a`" in out and "new computer" not in out and "not applied here): none" in out, out
assert "already has a section" in run("studio-mac", "init") and read() == spaced
print("disk-cleanup decisions: ok")
EOF
