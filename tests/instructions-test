#!/bin/sh
# Checks the instruction files bootstrap builds from install/instructions.tsv (scripts/instructions,
# through bootstrap, doctor and uninstall), in a made-up home with a made-up private repository and
# two made-up computers: studio-mac and travel-mac share sections and differ in one. Each file is
# built exactly from its sections with the marker on its first line; the owner's own file at a
# target is left alone ("not adopted", a warning in doctor) until --adopt-instructions takes it over
# with a backup beside it; a built file that no longer matches its sections is rebuilt and reported;
# uninstall removes only built files; no table, or no row for this computer, builds and reports
# nothing; manifest refuses a row it cannot use.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
test_home=$(mktemp -d "${TMPDIR:-/tmp}/instructions-test.XXXXXX")
trap 'rm -rf "$test_home"' EXIT HUP INT TERM
# As the scripts spell it: TMPDIR may end in a slash.
test_home=$(CDPATH= cd -- "$test_home" && pwd)

export AGENT_SKILLS_STATE="$test_home/no-state"
export XDG_STATE_HOME="$test_home/.local/state"
export AGENT_SKILLS_NO_UPDATE_CHECK=1
# Doctor --all asks the OpenCode CLI which skills it sees: a stand-in answers.
stand_in_bin="$test_home/stand-in-bin"
mkdir -p "$stand_in_bin"
printf '#!/bin/sh\necho "{\\"data\\": [{\\"id\\": \\"product-design\\"}]}"\n' >"$stand_in_bin/opencode"
chmod +x "$stand_in_bin/opencode"

fail() { echo "instructions-test: $*" >&2; exit 1; }
expect() { grep -q -- "$1" "$2" || { echo "instructions-test: expected \"$1\" in $2:" >&2; cat "$2" >&2; exit 1; }; }
refuse() { if grep -q -- "$1" "$2"; then echo "instructions-test: did not expect \"$1\" in $2:" >&2; cat "$2" >&2; exit 1; fi; }

private="$test_home/agent-skills-private"
mkdir -p "$private/install" "$private/instructions/sections"
: >"$private/install/skills.tsv"
printf '# computer\thosts\nstudio-mac\tclaude codex opencode factory\ntravel-mac\tclaude codex opencode\n' >"$private/install/computers.tsv"
sections="$private/instructions/sections"
printf '# Global instructions\n' >"$sections/title.md"
printf '## Long responses\n\nEnd a long reply with a TLDR.\n' >"$sections/long-responses.md"
printf '## Computer use\n\nUse the studio tools.\n\n- Check a screenshot.\n' >"$sections/computer-use-studio.md"
printf '## Computer use\n\nUse the travel tools.\n\n- Check a screenshot.\n' >"$sections/computer-use-travel.md"
# A section without a final newline still ends its line.
printf '## Voice\n\nSpeak only when blocked.' >"$sections/voice.md"
{
  printf '# computer\thost\ttarget\tsections\n'
  printf 'studio-mac\tclaude\t~/.claude/CLAUDE.md\ttitle long-responses computer-use-studio voice\n'
  printf 'studio-mac\tcodex\t~/.codex/AGENTS.md\tlong-responses computer-use-studio\n'
  printf 'studio-mac\topencode\t~/.config/opencode/AGENTS.md\tcomputer-use-studio voice\n'
  printf 'travel-mac\tclaude\t~/.claude/CLAUDE.md\ttitle long-responses computer-use-travel\n'
  printf 'travel-mac\tcodex\t~/.codex/AGENTS.md\tlong-responses computer-use-travel\n'
  printf 'travel-mac\topencode\t~/.config/opencode/AGENTS.md\tcomputer-use-travel\n'
} >"$private/install/instructions.tsv"
export AGENT_SKILLS_PRIVATE="$private"

on() {
  on_computer=$1
  shift
  AGENT_SKILLS_COMPUTER="$on_computer" HOME="$on_home" PATH="$stand_in_bin:$PATH" "$@"
}
# The marker names the repository by its folder's name and ends with the checksum of the rest.
marker_start="<!-- Generated by agent-skills scripts/bootstrap from agent-skills-private (install/instructions.tsv, instructions/sections/). Edit there and run scripts/bootstrap: it rebuilds this file, keeping a change made here in a backup beside it. Checksum: "
# Is $2 the marker line, then exactly the text in $1?
built_as() {
  first=$(head -n 1 "$2")
  case "$first" in "$marker_start"*" -->") ;; *) echo "instructions-test: no marker on the first line of $2: $first" >&2; return 1 ;; esac
  tail -n +2 "$2" | cmp -s "$1" - || { echo "instructions-test: $2 is not its sections:" >&2; tail -n +2 "$2" | diff "$1" - >&2; return 1; }
  sum=$(tail -n +2 "$2" | cksum | awk '{ print $1 "-" $2 }')
  test "$first" = "$marker_start$sum -->"
}

# The manifest gives each computer its rows: host, target, then each section's path.
on_home=$test_home
on studio-mac "$repo_root/scripts/manifest" instructions >"$test_home/studio.rows"
test "$(wc -l <"$test_home/studio.rows" | tr -d ' ')" = 3
test "$(sed -n 1p "$test_home/studio.rows")" = "$(printf 'claude\t~/.claude/CLAUDE.md\t%s\t%s\t%s\t%s' "$sections/title.md" "$sections/long-responses.md" "$sections/computer-use-studio.md" "$sections/voice.md")"
test -z "$(on spare-mac "$repo_root/scripts/manifest" instructions 2>/dev/null || true)"

# Each computer's files, built in its own made-up home: the marker, then the sections with a blank
# line between two of them.
for computer in studio-mac travel-mac; do
  on_home="$test_home/$computer"
  mkdir -p "$on_home"
  on "$computer" "$repo_root/scripts/bootstrap" --all --skip-dependencies >"$test_home/$computer.out" 2>&1 ||
    { cat "$test_home/$computer.out" >&2; fail "bootstrap failed on $computer"; }
  expect "^BUILT $on_home/.claude/CLAUDE.md$" "$test_home/$computer.out"
done
on_home="$test_home/studio-mac"
printf '# Global instructions\n\n## Long responses\n\nEnd a long reply with a TLDR.\n\n## Computer use\n\nUse the studio tools.\n\n- Check a screenshot.\n\n## Voice\n\nSpeak only when blocked.\n' >"$test_home/expected"
built_as "$test_home/expected" "$on_home/.claude/CLAUDE.md" || fail "studio-mac's CLAUDE.md is not its sections"
printf '## Long responses\n\nEnd a long reply with a TLDR.\n\n## Computer use\n\nUse the studio tools.\n\n- Check a screenshot.\n' >"$test_home/expected"
built_as "$test_home/expected" "$on_home/.codex/AGENTS.md" || fail "studio-mac's AGENTS.md is not its sections"
printf '## Computer use\n\nUse the travel tools.\n\n- Check a screenshot.\n' >"$test_home/expected"
built_as "$test_home/expected" "$test_home/travel-mac/.config/opencode/AGENTS.md" || fail "travel-mac's OpenCode AGENTS.md is not its sections"
# A new file gets what the umask gives it.
test "$(stat -f %Lp "$on_home/.claude/CLAUDE.md")" = "$(printf '%o' $((0666 & ~$(umask))))"
# A real file, not a link.
test -f "$on_home/.claude/CLAUDE.md" && test ! -L "$on_home/.claude/CLAUDE.md"
# Again: nothing to do.
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies >"$test_home/again.out" 2>&1
expect "^OK $on_home/.claude/CLAUDE.md$" "$test_home/again.out"
refuse "BUILT\|REBUILT" "$test_home/again.out"
on studio-mac "$repo_root/scripts/doctor" --all >"$test_home/doctor.out" 2>&1 || true
expect "^PASS $on_home/.claude/CLAUDE.md is built from install/instructions.tsv" "$test_home/doctor.out"
expect "^PASS $on_home/.config/opencode/AGENTS.md is built" "$test_home/doctor.out"
# The check alone: it exits 0 while it finds nothing to fail.
on studio-mac "$repo_root/scripts/instructions" check >/dev/null || fail "instructions check failed on built files"

# A section changed: bootstrap rebuilds every file that has it, and doctor reports the file first.
printf '## Long responses\n\nEnd a long reply with a short TLDR.\n' >"$sections/long-responses.md"
on studio-mac "$repo_root/scripts/doctor" --all >"$test_home/doctor.out" 2>&1 || true
expect "^FAIL $on_home/.claude/CLAUDE.md no longer matches its sections in install/instructions.tsv: run scripts/bootstrap" "$test_home/doctor.out"
expect "^FAIL $on_home/.codex/AGENTS.md no longer matches" "$test_home/doctor.out"
expect "^PASS $on_home/.config/opencode/AGENTS.md is built" "$test_home/doctor.out"
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies --dry-run >"$test_home/dry.out" 2>&1
expect "^DRY RUN: write $on_home/.claude/CLAUDE.md" "$test_home/dry.out"
grep -q "a TLDR\." "$on_home/.claude/CLAUDE.md" || fail "a dry run rebuilt a file"
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies >"$test_home/rebuild.out" 2>&1
expect "^REBUILT $on_home/.claude/CLAUDE.md$" "$test_home/rebuild.out"
expect "^REBUILT $on_home/.codex/AGENTS.md$" "$test_home/rebuild.out"
expect "^OK $on_home/.config/opencode/AGENTS.md$" "$test_home/rebuild.out"
grep -q "a short TLDR\." "$on_home/.claude/CLAUDE.md" || fail "the rebuilt file lacks the changed section"
# A built file changed by hand (or by an agent): doctor says so, uninstall keeps it, and bootstrap
# rebuilds it after keeping the changed file as a backup beside it, named in its output.
echo "a line of my own" >>"$on_home/.codex/AGENTS.md"
on studio-mac "$repo_root/scripts/doctor" --all >"$test_home/doctor.out" 2>&1 || true
expect "^FAIL $on_home/.codex/AGENTS.md was changed since bootstrap built it: move the change into a section" "$test_home/doctor.out"
if on studio-mac "$repo_root/scripts/instructions" check >/dev/null; then fail "instructions check passed a changed file"; fi
on studio-mac "$repo_root/scripts/uninstall" --host codex >"$test_home/uninstall.out" 2>&1
expect "^KEEP $on_home/.codex/AGENTS.md: it was changed since bootstrap built it" "$test_home/uninstall.out"
grep -q "a line of my own" "$on_home/.codex/AGENTS.md" || fail "uninstall removed a changed file"
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies --dry-run >"$test_home/dry.out" 2>&1
expect "^DRY RUN: cp $on_home/.codex/AGENTS.md $on_home/.codex/AGENTS.md.changed-" "$test_home/dry.out"
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies >"$test_home/rebuild.out" 2>&1
expect "^REBUILT $on_home/.codex/AGENTS.md; the change made in it is kept as $on_home/.codex/AGENTS.md.changed-[0-9]*-[0-9]*$" "$test_home/rebuild.out"
refuse "a line of my own" "$on_home/.codex/AGENTS.md"
changed_backup=$(sed -n "s#^REBUILT .*; the change made in it is kept as ##p" "$test_home/rebuild.out")
grep -q "a line of my own" "$changed_backup" || fail "the backup of a changed file lacks the change"
rm "$changed_backup"
# A rebuild only because the sections changed keeps no backup (above), and leaves no temporary file.
test -z "$(find "$on_home" -name '.agent-skills-instructions.*')" || fail "a temporary file was left beside a target"
# A marker without a checksum (as an earlier version wrote it) counts as changed: kept, to be safe.
{ printf '%s\n' "${marker_start%% Checksum: } -->"; tail -n +2 "$on_home/.codex/AGENTS.md"; } >"$test_home/old-marker"
cp "$test_home/old-marker" "$on_home/.codex/AGENTS.md"
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies >"$test_home/rebuild.out" 2>&1
expect "^REBUILT $on_home/.codex/AGENTS.md; the change made in it is kept as " "$test_home/rebuild.out"
rm "$(sed -n "s#^REBUILT .*; the change made in it is kept as ##p" "$test_home/rebuild.out")"
# A change to the marker line alone counts too.
sed '1s/Edit there/Edit only there/' "$on_home/.codex/AGENTS.md" >"$test_home/marker-edit"
cp "$test_home/marker-edit" "$on_home/.codex/AGENTS.md"
on studio-mac "$repo_root/scripts/doctor" --all >"$test_home/doctor.out" 2>&1 || true
expect "^FAIL $on_home/.codex/AGENTS.md was changed since bootstrap built it" "$test_home/doctor.out"
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies >"$test_home/rebuild.out" 2>&1
expect "^REBUILT $on_home/.codex/AGENTS.md; the change made in it is kept as " "$test_home/rebuild.out"
rm "$(sed -n "s#^REBUILT .*; the change made in it is kept as ##p" "$test_home/rebuild.out")"
# A change made after bootstrap judged the file unchanged, and before it moves the new file into
# place, is kept as well: a stand-in chmod (run in between) appends to the target.
printf '## Long responses\n\nEnd a long reply with a short TLDR, always.\n' >"$sections/long-responses.md"
mkdir -p "$test_home/late-bin"
printf '#!/bin/sh\necho "LATE EDIT" >>"$LATE_TARGET"\nexec /bin/chmod "$@"\n' >"$test_home/late-bin/chmod"
chmod +x "$test_home/late-bin/chmod"
(LATE_TARGET="$on_home/.codex/AGENTS.md"; PATH="$test_home/late-bin:$PATH"; export LATE_TARGET PATH
  on studio-mac "$repo_root/scripts/instructions" install --host codex) >"$test_home/late.out" 2>&1
expect "^REBUILT $on_home/.codex/AGENTS.md; the change made in it is kept as " "$test_home/late.out"
grep -q "LATE EDIT" "$(sed -n "s#^REBUILT .*; the change made in it is kept as ##p" "$test_home/late.out")" || fail "the late change was not kept"
rm "$(sed -n "s#^REBUILT .*; the change made in it is kept as ##p" "$test_home/late.out")"
# After the last check, bootstrap holds the file by a second name (a hard link) and moves the new
# one into place: a change written into it then is in the file that was replaced, and kept as a
# backup. A stand-in ln makes the change right after the hold.
mkdir -p "$test_home/hold-bin"
printf '#!/bin/sh\n/bin/ln "$@" || exit\ncase "$1" in -f) eval "$HOLD_EDIT" ;; esac\n' >"$test_home/hold-bin/ln"
chmod +x "$test_home/hold-bin/ln"
printf '## Long responses\n\nEnd a long reply with a TLDR of two lines.\n' >"$sections/long-responses.md"
(HOLD_EDIT='echo "HELD EDIT" >>"$HOLD_TARGET"'; HOLD_TARGET="$on_home/.codex/AGENTS.md"; PATH="$test_home/hold-bin:$PATH"; export HOLD_EDIT HOLD_TARGET PATH
  on studio-mac "$repo_root/scripts/instructions" install --host codex) >"$test_home/held.out" 2>&1
expect "^REBUILT $on_home/.codex/AGENTS.md; the change made in it is kept as " "$test_home/held.out"
held_backup=$(sed -n "s#^REBUILT .*; the change made in it is kept as ##p" "$test_home/held.out")
grep -q "HELD EDIT" "$held_backup" || fail "the change made after the hold was not kept"
refuse "HELD EDIT" "$on_home/.codex/AGENTS.md"
rm "$held_backup"
# A file replaced by another one (an editor that saves by renaming) after the hold is left as it is,
# for the next run, and the run says so and fails.
printf '## Long responses\n\nEnd a long reply with a TLDR of one line.\n' >"$sections/long-responses.md"
if (HOLD_EDIT='printf "Saved by an editor\n" >"$HOLD_TARGET.saved" && /bin/mv "$HOLD_TARGET.saved" "$HOLD_TARGET"'; HOLD_TARGET="$on_home/.codex/AGENTS.md"; PATH="$test_home/hold-bin:$PATH"; export HOLD_EDIT HOLD_TARGET PATH
  on studio-mac "$repo_root/scripts/instructions" install --host codex) >"$test_home/held.out" 2>&1; then
  fail "a file replaced during the rebuild was reported as rebuilt"
fi
expect "^KEEP $on_home/.codex/AGENTS.md: it was replaced while bootstrap was rebuilding it; run scripts/bootstrap again$" "$test_home/held.out"
test "$(cat "$on_home/.codex/AGENTS.md")" = "Saved by an editor" || fail "the file saved by an editor was overwritten"
test -z "$(find "$on_home/.codex" -name '.agent-skills-instructions*' -print -quit)" || fail "a temporary file was left behind"
rm "$on_home/.codex/AGENTS.md"
on studio-mac "$repo_root/scripts/instructions" install --host codex >/dev/null 2>&1
# A folder that takes no hard links (a stand-in ln that refuses them) gets a copy instead: the
# rebuild still works, and a change made before the copy is still kept.
printf '#!/bin/sh\ncase "$1" in -f) exit 1 ;; esac\nexec /bin/ln "$@"\n' >"$test_home/hold-bin/ln"
printf '## Long responses\n\nEnd a long reply with a TLDR, short.\n' >"$sections/long-responses.md"
(PATH="$test_home/hold-bin:$PATH"; export PATH; on studio-mac "$repo_root/scripts/instructions" install --host codex) >"$test_home/held.out" 2>&1 || { cat "$test_home/held.out" >&2; fail "a rebuild without hard links failed"; }
expect "^REBUILT $on_home/.codex/AGENTS.md$" "$test_home/held.out"
(LATE_TARGET="$on_home/.codex/AGENTS.md"; PATH="$test_home/hold-bin:$test_home/late-bin:$PATH"; export LATE_TARGET PATH
  printf '## Long responses\n\nEnd a long reply with a TLDR, shorter.\n' >"$sections/long-responses.md"
  on studio-mac "$repo_root/scripts/instructions" install --host codex) >"$test_home/held.out" 2>&1
expect "^REBUILT $on_home/.codex/AGENTS.md; the change made in it is kept as " "$test_home/held.out"
rm "$(sed -n "s#^REBUILT .*; the change made in it is kept as ##p" "$test_home/held.out")"
test -z "$(find "$on_home/.codex" -name '.agent-skills-instructions*' -print -quit)" || fail "a temporary file was left behind"
# A check that stops without a FAIL line (here, no temporary folder) fails doctor all the same.
(TMPDIR="$test_home/no-such-folder"; export TMPDIR; on studio-mac "$repo_root/scripts/doctor" --host claude) >"$test_home/doctor.out" 2>&1 || true
expect "^FAIL the instruction files could not be checked (scripts/instructions check exited [1-9]" "$test_home/doctor.out"
# --host builds only that host's file.
rm "$on_home/.codex/AGENTS.md" "$on_home/.claude/CLAUDE.md"
on studio-mac "$repo_root/scripts/bootstrap" --host codex --skip-dependencies >"$test_home/host.out" 2>&1
test -f "$on_home/.codex/AGENTS.md" && test ! -e "$on_home/.claude/CLAUDE.md"
on studio-mac "$repo_root/scripts/doctor" --host claude >"$test_home/doctor.out" 2>&1 || true
expect "^FAIL $on_home/.claude/CLAUDE.md is missing: run scripts/bootstrap" "$test_home/doctor.out"
refuse "AGENTS.md" "$test_home/doctor.out"

# The owner's own file at a target, without the marker: bootstrap leaves it, says how to adopt it,
# and doctor warns; nothing fails.
printf '# My own instructions\n' >"$on_home/.claude/CLAUDE.md"
chmod 600 "$on_home/.claude/CLAUDE.md"
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies >"$test_home/own.out" 2>&1 ||
  fail "bootstrap failed on an unadopted file"
expect "^NOT ADOPTED $on_home/.claude/CLAUDE.md: your own file, so bootstrap leaves it. .*run scripts/bootstrap --adopt-instructions" "$test_home/own.out"
test "$(cat "$on_home/.claude/CLAUDE.md")" = "# My own instructions"
on studio-mac "$repo_root/scripts/doctor" --all >"$test_home/doctor.out" 2>&1 || true
expect "^WARN $on_home/.claude/CLAUDE.md is not adopted: .*run scripts/bootstrap --adopt-instructions" "$test_home/doctor.out"
refuse "FAIL.*CLAUDE.md" "$test_home/doctor.out"
# Uninstall keeps it.
on studio-mac "$repo_root/scripts/uninstall" --host claude >"$test_home/uninstall.out" 2>&1
expect "^KEEP $on_home/.claude/CLAUDE.md: your own file" "$test_home/uninstall.out"
test "$(cat "$on_home/.claude/CLAUDE.md")" = "# My own instructions"
# A dry run of the adoption says what it would do and does nothing.
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies --adopt-instructions --dry-run >"$test_home/adopt-dry.out" 2>&1
expect "^DRY RUN: cp $on_home/.claude/CLAUDE.md $on_home/.claude/CLAUDE.md.before-agent-skills-" "$test_home/adopt-dry.out"
test "$(cat "$on_home/.claude/CLAUDE.md")" = "# My own instructions"
test -z "$(find "$on_home/.claude" -name 'CLAUDE.md.before-*')"
# --adopt-instructions takes it over after copying it to a backup beside it, named in the output.
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies --adopt-instructions >"$test_home/adopt.out" 2>&1
expect "^ADOPTED $on_home/.claude/CLAUDE.md; your file is kept as $on_home/.claude/CLAUDE.md.before-agent-skills-[0-9]*-[0-9]*$" "$test_home/adopt.out"
backup=$(sed -n "s#^ADOPTED .*; your file is kept as ##p" "$test_home/adopt.out")
test "$(cat "$backup")" = "# My own instructions"
test "$(stat -f %Lp "$backup")" = 600
# The built file keeps the permissions of the file it replaced.
test "$(stat -f %Lp "$on_home/.claude/CLAUDE.md")" = 600
case "$(head -n 1 "$on_home/.claude/CLAUDE.md")" in "$marker_start"*) ;; *) fail "the adopted file has no marker" ;; esac
# Adopting again changes nothing: the file is built now, and the backup stays the only one.
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies --adopt-instructions >"$test_home/adopt.out" 2>&1
expect "^OK $on_home/.claude/CLAUDE.md$" "$test_home/adopt.out"
test "$(find "$on_home/.claude" -name 'CLAUDE.md.before-*' | wc -l | tr -d ' ')" = 1
# A link at a target is the owner's too: adopting keeps the link itself as the backup.
printf '# Linked instructions\n' >"$test_home/linked.md"
rm "$on_home/.codex/AGENTS.md"
ln -s "$test_home/linked.md" "$on_home/.codex/AGENTS.md"
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies >"$test_home/own.out" 2>&1
expect "^NOT ADOPTED $on_home/.codex/AGENTS.md" "$test_home/own.out"
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies --adopt-instructions --dry-run >"$test_home/adopt-dry.out" 2>&1
expect "^DRY RUN: keep the link $on_home/.codex/AGENTS.md as $on_home/.codex/AGENTS.md.before-agent-skills-" "$test_home/adopt-dry.out"
test -L "$on_home/.codex/AGENTS.md"
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies --adopt-instructions >"$test_home/adopt.out" 2>&1
link_backup=$(sed -n "s#^ADOPTED $on_home/.codex/AGENTS.md; your file is kept as ##p" "$test_home/adopt.out")
test "$(readlink "$link_backup")" = "$test_home/linked.md"
test "$(cat "$test_home/linked.md")" = "# Linked instructions"
test -f "$on_home/.codex/AGENTS.md" && test ! -L "$on_home/.codex/AGENTS.md"
# A folder where a file belongs stops bootstrap and is kept.
rm "$on_home/.config/opencode/AGENTS.md"
mkdir "$on_home/.config/opencode/AGENTS.md"
if on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies --adopt-instructions >"$test_home/folder.out" 2>&1; then
  fail "bootstrap passed with a folder at a target"
fi
expect "^KEEP $on_home/.config/opencode/AGENTS.md: a folder" "$test_home/folder.out"
on studio-mac "$repo_root/scripts/doctor" --all >"$test_home/doctor.out" 2>&1 || true
expect "^FAIL $on_home/.config/opencode/AGENTS.md is a folder, where install/instructions.tsv expects a file: move it away" "$test_home/doctor.out"
test -d "$on_home/.config/opencode/AGENTS.md"
rmdir "$on_home/.config/opencode/AGENTS.md"

# Uninstall removes the built files and nothing else: the backups and the owner's link target stay.
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies >/dev/null 2>&1
on studio-mac "$repo_root/scripts/uninstall" --all --dry-run >"$test_home/uninstall.out" 2>&1
expect "^DRY RUN: rm $on_home/.claude/CLAUDE.md; your file from before bootstrap built it is $backup" "$test_home/uninstall.out"
test -f "$on_home/.claude/CLAUDE.md"
on studio-mac "$repo_root/scripts/uninstall" --all >"$test_home/uninstall.out" 2>&1
expect "^REMOVED $on_home/.claude/CLAUDE.md; your file from before bootstrap built it is $backup: rename it back to use it again$" "$test_home/uninstall.out"
expect "^REMOVED $on_home/.codex/AGENTS.md; your file from before bootstrap built it is $link_backup" "$test_home/uninstall.out"
expect "^REMOVED $on_home/.config/opencode/AGENTS.md$" "$test_home/uninstall.out"
test ! -e "$on_home/.claude/CLAUDE.md" && test ! -e "$on_home/.codex/AGENTS.md"
test -f "$backup" && test -L "$link_backup" && test -f "$test_home/linked.md"
# travel-mac's files are another home's: untouched.
test -f "$test_home/travel-mac/.claude/CLAUDE.md"

# A row removed from the table leaves a built file that no row builds any more. Bootstrap recorded
# it, so doctor warns about it, and bootstrap removes it when nobody changed it, and keeps it, saying
# so, when someone did; uninstall removes it too.
on_home="$test_home/studio-mac"
record="$XDG_STATE_HOME/agent-skills/instructions-built"
cp "$private/install/instructions.tsv" "$test_home/instructions.full"
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies >"$test_home/orphan.out" 2>&1
test "$(grep -c "^studio-mac	" "$record")" -eq 3 || { cat "$test_home/orphan.out" "$record" >&2; fail "the record does not hold studio-mac's three files"; }
grep -q "^travel-mac	" "$record" || fail "travel-mac's entries went from the shared record"
grep -v "^studio-mac	opencode" "$test_home/instructions.full" >"$private/install/instructions.tsv"
on studio-mac "$repo_root/scripts/doctor" --all >"$test_home/doctor.out" 2>&1 || true
expect "^WARN $on_home/.config/opencode/AGENTS.md was built by bootstrap, but no row of install/instructions.tsv builds it any more: run scripts/bootstrap to remove it$" "$test_home/doctor.out"
refuse "^FAIL.*opencode/AGENTS.md" "$test_home/doctor.out"
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies --dry-run >"$test_home/orphan.out" 2>&1
expect "^DRY RUN: rm $on_home/.config/opencode/AGENTS.md$" "$test_home/orphan.out"
test -f "$on_home/.config/opencode/AGENTS.md" || fail "a dry run removed the file"
on studio-mac "$repo_root/scripts/bootstrap" --host claude --skip-dependencies >"$test_home/orphan.out" 2>&1
refuse "opencode/AGENTS.md" "$test_home/orphan.out"
test -f "$on_home/.config/opencode/AGENTS.md" || fail "--host claude removed opencode's file"
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies >"$test_home/orphan.out" 2>&1
expect "^REMOVED $on_home/.config/opencode/AGENTS.md: no row of install/instructions.tsv builds it any more$" "$test_home/orphan.out"
test ! -e "$on_home/.config/opencode/AGENTS.md" || fail "the file no row builds is still there"
refuse "^studio-mac	opencode" "$record"
on studio-mac "$repo_root/scripts/doctor" --all >"$test_home/doctor.out" 2>&1 || true
refuse "opencode/AGENTS.md" "$test_home/doctor.out"
# Changed by hand, it is kept, with a warning, until the owner deletes it; then it leaves the record.
echo "a line of my own" >>"$on_home/.codex/AGENTS.md"
grep -v "^studio-mac	opencode\|^studio-mac	codex" "$test_home/instructions.full" >"$private/install/instructions.tsv"
on studio-mac "$repo_root/scripts/doctor" --all >"$test_home/doctor.out" 2>&1 || true
expect "^WARN $on_home/.codex/AGENTS.md was built by bootstrap and changed since, and no row of install/instructions.tsv builds it any more, so bootstrap keeps it" "$test_home/doctor.out"
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies >"$test_home/orphan.out" 2>&1 || fail "bootstrap failed over a changed file no row builds"
expect "^KEEP $on_home/.codex/AGENTS.md: no row of install/instructions.tsv builds it any more, but it was changed since bootstrap built it" "$test_home/orphan.out"
grep -q "a line of my own" "$on_home/.codex/AGENTS.md" || fail "the changed file no row builds was removed"
grep -q "^studio-mac	codex" "$record" || fail "the kept file left the record"
on studio-mac "$repo_root/scripts/uninstall" --all --dry-run >"$test_home/orphan.out" 2>&1
expect "^KEEP $on_home/.codex/AGENTS.md: no row" "$test_home/orphan.out"
rm "$on_home/.codex/AGENTS.md"
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies >"$test_home/orphan.out" 2>&1
refuse "codex/AGENTS.md" "$test_home/orphan.out"
refuse "^studio-mac	codex" "$record"
# Uninstall removes a file no row builds as it removes the others, and the record goes with them.
cp "$test_home/instructions.full" "$private/install/instructions.tsv"
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies >/dev/null 2>&1
grep -v "^studio-mac	opencode" "$test_home/instructions.full" >"$private/install/instructions.tsv"
on studio-mac "$repo_root/scripts/uninstall" --all >"$test_home/orphan.out" 2>&1
expect "^REMOVED $on_home/.config/opencode/AGENTS.md: no row of install/instructions.tsv builds it any more$" "$test_home/orphan.out"
expect "^REMOVED $on_home/.claude/CLAUDE.md" "$test_home/orphan.out"
test ! -e "$on_home/.config/opencode/AGENTS.md" && test ! -e "$on_home/.claude/CLAUDE.md" && test ! -e "$on_home/.codex/AGENTS.md"
refuse "^studio-mac	" "$record"
# The last row of this computer removed: its files are still known, and removed.
cp "$test_home/instructions.full" "$private/install/instructions.tsv"
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies >/dev/null 2>&1
grep -v "^studio-mac	" "$test_home/instructions.full" >"$private/install/instructions.tsv"
on studio-mac "$repo_root/scripts/doctor" --all >"$test_home/doctor.out" 2>&1 || true
expect "^WARN $on_home/.claude/CLAUDE.md was built by bootstrap, but no row" "$test_home/doctor.out"
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies >"$test_home/orphan.out" 2>&1
for file in .claude/CLAUDE.md .codex/AGENTS.md .config/opencode/AGENTS.md; do
  expect "^REMOVED $on_home/$file: no row of install/instructions.tsv builds it any more" "$test_home/orphan.out"
  test ! -e "$on_home/$file" || fail "$file is still there with no row for this computer"
done
refuse "^studio-mac	" "$record"
grep -q "^travel-mac	" "$record" || fail "travel-mac's entries went from the shared record"
cp "$test_home/instructions.full" "$private/install/instructions.tsv"

# No row for this computer, and no table: nothing is built and nothing is reported.
on_home="$test_home/spare-mac"
mkdir -p "$on_home"
on spare-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies >"$test_home/spare.out" 2>&1
on spare-mac "$repo_root/scripts/doctor" --all >"$test_home/doctor-spare.out" 2>&1 || true
test ! -e "$on_home/.claude/CLAUDE.md"
refuse "CLAUDE.md\|AGENTS.md" "$test_home/spare.out"
refuse "CLAUDE.md\|AGENTS.md" "$test_home/doctor-spare.out"
rm "$private/install/instructions.tsv"
on_home="$test_home/studio-mac"
printf '# My own instructions\n' >"$on_home/.claude/CLAUDE.md"
on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies --adopt-instructions >"$test_home/none.out" 2>&1
on studio-mac "$repo_root/scripts/doctor" --all >"$test_home/doctor-none.out" 2>&1 || true
on studio-mac "$repo_root/scripts/uninstall" --all >"$test_home/uninstall-none.out" 2>&1
test "$(cat "$on_home/.claude/CLAUDE.md")" = "# My own instructions"
test ! -e "$on_home/.codex/AGENTS.md"
for out in none doctor-none uninstall-none; do refuse "CLAUDE.md\|AGENTS.md" "$test_home/$out.out"; done

# The manifest refuses a row it cannot use, and then bootstrap builds nothing.
bad_row() {
  printf '%s\n' "$1" | tr '|' '\t' >"$private/install/instructions.tsv"
  if on studio-mac "$repo_root/scripts/manifest" instructions >"$test_home/bad.out" 2>&1; then
    fail "manifest took the row: $1"
  fi
  expect "$2" "$test_home/bad.out"
}
bad_row 'studio-mac|claude|~/.claude/CLAUDE.md' "expected four columns"
bad_row 'studio-mac|nohost|~/.claude/CLAUDE.md|title' 'no table names a host "nohost"'
bad_row 'studio-mac|claude|.claude/CLAUDE.md|title' "not a path that starts with ~/ or /"
bad_row 'studio-mac|claude|~/.claude/CLAUDE.md|title missing' "no section file .*/instructions/sections/missing.md"
bad_row 'studio-mac|claude|~/.claude/CLAUDE.md|title ../title' 'not a section name: "../title"'
bad_row 'studio-mac|claude|~/.claude/CLAUDE.md| ' "names no section"
bad_row 'travel-mac|factory|~/.factory/AGENTS.md|title' "travel-mac leaves out factory in computers.tsv"
bad_row 'studio-mac|claude|~/.claude/../.claude/CLAUDE.md|title' "a path with a .. step"
bad_row 'nowhere-mac|claude|~/.claude/CLAUDE.md|title' 'no computers.tsv names a computer "nowhere-mac"'
printf 'studio-mac\tclaude\t~/.claude/CLAUDE.md\ttitle\nstudio-mac\tcodex\t~/.claude/CLAUDE.md\ttitle\n' >"$private/install/instructions.tsv"
on studio-mac "$repo_root/scripts/manifest" instructions >"$test_home/bad.out" 2>&1 && fail "manifest took a file named twice"
expect "is named twice for studio-mac" "$test_home/bad.out"
# Also when the two rows spell the same file differently: through $HOME, a doubled slash or a "." step.
printf 'studio-mac\tclaude\t~/.claude/CLAUDE.md\ttitle\nstudio-mac\tcodex\t~/./.claude/./CLAUDE.md\ttitle\n' >"$private/install/instructions.tsv"
on studio-mac "$repo_root/scripts/manifest" instructions >"$test_home/bad.out" 2>&1 && fail "manifest took a file named twice with . steps"
expect "is named twice for studio-mac" "$test_home/bad.out"
printf 'studio-mac\tclaude\t~/.claude/CLAUDE.md\ttitle\nstudio-mac\tcodex\t%s//.claude/CLAUDE.md\ttitle\n' "$on_home" >"$private/install/instructions.tsv"
on studio-mac "$repo_root/scripts/manifest" instructions >"$test_home/bad.out" 2>&1 && fail "manifest took a file named twice in two spellings"
expect "is named twice for studio-mac" "$test_home/bad.out"
# A target a link already claims.
printf 'claude\tlink\tREADME.md\t~/.claude/CLAUDE.md\n' >"$private/install/links.tsv"
printf 'studio-mac\tclaude\t~/.claude/CLAUDE.md\ttitle\n' >"$private/install/instructions.tsv"
on studio-mac "$repo_root/scripts/manifest" instructions >"$test_home/bad.out" 2>&1 && fail "manifest took a file a link claims"
expect "~/.claude/CLAUDE.md is also a link" "$test_home/bad.out"
rm "$private/install/links.tsv"
# Two computers may each have a file at the same path.
printf 'studio-mac\tclaude\t~/.claude/CLAUDE.md\ttitle\ntravel-mac\tclaude\t~/.claude/CLAUDE.md\ttitle\n' >"$private/install/instructions.tsv"
on studio-mac "$repo_root/scripts/manifest" instructions >/dev/null
# Unreadable, the table stops bootstrap before it changes anything, and doctor fails.
printf 'studio-mac\tclaude\t~/.claude/CLAUDE.md\tmissing\n' >"$private/install/instructions.tsv"
on_home="$test_home/fresh-home"
mkdir -p "$on_home"
if on studio-mac "$repo_root/scripts/bootstrap" --all --skip-dependencies >"$test_home/bad.out" 2>&1; then
  fail "bootstrap ran with a table it cannot read"
fi
test -z "$(find "$on_home" -mindepth 1 -print -quit)" || fail "bootstrap changed the home with a table it cannot read"
on studio-mac "$repo_root/scripts/doctor" --all >"$test_home/doctor-bad.out" 2>&1 && fail "doctor passed a table it cannot read"
expect "FAIL the install tables cannot be read" "$test_home/doctor-bad.out"

echo "instructions-test: passed"
