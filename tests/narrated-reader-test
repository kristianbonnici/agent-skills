#!/usr/bin/env bash
# Checks the narrated-markdown-reader's scripts offline, on a small sample in a temporary folder:
# prepare-reader (inline math needs a spoken form and never reaches the narration, HTML is rendered
# safely and narrated, images are shown and not read, entities and strikethrough), synthesize-reader
# against a stand-in for edge_tts (an empty document stops with a message, its chunk folder is gone
# afterwards, also after a failure), and build-reader (KaTeX with integrity hashes, every narrated word
# mapped in headless Chrome when one is installed). Nothing here reaches the network.
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
scripts="$repo_root/skills/narrated-markdown-reader/scripts"
work="$(mktemp -d "${TMPDIR:-/tmp}/narrated-reader-test.XXXXXX")"
trap 'rm -rf "$work"' EXIT HUP INT TERM

fail() {
  echo "narrated-reader-test: $*" >&2
  exit 1
}

cat > "$work/sample.md" <<'EOF'
# Sample with $a_b$

Intro with inline $x_i + y_j$ and \(z\) and costs $5 or $10. Escaped \$ sign. Also ~~old~~ new &nbsp;&amp; &mdash; &copy; `$code$` [link](a.md) ![alt words](pic.png).

![only image](pic.png)

<details>
<summary>Open me $x_i$</summary>

Inside paragraph.

</details>

<figure><img src="p.png" alt="figure alt"><figcaption>Caption &amp; text</figcaption></figure>

<div onclick="evil()" style="color:red">Hello <b>bold</b> <script>alert(1)</script>world <a href="javascript:evil()">trap</a></div>

</div>

- item $x_i$
- ![picture only](y.png)

| Column |
|--------|
| $x_i$ and text |

```
code <b> &amp; here
```
EOF
cat > "$work/spec.json" <<'EOF'
{"schemaVersion": 1, "formulas": [], "inline": [
  {"source": "a_b", "speech": "a sub b"},
  {"source": "x_i + y_j", "speech": "x sub i plus y sub j"},
  {"source": "z", "speech": "zee"},
  {"source": "x_i", "speech": "x sub i"}
]}
EOF
source_hash="$(shasum -a 256 "$work/sample.md")"

# prepare-reader: inline math without a spoken form stops the run, listing it, and writes nothing.
status=0
node "$scripts/prepare-reader.mjs" --source "$work/sample.md" --output "$work/missing/blocks.json" \
  > "$work/missing.out" 2> "$work/missing.err" || status=$?
test "$status" -eq 1 || fail "missing inline spoken forms did not exit 1 (got $status)"
grep -q "4 inline math expressions have no spoken form" "$work/missing.err" || fail "no listing of the missing forms"
grep -q -- "  - x_i + y_j" "$work/missing.err" || fail "the missing expression is not named"
test ! -e "$work/missing/blocks.json" || fail "blocks.json was written for a source with missing spoken forms"

# A spoken form that still holds LaTeX is refused.
printf '%s\n' '{"inline": [{"source": "a_b", "speech": "a_b"}]}' > "$work/latex-spec.json"
status=0
node "$scripts/prepare-reader.mjs" --source "$work/sample.md" --output "$work/latex/blocks.json" \
  --math-spec "$work/latex-spec.json" > /dev/null 2> "$work/latex.err" || status=$?
test "$status" -eq 1 || fail "a LaTeX spoken form was accepted"
grep -q "still holds LaTeX" "$work/latex.err" || fail "no message for a LaTeX spoken form"

# prepare-reader with the spec.
node "$scripts/prepare-reader.mjs" --source "$work/sample.md" --output "$work/build/blocks.json" \
  --math-spec "$work/spec.json" > "$work/prepare.out" 2> "$work/prepare.err"
test "$(shasum -a 256 "$work/sample.md")" = "$source_hash" || fail "the source Markdown changed"
grep -q "Left out <script>" "$work/prepare.err" || fail "no warning for the <script> that was left out"
grep -q "stray </div>" "$work/prepare.err" || fail "no warning for the stray closing tag"

node - "$work/build/blocks.json" <<'EOF'
const fs = require("fs");
const report = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const spoken = report.blocks.map((block) => block.text);
const all = spoken.join("\n");
const check = (condition, message) => { if (!condition) { console.error("narrated-reader-test: " + message + "\n" + all); process.exit(1); } };

check(report.blocks.every((block) => block.type === "code" || !/[\\^_{}$]/.test(block.text.replace("$5 or $10", "").replace("Escaped $ sign", "").replace("$code$", ""))),
  "LaTeX reached the spoken text");
check(spoken.includes("Sample with a sub b"), "the heading's inline math is not spoken");
const intro = report.blocks.find((block) => block.text.startsWith("Intro"));
check(intro.text.startsWith("Intro with inline x sub i plus y sub j and zee and costs $5 or $10. Escaped $ sign."), "inline math or dollars: " + intro.text);
check(intro.inlineMath.length === 2, "the intro's inline math spans");
for (const span of intro.inlineMath) check(intro.text.slice(span.speechStart, span.speechEnd) === span.speech, "a span does not match its speech");
check(intro.text.includes("old new & — © $code$ link"), "entities, strikethrough or code: " + intro.text);
check(!all.includes("&nbsp;") && !all.includes("~~"), "an entity or strikethrough marks were spoken");
check(!all.includes("alt words") && !all.includes("figure alt") && !all.includes("picture only") && !all.includes("only image"), "alt text was spoken");
check(spoken.includes("Open me x sub i"), "the <summary> is not narrated");
check(spoken.includes("Caption & text"), "the <figure>'s caption is not narrated");
check(spoken.includes("Hello bold world trap"), "the <div>'s text is not narrated: " + JSON.stringify(spoken));
check(spoken.includes("Inside paragraph."), "the paragraph inside <details>");
check(spoken.includes("code <b> &amp; here"), "code is not read as written");
check(!all.includes("alert"), "the <script>'s content was narrated");

const html = report.bodyHtml;
check(html.includes("<details open>") && html.includes("</details>"), "the <details> is not rendered");
check(html.includes("<figure"), "the <figure> is not rendered");
check(html.includes('<p><img src="pic.png" alt="only image"></p>'), "the image-only paragraph is not on the page");
check(html.includes('<li><img src="y.png" alt="picture only"></li>'), "the image-only list item is not on the page");
check(!/<script|onclick|style=|javascript:/i.test(html), "unsafe HTML reached the page");
check((html.match(/<div/g) || []).length === (html.match(/<\/div>/g) || []).length, "the page's <div>s are unbalanced");
check((html.match(/<details/g) || []).length === (html.match(/<\/details>/g) || []).length, "the page's <details> are unbalanced");
check(/data-inline-math="0" data-tex="x_i \+ y_j"/.test(html), "an inline expression is not on the page for KaTeX");
EOF

# A source with only images has no spoken block; synthesize-reader says so.
mkdir -p "$work/empty"
printf '%s\n' '![nothing to read](pic.png)' > "$work/empty.md"
node "$scripts/prepare-reader.mjs" --source "$work/empty.md" --output "$work/empty/blocks.json" > /dev/null
grep -q 'nothing to read' "$work/empty/blocks.json" || fail "the image-only document lost its image"

# synthesize-reader against a stand-in for edge_tts: a silent mp3, a word boundary per word without its closing punctuation.
mkdir -p "$work/stub"
cat > "$work/stub/edge_tts.py" <<'EOF'
import os
import pathlib
import re


class Communicate:
    def __init__(self, text, voice, rate=None, boundary=None):
        self.text = text

    async def stream(self):
        if os.environ.get("STUB_FAIL"):
            raise RuntimeError("stub failure")
        yield {"type": "audio", "data": pathlib.Path(os.environ["STUB_AUDIO"]).read_bytes()}
        offset = 0
        for match in re.finditer(r"\S+", self.text):
            word = match.group(0).rstrip(".,;:!?")  # as Edge's word boundaries leave punctuation off
            if word:
                yield {"type": "WordBoundary", "offset": offset, "duration": 1_000_000, "text": word}
                offset += 1_000_000
EOF
ffmpeg -hide_banner -loglevel error -y -f lavfi -i anullsrc=r=24000:cl=mono -t 2 "$work/stub/silence.mp3"
export STUB_AUDIO="$work/stub/silence.mp3"
# Runs synthesize-reader.py with the stand-in's folder on its import path.
synthesize() {
  PYTHONDONTWRITEBYTECODE=1 python3 -c '
import runpy, sys
sys.path.insert(0, sys.argv[1])
sys.argv = sys.argv[2:]
runpy.run_path(sys.argv[0], run_name="__main__")
' "$work/stub" "$scripts/synthesize-reader.py" "$@"
}

status=0
synthesize --workdir "$work/empty" > "$work/empty.out" 2> "$work/empty.err" || status=$?
test "$status" -ne 0 || fail "an empty document did not stop synthesize-reader"
grep -q "nothing to narrate" "$work/empty.err" || fail "no clear message for an empty document: $(cat "$work/empty.err")"
grep -q "Traceback" "$work/empty.err" && fail "an empty document ended in a traceback"
test -z "$(find "$work/empty" -name '.narrated-markdown-audio-*')" || fail "a chunk folder was left behind by an empty document"

status=0
STUB_FAIL=1 synthesize --workdir "$work/build" > /dev/null 2> "$work/failed.err" || status=$?
test "$status" -ne 0 || fail "a failing synthesis did not fail"
test -z "$(find "$work/build" -name '.narrated-markdown-audio-*')" || fail "a chunk folder was left behind after a failure"

synthesize --workdir "$work/build" > "$work/synthesize.out"
test -z "$(find "$work/build" -name '.narrated-markdown-audio-*')" || fail "a chunk folder was left behind"
test -z "$(find "${TMPDIR:-/tmp}" -maxdepth 1 -name 'narrated-markdown-audio-*' 2>/dev/null)" || fail "a chunk folder was made in the temporary folder"
test -s "$work/build/narration.mp3" || fail "no narration.mp3"
test -s "$work/build/word-timings.json" || fail "no word-timings.json"

# build-reader: KaTeX with integrity hashes and an inline-math map.
node "$scripts/build-reader.mjs" --workdir "$work/build" --title "Sample" > /dev/null
index="$work/build/index.html"
grep -q 'katex.min.css" integrity="sha384-[A-Za-z0-9+/=]*" crossorigin="anonymous"' "$index" || fail "KaTeX's stylesheet has no integrity hash"
grep -q 'katex.min.js" integrity="sha384-[A-Za-z0-9+/=]*" crossorigin="anonymous"' "$index" || fail "KaTeX's script has no integrity hash"

# In headless Chrome (when there is one), every narrated word maps to the page, with no network:
# KaTeX's tags are taken out of a copy, so the inline expressions show their source.
chrome=""
for candidate in "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
  "/Applications/Chromium.app/Contents/MacOS/Chromium" "$(command -v google-chrome || true)" "$(command -v chromium || true)"; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then chrome="$candidate"; break; fi
done
if [ -n "$chrome" ]; then
  python3 -I - "$index" "$work/offline.html" <<'EOF'
import re, sys
text = open(sys.argv[1]).read()
text = re.sub(r'<link rel="stylesheet" href="https://cdn[^>]*>', "", text)
text = re.sub(r'<script src="https://cdn[^>]*></script>', "", text)
before = '<script>window.__warnings=[];console.warn=(...a)=>{window.__warnings.push(a.join(" "))};</script>'
after = ('<script>setTimeout(()=>{const pre=document.createElement("pre");pre.id="result";'
         'pre.textContent=JSON.stringify({warnings:window.__warnings.filter(w=>!w.startsWith("KaTeX did not load")),'
         'overflow:document.documentElement.scrollWidth>document.documentElement.clientWidth});'
         'document.body.append(pre)},100)</script>')
text = text.replace("<body>", "<body>" + before).replace("</body>", after + "</body>")
open(sys.argv[2], "w").write(text)
EOF
  result="$("$chrome" --headless=new --disable-gpu --no-first-run --user-data-dir="$work/chrome-profile" \
    --virtual-time-budget=3000 --dump-dom "file://$work/offline.html" 2>/dev/null \
    | grep -o '<pre id="result">[^<]*</pre>' || true)"
  test -n "$result" || fail "headless Chrome gave no result"
  case "$result" in
    *'"warnings":[]'*) ;;
    *) fail "the page warned: $result" ;;
  esac
  case "$result" in
    *'"overflow":false'*) ;;
    *) fail "the page overflows sideways: $result" ;;
  esac
else
  echo "narrated-reader-test: no Chrome found, the in-browser word mapping was not checked"
fi

echo "narrated-reader-test: ok"
