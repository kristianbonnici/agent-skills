#!/bin/sh
# Checks scripts/sync and doctor's warning about a default branch ahead of or behind origin, with
# three made-up repositories (a public one holding this repository's scripts and a one-skill table,
# a private one and a state one), each cloned from a made-up remote into a made-up home. Sync pulls
# a repository that is behind, skips one with an uncommitted change and one off its default branch,
# reports unpushed commits, pushes nothing, says when a pull cannot fast-forward, and then runs
# bootstrap. Doctor warns, from what the last fetch saw, with the count and the command to run.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/sync-test.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
work=$(CDPATH= cd -- "$work" && pwd)

fail() { echo "sync-test: $*" >&2; exit 1; }
expect() { grep -q -- "$1" "$2" || { echo "sync-test: expected \"$1\" in $2:" >&2; cat "$2" >&2; exit 1; }; }
refuse() { if grep -q -- "$1" "$2"; then echo "sync-test: did not expect \"$1\" in $2:" >&2; cat "$2" >&2; exit 1; fi; }

# Git as in a new home: none of the owner's settings, hooks or signing.
export HOME="$work/home"
export XDG_CONFIG_HOME="$HOME/.config"
export GIT_CONFIG_NOSYSTEM=1
export GIT_TERMINAL_PROMPT=0
export AGENT_SKILLS_NO_UPDATE_CHECK=1
export AGENT_SKILLS_COMPUTER=studio-mac
mkdir -p "$HOME"
git config --global user.name test
git config --global user.email test@example.invalid
git config --global commit.gpgsign false
git config --global init.defaultBranch main
# Doctor asks the OpenCode CLI which skills it sees: a stand-in answers.
mkdir -p "$work/bin"
printf '#!/bin/sh\necho "{\\"data\\": []}"\n' >"$work/bin/opencode"
chmod +x "$work/bin/opencode"
# Nothing here may reach launchd: a stand-in launchctl records any call, and none is expected.
printf '#!/bin/sh\necho "$*" >>"%s/launchctl.log"\nexit 1\n' "$work" >"$work/bin/launchctl"
chmod +x "$work/bin/launchctl"
export PATH="$work/bin:$PATH"

developer="$HOME/Developer"
public="$developer/agent-skills"
private="$developer/agent-skills-private"
state="$developer/agent-skills-state"
export AGENT_SKILLS_PRIVATE="$private"
export AGENT_SKILLS_STATE="$state"
export XDG_STATE_HOME="$HOME/.local/state"

# A remote and a seed checkout that pushes to it, then the clone sync works on.
make_repo() {
  name=$1
  git init -q --bare "$work/remotes/$name.git"
  git clone -q "$work/remotes/$name.git" "$work/seeds/$name" 2>/dev/null
}
commit_seed() {
  git -C "$work/seeds/$1" add -A
  git -C "$work/seeds/$1" commit -q -m "$2"
  git -C "$work/seeds/$1" push -q origin main
}
mkdir -p "$work/remotes" "$work/seeds" "$developer"
make_repo agent-skills
cp -R "$repo_root/scripts" "$work/seeds/agent-skills/"
mkdir -p "$work/seeds/agent-skills/install" "$work/seeds/agent-skills/skills/demo"
printf 'claude\tClaude Code\tlink\t~/.claude/skills\n' >"$work/seeds/agent-skills/install/hosts.tsv"
printf 'install\tdemo\tclaude\n' >"$work/seeds/agent-skills/install/skills.tsv"
echo demo >"$work/seeds/agent-skills/skills/demo/SKILL.md"
commit_seed agent-skills "A release"
make_repo agent-skills-private
mkdir -p "$work/seeds/agent-skills-private/install"
: >"$work/seeds/agent-skills-private/install/skills.tsv"
echo notes >"$work/seeds/agent-skills-private/README.md"
commit_seed agent-skills-private "Private"
make_repo agent-skills-state
mkdir -p "$work/seeds/agent-skills-state/demo"
echo state >"$work/seeds/agent-skills-state/demo/notes.md"
commit_seed agent-skills-state "State"
for name in agent-skills agent-skills-private agent-skills-state; do
  git clone -q "$work/remotes/$name.git" "$developer/$name"
done

remote_heads() {
  for name in agent-skills agent-skills-private agent-skills-state; do
    git --git-dir "$work/remotes/$name.git" for-each-ref --format='%(refname) %(objectname)' refs/heads
  done
}

# All three current: each is up to date, and bootstrap runs.
"$public/scripts/sync" --skip-dependencies >"$work/sync.out" 2>&1 || { cat "$work/sync.out" >&2; fail "sync failed"; }
expect "^OK agent-skills is up to date with origin/main$" "$work/sync.out"
expect "^OK agent-skills-private is up to date" "$work/sync.out"
expect "^OK agent-skills-state is up to date" "$work/sync.out"
expect "^Bootstrap complete" "$work/sync.out"
test "$(readlink "$HOME/.claude/skills/demo")" = "$public/skills/demo"
test "$(readlink "$XDG_STATE_HOME/agent-skills/demo/notes.md")" = "$state/demo/notes.md"
"$public/scripts/doctor" --host claude >"$work/doctor.out" 2>&1 || true
expect "^PASS agent-skills main matches origin/main as of the last fetch" "$work/doctor.out"
expect "^PASS agent-skills-state main matches origin/main" "$work/doctor.out"

# The public repository falls behind: a new skill lands on the remote. Doctor sees it only after a
# fetch, since it never uses the network.
mkdir -p "$work/seeds/agent-skills/skills/newer"
echo newer >"$work/seeds/agent-skills/skills/newer/SKILL.md"
printf 'install\tnewer\tclaude\n' >>"$work/seeds/agent-skills/install/skills.tsv"
commit_seed agent-skills "A new skill"
echo more >>"$work/seeds/agent-skills/skills/newer/SKILL.md"
commit_seed agent-skills "More"
"$public/scripts/doctor" --host claude >"$work/doctor.out" 2>&1 || true
refuse "WARN agent-skills main" "$work/doctor.out"
git -C "$public" fetch -q
"$public/scripts/doctor" --host claude >"$work/doctor.out" 2>&1 || true
expect "^WARN agent-skills main is 2 commit(s) behind origin/main as of the last fetch: run scripts/sync$" "$work/doctor.out"
refuse "FAIL.*behind" "$work/doctor.out"

# The private repository has an uncommitted change, and the state one is on another branch, with
# two commits on its main that were never pushed.
echo "work in progress" >>"$private/README.md"
git -C "$state" commit -q --allow-empty -m "Unpushed one"
git -C "$state" commit -q --allow-empty -m "Unpushed two"
git -C "$state" switch -q -c experiment
echo seed-change >>"$work/seeds/agent-skills-private/README.md"
commit_seed agent-skills-private "Private, newer"
git -C "$private" fetch -q
private_before=$(git -C "$private" rev-parse HEAD)
"$public/scripts/doctor" --host claude >"$work/doctor.out" 2>&1 || true
expect "^WARN agent-skills-state main is 2 commit(s) ahead of origin/main as of the last fetch: no other computer has them until you push: git -C $state push origin main$" "$work/doctor.out"
expect "^WARN agent-skills-private main is 1 commit(s) behind" "$work/doctor.out"

"$public/scripts/sync" --skip-dependencies >"$work/sync.out" 2>&1 || { cat "$work/sync.out" >&2; fail "sync failed"; }
expect "^PULLED agent-skills: 2 new commit(s) from origin/main$" "$work/sync.out"
expect "^SKIP agent-skills-private: it has uncommitted changes, so it is not pulled" "$work/sync.out"
expect "^SKIP agent-skills-state: on experiment, not main, so it is not pulled: switch back to main" "$work/sync.out"
expect "^UNPUSHED agent-skills-state: 2 commit(s) on main are not on origin/main as of the last fetch, .*sync never pushes: git -C $state push origin main$" "$work/sync.out"
refuse "UNPUSHED agent-skills:\|UNPUSHED agent-skills-private" "$work/sync.out"
test "$(git -C "$public" rev-parse HEAD)" = "$(git -C "$work/seeds/agent-skills" rev-parse HEAD)"
test "$(git -C "$private" rev-parse HEAD)" = "$private_before"
grep -q "work in progress" "$private/README.md"
test "$(git -C "$state" symbolic-ref --short HEAD)" = experiment
# Bootstrap ran from the pulled tables: the new skill is linked.
test "$(readlink "$HOME/.claude/skills/newer")" = "$public/skills/newer"
"$public/scripts/doctor" --host claude >"$work/doctor.out" 2>&1 || true
expect "^PASS agent-skills main matches origin/main" "$work/doctor.out"

# Clean again, with a commit of its own on the private main: pulled where it can fast-forward
# (it cannot: both moved), reported as unpushed, never pushed.
git -C "$private" checkout -q -- README.md
git -C "$state" switch -q main
git -C "$private" commit -q --allow-empty -m "Private, local"
if "$public/scripts/sync" --skip-dependencies >"$work/sync.out" 2>&1; then
  fail "sync passed when a pull could not fast-forward"
fi
expect "^FAIL agent-skills-private: git pull --ff-only failed; if main and origin/main have both moved on, rebase or merge by hand" "$work/sync.out"
expect "^UNPUSHED agent-skills-private: 1 commit(s) on main" "$work/sync.out"
expect "^OK agent-skills-state is up to date with origin/main$" "$work/sync.out"
expect "^UNPUSHED agent-skills-state: 2 commit(s) on main" "$work/sync.out"
# A failed pull doesn't stop bootstrap.
expect "^Bootstrap complete" "$work/sync.out"
expect "^sync: 1 step(s) failed" "$work/sync.out"
# Doctor gives both counts of a branch that has moved on both sides.
"$public/scripts/doctor" --host claude >"$work/doctor.out" 2>&1 || true
expect "^WARN agent-skills-private main is 1 commit(s) ahead of origin/main" "$work/doctor.out"
expect "^WARN agent-skills-private main is 1 commit(s) behind origin/main" "$work/doctor.out"
git -C "$private" reset -q --hard origin/main

# A detached checkout is skipped, and so is one with no origin; neither stops the rest.
git -C "$state" checkout -q --detach
git -C "$private" remote rename origin upstream
"$public/scripts/sync" --skip-dependencies >"$work/sync.out" 2>&1 || { cat "$work/sync.out" >&2; fail "sync failed"; }
expect "^SKIP agent-skills-state: on a detached commit, not main, so it is not pulled" "$work/sync.out"
expect "^SKIP agent-skills-private: it has no remote named origin$" "$work/sync.out"
expect "^OK agent-skills is up to date" "$work/sync.out"
"$public/scripts/doctor" --host claude >"$work/doctor.out" 2>&1 || true
expect "^SKIP agent-skills-private has no origin/main to compare main with" "$work/doctor.out"
git -C "$private" remote rename upstream origin
git -C "$state" switch -q main

# Nothing was ever pushed: the remotes hold what the seeds pushed, and nothing from the clones.
for name in agent-skills agent-skills-private agent-skills-state; do
  test "$(git --git-dir "$work/remotes/$name.git" rev-parse main)" = "$(git -C "$work/seeds/$name" rev-parse HEAD)" ||
    fail "$name's remote changed: sync pushed"
done
# No branch was pushed either, such as the state repository's experiment.
remote_heads | awk '{ print $1 }' >"$work/remotes.after"
test "$(sort -u "$work/remotes.after" | paste -sd' ' -)" = refs/heads/main || fail "a branch was pushed"

# Run with no terminal, sync lets git fail rather than prompt: no password prompt, and ssh in batch
# mode added to the repository's own ssh command. A stand-in ssh records how it was called.
printf '#!/bin/sh\nprintf "%%s|%%s\\n" "$GIT_TERMINAL_PROMPT" "$*" >>"%s/ssh.log"\nexit 255\n' "$work" >"$work/bin/ssh"
chmod +x "$work/bin/ssh"
git -C "$private" remote set-url origin ssh://git@example.invalid/agent-skills-private.git
git -C "$private" config core.sshCommand "ssh -i $work/work-key"
if env -u GIT_TERMINAL_PROMPT -u GIT_SSH_COMMAND "$public/scripts/sync" --skip-dependencies </dev/null >"$work/sync.out" 2>&1; then
  fail "sync passed with an origin it cannot reach"
fi
expect "^FAIL agent-skills-private: git pull --ff-only failed" "$work/sync.out"
expect "^0|-o BatchMode=yes -i $work/work-key .*example.invalid" "$work/ssh.log"
# A configured command that wraps ssh is left as it is.
: >"$work/ssh.log"
git -C "$private" config core.sshCommand "env SYNC_TEST=1 $work/bin/ssh -i $work/work-key"
env -u GIT_TERMINAL_PROMPT -u GIT_SSH_COMMAND "$public/scripts/sync" --skip-dependencies </dev/null >"$work/sync.out" 2>&1 || true
expect "^0|-i $work/work-key .*example.invalid" "$work/ssh.log"
refuse "BatchMode" "$work/ssh.log"
# A command given in GIT_SSH_COMMAND is the caller's: sync leaves it alone.
: >"$work/ssh.log"
GIT_SSH_COMMAND="ssh -o ConnectTimeout=1" "$public/scripts/sync" --skip-dependencies </dev/null >"$work/sync.out" 2>&1 || true
expect "|-o ConnectTimeout=1 .*example.invalid" "$work/ssh.log"
refuse "BatchMode" "$work/ssh.log"
# A configured ssh named by its path gets batch mode too.
: >"$work/ssh.log"
git -C "$private" config core.sshCommand "$work/bin/ssh -i $work/work-key"
env -u GIT_TERMINAL_PROMPT -u GIT_SSH_COMMAND "$public/scripts/sync" --skip-dependencies </dev/null >"$work/sync.out" 2>&1 || true
expect "^0|-o BatchMode=yes -i $work/work-key .*example.invalid" "$work/ssh.log"
# With no ssh command configured, plain ssh in batch mode.
: >"$work/ssh.log"
git -C "$private" config --unset core.sshCommand
env -u GIT_TERMINAL_PROMPT -u GIT_SSH_COMMAND -u GIT_SSH "$public/scripts/sync" --skip-dependencies </dev/null >"$work/sync.out" 2>&1 || true
expect "^0|-o BatchMode=yes .*example.invalid" "$work/ssh.log"
# A program given in GIT_SSH is the caller's too: no command is put above it (git ranks
# core.sshCommand above GIT_SSH), so it is the one that runs, without batch mode.
: >"$work/ssh.log"
cp "$work/bin/ssh" "$work/bin/their-ssh"
env -u GIT_TERMINAL_PROMPT -u GIT_SSH_COMMAND GIT_SSH="$work/bin/their-ssh" "$public/scripts/sync" --skip-dependencies </dev/null >"$work/sync.out" 2>&1 || true
expect "example.invalid" "$work/ssh.log"
refuse "BatchMode" "$work/ssh.log"

# Nothing can prompt, a wrapper included: ssh must ask through an askpass program, which fails at
# once and says nothing. A stand-in ssh behind a wrapper records what it was given, and asks.
cat >"$work/bin/asking-ssh" <<'ASK'
#!/bin/sh
if [ -n "${SSH_ASKPASS:-}" ] && answer=$("$SSH_ASKPASS" "Enter passphrase:" 2>&1); then asked=answered; else asked=refused; fi
printf '%s|%s|%s|%s\n' "$GIT_TERMINAL_PROMPT" "${SSH_ASKPASS_REQUIRE:-}" "$asked" "${answer:-}" >>"$SYNC_TEST_LOG"
exit 255
ASK
chmod +x "$work/bin/asking-ssh"
export SYNC_TEST_LOG="$work/ssh.log"
git -C "$private" config core.sshCommand "env SYNC_TEST=1 $work/bin/asking-ssh"
: >"$work/ssh.log"
env -u GIT_TERMINAL_PROMPT -u GIT_SSH_COMMAND -u SSH_ASKPASS -u SSH_ASKPASS_REQUIRE "$public/scripts/sync" --skip-dependencies </dev/null >"$work/sync.out" 2>&1 || true
expect "^0|force|refused|$" "$work/ssh.log"
# A caller's own askpass program is theirs: kept, and not forced.
printf '#!/bin/sh\necho from-their-askpass\n' >"$work/bin/their-askpass"
chmod +x "$work/bin/their-askpass"
: >"$work/ssh.log"
env -u GIT_TERMINAL_PROMPT -u GIT_SSH_COMMAND -u SSH_ASKPASS_REQUIRE SSH_ASKPASS="$work/bin/their-askpass" "$public/scripts/sync" --skip-dependencies </dev/null >"$work/sync.out" 2>&1 || true
expect "^0||answered|from-their-askpass$" "$work/ssh.log"
git -C "$private" remote set-url origin "$work/remotes/agent-skills-private.git"
git -C "$private" config --unset core.sshCommand

# What the schedule runs: a line with the time before and after, for doctor; the pinned runtimes are
# installed only when one isn't installed from its lockfile as it is now, so a failed install is
# tried again. Stand-in npm and node record what they are asked.
printf '#!/bin/sh\necho "$*" >>"%s/npm.log"\n' "$work" >"$work/bin/npm"
printf '#!/bin/sh\necho 26\n' >"$work/bin/node"
chmod +x "$work/bin/npm" "$work/bin/node"
: >"$work/npm.log"
"$public/scripts/sync" --from-schedule </dev/null >"$work/sync.out" 2>&1 || { cat "$work/sync.out" >&2; fail "a scheduled sync failed"; }
expect "^agent-skills sync started [0-9-]* [0-9:]* [-+][0-9]*$" "$work/sync.out"
expect "^agent-skills sync finished [0-9-]* [0-9:]* [-+][0-9]*: ok$" "$work/sync.out"
test ! -s "$work/npm.log" || fail "a scheduled sync installed runtimes nothing changed"
mkdir -p "$work/seeds/agent-skills/runtime/playwright"
echo '{}' >"$work/seeds/agent-skills/runtime/playwright/package-lock.json"
commit_seed agent-skills "A runtime pin"
"$public/scripts/sync" --from-schedule </dev/null >"$work/sync.out" 2>&1 || { cat "$work/sync.out" >&2; fail "a scheduled sync failed"; }
expect "^ci --prefix $public/runtime/playwright" "$work/npm.log"
# The stand-in installed nothing, as a failed install would: the next run tries again.
: >"$work/npm.log"
"$public/scripts/sync" --from-schedule </dev/null >"$work/sync.out" 2>&1 || { cat "$work/sync.out" >&2; fail "a scheduled sync failed"; }
expect "^ci --prefix $public/runtime/playwright" "$work/npm.log"
# Installed from the lockfile as it is: left alone.
mkdir -p "$public/runtime/playwright/node_modules"
touch -t 203001010000 "$public/runtime/playwright/node_modules/.package-lock.json"
: >"$work/npm.log"
"$public/scripts/sync" --from-schedule </dev/null >"$work/sync.out" 2>&1 || { cat "$work/sync.out" >&2; fail "a scheduled sync failed"; }
test ! -s "$work/npm.log" || fail "a scheduled sync reinstalled a runtime that is current"
rm -rf "$public/runtime/playwright/node_modules"
# A failed run says so in its last line.
git -C "$public" commit -q --allow-empty -m "Local"
echo newer >>"$work/seeds/agent-skills/skills/demo/SKILL.md"
commit_seed agent-skills "Moves on"
if "$public/scripts/sync" --from-schedule </dev/null >"$work/sync.out" 2>&1; then fail "sync passed when a pull could not fast-forward"; fi
tail -n 1 "$work/sync.out" | grep -q "^agent-skills sync finished .*: failed (exit 1)$" || { cat "$work/sync.out" >&2; fail "no failed finish line"; }
git -C "$public" reset -q --hard origin/main
rm -f "$work/bin/npm" "$work/bin/node"

# A private repository left out (set empty) and a state repository that isn't there are skipped.
rm -rf "$state"
AGENT_SKILLS_PRIVATE= "$public/scripts/sync" --skip-dependencies >"$work/sync.out" 2>&1 || { cat "$work/sync.out" >&2; fail "sync failed"; }
expect "^SKIP agent-skills-state: not there ($state)" "$work/sync.out"
refuse "agent-skills-private" "$work/sync.out"

test ! -e "$work/launchctl.log" || fail "launchctl was called: $(cat "$work/launchctl.log")"

echo "sync-test: passed"
