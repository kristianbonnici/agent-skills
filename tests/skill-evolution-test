#!/bin/sh
# Checks skill-evolution's lessons script: two computers sharing one private state repository (a
# bare remote and two clones), each entry its own file with an ID that never changes, adds on both
# at once, an offline add sent later with its ID unchanged, status and incident updates seen on the
# other computer, only the lessons' files ever committed, no rebase left behind, the lock, bad
# input, and a computer without a state repository.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/skill-evolution-test.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM

GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 python3 -I - "$repo_root/skills/skill-evolution/scripts/lessons" "$work" <<'EOF'
import os, re, subprocess, sys, time
script, work = sys.argv[1], sys.argv[2]

def git(repo, *args, check=True):
    done = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    assert done.returncode == 0 or not check, (args, done.stderr)
    return done.stdout

remote = os.path.join(work, "remote.git")
subprocess.run(["git", "init", "-q", "--bare", "-b", "main", remote], check=True)
seed = os.path.join(work, "seed")
subprocess.run(["git", "clone", "-q", remote, seed], check=True, capture_output=True)
git(seed, "config", "user.email", "t@example.com"); git(seed, "config", "user.name", "T")
open(os.path.join(seed, "README.md"), "w").write("state\n")
git(seed, "add", "README.md"); git(seed, "commit", "-q", "-m", "seed"); git(seed, "push", "-q", "origin", "main")

env = {}
for name in ("a", "b"):
    clone = os.path.join(work, name, "agent-skills-state")
    subprocess.run(["git", "clone", "-q", remote, clone], check=True, capture_output=True)
    git(clone, "config", "user.email", f"{name}@example.com"); git(clone, "config", "user.name", name)
    env[name] = dict(os.environ, AGENT_SKILLS_STATE=clone, XDG_STATE_HOME=os.path.join(work, name, "state"),
                     GIT_TERMINAL_PROMPT="0")
clone = {n: env[n]["AGENT_SKILLS_STATE"] for n in env}

def lessons(name, *args):
    return subprocess.run([sys.executable, "-I", script, *args], capture_output=True, text=True, env=env[name], timeout=120)

def entry(name, title, body="- Status: proposed\n- Incidents: 2026-10-31 run: something cost an hour\n"):
    path = os.path.join(work, f"{name}-{abs(hash(title))}.md")
    open(path, "w").write(f"## L?. {title}\n{body}")
    return path

def ids(output):
    return re.findall(r"^added: (L-[A-Z2-9]{4}) ", output, re.M)

def on_remote(entry_id):
    done = subprocess.run(["git", "--git-dir", remote, "show", f"main:skill-evolution/lessons/{entry_id}.md"],
                          capture_output=True, text=True)
    return done.stdout if done.returncode == 0 else None

def remote_files():
    return subprocess.run(["git", "--git-dir", remote, "log", "--name-only", "--format=", "main"],
                          capture_output=True, text=True).stdout.split()

# An add on a: the entry gets an ID and a date, its own file, committed and pushed.
done = lessons("a", "add", entry("a", "orchestrator: run folders grow"))
assert done.returncode == 0 and "pushed" in done.stdout, (done.stdout, done.stderr)
first = ids(done.stdout)[0]
text = on_remote(first)
assert text.startswith(f"## {first}. orchestrator: run folders grow\n- Recorded: ") and "- Incidents: 2026-10-31 run" in text, text

# b sees it: one line per entry, the entry in full by its ID.
done = lessons("b", "show")
assert done.returncode == 0 and f"{first}  proposed  orchestrator: run folders grow" in done.stdout, done.stdout
done = lessons("b", "show", first)
assert done.returncode == 0 and f"## {first}. orchestrator: run folders grow" in done.stdout and "- Incidents:" in done.stdout, done.stdout

# Both add at once, with identical bodies (the shape a text merge would garble): both kept whole.
a_add = entry("a", "review-gate: a's lesson", "- Status: seen\n")
b_add = entry("b", "planner: b's lesson", "- Status: seen\n")
assert lessons("a", "add", a_add).returncode == 0
done = lessons("b", "add", b_add)        # b hasn't pulled a's: its push is rejected, rebased, pushed
assert done.returncode == 0 and "pushed" in done.stdout, (done.stdout, done.stderr)
b_id = ids(done.stdout)[0]
assert on_remote(b_id).endswith("planner: b's lesson\n- Recorded: " + time.strftime("%Y-%m-%d") + "\n- Status: seen\n"), on_remote(b_id)
shown = lessons("a", "show", "--all").stdout
assert shown.count("## L-") == 3 and "review-gate: a's lesson" in shown and "planner: b's lesson" in shown, shown

# b offline: written and committed here, not pushed (3), its ID final; a adds meanwhile; b's next
# command sends it unchanged.
git(clone["b"], "remote", "set-url", "origin", os.path.join(work, "nowhere.git"))
done = lessons("b", "add", entry("b", "orchestrator: offline lesson"))
assert done.returncode == 3 and "not pushed" in done.stdout, (done.stdout, done.stderr)
offline = ids(done.stdout)[0]
assert lessons("a", "add", entry("a", "orchestrator: a meanwhile")).returncode == 0
git(clone["b"], "remote", "set-url", "origin", remote)
done = lessons("b", "show")
assert done.returncode == 0 and "orchestrator: a meanwhile" in done.stdout and "not pushed" not in done.stdout, done.stdout
assert on_remote(offline) and on_remote(offline).startswith(f"## {offline}. orchestrator: offline lesson"), on_remote(offline)

# Decisions and repeats: set and note on a, seen on b.
assert lessons("a", "set", first, "declined 2026-11-01: not worth the context").returncode == 0
assert lessons("a", "note", first, "orbos run: the disk filled again").returncode == 0
text = lessons("b", "show", first).stdout
assert "- Status: declined 2026-11-01: not worth the context" in text and "; " + time.strftime("%Y-%m-%d") + ": orbos run: the disk filled again" in text, text

# A chain of unsent changes (a set, a note and an add) meeting another computer's change of the same
# entry: the set and the note are dropped with what they said, the new entry survives with its ID.
git(clone["b"], "remote", "set-url", "origin", os.path.join(work, "nowhere.git"))
assert lessons("b", "set", first, "proposed 2026-11-04").returncode == 3
assert lessons("b", "note", first, "laptop run: it happened again").returncode == 3
done = lessons("b", "add", entry("b", "x: survives the conflict"))
assert done.returncode == 3
survivor = ids(done.stdout)[0]
assert lessons("a", "set", first, "applied long-horizon-orchestrator 2.0.0 2026-11-04").returncode == 0
git(clone["b"], "remote", "set-url", "origin", remote)
done = lessons("b", "show")
assert done.returncode == 0 and "it happened again" in done.stdout and "proposed 2026-11-04" in done.stdout, done.stdout
assert on_remote(survivor) and "applied long-horizon-orchestrator 2.0.0" in on_remote(first), on_remote(first)

# Two computers picking the same ID offline: the one sent second moves to a new ID and says so.
git(clone["b"], "remote", "set-url", "origin", os.path.join(work, "nowhere.git"))
done = lessons("b", "add", entry("b", "x: b's entry under a shared ID"))
shared = ids(done.stdout)[0]
os.makedirs(os.path.join(clone["a"], "skill-evolution", "lessons"), exist_ok=True)
assert lessons("a", "show").returncode == 0
open(os.path.join(clone["a"], "skill-evolution", "lessons", shared + ".md"), "w").write(f"## {shared}. x: a's entry\n- Status: seen\n")
git(clone["a"], "add", "--", f"skill-evolution/lessons/{shared}.md"); git(clone["a"], "commit", "-q", "-m", "a's"); git(clone["a"], "push", "-q")
git(clone["b"], "remote", "set-url", "origin", remote)
done = lessons("b", "show")
moved = re.search(rf"moved: this computer's unsent entry {shared} is now (L-[A-Z2-9]{{4}})", done.stdout)
assert done.returncode == 0 and moved, (done.stdout, done.stderr)
assert "x: a's entry" in on_remote(shared) and "x: b's entry under a shared ID" in on_remote(moved.group(1))

# A failed commit (a signing error): the ID was shown, so the next command commits and sends it.
git(clone["a"], "config", "commit.gpgsign", "true"); git(clone["a"], "config", "gpg.program", "false")
done = lessons("a", "add", entry("a", "x: commit fails"))
assert done.returncode == 3 and "not committed" in done.stdout, done.stdout
unsent = ids(done.stdout)[0]
done = lessons("a", "show")                                     # still failing: said, not "sent"
assert done.returncode == 3 and f"not committed: {unsent} still not committed" in done.stdout, done.stdout
git(clone["a"], "config", "--unset", "commit.gpgsign")
done = lessons("a", "show")
assert done.returncode == 0 and f"committed earlier entries: {unsent}" in done.stdout and on_remote(unsent), done.stdout

# Only the lessons' files are ever committed: the owner's other edits, staged or not, stay theirs.
open(os.path.join(clone["a"], "README.md"), "a").write("owner's edit\n")
open(os.path.join(clone["a"], "other.txt"), "w").write("staged\n")
git(clone["a"], "add", "other.txt")
assert lessons("a", "add", entry("a", "x: with other edits around")).returncode == 0
assert all(f == "README.md" or f.startswith("skill-evolution/lessons/L-") for f in remote_files()), remote_files()
status = git(clone["a"], "status", "--porcelain")
assert " M README.md" in status and "A  other.txt" in status, status
git(clone["a"], "reset", "-q", "--", "other.txt"); os.unlink(os.path.join(clone["a"], "other.txt"))
git(clone["a"], "checkout", "-q", "--", "README.md")

# The later decision wins when b pulls before writing.
assert lessons("a", "set", b_id, "applied planner 1.1.0 2026-11-02").returncode == 0
assert lessons("b", "set", b_id, "declined 2026-11-02: changed my mind").returncode == 0
assert "declined 2026-11-02: changed my mind" in on_remote(b_id)
# A real conflict: b changes an entry offline while a changes the same entry. b's next command keeps
# a's (sent, maybe shown), drops b's unsent edit and says so; nothing is left mid-rebase.
git(clone["b"], "remote", "set-url", "origin", os.path.join(work, "nowhere.git"))
assert lessons("b", "set", b_id, "proposed again").returncode == 3
assert lessons("a", "set", b_id, "applied planner 1.2.0 2026-11-03").returncode == 0
git(clone["b"], "remote", "set-url", "origin", remote)
done = lessons("b", "show", b_id)
assert done.returncode == 0 and f"dropped: this computer's unsent change to {b_id}" in done.stdout, (done.stdout, done.stderr)
assert "- Status: proposed again" in done.stdout.split("\n", 1)[0] or "proposed again" in done.stdout.splitlines()[0], done.stdout
assert "applied planner 1.2.0" in done.stdout and "## " in done.stdout, done.stdout
for leftover in ("rebase-merge", "rebase-apply", "MERGE_HEAD"):
    assert not os.path.exists(os.path.join(clone["b"], ".git", leftover)), leftover
assert git(clone["b"], "rev-list", "--count", "@{u}..HEAD").strip() == "0"
assert lessons("b", "add", entry("b", "x: after the conflict")).returncode == 0

# The owner's other unpushed commit is never pushed by a lessons command: the entry waits (3) until
# the owner pushes, and goes with it. Their uncommitted edits stop the pull, never get stashed.
open(os.path.join(clone["a"], "notes.txt"), "w").write("mine\n")
git(clone["a"], "add", "notes.txt"); git(clone["a"], "commit", "-q", "-m", "owner's own")
done = lessons("a", "add", entry("a", "x: waits for the owner's push"))
assert done.returncode == 3 and "other unpushed commits (owner's own)" in done.stdout, done.stdout
waiting = ids(done.stdout)[0]
assert on_remote(waiting) is None and "notes.txt" not in remote_files()
git(clone["a"], "push", "-q")
assert on_remote(waiting)
git(clone["a"], "commit", "-q", "--allow-empty", "-m", "owner's empty commit")   # no files, still the owner's
done = lessons("a", "add", entry("a", "x: waits for the empty commit"))
assert done.returncode == 3 and "owner's empty commit" in done.stdout, done.stdout
git(clone["a"], "push", "-q")
open(os.path.join(clone["a"], "README.md"), "a").write("owner's unsaved edit\n")
assert lessons("b", "add", entry("b", "x: from b meanwhile")).returncode == 0
done = lessons("a", "add", entry("a", "x: with the owner's edit open"))
assert done.returncode == 3 and "uncommitted changes of its own (README.md)" in done.stdout, done.stdout
assert "owner's unsaved edit" in open(os.path.join(clone["a"], "README.md")).read()
assert git(clone["a"], "stash", "list") == ""
git(clone["a"], "checkout", "-q", "--", "README.md")
assert lessons("a", "show").returncode == 0                 # pulls b's, sends a's
assert git(clone["a"], "rev-list", "--count", "@{u}..HEAD").strip() == "0"

# A repository already mid-rebase is left alone (4), nothing written.
os.mkdir(os.path.join(clone["a"], ".git", "rebase-merge"))
done = lessons("a", "add", entry("a", "x: while rebasing"))
assert done.returncode == 4 and os.path.isdir(os.path.join(clone["a"], ".git", "rebase-merge")), done.stderr
os.rmdir(os.path.join(clone["a"], ".git", "rebase-merge"))

# The lock: one held by a live process waits (and gives up, 75); one whose process is gone is taken over.
lock = os.path.join(work, "a", "state", "agent-skills", "skill-evolution", ".lock")
os.mkdir(lock)
open(os.path.join(lock, "pid"), "w").write(str(os.getpid()))
done = subprocess.run([sys.executable, "-I", script, "show"], capture_output=True, text=True,
                      env=dict(env["a"], LESSONS_LOCK_WAIT="1"), timeout=60)
assert done.returncode == 75, done.stderr
dead = subprocess.Popen([sys.executable, "-c", "pass"]); dead.wait()
open(os.path.join(lock, "pid"), "w").write(str(dead.pid))
assert lessons("a", "show").returncode == 0 and not os.path.exists(lock)

# Bad input: refused, nothing written.
before = sorted(os.listdir(os.path.join(clone["a"], "skill-evolution", "lessons")))
bad = os.path.join(work, "bad.md")
open(bad, "w").write("## L?. one\n## L?. two\n")
assert lessons("a", "add", bad).returncode == 64
open(bad, "w").write("no heading\n")
assert lessons("a", "add", bad).returncode == 64
assert lessons("a", "set", "L-ZZZ", "x").returncode == 64
assert lessons("a", "set", "nonsense", "x").returncode == 64
assert lessons("a", "frobnicate").returncode == 64
assert sorted(os.listdir(os.path.join(clone["a"], "skill-evolution", "lessons"))) == before
assert git(clone["a"], "status", "--porcelain") == ""

# No state repository: plain local files.
env["c"] = dict(os.environ, AGENT_SKILLS_STATE=os.path.join(work, "c", "not-a-repo"), XDG_STATE_HOME=os.path.join(work, "c", "state"))
done = lessons("c", "add", entry("c", "x: local"))
assert done.returncode == 0 and "this computer only" in done.stdout and "no private state repository" in done.stderr, done.stdout
local_id = ids(done.stdout)[0]
assert os.path.isfile(os.path.join(work, "c", "state", "agent-skills", "skill-evolution", "lessons", local_id + ".md"))
assert "x: local" in lessons("c", "show").stdout
EOF
echo "skill-evolution: ok"
