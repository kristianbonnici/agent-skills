                )
            self.assertEqual(checked, [True])

            checked.clear()
            attempt_n = [0]

            def check_fails_on_retry():
                checked.append(len(checked) + 1)
                if len(checked) >= 3:
                    raise bench.Refused("daemon changed mid-batch")

            def zero_tool_driver(*a, **kw):
                def go():
                    attempt_n[0] += 1
