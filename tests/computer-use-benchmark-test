                    json.dump({"version": 1, "run_id": "orphan", "stage": ".orphan.stage.abcd", "backup": None}, f)
                real_open = open

                def deny_results(path, *args, **kwargs):
                    if os.path.abspath(str(path)) == os.path.abspath(bad_res):
                        raise PermissionError(errno.EACCES, "unreadable results", path)
                    return real_open(path, *args, **kwargs)

                with mock.patch("builtins.open", side_effect=deny_results):
                    with self.assertRaises(PermissionError):
                        bench.load_folders([], ro_data)

            # Attempt-chain scoping, dedupe across snapshots, and stopped -> usage-limit -> pass cost preservation.
            with tempfile.TemporaryDirectory() as ch_state, tempfile.TemporaryDirectory() as ch_out_a, tempfile.TemporaryDirectory() as ch_out_b:
                os.makedirs(os.path.join(ch_state, ".git"))
                ch_data = os.path.join(ch_state, "computer-use-benchmark")
                os.makedirs(ch_data)
                with open(os.path.join(ch_data, "set.json"), "w", encoding="utf-8") as f:
                    json.dump({"version": "1.0", "tasks": ["form"], "seeds": 1}, f)

                class ChainBench:
                    def __init__(self, task, seed, log, quiet):
                        self.log = log
                        ev = [{"event": "shown", "t": 0.1}]
                        if "-r3" in os.path.basename(log):
                            ev.append({"event": "success", "t": 2.0})
                        with open(log, "w", encoding="utf-8") as lf:
                            for item in ev:
                                lf.write(json.dumps(item) + "\n")

                    def events(self):
                        with open(self.log, encoding="utf-8") as lf:
                            return [json.loads(l) for l in lf if l.strip()]

                    def close(self):
                        pass

                ch_cua_calls = [0]

                def cua_stop_on_first():
                    ch_cua_calls[0] += 1
                    if ch_cua_calls[0] == 3:
                        raise bench.Refused("cua paused mid-retry")

                ch_step = [0]

                def seq_driver(*a, **kw):
                    def run_one():
                        ch_step[0] += 1
                        if ch_step[0] == 1:
                            return dict(started=100.0, wall=3.0, notes=[], tools={}, usage={"input": 100, "cache_read": 0, "cache_write": 0, "output": 10}, final=None, images=None)
                        if ch_step[0] == 2:
                            return dict(started=200.0, wall=4.0, notes=["codex limit"], tools={}, usage={}, final=None, images=None)
                        return dict(started=300.0, wall=2.0, notes=[], tools={"click": 1}, usage={"input": 60, "cache_read": 0, "cache_write": 0, "output": 5}, final="DONE", images=None)

                    return run_one

                # Step 1: stopped row recorded as two snapshots; dedup must not double stopped cost when both load.
                with mock.patch("time.sleep"), self.assertRaises(SystemExit):
                    bench.run_batch(ch_out_a, [bench.parse_setup("codex-cua")], ["form"], [1], quiet=True, check_cua=cua_stop_on_first, describe_fn=lambda t, s: "desc", bench_cls=ChainBench, driver_fn=seq_driver)
                bench.record_run(ch_out_a, ch_data, name="snap-stopped")
                bench.record_run(ch_out_a, ch_data, name="snap-stopped-2")
                dup_stopped = bench.latest_runs(
                    bench.load_folders([os.path.join(ch_data, "runs", "snap-stopped"), os.path.join(ch_data, "runs", "snap-stopped-2")], ch_data)
