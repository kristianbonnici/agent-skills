                # An unresolved journal where rename failed must refuse rather than overwrite the journal.
                locked_bk = os.path.join(jb_runs, ".locked.backup")
                os.makedirs(locked_bk)
                with open(os.path.join(locked_bk, "results.jsonl"), "w", encoding="utf-8") as f:
                    f.write(json.dumps(make_row("codex-native", "codex-native", "gpt-6.1-terra", "form", 1, True, 9.0)) + "\n")
                with open(os.path.join(jb_runs, ".locked.tx.json"), "w", encoding="utf-8") as f:
                    json.dump({"version": 1, "run_id": "locked", "stage": ".locked.stage.1234", "backup": ".locked.backup"}, f)
                real_rename = os.rename

                def fail_locked_rename(src, dst):
                    if os.path.basename(src) == ".locked.backup":
                        raise OSError(errno.EACCES, "simulated rename failure")
                    return real_rename(src, dst)

                with mock.patch("os.rename", side_effect=fail_locked_rename):
