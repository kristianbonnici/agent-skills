                self.assertIn("unresolved transaction journal", tx_err.exception.message)
                self.assertTrue(os.path.isdir(locked_bk))

                # Failed fallback O_EXCL journal write unlinks the truncated .tx.json so the run name isn't locked out.
                real_json_dump = json.dump

                def fail_excl_dump(obj, fp, *args, **kwargs):
                    if isinstance(getattr(fp, "name", None), int) and isinstance(obj, dict) and obj.get("run_id") == "excl-fail":
                        raise OSError(errno.ENOSPC, "disk full during O_EXCL fallback")
                    return real_json_dump(obj, fp, *args, **kwargs)

                with mock.patch("os.link", side_effect=OSError(errno.EPERM, "no hardlinks")), mock.patch(
                    "json.dump", side_effect=fail_excl_dump
                ):
                    with self.assertRaises(OSError):
                        bench.record_run(jb_out, jb_data, name="excl-fail")
                self.assertFalse(os.path.exists(os.path.join(jb_runs, ".excl-fail.tx.json")))
                bench.record_run(jb_out, jb_data, name="excl-fail")
                self.assertTrue(os.path.isdir(os.path.join(jb_runs, "excl-fail")))

            # OSError while reading under _read_runs_snapshot with a pending journal propagates the real OSError, never RuntimeError.
            with tempfile.TemporaryDirectory() as ro_state:
                os.makedirs(os.path.join(ro_state, ".git"))
                ro_data = os.path.join(ro_state, "computer-use-benchmark")
                ro_runs = os.path.join(ro_data, "runs")
                os.makedirs(os.path.join(ro_runs, "b1"))
