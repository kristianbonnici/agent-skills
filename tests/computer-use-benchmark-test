            env = dict(os.environ, AGENT_SKILLS_STATE=tmp_state)
            t_active = subprocess.run([sys.executable, "-I", bench_path, "totals", "--json"], capture_output=True, text=True, env=env)
            self.assertEqual(t_active.returncode, 0, t_active.stderr)
            d_active = json.loads(t_active.stdout)
