                self.assertEqual(len(dup_stopped), 1)
                self.assertFalse(dup_stopped[0]["passed"])
                self.assertEqual(dup_stopped[0]["wall"], 3.0)
                self.assertEqual(dup_stopped[0]["usage"]["input"], 100)
                self.assertEqual(dup_stopped[0]["attempts"], 1)

                # Step 2: usage-limit row in the same folder.
                bench.run_batch(ch_out_a, [bench.parse_setup("codex-cua")], ["form"], [1], quiet=True, check_cua=lambda: "ok", describe_fn=lambda t, s: "desc", bench_cls=ChainBench, driver_fn=seq_driver)

                # Step 3: final pass in the same folder, recorded across two snapshots (snap-resumed and snap-final).
                bench.run_batch(ch_out_a, [bench.parse_setup("codex-cua")], ["form"], [1], quiet=True, check_cua=lambda: "ok", describe_fn=lambda t, s: "desc", bench_cls=ChainBench, driver_fn=seq_driver)
                bench.record_run(ch_out_a, ch_data, name="snap-resumed")
                bench.record_run(ch_out_a, ch_data, name="snap-final")

                # Loading all snapshots (including two containing the passing row W) and reversed order folds stopped cost ONCE.
                for loaded_rows in (
                    bench.load_folders([], ch_data),
                    bench.load_folders([os.path.join(ch_data, "runs", "snap-final"), os.path.join(ch_data, "runs", "snap-stopped")], ch_data),
                ):
