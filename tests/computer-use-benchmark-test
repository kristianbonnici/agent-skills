                    self.assertEqual(len(combined_latest), 1)
                    self.assertTrue(combined_latest[0]["passed"])
                    self.assertEqual(combined_latest[0]["wall"], 5.0)
                    self.assertEqual(combined_latest[0]["usage"]["input"], 160)
                    self.assertEqual(combined_latest[0]["attempts"], 2)

                # Independent batch B passing the same cell must NOT inherit batch A's stopped cost.
                bench.run_batch(
                    ch_out_b,
                    [bench.parse_setup("codex-cua")],
                    ["form"],
                    [1],
                    quiet=True,
                    check_cua=lambda: "ok",
                    describe_fn=lambda t, s: "desc",
                    bench_cls=ChainBench,
                    driver_fn=lambda *a, **kw: lambda: dict(started=400.0, wall=1.5, notes=[], tools={"click": 1}, usage={"input": 40, "cache_read": 0, "cache_write": 0, "output": 5}, final="DONE", images=None),
                )
                cross_rows = bench.load_folders([os.path.join(ch_data, "runs", "snap-stopped"), ch_out_b], ch_data)
                cross_latest = bench.latest_runs(cross_rows)
                self.assertEqual(len(cross_latest), 1)
                self.assertEqual(cross_latest[0]["wall"], 1.5)
                self.assertEqual(cross_latest[0]["usage"]["input"], 40)
                self.assertEqual(cross_latest[0]["attempts"], 1)

            # Resuming an untagged legacy retry_stopped row in the same folder folds its cost into the new tagged pass without leaking.
            with tempfile.TemporaryDirectory() as u_state, tempfile.TemporaryDirectory() as u_out_a, tempfile.TemporaryDirectory() as u_out_b, tempfile.TemporaryDirectory() as u_out_c:
                os.makedirs(os.path.join(u_state, ".git"))
                u_data = os.path.join(u_state, "computer-use-benchmark")
                os.makedirs(u_data)
                with open(os.path.join(u_data, "set.json"), "w", encoding="utf-8") as f:
                    json.dump({"version": "1.0", "tasks": ["form"], "seeds": 1}, f)

                untagged_stopped = make_row(
                    "codex-cua",
                    "codex-cua",
                    "gpt-6.1-terra",
                    "form",
                    1,
                    False,
                    100.0,
