            finally:
                bench.CODEX_HOME, bench.CODEX_CONFIG, bench.CODEX_SESSIONS, bench.HOME, bench._screen = saved

    def test_tui_screen_preserves_passed_env_and_strips_claude_vars(self):
        fake_pyte = types.SimpleNamespace(Screen=lambda cols, rows: None, ByteStream=lambda s: None)
        tui_path = os.path.join(skill_dir, "scripts", "tui.py")
        tui_loader = importlib.machinery.SourceFileLoader("tui_test_mod", tui_path)
        tui_spec = importlib.util.spec_from_loader("tui_test_mod", tui_loader)
        tui_mod = importlib.util.module_from_spec(tui_spec)
        with mock.patch.dict(sys.modules, {"pyte": fake_pyte}):
            tui_loader.exec_module(tui_mod)
        captured = {}

        def fake_fork():
            return 0, 99

        def fake_execvpe(cmd, argv, env):
            captured["cmd"] = cmd
            captured["env"] = env
            raise RuntimeError("stop child")

        exited = []

        def fake_exit(code):
            exited.append(code)
            raise SystemExit(code)

        with (
            mock.patch.object(tui_mod.pty, "fork", side_effect=fake_fork),
            mock.patch.object(tui_mod.os, "chdir"),
            mock.patch.object(tui_mod.os, "execvpe", side_effect=fake_execvpe),
            mock.patch.object(tui_mod.os, "_exit", side_effect=fake_exit),
        ):
            with self.assertRaises(SystemExit) as cm:
                tui_mod.Screen(
                    ["codex"],
                    work,
                    env={"CODEX_HOME": "/abs/codex", "CLAUDECODE": "1", "ANTHROPIC_API_KEY": "secret"},
                )
        self.assertEqual(exited, [127])
        self.assertEqual(cm.exception.code, 127)
        self.assertEqual(captured["env"]["CODEX_HOME"], "/abs/codex")
        self.assertEqual(captured["env"]["TERM"], "xterm-256color")
        self.assertNotIn("CLAUDECODE", captured["env"])
        self.assertNotIn("ANTHROPIC_API_KEY", captured["env"])


class TuiLifecycleAndTranscriptTests(unittest.TestCase):
    def test_tui_screen_close_kills_sigterm_ignoring_child_reaps_and_closes_fd(self):
        fake_pyte = types.SimpleNamespace(
            Screen=lambda cols, rows: types.SimpleNamespace(display=[""] * rows),
            ByteStream=lambda s: types.SimpleNamespace(feed=lambda data: None),
        )
        tui_path = os.path.join(skill_dir, "scripts", "tui.py")
        tui_loader = importlib.machinery.SourceFileLoader("tui_live_mod", tui_path)
        tui_spec = importlib.util.spec_from_loader("tui_live_mod", tui_loader)
        tui_mod = importlib.util.module_from_spec(tui_spec)
        with mock.patch.dict(sys.modules, {"pyte": fake_pyte}):
            tui_loader.exec_module(tui_mod)
        scr = tui_mod.Screen(["/bin/sh", "-c", "trap '' TERM; sleep 30"], work, rows=10, cols=40)
        pid, fd = scr.pid, scr.fd
        scr.close(wait=0.2)
        self.assertIsNone(scr.pid)
        self.assertIsNone(scr.fd)
        self.assertFalse(scr.pump(0.1))
        with self.assertRaises(OSError) as cm:
            os.fstat(fd)
        self.assertEqual(cm.exception.errno, errno.EBADF)
        with self.assertRaises(ProcessLookupError):
            os.kill(pid, 0)
        scr.close()

    def test_tui_screen_close_kills_surviving_descendant_when_leader_exits_sigterm(self):
        fake_pyte = types.SimpleNamespace(
            Screen=lambda cols, rows: types.SimpleNamespace(display=[""] * rows),
            ByteStream=lambda s: types.SimpleNamespace(feed=lambda data: None),
        )
        tui_path = os.path.join(skill_dir, "scripts", "tui.py")
        tui_loader = importlib.machinery.SourceFileLoader("tui_desc_mod", tui_path)
        tui_spec = importlib.util.spec_from_loader("tui_desc_mod", tui_loader)
        tui_mod = importlib.util.module_from_spec(tui_spec)
        with mock.patch.dict(sys.modules, {"pyte": fake_pyte}):
            tui_loader.exec_module(tui_mod)
        with tempfile.TemporaryDirectory() as d:
            pidfile = os.path.join(d, "helper.pid")
            cmd = (
                f"/bin/sh -c 'trap \"\" TERM; echo $$ > {pidfile}; exec sleep 30' "
                "</dev/null >/dev/null 2>&1 & while [ ! -s "
                f"{pidfile} ]; do sleep 0.05; done; exec cat"
            )
            scr = tui_mod.Screen(["/bin/sh", "-c", cmd], work, rows=10, cols=40)
            for _ in range(60):
                if os.path.exists(pidfile) and read(pidfile).strip():
                    break
                time.sleep(0.05)
            helper_pid = int(read(pidfile).strip())
            scr.close(wait=0.25)
            for _ in range(40):
                try:
                    os.kill(helper_pid, 0)
                except ProcessLookupError:
                    break
                time.sleep(0.05)
            with self.assertRaises(ProcessLookupError):
                os.kill(helper_pid, 0)

