#!/bin/sh
# Checks computer-use-benchmark's bench script, tui wrapper, capability manifest verification, and
# Harbor Desk build/selftest in a disposable work directory without touching live user configs.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/computer-use-benchmark-test.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM

python3 -I - "$repo_root/skills/computer-use-benchmark" "$work" <<'EOF'
