#!/bin/sh
# Checks computer-use-benchmark's bench script, tui wrapper, capability manifest verification, and
# Harbor Desk build/selftest in a disposable work directory without touching live user configs.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/computer-use-benchmark-test.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM

python3 -I - "$repo_root/skills/computer-use-benchmark" "$work" <<'EOF'
from datetime import datetime, timezone
import errno
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import types
import unittest
from unittest import mock

skill_dir = sys.argv[1]
work = os.path.realpath(sys.argv[2])
bench_path = os.path.join(skill_dir, "scripts", "bench")

# Isolate state, cache, and socket before loading bench so module defaults never point at live user folders.
state_dir = os.path.join(work, "agent-skills-state")
cache_dir = os.path.join(work, "cache")
xdg_state = os.path.join(work, "xdg-state")
sock_path = os.path.join(work, "sock", "cua.sock")
os.makedirs(os.path.join(state_dir, ".git"), exist_ok=True)
os.makedirs(cache_dir, exist_ok=True)
os.environ["AGENT_SKILLS_STATE"] = state_dir
os.environ["COMPUTER_USE_BENCHMARK_CACHE"] = cache_dir
os.environ["COMPUTER_USE_BENCHMARK_SOCKET"] = sock_path
os.environ["XDG_STATE_HOME"] = xdg_state
os.environ.pop("GEMINI_HOME", None)

loader = importlib.machinery.SourceFileLoader("bench_mod", bench_path)
spec = importlib.util.spec_from_loader("bench_mod", loader)
bench = importlib.util.module_from_spec(spec)
loader.exec_module(bench)

SAMPLE_CODEX = os.path.join(work, "sample-codex.toml")
with open(SAMPLE_CODEX, "w", encoding="utf-8") as f:
    f.write(
        '[mcp_servers.node_repl]\ncommand = "x"\n'
        '[mcp_servers.computer-use]\ncommand = "x"\nenabled = false\n'
        '[mcp_servers.notes]\ncommand = "x"\n'
        '[mcp_servers.reader]\ncommand = "x"\n'
        '[mcp_servers.cua]\ncommand = "x"\n'
        '[mcp_servers.cua-driver]\ncommand = "x"\n'
        '[mcp_servers.search]\ncommand = "x"\n'
    )
bench.CODEX_CONFIG = SAMPLE_CODEX


def read(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


def iso(epoch):
    return datetime.fromtimestamp(epoch, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ")


def write_rollout(root, relpath, *, session_id, cwd, created, prompt=None, tools=(), extra_lines=(), mtime=None):
    path = os.path.join(root, relpath)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    lines = [
        json.dumps(
            {
                "timestamp": iso(created),
                "ordinal": 0,
                "type": "session_meta",
                "payload": {"id": session_id, "session_id": session_id, "cwd": cwd, "timestamp": iso(created)},
            }
        )
    ]
    if prompt is not None:
        lines.append(
            json.dumps(
                {
                    "timestamp": iso(created + 0.1),
                    "type": "response_item",
                    "payload": {
                        "type": "message",
                        "role": "user",
                        "content": [{"type": "input_text", "text": prompt}],
                    },
                }
            )
        )
    for kind, name in tools:
        lines.append(
            json.dumps(
                {
                    "timestamp": iso(created + 0.5),
                    "type": "response_item",
                    "payload": {"type": kind, "name": name},
                }
            )
        )
    lines.extend(extra_lines)
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    stamp = mtime if mtime is not None else created + 1.0
    os.utime(path, (stamp, stamp))
    return path


