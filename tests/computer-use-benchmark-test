                u_cutoff = bench.latest_runs(bench.load_folders([u_out_c], u_data))
                self.assertEqual(len(u_cutoff), 1)
                self.assertTrue(u_cutoff[0]["passed"])
                self.assertEqual(u_cutoff[0]["wall"], 2.0)
                self.assertEqual(u_cutoff[0]["usage"]["input"], 60)
                self.assertEqual(u_cutoff[0]["attempts"], 1)

            # Recovered launch error followed by wrong answer classifies as wrong-answer; STOP/daemon abort after launch failure blames STOP/daemon.
            with tempfile.TemporaryDirectory() as lf_out, tempfile.TemporaryDirectory() as sa_out:
                lf_calls = [0]

                class WrongAfterLaunchFailBench:
                    def __init__(self, task, seed, log, quiet):
                        lf_calls[0] += 1
                        if lf_calls[0] == 1:
                            raise bench.BenchLaunchError("transient open err")
                        with open(log, "w", encoding="utf-8") as lf:
                            lf.write(json.dumps({"event": "shown", "t": 0.1}) + "\n")
                            lf.write(json.dumps({"event": "wrong", "t": 1.2}) + "\n")

                    def events(self):
                        return [{"event": "shown", "t": 0.1}, {"event": "wrong", "t": 1.2}]

                    def close(self):
                        pass

                with mock.patch("time.sleep"):
                    bench.run_batch(
