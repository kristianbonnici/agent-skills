                        describe_fn=lambda t, s: "desc",
                        bench_cls=LaunchAlwaysFailBench,
                    )
                self.assertIn("stopped before a retry: daemon stopped", str(stop_msg.exception))
                self.assertFalse(os.path.exists(os.path.join(sa_out, "results.jsonl")))

            with tempfile.TemporaryDirectory() as stop_home, tempfile.TemporaryDirectory() as stop_out:
                stop_marker = os.path.join(stop_home, "STOP")

                class TouchStopOnLaunchFailBench:
                    def __init__(self, task, seed, log, quiet):
                        with open(stop_marker, "w", encoding="utf-8") as sf:
                            sf.write("stop\n")
                        raise bench.BenchLaunchError("launch boom")

                with mock.patch.object(bench, "HOME", stop_home), mock.patch("time.sleep"), self.assertRaises(SystemExit) as stop_err:
                    bench.run_batch(
                        stop_out,
                        [bench.parse_setup("codex-native")],
                        ["form"],
                        [1],
                        quiet=True,
                        describe_fn=lambda t, s: "desc",
                        bench_cls=TouchStopOnLaunchFailBench,
                    )
                stop_text = str(stop_err.exception)
                self.assertIn(stop_marker, stop_text)
                self.assertIn("exists", stop_text)
                self.assertIn("after launch failure: launch boom", stop_text)
                self.assertNotIn("the check between runs failed", stop_text)
                self.assertFalse(os.path.exists(os.path.join(stop_out, "results.jsonl")))

            # build() compiles from an immutable source snapshot and stamps those compiled bytes even if Bench.swift changes mid-compile.
            with tempfile.TemporaryDirectory() as snap_cache, tempfile.TemporaryDirectory() as snap_src_dir:
                snap_app = os.path.join(snap_cache, "Harbor Desk.app")
                snap_bin = os.path.join(snap_app, "Contents", "MacOS", "HarborDesk")
                snap_manifest = os.path.join(snap_cache, "manifest.yaml")
                mut_swift = os.path.join(snap_src_dir, "Bench.swift")
                with open(mut_swift, "wb") as f:
                    f.write(b"// original swift source\n")
                expected_orig_sha = hashlib.sha256(b"// original swift source\n").hexdigest()
                saved_globals = (bench.APP, bench.BIN, bench.MANIFEST, bench.BENCH_SOURCE)
                try:
                    bench.APP, bench.BIN, bench.MANIFEST, bench.BENCH_SOURCE = snap_app, snap_bin, snap_manifest, mut_swift

                    def fake_subproc_run(argv, **kwargs):
                        if argv[0] == "swiftc":
                            with open(argv[-1], "rb") as sf:
                                compiled_bytes = sf.read()
                            # Simulate Bench.swift mutating after swiftc read starts.
                            with open(mut_swift, "wb") as mf:
                                mf.write(b"// edited mid-compile\n")
                            with open(argv[argv.index("-o") + 1], "wb") as bf:
                                bf.write(b"compiled:" + compiled_bytes)
                        return types.SimpleNamespace(returncode=0, stdout="", stderr="")

                    with mock.patch("subprocess.run", side_effect=fake_subproc_run):
                        bench.build()
                    with open(bench.build_stamp_path(snap_app), encoding="utf-8") as f:
                        built_stamp = json.load(f)
                    self.assertEqual(built_stamp["source_sha256"], expected_orig_sha)
                    with self.assertRaises(bench.Refused) as drift_err:
                        bench.require_built_app()
                    self.assertIn("does not match current Bench.swift", drift_err.exception.message)
                finally:
                    bench.APP, bench.BIN, bench.MANIFEST, bench.BENCH_SOURCE = saved_globals

            for bad_argv in (
                ["selftest", "--seed", "abc"],
                ["run", out1, "codex-cua", "form", "--limit", "0"],
                ["run", out1, "codex-cua", "form", "--seed", "1", "--seed", "2"],
            ):
                res = subprocess.run([sys.executable, "-I", bench_path] + bad_argv, capture_output=True, text=True, env=env)
                self.assertEqual(res.returncode, 64, bad_argv)


class HarborDeskBuildAndSelftestTests(unittest.TestCase):
    def test_build_describe_and_offscreen_selftest(self):
        if not shutil.which("swiftc"):
            self.skipTest("swiftc unavailable")
        built = subprocess.run([sys.executable, "-I", bench_path, "build"], capture_output=True, text=True)
        self.assertEqual(built.returncode, 0, built.stderr)
        self.assertTrue(os.path.exists(bench.BIN))
