                )
                untagged_stopped["effort"] = "high"
                untagged_stopped["wall"] = 3.0
                untagged_stopped["seconds"] = None
                untagged_stopped["tools"] = {}
                with open(os.path.join(u_out_a, "results.jsonl"), "w", encoding="utf-8") as f:
                    f.write(json.dumps(untagged_stopped) + "\n")
                bench.record_run(u_out_a, u_data, name="u-snap-1")

                class UntaggedResumeBench:
                    def __init__(self, task, seed, log, quiet):
                        with open(log, "w", encoding="utf-8") as lf:
                            lf.write(json.dumps({"event": "shown", "t": 0.1}) + "\n")
                            lf.write(json.dumps({"event": "success", "t": 2.0}) + "\n")

                    def events(self):
