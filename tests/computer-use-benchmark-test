    def test_concurrent_same_task_and_seed_failed_startup_never_borrows_other_attempt(self):
        with tempfile.TemporaryDirectory() as root, tempfile.TemporaryDirectory() as fake_home, tempfile.TemporaryDirectory() as out_a, tempfile.TemporaryDirectory() as out_b:
            prompt = "You are operating Harbor Desk.\n\nTask: form seed 1"
            seen_cwds = []

            class FakeScreen:
                def __init__(self, argv, cwd, rows=50, cols=130, env=None):
                    seen_cwds.append(cwd)
                    self.cwd = cwd
                    self.closed = False
                    self.is_b = len(seen_cwds) == 1
                    if self.is_b:
                        write_rollout(
                            root,
                            "2026/11/22/rollout-b-bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb.jsonl",
                            session_id="bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
                            cwd=cwd,
                            created=time.time(),
                            prompt=prompt,
                            tools=[("custom_tool_call", "computer")] * 3,
                        )

                def pump(self, seconds):
                    return True

                def show(self):
                    if self.is_b:
                        return "DONE\n" + (
                            "To continue this session, run codex resume bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb\n"
                            if self.closed
                            else ""
                        )
                    return "FAILED\n"

                def paste(self, text):
                    pass

                def send(self, text):
                    if text == "\x03":
                        self.closed = True

                def close(self):
                    self.closed = True

            orig_screen, orig_sessions, orig_home = bench._screen, bench.CODEX_SESSIONS, bench.HOME
            try:
                bench._screen = lambda: FakeScreen
                bench.HOME = fake_home
                bench.CODEX_SESSIONS = root
                report_b = bench.drive_codex_tui(prompt, 5, out_b, "codex-native-form-1")
                report_a = bench.drive_codex_tui(prompt, 5, out_a, "codex-native-form-1")
            finally:
                bench._screen, bench.HOME, bench.CODEX_SESSIONS = orig_screen, orig_home, orig_sessions

            self.assertEqual(len(seen_cwds), 2)
            self.assertNotEqual(seen_cwds[0], seen_cwds[1])
            for cwd in seen_cwds:
                self.assertTrue(os.path.realpath(cwd).startswith(os.path.realpath(fake_home) + os.sep))
            self.assertEqual(report_b["tools"], {"computer": 3})
            self.assertEqual(report_b["session"], "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb")
            self.assertEqual(report_a["tools"], {})
            self.assertIsNone(report_a["session"])
            sleeps, tries = [], []

            def retry_drive():
                tries.append(1)
                return dict(tools=report_a["tools"], notes=[])

            bench.run_attempts(retry_drive, attempts=2, pause=1, sleep=sleeps.append)
            self.assertEqual(len(tries), 2)
            self.assertEqual(sleeps, [1])


class RelativeCodexHomeTests(unittest.TestCase):
    def test_relative_codex_home_resolves_once_and_passes_absolute_to_both_launchers(self):
        with tempfile.TemporaryDirectory() as caller_cwd, tempfile.TemporaryDirectory() as fake_home, tempfile.TemporaryDirectory() as out:
            rel = ".codex-rel"
            expected_abs = os.path.realpath(os.path.join(caller_cwd, rel))
            os.makedirs(expected_abs, exist_ok=True)
            cfg = os.path.join(expected_abs, "config.toml")
            with open(cfg, "w", encoding="utf-8") as f:
                f.write('[mcp_servers.cua-driver]\ncommand = "x"\n[mcp_servers.extra]\ncommand = "y"\n')

            resolved = bench.resolve_codex_home(rel, cwd=caller_cwd)
            self.assertEqual(os.path.realpath(resolved), expected_abs)
            self.assertTrue(os.path.isabs(resolved))

            seen_popen = {}

            class FakeProc:
                returncode = 0

                def wait(self, timeout=None):
                    return 0

            def fake_popen(argv, **kw):
                seen_popen["cwd"] = kw.get("cwd")
                seen_popen["env"] = kw.get("env")
                return FakeProc()

            seen_tui = {}

            class FakeScreen:
                def __init__(self, argv, cwd, rows=50, cols=130, env=None):
                    seen_tui["cwd"] = cwd
                    seen_tui["env"] = env

                def pump(self, seconds):
                    return True

                def show(self):
                    return "DONE\n"

                def paste(self, text):
                    pass

                def send(self, text):
                    pass

                def close(self):
                    pass

            saved = (bench.CODEX_HOME, bench.CODEX_CONFIG, bench.CODEX_SESSIONS, bench.HOME, bench._screen)
            try:
                bench.CODEX_HOME = resolved
                bench.CODEX_CONFIG = os.path.join(resolved, "config.toml")
                bench.CODEX_SESSIONS = os.path.join(resolved, "sessions")
                bench.HOME = fake_home
                bench._screen = lambda: FakeScreen

                with mock.patch.dict(os.environ, {"CODEX_HOME": rel}), mock.patch("subprocess.Popen", side_effect=fake_popen):
                    bench.drive_codex("codex-cua", "P", 5, out, "c-form-1")
                    self.assertEqual(os.path.realpath(seen_popen["env"]["CODEX_HOME"]), expected_abs)
                    self.assertNotEqual(os.path.realpath(seen_popen["cwd"]), expected_abs)

                    bench.drive_codex_tui("P", 5, out, "t-form-1")
                    self.assertEqual(os.path.realpath(seen_tui["env"]["CODEX_HOME"]), expected_abs)
                    self.assertTrue(os.path.realpath(seen_tui["cwd"]).startswith(os.path.realpath(fake_home)))
            finally:
                bench.CODEX_HOME, bench.CODEX_CONFIG, bench.CODEX_SESSIONS, bench.HOME, bench._screen = saved

    def test_tui_screen_preserves_passed_env_and_strips_claude_vars(self):
        fake_pyte = types.SimpleNamespace(Screen=lambda cols, rows: None, ByteStream=lambda s: None)
        tui_path = os.path.join(skill_dir, "scripts", "tui.py")
        tui_loader = importlib.machinery.SourceFileLoader("tui_test_mod", tui_path)
        tui_spec = importlib.util.spec_from_loader("tui_test_mod", tui_loader)
        tui_mod = importlib.util.module_from_spec(tui_spec)
        with mock.patch.dict(sys.modules, {"pyte": fake_pyte}):
            tui_loader.exec_module(tui_mod)
        captured = {}

        def fake_fork():
            return 0, 99

        def fake_execvpe(cmd, argv, env):
            captured["cmd"] = cmd
            captured["env"] = env
            raise RuntimeError("stop child")

        with mock.patch.object(tui_mod.pty, "fork", side_effect=fake_fork), mock.patch.object(tui_mod.os, "chdir"), mock.patch.object(tui_mod.os, "execvpe", side_effect=fake_execvpe):
            with self.assertRaises(RuntimeError):
                tui_mod.Screen(
                    ["codex"],
                    work,
                    env={"CODEX_HOME": "/abs/codex", "CLAUDECODE": "1", "ANTHROPIC_API_KEY": "secret"},
                )
        self.assertEqual(captured["env"]["CODEX_HOME"], "/abs/codex")
        self.assertEqual(captured["env"]["TERM"], "xterm-256color")
        self.assertNotIn("CLAUDECODE", captured["env"])
        self.assertNotIn("ANTHROPIC_API_KEY", captured["env"])


class RecoveredCodexRateLimitTests(unittest.TestCase):
    def test_recovered_429_followed_by_turn_completed_is_not_redoable(self):
        with tempfile.TemporaryDirectory() as d:
            log = os.path.join(d, "recovered.jsonl")
            events = [
                {"type": "error", "message": "HTTP 429 rate limit exceeded, retrying..."},
                {"type": "item.completed", "item": {"type": "agent_message", "text": "FAILED"}},
                {"type": "turn.completed", "usage": {"input_tokens": 120, "cached_input_tokens": 20, "output_tokens": 15}},
            ]
            with open(log, "w", encoding="utf-8") as f:
                f.write("\n".join(json.dumps(e) for e in events) + "\n")
            report = bench.codex_report(log)
            self.assertNotIn("codex limit", report["notes"])
            self.assertIn("codex rate limit recovered", report["notes"])
            self.assertEqual(report["final"], "FAILED")
            row = dict(arm="codex-cua", setup="codex-cua", model="gpt-6.1-terra", task="form", seed=1, passed=False, started=100.0, **report)
            self.assertFalse(bench.usage_limited(row))
            later_pass = dict(row, passed=True, started=200.0, notes=[])
            self.assertEqual(len(bench.latest_runs([row, later_pass])), 1)
            # Without folder/usage_limited replacement, later started replaces earlier; with earlier order, kept as latest.
            kept = bench.latest_runs([dict(row, started=200.0), dict(row, started=100.0, passed=True, notes=[])])
            self.assertFalse(kept[0]["passed"])

    def test_terminal_rate_limit_after_earlier_turn_is_still_caught(self):
        with tempfile.TemporaryDirectory() as d:
            log = os.path.join(d, "terminal.jsonl")
            events = [
                {"type": "turn.completed", "usage": {"input_tokens": 50, "cached_input_tokens": 0, "output_tokens": 5}},
                {"type": "error", "message": "You've hit your usage limit. Try again later."},
                {"type": "turn.failed", "error": {"message": "aborted"}},
            ]
            with open(log, "w", encoding="utf-8") as f:
                f.write("\n".join(json.dumps(e) for e in events) + "\n")
            report = bench.codex_report(log)
            self.assertIn("codex limit", report["notes"])
            self.assertTrue(bench.usage_limited(dict(passed=False, notes=report["notes"])))

    def test_rollout_recovered_rate_limit_clears_limit_reached(self):
        with tempfile.TemporaryDirectory() as root, tempfile.TemporaryDirectory() as home:
            t0 = time.time() - 60
            sid = "cdcdcdcd-cdcd-cdcd-cdcd-cdcdcdcdcdcd"
            def tok(inp, cached, out, reached=None):
                return json.dumps(
                    {
                        "type": "event_msg",
                        "payload": {
                            "type": "token_count",
                            "info": {"total_token_usage": {"input_tokens": inp, "cached_input_tokens": cached, "output_tokens": out}},
                            "rate_limits": {"rate_limit_reached_type": reached},
                        },
                    }
                )

            write_rollout(
                root,
                f"r-{sid}.jsonl",
                session_id=sid,
                cwd=home,
                created=t0 + 1,
                prompt="P",
                extra_lines=[tok(10, 0, 1, "primary"), tok(50, 10, 5, None)],
            )
            _, info = bench.find_rollout(t0, session_id=sid, cwd=home, root=root)
            self.assertFalse(info["limit_reached"])


class SetupTests(unittest.TestCase):
    def test_parse_setup_defaults_and_labels(self):
        self.assertEqual(bench.parse_setup("claude-cua"), ("claude-cua", "claude-sonnet-5-5", None, "claude-cua"))
        self.assertEqual(
            bench.parse_setup("claude-cua:claude-opus-5-5@high"),
            ("claude-cua", "claude-opus-5-5", "high", "claude-cua-claude-opus-5-5-high"),
        )
        self.assertEqual(bench.parse_setup("codex-native"), ("codex-native", "gpt-6.1-terra", "high", "codex-native"))
        self.assertEqual(
            bench.parse_setup("codex-native:gpt-6.1-sol@medium"),
            ("codex-native", "gpt-6.1-sol", "medium", "codex-native-gpt-6.1-sol-medium"),
        )
        self.assertEqual(bench.parse_setup("antigravity-cua"), ("antigravity-cua", "gemini-4-neon-high", None, "antigravity-cua"))
        self.assertEqual(
            bench.parse_setup("antigravity-cua:gemini-4-hydrogen-high")[1:],
            ("gemini-4-hydrogen-high", None, "antigravity-cua-gemini-4-hydrogen-high"),
        )
        self.assertEqual(bench.provider("antigravity-cua"), "antigravity")
        self.assertEqual(bench.provider("codex-native"), "codex")

