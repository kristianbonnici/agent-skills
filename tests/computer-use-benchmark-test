    def test_timed_out_group_ignoring_sigterm_is_killed(self):
        p = subprocess.Popen(["/bin/sh", "-c", "trap '' TERM; sleep 30"], start_new_session=True)
        time.sleep(0.3)
        started = time.time()
        bench.end_group(p, wait=0.5)
        self.assertEqual(p.returncode, -signal.SIGKILL)
        self.assertLess(time.time() - started, 5)
        with tempfile.TemporaryDirectory() as d:
            pidfile = os.path.join(d, "child")
            p = subprocess.Popen(
                ["/bin/sh", "-c", f"/bin/sh -c 'trap \"\" TERM; echo $$ > {pidfile}; exec sleep 30' & wait"],
                start_new_session=True,
            )
            for _ in range(50):
                if os.path.exists(pidfile) and read(pidfile).strip():
                    break
                time.sleep(0.05)
            child = int(read(pidfile))
            bench.end_group(p, wait=0.5)
            for _ in range(50):
                try:
                    os.kill(child, 0)
                except ProcessLookupError:
                    break
                time.sleep(0.05)
            with self.assertRaises(ProcessLookupError):
                os.kill(child, 0)

