                bench.run_batch(
                    u_out_a,
                    [bench.parse_setup("codex-cua")],
                    ["form"],
                    [1],
                    quiet=True,
                    check_cua=lambda: "ok",
                    describe_fn=lambda t, s: "desc",
                    bench_cls=UntaggedResumeBench,
                    driver_fn=lambda *a, **kw: lambda: dict(
                        started=300.0,
                        wall=2.0,
                        notes=[],
                        tools={"click": 1},
                        usage={"input": 60, "cache_read": 0, "cache_write": 0, "output": 5},
                        final="DONE",
                        images=None,
                    ),
                )
                bench.record_run(u_out_a, u_data, name="u-snap-2")
                for u_rows in (
                    bench.load_folders([], u_data),
                    bench.load_folders([os.path.join(u_data, "runs", "u-snap-2"), os.path.join(u_data, "runs", "u-snap-1")], u_data),
                ):
                    u_latest = bench.latest_runs(u_rows)
                    self.assertEqual(len(u_latest), 1)
                    self.assertTrue(u_latest[0]["passed"])
                    self.assertEqual(u_latest[0]["wall"], 5.0)
                    self.assertEqual(u_latest[0]["usage"]["input"], 160)
                    self.assertEqual(u_latest[0]["attempts"], 2)

                # Separate batch folder u_out_b must NOT inherit u-snap-1's untagged stopped cost.
                bench.run_batch(
                    u_out_b,
                    [bench.parse_setup("codex-cua")],
                    ["form"],
                    [1],
                    quiet=True,
                    check_cua=lambda: "ok",
                    describe_fn=lambda t, s: "desc",
                    bench_cls=UntaggedResumeBench,
                    driver_fn=lambda *a, **kw: lambda: dict(
                        started=400.0,
                        wall=1.5,
                        notes=[],
                        tools={"click": 1},
                        usage={"input": 40, "cache_read": 0, "cache_write": 0, "output": 5},
                        final="DONE",
                        images=None,
                    ),
                )
                u_cross = bench.latest_runs(bench.load_folders([os.path.join(u_data, "runs", "u-snap-1"), u_out_b], u_data))
                self.assertEqual(len(u_cross), 1)
                self.assertEqual(u_cross[0]["wall"], 1.5)
                self.assertEqual(u_cross[0]["usage"]["input"], 40)
                self.assertEqual(u_cross[0]["attempts"], 1)

                # An untagged complete fail between an untagged stopped row and a later tagged pass cuts off the earlier stopped row.
                untagged_complete = make_row("codex-cua", "codex-cua", "gpt-6.1-terra", "form", 1, False, 150.0, [])
                untagged_complete["effort"] = "high"
                later_tagged_pass = make_row("codex-cua", "codex-cua", "gpt-6.1-terra", "form", 1, True, 300.0, [])
                later_tagged_pass["effort"] = "high"
                later_tagged_pass["wall"] = 2.0
                later_tagged_pass["seconds"] = 2.0
                later_tagged_pass["usage"] = {"input": 60, "cache_read": 0, "cache_write": 0, "output": 5}
                later_tagged_pass["chain_id"] = "tagged-after-complete"
                later_tagged_pass["row_id"] = "row-after-complete"
                with open(os.path.join(u_out_c, "results.jsonl"), "w", encoding="utf-8") as f:
