    def test_drive_claude_and_codex_tui_exit_immediately_on_pty_eof_and_interrupt_closes(self):
        with tempfile.TemporaryDirectory() as fake_home, tempfile.TemporaryDirectory() as out:
            instances = []

            class DeadScreen:
                def __init__(self, argv, cwd, rows=50, cols=130, env=None):
                    self.closed = False
                    self.pumps = 0
                    instances.append(self)

                def pump(self, seconds):
                    self.pumps += 1
                    return False

                def show(self):
                    return ""

                def paste(self, text):
                    raise AssertionError("paste must not be called on dead PTY")

                def send(self, text):
                    raise AssertionError("send must not be called on dead PTY")

                def close(self):
                    self.closed = True

            saved = (bench._screen, bench.HOME)
            try:
                bench._screen = lambda: DeadScreen
                bench.HOME = fake_home
                rep = bench.drive_claude("claude-native", "P", 420, out, "c-eof", overlays=set())
                self.assertIn("claude exited", rep["notes"])
                self.assertNotIn("limit reached", rep["notes"])
                self.assertTrue(instances[-1].closed)
                self.assertEqual(
                    bench.failure_kind(dict(passed=False, notes=rep["notes"], wrong=0, seconds=None, final=None)),
                    "harness-error",
