            finally:
                bench.GEMINI_HOME, bench.HOME = original, home
        with self.assertRaises(SystemExit):
            bench.parse_setup("opencode-cua:opencode/x@high")
        self.assertEqual(bench.parse_setup("opencode-cua:opencode/glm")[1], "opencode/glm")
        argv = bench.codex_exec_argv("codex-cua", "gpt-6.1-sol", "medium")
        self.assertEqual(argv[argv.index("-m") + 1], "gpt-6.1-sol")
        self.assertIn('model_reasoning_effort="medium"', argv)
        launched = {}
        for arm, model, effort in (
            ("opencode-cua", "opencode/glm", None),
            ("codex-cua", "gpt-6.1-sol", "medium"),
            ("codex-native", "gpt-6.1-sol", "medium"),
