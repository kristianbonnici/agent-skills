import errno
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import types
import unittest
from unittest import mock

skill_dir = sys.argv[1]
work = os.path.realpath(sys.argv[2])
bench_path = os.path.join(skill_dir, "scripts", "bench")

# Isolate state, cache, and socket before loading bench so module defaults never point at live user folders.
state_dir = os.path.join(work, "agent-skills-state")
cache_dir = os.path.join(work, "cache")
xdg_state = os.path.join(work, "xdg-state")
sock_path = os.path.join(work, "sock", "cua.sock")
os.makedirs(os.path.join(state_dir, ".git"), exist_ok=True)
os.makedirs(cache_dir, exist_ok=True)
os.environ["AGENT_SKILLS_STATE"] = state_dir
os.environ["COMPUTER_USE_BENCHMARK_CACHE"] = cache_dir
os.environ["COMPUTER_USE_BENCHMARK_SOCKET"] = sock_path
os.environ["XDG_STATE_HOME"] = xdg_state
os.environ.pop("GEMINI_HOME", None)

loader = importlib.machinery.SourceFileLoader("bench_mod", bench_path)
spec = importlib.util.spec_from_loader("bench_mod", loader)
bench = importlib.util.module_from_spec(spec)
loader.exec_module(bench)

