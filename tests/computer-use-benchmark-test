                        self.assertEqual(saved_stopped["wall"], 1.2)

            # Force-record with absent dest and pre-existing .backup leaves that backup untouched on post-publish recovery,
            # and refuses when an unresolved journal still exists after failed recovery.
            with tempfile.TemporaryDirectory() as jb_state, tempfile.TemporaryDirectory() as jb_out:
                os.makedirs(os.path.join(jb_state, ".git"))
