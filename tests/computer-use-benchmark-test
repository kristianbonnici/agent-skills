    def test_usage_snapshot_shlex_opencode_go_and_record_force_atomic_totals_versions(self):
        with tempfile.TemporaryDirectory() as tmp_state, tempfile.TemporaryDirectory() as out1, tempfile.TemporaryDirectory() as out2:
            os.makedirs(os.path.join(tmp_state, ".git"))
            data = os.path.join(tmp_state, "computer-use-benchmark")
            os.makedirs(data)
            with open(os.path.join(data, "set.json"), "w", encoding="utf-8") as f:
                json.dump({"version": "1.0", "tasks": ["form"], "seeds": 1}, f)

            seen_cmds = []

            def fake_run(*argv):
                seen_cmds.append(argv)
                if "codex" in argv:
                    return types.SimpleNamespace(returncode=1, stdout="", stderr="boom")
                return types.SimpleNamespace(
                    returncode=0,
                    stdout=json.dumps({"providers": {argv[-1]: {"ok": True}}}),
                    stderr="",
                )

            bench.usage_snapshot("python3 /opt/fake/usage.py --fast", {"opencode_go", "codex"}, out1, "before", run=fake_run)
            self.assertEqual(seen_cmds[0][:3], ("python3", "/opt/fake/usage.py", "--fast"))
            self.assertTrue(any("opencode_go" in c for c in seen_cmds))
            with open(os.path.join(out1, "usage.jsonl"), encoding="utf-8") as f:
                self.assertEqual(len(f.read().splitlines()), 2)

            def make_row(setup, arm, model, task, seed, passed, started, notes=()):
                return {
                    "arm": arm,
                    "setup": setup,
                    "model": model,
                    "effort": None,
                    "task": task,
                    "seed": seed,
                    "passed": passed,
                    "wrong": 0,
                    "seconds": 5.0 if passed else None,
                    "wall": 10.0,
                    "attempts": 1,
                    "tools": {"click": 1},
                    "usage": {"input": 100, "cache_read": 0, "cache_write": 0, "output": 10},
                    "usage_basis": "uncached",
                    "started": started,
                    "notes": list(notes),
                }

            # Initial batch with usage.jsonl and a codex limit row.
            with open(os.path.join(out1, "results.jsonl"), "w", encoding="utf-8") as f:
                f.write(json.dumps(make_row("codex-cua", "codex-cua", "gpt-6.1-terra", "form", 1, False, 100.0, ["codex limit"])) + "\n")
            bench.record_run(out1, data, name="run-a")
            self.assertTrue(os.path.exists(os.path.join(data, "runs", "run-a", "usage.jsonl")))

            # Staging / first-rename / second-rename failures during --force preserve existing run-a cleanly.
            with open(os.path.join(out2, "results.jsonl"), "w", encoding="utf-8") as f:
                f.write(json.dumps(make_row("codex-cua", "codex-cua", "gpt-6.1-terra", "form", 1, True, 200.0)) + "\n")
            real_rename = os.rename
            rename_calls = [0]

            def fail_second_rename(src, dst):
                rename_calls[0] += 1
                if rename_calls[0] == 2:
                    raise OSError(errno.EIO, "simulated second rename crash")
                return real_rename(src, dst)

            with mock.patch("os.rename", side_effect=fail_second_rename):
                with self.assertRaises(OSError):
                    bench.record_run(out2, data, name="run-a", force=True)
            self.assertTrue(os.path.exists(os.path.join(data, "runs", "run-a", "usage.jsonl")))

            # Crash left journaled .run-a.tx.json + .run-a.backup: both totals and non-force record heal it instead of losing/clobbering it.
            run_a_dir = os.path.join(data, "runs", "run-a")
            backup_dir = os.path.join(data, "runs", ".run-a.backup")
            tx_file = os.path.join(data, "runs", ".run-a.tx.json")
            tx_payload = {"version": 1, "run_id": "run-a", "stage": ".run-a.stage.deadbeef", "backup": ".run-a.backup"}
            os.rename(run_a_dir, backup_dir)
            with open(tx_file, "w", encoding="utf-8") as f:
                json.dump(tx_payload, f)
            with self.assertRaises(bench.Refused):
                bench.record_run(out2, data, name="run-a", force=False)
            self.assertTrue(os.path.exists(os.path.join(run_a_dir, "usage.jsonl")))
            self.assertFalse(os.path.exists(backup_dir))
            self.assertFalse(os.path.exists(tx_file))

            os.rename(run_a_dir, backup_dir)
            with open(tx_file, "w", encoding="utf-8") as f:
                json.dump(tx_payload, f)
            healed = bench.load_folders([], data)
            self.assertEqual(len(healed), 1)
            self.assertTrue(os.path.exists(os.path.join(run_a_dir, "usage.jsonl")))
            self.assertFalse(os.path.exists(tx_file))

            # Concurrent/interleaved non-force writers targeting the same name never clobber.
            conc_out = [tempfile.mkdtemp(dir=tmp_state), tempfile.mkdtemp(dir=tmp_state)]
            for idx, co in enumerate(conc_out):
                with open(os.path.join(co, "results.jsonl"), "w", encoding="utf-8") as f:
                    f.write(json.dumps(make_row("codex-cua", "codex-cua", "gpt-6.1-terra", "form", 1, idx == 0, 150.0 + idx)) + "\n")
            barrier = threading.Barrier(2)
            conc_results = []

            def worker(idx):
                barrier.wait()
                try:
                    bench.record_run(conc_out[idx], data, name="run-race")
                    conc_results.append(("ok", idx))
                except bench.Refused:
                    conc_results.append(("refused", idx))

            threads = [threading.Thread(target=worker, args=(i,)) for i in (0, 1)]
            for th in threads:
                th.start()
            for th in threads:
                th.join()
            self.assertEqual(sorted(r[0] for r in conc_results), ["ok", "refused"])
            winner = next(idx for st, idx in conc_results if st == "ok")
            with open(os.path.join(data, "runs", "run-race", "results.jsonl"), encoding="utf-8") as f:
                self.assertEqual(json.loads(f.read().strip())["passed"], winner == 0)
            shutil.rmtree(os.path.join(data, "runs", "run-race"))

            # Successful --force without usage.jsonl removes stale usage.jsonl.
            bench.record_run(out2, data, name="run-a", force=True)
            self.assertFalse(os.path.exists(os.path.join(data, "runs", "run-a", "usage.jsonl")))

            # Re-record run-a (usage-limit) alongside run-b (redo pass) + another batch in Set 2.0 + legacy (no meta.json).
            bench.record_run(out1, data, name="run-a", force=True)
            bench.record_run(out2, data, name="run-b")
            # Dedupes across run-a & run-b within Set 1.0: pass replaces usage-limit, runs == 1 (not 2!).
            with open(os.path.join(data, "set.json"), "w", encoding="utf-8") as f:
