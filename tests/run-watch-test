#!/usr/bin/env python3
"""Checks the long-horizon-orchestrator's run-watch with real processes and made-up session logs:
the two hangs it exists for (a sleeping child at 0% CPU, a blocked stdin read), an approval wait, a
call the harness moved to the background, a Codex task and a stuck non-shell call are flagged; the
benign long calls (a reviewer wait, a reviewer's CLI, a lease-queued build, CPU and GPU benchmarks,
a sleep loop on a background job, a call whose job writes files, a deliberate background server, a
task that isn't running) are not. A lease that holds its turn is judged by its stuck command, a busy
process another call started doesn't hide a hang, a call idle now that worked earlier or holds a
network connection gets a look rather than a kill, and calls started together get no kill. Also: quiet tasks, a blind harness (once), a hog that isn't the
run's (once, and never the run's own busy process), the disk, swap, a password dialog, a stopped
keep-awake and sampler, exact commit, merge and report-back times (once), a missing watch.json, a
usage error, and that it writes nothing in the run folder but its state file. Thresholds are
shrunk through its environment variables, and CPU use is made up by a stand-in ps (no core is
burned), so the whole check takes about ten seconds."""

import json
import re
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone

here = os.path.dirname(os.path.abspath(__file__))
script = os.path.join(here, "..", "skills", "long-horizon-orchestrator", "scripts", "run-watch")
work = os.path.realpath(tempfile.mkdtemp(prefix="run-watch-test."))
started = []


def spawn(cmd, cwd, **kw):
    p = subprocess.Popen(cmd, cwd=cwd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True, **kw)
    started.append(p)
    return p


def stamp(t):
    return datetime.fromtimestamp(t, timezone.utc).isoformat().replace("+00:00", "Z")


def claude_log(worktree, session, entries):
    folder = os.path.join(work, "claude", "projects", "".join(c if c.isalnum() else "-" for c in worktree))
    os.makedirs(folder, exist_ok=True)
    path = os.path.join(folder, session + ".jsonl")
    with open(path, "w") as f:
        for e in entries:
            f.write(json.dumps(e) + "\n")
    return path


def use(cid, name, t, **inp):
    return {"type": "assistant", "timestamp": stamp(t),
            "message": {"content": [{"type": "tool_use", "id": cid, "name": name, "input": inp}]}}


def result(cid, t, text="ok"):
    return {"type": "user", "timestamp": stamp(t),
            "message": {"content": [{"type": "tool_result", "tool_use_id": cid, "content": text}]}}


def git(*args, cwd):
    subprocess.run(["git", "-c", "user.name=t", "-c", "user.email=t@example.com", *args], cwd=cwd,
                   check=True, capture_output=True)


def watch(env, *extra):
    done = subprocess.run([sys.executable, "-I", script, run_dir, *extra], capture_output=True, text=True, env=env, timeout=120)
    assert done.returncode == 0, done.stderr
    return done.stdout.splitlines()


def lines_for(lines, word, task):
    return [line for line in lines if line.startswith(f"{word} {task}")]


try:
    t_launch = time.time() - 30
    run_dir = os.path.join(work, "run")
    os.makedirs(os.path.join(run_dir, "usage"))
    bin_dir = os.path.join(work, "bin")
    os.makedirs(bin_dir)
    elsewhere = os.path.join(work, "elsewhere")
    os.makedirs(elsewhere)
    # A reviewer's CLI and the lease script, each one idle process as the real ones are while they
    # wait; "lease run … -- <command>" holds its turn and runs the command as its child, as lease does.
    for name in ("codex", "lease"):
        path = os.path.join(bin_dir, name)
        open(path, "w").write(f"#!{sys.executable}\nimport subprocess, sys, time\n"
                              "if 'run' in sys.argv and '--' in sys.argv:\n"
                              "    subprocess.run(sys.argv[sys.argv.index('--') + 1:])\n"
                              "time.sleep(600)\n")
        os.chmod(path, 0o755)
    os.symlink("/bin/sleep", os.path.join(bin_dir, "SecurityAgent"))   # a copy of a system binary won't run
    gpu_pids = os.path.join(work, "gpu-pids")
    ioreg = os.path.join(bin_dir, "fake-ioreg")
    open(ioreg, "w").write(
        "#!/bin/sh\n# GPU time that keeps rising, for each pid listed in the file\n"
        f"for pid in $(cat {gpu_pids} 2>/dev/null); do\n"
        "  n=$(python3 -c 'import time; print(time.time_ns())')\n"
        "  printf '+-o AGXDeviceUserClient\\n  {\\n    \"IOUserClientCreator\" = \"pid %s, bench\"\\n"
        "    \"AppUsage\" = ({\"API\"=\"Metal\",\"accumulatedGPUTime\"=%s})\\n  }\\n' \"$pid\" \"$n\"\n"
        "done\n")
    os.chmod(ioreg, 0o755)
    # CPU use is made up, so no core is burned: the real ps, with the CPU time of each pid listed in
    # the file set to its share of a core since it started ("fixed:<seconds>": that much CPU, all of it
    # earlier, and none now).
    cpu_shares = os.path.join(work, "cpu-shares")
    fake_ps = os.path.join(bin_dir, "fake-ps")
    open(fake_ps, "w").write(
        f"#!{sys.executable}\n"
        "import subprocess, sys, time\n"
        f"shares = dict(l.split() for l in open({cpu_shares!r}) if l.strip())\n"
        "out = subprocess.run(['/bin/ps'] + sys.argv[1:], capture_output=True, text=True).stdout\n"
        "for line in out.splitlines():\n"
        "    f = line.split(None, 9)\n"
        "    if 'time=' in ' '.join(sys.argv) and len(f) >= 9 and f[0] in shares:\n"
        "        age = time.time() - time.mktime(time.strptime(' '.join(f[4:9]), '%a %b %d %H:%M:%S %Y'))\n"
        "        fixed = shares[f[0]].startswith('fixed:')\n"
        "        share = 0.0 if fixed else float(shares[f[0]])\n"
        "        cpu = float(shares[f[0]][6:]) if fixed else share * age\n"
        "        f[2], f[3] = f'{share * 100:.1f}', f'{int(cpu // 60)}:{cpu % 60:05.2f}'\n"
        "        line = ' '.join(f)\n"
        "    print(line)\n")
    os.chmod(fake_ps, 0o755)

    # The integration checkout and task A's worktree, with a commit merged into main.
    repo = os.path.join(work, "repo")
    os.makedirs(repo)
    git("init", "-q", "-b", "main", cwd=repo)
    open(os.path.join(repo, "f"), "w").write("1\n")
    git("add", "f", cwd=repo)
    git("commit", "-q", "-m", "start", cwd=repo)
    wt = {t: os.path.join(work, "wt", t) for t in "ABCDEFGHIJKLMNOPQRSTUVWX"}
    git("worktree", "add", "-q", "-b", "task/a", wt["A"], cwd=repo)
    for t, path in wt.items():
        os.makedirs(path, exist_ok=True)
        os.makedirs(os.path.join(run_dir, t), exist_ok=True)
    open(os.path.join(wt["A"], "f"), "w").write("2\n")
    git("commit", "-q", "-am", "the change", cwd=wt["A"])
    git("merge", "-q", "--ff-only", "task/a", cwd=repo)

    # Processes, each started by a "harness" working in the task's worktree.
    t_call = time.time() - 1
    procs = {
        "A": spawn(["sh", "-c", "sleep 600"], wt["A"]),                                 # a sleeping child
        "B": spawn(["cat"], wt["B"], stdin=subprocess.PIPE),                           # a blocked stdin read
        "D": spawn([os.path.join(bin_dir, "codex"), "exec", "review"], wt["D"]),        # a reviewer's CLI
        "E": spawn([os.path.join(bin_dir, "lease"), "acquire", "cpu", "--owner", "E"], wt["E"]),
        "F": spawn(["sleep", "600"], wt["F"]),                                        # a CPU benchmark (made-up CPU)
        "G": spawn(["sleep", "600"], wt["G"]),                                        # a GPU benchmark
        "H": spawn(["sh", "-c", "sleep 600 & bg=$!; while kill -0 $bg; do sleep 0.5; done"], wt["H"]),
        "I": spawn(["sleep", "600"], wt["I"]),
        "K": spawn(["sleep", "600"], wt["K"]),                                        # moved to the background
        "L": spawn(["sleep", "600"], wt["L"]),                                        # a deliberate server
        "M": spawn(["sh", "-c", "sleep 600"], wt["M"]),                                # Codex
        "V": spawn(["sleep", "600"], wt["V"]),                                        # a task that isn't running
        "O": spawn([os.path.join(bin_dir, "lease"), "run", "cpu", "--owner", "O", "--", "sleep", "600"], wt["O"]),
        "P": spawn(["sleep", "600"], wt["P"]),                                        # worked earlier, idle now
        "T": spawn([sys.executable, "-c", "import socket, time; s = socket.socket(); s.bind(('127.0.0.1', 0)); s.listen(); "
                    "c = socket.create_connection(s.getsockname()); a, _ = s.accept(); time.sleep(600)"], wt["T"]),
        "U": spawn(["sleep", "600"], wt["U"]),                                        # two calls started together
        "W": spawn(["sleep", "600"], wt["W"]),                                        # 6 s of work, then a wait
        "X": spawn(["sleep", "600"], wt["X"]),                                        # stuck, beside a finished call
    }
    writer = spawn(["sh", "-c", f"while true; do date >> {os.path.join(run_dir, 'I', 'build.log')}; sleep 0.5; done"], elsewhere)
    open(gpu_pids, "w").write(str(procs["G"].pid))
    hog = spawn(["sleep", "600"], elsewhere)                                          # not the run's (made-up CPU)
    open(cpu_shares, "w").write(f"{procs['F'].pid} 1.0\n{hog.pid} 2.0\n{procs['P'].pid} fixed:30\n{procs['W'].pid} fixed:6\n")
    dialog = spawn([os.path.join(bin_dir, "SecurityAgent"), "600"], elsewhere)
    dead = subprocess.Popen(["true"])
    dead.wait()
    sampler = spawn(["sh", "-c", "sleep 600; :", "usage-sampler"], elsewhere)   # sh stays, with the name

    tasks = {}
    for t in wt:
        tasks[t] = {"worktree": wt[t], "harness": "claude-code", "session": f"00000000-0000-4000-8000-0000000000{ord(t):02x}",
                    "branch": f"task/{t.lower()}", "launched": stamp(t_launch), "status": "running", "thread": f"thread-{t}"}
    tasks["N"].update(harness="opencode")
    tasks["M"].update(harness="codex")
    del tasks["M"]["session"]
    tasks["V"].update(status="ready")
    bash = lambda cid, cmd, **kw: use(cid, "Bash", t_call, command=cmd, **kw)
    logs = {
        "A": [bash("a1", "sleep 600")],
        "B": [bash("b1", "cat > /dev/null")],
        "C": [use("c1", "mcp__t3-code__t3_thread_wait", t_call, threadId="reviewer")],
        "D": [bash("d1", "codex exec review")],
        "E": [bash("e1", "lease acquire cpu --owner E && swift build")],
        "F": [bash("f1", "python3 bench.py")],
        "G": [bash("g1", "python3 gpu-bench.py")],
        "H": [bash("h1", "until ! kill -0 $bg; do sleep 5; done")],
        "I": [bash("i1", "sleep 600 # waits on a build that writes its log")],
        "J": [bash("j1", "rm -rf \"$DIR/$name\"")],
        "K": [bash("k1", "eval frames"), result("k1", t_call + 1, "Command running in background with ID: kk1. Output is "
                                                f"being written to: {work}/claude-tmp/kk1.output. You will be notified.")],
        "L": [bash("l1", "server", run_in_background=True), result("l1", t_call + 1, "Command running in background with ID: ll1. "
                                                                    "Output is being written to: /nowhere/ll1.output.")],
        "Q": [bash("q1", "ls"), result("q1", t_call)],
        "R": [use("r1", "mcp__t3-code__t3_thread_send", t_call, message="[long-horizon-orchestrator] run=x task=R status=merged\nbranch=task/r"),
              result("r1", t_call)],
        "S": [use("s1", "mcp__cua-driver__click", t_call, x=1)],
        "V": [bash("v1", "sleep 600")],
        "O": [bash("o1", "lease run cpu --owner O -- trove-sort-eval frames")],
        "P": [bash("p1", "python3 eval.py")],
        "T": [bash("t1", "curl -O https://slow.example/model.bin")],
        "U": [bash("u1", "sleep 600"), bash("u2", "sleep 600 # in parallel")],
        "W": [bash("w1", "python3 fetch.py")],
        "X": [bash("x1", "sleep 600"), use("x2", "Bash", t_call + 1, command="server &"), result("x2", t_call + 2)],
    }
    for t, entries in logs.items():
        claude_log(wt[t], tasks[t]["session"], entries)
    day = time.strftime("%Y/%m/%d", time.localtime())
    codex_dir = os.path.join(work, "codex", "sessions", day)
    os.makedirs(codex_dir)
    with open(os.path.join(codex_dir, "rollout-review.jsonl"), "w") as f:    # a `codex exec` reviewer there first
        f.write(json.dumps({"timestamp": stamp(t_launch - 10), "type": "session_meta",
                            "payload": {"cwd": wt["M"], "originator": "codex_exec", "timestamp": stamp(t_launch - 10)}}) + "\n")
    with open(os.path.join(codex_dir, "rollout-task.jsonl"), "w") as f:
        f.write(json.dumps({"timestamp": stamp(t_launch), "type": "session_meta",
                            "payload": {"cwd": wt["M"], "originator": "T3 Code", "timestamp": stamp(t_launch)}}) + "\n")
        f.write(json.dumps({"timestamp": stamp(t_call), "type": "response_item",
                            "payload": {"type": "function_call", "name": "exec_command", "call_id": "m1",
                                        "arguments": json.dumps({"cmd": "sleep 600"})}}) + "\n")
    # Q: nothing changed for an hour, and nothing of its own runs.
    old = time.time() - 3600
    for path in (wt["Q"], os.path.join(run_dir, "Q"), os.path.dirname(claude_log(wt["Q"], tasks["Q"]["session"], logs["Q"]))):
        for root, dirs, files in os.walk(path):
            for name in files + dirs:
                os.utime(os.path.join(root, name), (old, old))
        os.utime(path, (old, old))

    with open(os.path.join(run_dir, "watch.json"), "w") as f:
        json.dump({"started": stamp(t_launch - 60), "repo": repo, "integration_branch": "main",
                   "keep_awake_pid": dead.pid, "sampler_pid": sampler.pid, "tasks": tasks}, f)
    now = time.time()
    with open(os.path.join(run_dir, "usage", "machine.jsonl"), "w") as f:
        for dt, free in ((-400, 151.0), (-120, 150.0), (-60, 138.0)):
            f.write(json.dumps({"t": datetime.fromtimestamp(now + dt).astimezone().isoformat(), "disk_free_gb": free}) + "\n")

    env = dict(os.environ, CLAUDE_CONFIG_DIR=os.path.join(work, "claude"), CODEX_HOME=os.path.join(work, "codex"),
               RUN_WATCH_HANG_MINUTES="0.05", RUN_WATCH_QUIET_MINUTES="0.5", RUN_WATCH_HOG_MINUTES="0.05",
               RUN_WATCH_SAMPLE_SECONDS="0.5", RUN_WATCH_CALL_START_SECONDS="4", RUN_WATCH_IOREG=ioreg, RUN_WATCH_PS=fake_ps, RUN_WATCH_DISK_FREE_GB="138", RUN_WATCH_SWAP_GB="25",
               CLAUDE_CODE_TMPDIR=os.path.join(work, "tmp"), RUN_WATCH_GROWTH_MB="2", RUN_WATCH_RESIZE_SECONDS="0")
    # task A's Claude Code temp folder, where a session's scratchpad fills up (the disk line names it)
    a_temp = os.path.join(work, "tmp", f"claude-{os.getuid()}", "".join(c if c.isalnum() else "-" for c in wt["A"]))
    os.makedirs(os.path.join(a_temp, "s1", "scratchpad"))
    def fill(name, mb):
        with open(os.path.join(a_temp, "s1", "scratchpad", name), "wb") as f:
            f.write(b"x" * (mb << 20))
    fill("model.bin", 6)
    # a session task A started in its scratch folder: sized too
    a_scratch = os.path.join(work, "tmp", f"claude-{os.getuid()}", "".join(c if c.isalnum() else "-" for c in os.path.join(run_dir, "A", "scratch", "e2e")))
    os.makedirs(os.path.join(a_scratch, "s2", "scratchpad"))
    with open(os.path.join(a_scratch, "s2", "scratchpad", "lib.bin"), "wb") as f:
        f.write(b"x" * (1 << 20))
    before = sorted(os.listdir(run_dir))
    # A's busy server, started by a later call: not A's stuck call's, so its CPU hides nothing.
    time.sleep(5)                                           # past the 4-second "minute" a call's processes start in
    server = spawn(["sleep", "600"], wt["A"])
    with open(cpu_shares, "a") as f:
        f.write(f"{server.pid} 1.0\n")
    time.sleep(3.5)                                         # A's call is past the 3-second "6 minutes"
    out = watch(env)
    text = "\n".join(out)

    # the two hangs, with their process IDs and the kill that stops them
    a = lines_for(out, "hang", "A")
    assert len(a) == 1 and str(procs["A"].pid) in a[0] and f"kill {procs['A'].pid}" in a[0] and "sleep 600" in a[0], text
    assert str(server.pid) not in a[0], text
    # a lease that holds its turn is judged by its command: the stuck command is named, not the lease
    o = lines_for(out, "hang", "O")
    held = subprocess.run(["pgrep", "-P", str(procs["O"].pid)], capture_output=True, text=True).stdout.split()
    assert len(o) == 1 and held and f"kill {held[0]}" in o[0] and f"kill {procs['O'].pid}" not in o[0], (held, text)
    # idle now but busy earlier, or holding a network connection: a look, not a kill
    p = lines_for(out, "idle", "P")
    assert len(p) == 1 and "isn't shown to have used no CPU" in p[0] and "kill" not in p[0] and not lines_for(out, "hang", "P"), text
    w = lines_for(out, "idle", "W")                         # 6 s of CPU earlier: not shown idle, though its average is low
    assert len(w) == 1 and "kill" not in w[0] and not lines_for(out, "hang", "W"), text
    tn = lines_for(out, "idle", "T")
    assert len(tn) == 1 and "network connection" in tn[0] and not lines_for(out, "hang", "T"), text
    # two calls started together, or a stuck call beside another (finished) call: no kill offered
    u = lines_for(out, "hang", "U")
    assert len(u) == 2 and all("another call started within a minute" in line and "kill" not in line for line in u), text
    x = lines_for(out, "hang", "X")
    assert len(x) == 1 and "another call started within a minute" in x[0] and "kill" not in x[0], text
    b = lines_for(out, "hang", "B")
    assert len(b) == 1 and str(procs["B"].pid) in b[0] and "cat > /dev/null" in b[0], text
    # an approval wait: a shell call with no process; a call moved to the background on its timeout;
    # a Codex task's command; a stuck non-shell call
    assert len(lines_for(out, "approval", "J")) == 1, text
    assert len(lines_for(out, "hang", "K")) == 1 and str(procs["K"].pid) in lines_for(out, "hang", "K")[0], text
    assert len(lines_for(out, "hang", "M")) == 1 and str(procs["M"].pid) in lines_for(out, "hang", "M")[0], text
    assert len(lines_for(out, "hang", "S")) == 1 and "mcp__cua-driver__click" in lines_for(out, "hang", "S")[0], text
    # the benign long calls: reviewer waits, a lease queue, CPU and GPU benchmarks, a sleep loop, a
    # job writing its log, a deliberate background server, a task that isn't running
    for t in "CDEFGHILRV":
        assert not [line for line in out if line.split(":")[0].split(" ")[:2] in (["hang", t], ["approval", t], ["quiet", t])], (t, text)
    # quiet, blind once, hog once (and never the run's own busy benchmark)
    assert len(lines_for(out, "quiet", "Q")) == 1, text
    assert len(lines_for(out, "blind", "N")) == 1, text
    assert [line for line in out if line.startswith(f"hog {hog.pid} ")], text
    assert not [line for line in out if line.startswith(f"hog {procs['F'].pid} ")], text
    # the machine
    assert any(line.startswith("disk: free disk fell 12.0 GB") and f"largest of the tasks' folders: {a_temp} 6 MB" in line
               for line in out), text
    assert any(line.startswith("swap: 25.0 GB") for line in out), text
    assert any(line.startswith("dialog:") and str(dialog.pid) in line for line in out), text
    assert any(line.startswith(f"keep-awake: caffeinate pid {dead.pid}") for line in out), text
    assert not any(line.startswith("sampler:") for line in out), text
    # exact times, once
    head = subprocess.run(["git", "-C", wt["A"], "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
    assert any(line.startswith("commit A ") and head[:10] in line and "the change" in line for line in out), text
    assert any(line.startswith("merged A ") and head[:10] in line and "into main" in line for line in out), text
    assert any(line.startswith("report R ") and "status=merged" in line for line in out), text
    # it writes only its state file, and adds the time lines to times.log
    assert sorted(os.listdir(run_dir)) == sorted(before + ["run-watch.state.json", "times.log"]), os.listdir(run_dir)
    times = open(os.path.join(run_dir, "times.log")).read().splitlines()
    assert times == [line for line in out if line.split(" ")[0] in ("commit", "merged", "report")] and len(times) >= 3, times

    # The second run: hangs are said again; what was told once (blind, hog, a fall, times) isn't.
    out2 = watch(env)
    text2 = "\n".join(out2)
    assert len(lines_for(out2, "hang", "A")) == 1 and len(lines_for(out2, "hang", "B")) == 1, text2
    for word in ("blind", f"hog {hog.pid} ", "commit", "merged", "report", "disk: free disk fell"):
        assert not [line for line in out2 if line.startswith(word)], (word, text2)
    assert open(os.path.join(run_dir, "times.log")).read().splitlines() == times   # nothing new to add
    # times.log can't be written: a note, and the time is printed (and tried) again on the next wake
    times_path = os.path.join(run_dir, "times.log")
    os.rename(times_path, times_path + ".kept")
    os.makedirs(times_path)
    git("commit", "-q", "--allow-empty", "-m", "another change", cwd=wt["A"])
    failed = watch(env)
    assert [l for l in failed if l.startswith("commit A ") and "another change" in l], failed
    assert [l for l in failed if l.startswith("note: couldn't add the times")], failed
    os.rmdir(times_path)
    os.rename(times_path + ".kept", times_path)
    retried = watch(env)
    assert [l for l in retried if l.startswith("commit A ") and "another change" in l], retried
    assert "another change" in open(times_path).read().splitlines()[-1]

    # the sampler stops: its line; a stdin read that ended: no hang
    os.killpg(sampler.pid, signal.SIGTERM)
    procs["B"].stdin.close()
    procs["B"].wait()
    fill("build.bin", 3)                                   # the scratchpad grew by 3 MB since the last disk line
    out3 = watch(dict(env, RUN_WATCH_DISK_FREE_GB="15"))
    assert any(line.startswith("disk: 15.0 GB free, below 20 GB") and f"grew most: {a_temp} +3 MB since" in line
               and "now 9 MB" in line for line in out3), out3
    sized = json.load(open(os.path.join(run_dir, "run-watch.state.json")))["folders"]
    assert sized.get(a_scratch, [0, 0])[1] >= 1024, sized
    # while disk only stays low, the folders aren't sized again within 10 minutes (the real interval)
    low = dict(env, RUN_WATCH_DISK_FREE_GB="15")
    del low["RUN_WATCH_RESIZE_SECONDS"]
    again = [l for l in watch(low) if l.startswith("disk:")]
    assert again and not any("grew most" in l or "largest" in l for l in again), again
    # a malformed folder record in the state is ignored, not a crash
    state_path = os.path.join(run_dir, "run-watch.state.json")
    for bad in ("x", {"p": [1]}, None):
        st = json.load(open(state_path))
        st["folders"], st["folders_sized"] = bad, 0
        json.dump(st, open(state_path, "w"))
        assert any(l.startswith("disk:") and "tasks' folders" in l or "grew most" in l for l in watch(low))
    assert any(line.startswith(f"sampler: the usage sampler (pid {sampler.pid})") for line in out3), out3
    assert not lines_for(out3, "hang", "B"), out3
    # after three runs, A's process still has its first sample (older than the 3-second window) in the state
    kept = [v for k, v in json.load(open(os.path.join(run_dir, "run-watch.state.json")))["samples"].items()
            if k.startswith(f"{procs['A'].pid}@")]
    assert kept and kept[0][-1][0] - kept[0][0][0] >= 3, kept

    # no watch.json: a note, and the machine checks still run; a usage error
    os.remove(os.path.join(run_dir, "watch.json"))
    out4 = watch(env)
    assert out4[0].startswith("note: no readable") and any(line.startswith("swap:") for line in out4), out4
    # runs far more often than the window (here 30 s) keep the first sample until one is that old
    state_path = os.path.join(run_dir, "run-watch.state.json")
    def a_samples():
        return next(v for k, v in json.load(open(state_path))["samples"].items() if k.startswith(f"{procs['A'].pid}@"))
    often = dict(env, RUN_WATCH_HANG_MINUTES="0.5", RUN_WATCH_HOG_MINUTES="0.5")
    watch(often)
    first = a_samples()[0]
    for _ in range(8):
        watch(often)
    assert a_samples()[0] == first and len(a_samples()) <= 9, a_samples()
    bad = subprocess.run([sys.executable, "-I", script], capture_output=True, text=True)
    assert bad.returncode == 2 and "Usage" in bad.stderr, bad.stderr
    bad = subprocess.run([sys.executable, "-I", script, os.path.join(work, "missing")], capture_output=True, text=True)
    assert bad.returncode == 2, bad.stderr

    # A virtual machine started since the run began is named on every wake; a sleep from pmset's log once,
    # into times.log too; a sleep with no full wake after it says this wake is a dark wake.
    vm_run = os.path.join(work, "vm-run")
    os.makedirs(vm_run)
    json.dump({"started": stamp(time.time() - 3 * 3600), "tasks": {}}, open(os.path.join(vm_run, "watch.json"), "w"))
    # a stand-in VM: a program named like QEMU (a copy of /bin/sleep is stopped by macOS, so it is built)
    qemu = os.path.join(bin_dir, "qemu-system-aarch64")
    has_cc = shutil.which("cc") is not None
    if has_cc:
        open(qemu + ".c", "w").write("#include <unistd.h>\nint main(void) { sleep(60); return 0; }\n")
        has_cc = subprocess.run(["cc", "-o", qemu, qemu + ".c"], capture_output=True).returncode == 0
    if has_cc:
        spawn([qemu], work)
        time.sleep(0.5)
    def pm(t):
        return datetime.fromtimestamp(t).astimezone().strftime("%Y-%m-%d %H:%M:%S %z")
    t_sleep = time.time() - 2 * 3600
    pmset = os.path.join(bin_dir, "fake-pmset")
    log_lines = [f"{pm(t_sleep)} Sleep               \tEntering Sleep state due to 'Software Sleep pid=419':TCPKeepAlive=active",
                 f"{pm(t_sleep + 900)} DarkWake            \tDarkWake from Deep Idle [CDNP] : due to rtc",
                 f"{pm(t_sleep + 960)} Sleep               \tEntering Sleep state due to 'Maintenance Sleep'",
                 f"{pm(t_sleep + 900)} Wake Requests       \t[process=powerd request=UserWake]",
                 f"{pm(t_sleep + 5400)} Wake                \tWake from Normal Sleep [CDNVA] : due to UserActivity"]
    open(os.path.join(work, "pmset.log"), "w").write("\n".join(log_lines) + "\n")
    open(pmset, "w").write(f"#!/bin/sh\ncat {os.path.join(work, 'pmset.log')}\n")
    os.chmod(pmset, 0o755)
    vm_env = dict(env, RUN_WATCH_PMSET=pmset)
    first = subprocess.run([sys.executable, "-I", script, vm_run], capture_output=True, text=True, env=vm_env).stdout.splitlines()
    assert not has_cc or any(l.startswith("vm ") and "qemu-system-aarc" in l and "GB" in l for l in first), first
    slept = [l for l in first if l.startswith("slept ")]
    assert len(slept) == 1 and "(Software Sleep pid=419): 90 min" in slept[0], first
    logged = open(os.path.join(vm_run, "times.log")).read().splitlines()
    assert len(logged) == 1 and re.fullmatch(r"slept \S+T\d\d:\d\d:\d\d\S* \S+T\d\d:\d\d:\d\d\S* \(Software Sleep pid=419\)", logged[0]), logged
    again = subprocess.run([sys.executable, "-I", script, vm_run], capture_output=True, text=True, env=vm_env).stdout.splitlines()
    assert (not has_cc or any(l.startswith("vm ") and "still running" in l for l in again)) and not any(l.startswith("slept ") for l in again), again
    with open(os.path.join(work, "pmset.log"), "a") as f:
        f.write(f"{pm(time.time() - 600)} Sleep               \tEntering Sleep state due to 'Clamshell Sleep'\n")
    dark = subprocess.run([sys.executable, "-I", script, vm_run], capture_output=True, text=True, env=vm_env).stdout.splitlines()
    assert any(l.startswith("slept ") and " - (Clamshell Sleep)" in l and "dark wake" in l for l in dark), dark
    # a second sleep whose times.log append fails is told again next time, and only it, not the first
    log_lines.append(f"{pm(t_sleep + 6000)} Sleep               \tEntering Sleep state due to 'Maintenance Sleep'")
    log_lines.append(f"{pm(t_sleep + 6600)} Wake                \tWake from Normal Sleep [CDNVA] : due to UserActivity")
    open(os.path.join(work, "pmset.log"), "w").write("\n".join(log_lines) + "\n")
    os.rename(os.path.join(vm_run, "times.log"), os.path.join(vm_run, "times.kept"))
    os.mkdir(os.path.join(vm_run, "times.log"))
    failed = subprocess.run([sys.executable, "-I", script, vm_run], capture_output=True, text=True, env=vm_env).stdout.splitlines()
    assert any(l.startswith("note: couldn't add the sleeps") for l in failed), failed
    os.rmdir(os.path.join(vm_run, "times.log"))
    retold = [l for l in subprocess.run([sys.executable, "-I", script, vm_run], capture_output=True, text=True, env=vm_env).stdout.splitlines()
              if l.startswith("slept ") and " - (" not in l]
    assert len(retold) == 1 and "(Maintenance Sleep)" in retold[0], retold
    # a blind task leaves the blind list once it has a log of a harness run-watch reads
    watch_json = os.path.join(vm_run, "watch.json")
    wt_g = os.path.join(work, "wt-g")
    os.makedirs(wt_g, exist_ok=True)
    w = json.load(open(watch_json))
    w["tasks"] = {"G": {"worktree": wt_g, "harness": "opencode", "status": "running", "launched": stamp(time.time() - 60)}}
    json.dump(w, open(watch_json, "w"))
    subprocess.run([sys.executable, "-I", script, vm_run], capture_output=True, text=True, env=vm_env)
    state_file = os.path.join(vm_run, "run-watch.state.json")
    assert "G" in json.load(open(state_file))["blind"]
    w["tasks"]["G"].update(harness="claude-code", session_log=claude_log(wt_g, "g1", [use("x1", "Read", time.time() - 30), result("x1", time.time() - 29)]))
    json.dump(w, open(watch_json, "w"))
    subprocess.run([sys.executable, "-I", script, vm_run], capture_output=True, text=True, env=vm_env)
    assert "G" not in json.load(open(state_file))["blind"], json.load(open(state_file))["blind"]
    # a task whose log run-watch can't parse (another harness) is blind from the start, even with a log
    w["tasks"]["H"] = {"worktree": wt_g, "harness": "opencode", "status": "running", "launched": stamp(time.time() - 60),
                       "session_log": w["tasks"]["G"]["session_log"]}
    json.dump(w, open(watch_json, "w"))
    out_h = subprocess.run([sys.executable, "-I", script, vm_run], capture_output=True, text=True, env=vm_env).stdout.splitlines()
    assert any(l.startswith("blind H") for l in out_h) and "H" in json.load(open(state_file))["blind"], out_h
finally:
    for p in started:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except OSError:
            pass
        try:
            p.wait(timeout=5)
        except Exception:
            pass
    shutil.rmtree(work, ignore_errors=True)

print("run-watch: ok")
