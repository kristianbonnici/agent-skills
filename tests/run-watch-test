        "AG15": {"worktree": ag_wt["AG15"], "harness": "antigravity", "thread": "mcp:launch:ag15", "status": "running", "launched": stamp(old_ag)},
    }
    ag_watch = os.path.join(ag_run, "watch.json")
    json.dump({"started": stamp(old_ag), "tasks": ag_tasks}, open(ag_watch, "w"))
    ag_out1 = subprocess.run([sys.executable, "-I", script, ag_run], capture_output=True, text=True, env=ag_env, timeout=120)
    assert ag_out1.returncode == 0 and "Traceback" not in ag_out1.stderr, (ag_out1.returncode, ag_out1.stderr)
    ag_lines1 = ag_out1.stdout.splitlines()
    ag_text1 = "\n".join(ag_lines1)
    ag_state1 = json.load(open(os.path.join(ag_run, "run-watch.state.json")))
    # Active WAL prevents false quiet on AG1; stale DB+WAL emits quiet on AG2; busy process prevents quiet on AG3;
    # missing active DB (AG11) and driver-null/provider-only active row (AG15) stay blind rather than attaching to old idle DB;
    # symlinked -wal (AG13) does not suppress quiet.
    assert not lines_for(ag_lines1, "quiet", "AG1") and not lines_for(ag_lines1, "blind", "AG1"), ag_text1
    assert len(lines_for(ag_lines1, "quiet", "AG2")) == 1 and "log last written" in lines_for(ag_lines1, "quiet", "AG2")[0], ag_text1
    assert not lines_for(ag_lines1, "quiet", "AG3") and not lines_for(ag_lines1, "blind", "AG3"), ag_text1
    assert len(lines_for(ag_lines1, "quiet", "AG11")) == 1 and "log last written" not in lines_for(ag_lines1, "quiet", "AG11")[0], ag_text1
    assert len(lines_for(ag_lines1, "quiet", "AG15")) == 1 and "log last written" not in lines_for(ag_lines1, "quiet", "AG15")[0], ag_text1
    assert len(lines_for(ag_lines1, "quiet", "AG13")) == 1 and "log last written" in lines_for(ag_lines1, "quiet", "AG13")[0], ag_text1
    assert sorted(ag_state1["blind"]) == ["AG11", "AG12", "AG15", "AG6", "AG7", "AG8", "AG9"], ag_state1
    for t in ("AG1", "AG2", "AG3", "AG4", "AG5", "AG13"):
        assert not any(lines_for(ag_lines1, w, t) for w in ("hang", "idle", "approval", "blind")), (t, ag_text1)
    for t in ("AG6", "AG7", "AG8", "AG9", "AG11", "AG12", "AG15"):
        assert len(lines_for(ag_lines1, "blind", t)) == 1, (t, ag_text1)
        assert t not in ag_state1["sessions"], (t, ag_state1["sessions"])
    assert ag_state1["sessions"]["AG1"].endswith("ag1-active-uuid.db"), ag_state1["sessions"]
    assert ag_state1["sessions"]["AG5"] == custom_db, ag_state1["sessions"]

    # Once AG6's DB appears on a later wake, AG6 leaves blind cleanly
    make_ag_db(os.path.join(ag_conv, "ag6-missing-uuid.db"), time.time())
    ag_out2 = subprocess.run([sys.executable, "-I", script, ag_run], capture_output=True, text=True, env=ag_env, timeout=120)
    assert ag_out2.returncode == 0, ag_out2.stderr
    ag_state2 = json.load(open(os.path.join(ag_run, "run-watch.state.json")))
    assert sorted(ag_state2["blind"]) == ["AG11", "AG12", "AG15", "AG7", "AG8", "AG9"], ag_state2

    # Truly locked statev2.sqlite (rollback journal + BEGIN EXCLUSIVE blocking readers):
    # - un-remembered AG14 (with existing DB committed in statev2) fails read and goes blind;
    # - valid remembered AG1 stays tracked via fallback;
    # - poisoned symlink path in remembered AG2 is rejected by valid_antigravity_discovered_db.
    make_ag_db(os.path.join(ag_conv, "ag14-uuid.db"), time.time())
    con = sqlite3.connect(state_db)
    con.execute(
        "INSERT INTO orchestration_v2_projection_provider_threads "
        "(provider_thread_id, thread_id, provider, status, updated_at, payload_json, driver, provider_instance_id) "
        "VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
        ("pt-14", "mcp:launch:ag14", "antigravity", "active", "2026-11-22T10:05:00Z",
         json.dumps({"nativeThreadRef": {"driver": "antigravity", "nativeId": "ag14-uuid"}}), "antigravity", "antigravity"),
    )
    con.commit()
    con.close()
    os.makedirs(os.path.join(work, "wt-ag", "AG14"), exist_ok=True)
    os.makedirs(os.path.join(ag_run, "AG14"), exist_ok=True)
    ag_tasks["AG14"] = {"worktree": os.path.join(work, "wt-ag", "AG14"), "harness": "antigravity",
                        "thread": "mcp:launch:ag14", "status": "running", "launched": stamp(time.time())}
    json.dump({"started": stamp(old_ag), "tasks": ag_tasks}, open(ag_watch, "w"))
    ag_state_path = os.path.join(ag_run, "run-watch.state.json")
    poison = json.load(open(ag_state_path))
    poison["sessions"]["AG2"] = os.path.join(ag_conv, "ag9-symlink.db")
    json.dump(poison, open(ag_state_path, "w"))

    lock_con = sqlite3.connect(state_db, isolation_level=None)
    lock_con.execute("PRAGMA journal_mode=DELETE")
    lock_con.execute("BEGIN EXCLUSIVE")
    try:
        probe = sqlite3.connect(f"file:{state_db}?mode=ro", uri=True, timeout=0.05)
        try:
            try:
                probe.execute("SELECT 1 FROM orchestration_v2_projection_provider_threads LIMIT 1").fetchall()
                raise AssertionError("read-only probe succeeded under EXCLUSIVE rollback lock")
            except sqlite3.OperationalError:
                pass
        finally:
            probe.close()
        ag_locked = subprocess.run([sys.executable, "-I", script, ag_run], capture_output=True, text=True, env=ag_env, timeout=120)
        assert ag_locked.returncode == 0 and "Traceback" not in ag_locked.stderr, (ag_locked.returncode, ag_locked.stderr)
        ag_locked_state = json.load(open(ag_state_path))
        assert "AG1" not in ag_locked_state["blind"] and ag_locked_state["sessions"]["AG1"].endswith("ag1-active-uuid.db"), ag_locked_state
        assert "AG14" in ag_locked_state["blind"] and "AG14" not in ag_locked_state["sessions"], ag_locked_state
        assert "AG2" in ag_locked_state["blind"] and "AG2" not in ag_locked_state["sessions"], ag_locked_state
    finally:
        lock_con.rollback()
        lock_con.close()
    del ag_tasks["AG14"]

    # Read-only T3_USERDATA &immutable=1 fallback: when mode=ro fails without -shm in a 0o555 dir and the
    # checkpointed main DB only has an active row lacking nativeThreadRef, a valid remembered DB is preserved.
    ro_t3 = os.path.join(work, "ro-t3")
    ro_run = os.path.join(work, "ro-run")
    ro_conv = os.path.join(ro_t3, "providers", "antigravity", "prof-ro", "antigravity-acp", "conversations")
    ro_wt = os.path.join(work, "wt-ag", "RO1")
    os.makedirs(ro_conv)
    os.makedirs(os.path.join(ro_run, "RO1"))
    os.makedirs(ro_wt, exist_ok=True)
    make_ag_db(os.path.join(ro_conv, "ro1-remembered-uuid.db"), time.time())
    ro_db = os.path.join(ro_t3, "statev2.sqlite")
    ro_con = sqlite3.connect(ro_db)
    ro_con.execute("PRAGMA journal_mode=WAL")
    ro_con.execute(
        "CREATE TABLE orchestration_v2_projection_provider_threads ("
        "provider_thread_id TEXT PRIMARY KEY, thread_id TEXT, provider TEXT NOT NULL, "
        "status TEXT NOT NULL, updated_at TEXT NOT NULL, payload_json TEXT NOT NULL, driver TEXT)"
    )
    ro_con.execute(
        "INSERT INTO orchestration_v2_projection_provider_threads VALUES (?, ?, ?, ?, ?, ?, ?)",
        ("pt-ro1", "mcp:launch:ro1", "antigravity", "active", "2026-11-22T10:05:00Z",
         json.dumps({"nativeThreadRef": {"driver": "antigravity", "nativeId": "ro1-remembered-uuid"}}), "antigravity"),
    )
    ro_con.commit()
    ro_con.close()
    ro_env = dict(ag_env, T3_USERDATA=ro_t3)
    json.dump({"started": stamp(old_ag), "tasks": {
        "RO1": {"worktree": ro_wt, "harness": "antigravity", "thread": "mcp:launch:ro1", "status": "running", "launched": stamp(old_ag)},
    }}, open(os.path.join(ro_run, "watch.json"), "w"))
    ro_seed = subprocess.run([sys.executable, "-I", script, ro_run], capture_output=True, text=True, env=ro_env, timeout=120)
    assert ro_seed.returncode == 0 and "RO1" not in json.load(open(os.path.join(ro_run, "run-watch.state.json")))["blind"], ro_seed.stderr
    ro_con = sqlite3.connect(ro_db)
    ro_con.execute(
        "UPDATE orchestration_v2_projection_provider_threads SET payload_json = ? WHERE provider_thread_id = ?",
        (json.dumps({"nativeThreadRef": None}), "pt-ro1"),
    )
    ro_con.commit()
    ro_con.execute("PRAGMA wal_checkpoint(TRUNCATE)")
    ro_con.close()
    for sfx in ("-shm", "-wal"):
        if os.path.exists(ro_db + sfx):
            os.remove(ro_db + sfx)
    os.chmod(ro_t3, 0o555)
    try:
        ro_probe = sqlite3.connect(f"file:{ro_db}?mode=ro", uri=True, timeout=0.05)
        try:
            try:
                ro_probe.execute("SELECT 1 FROM orchestration_v2_projection_provider_threads LIMIT 1").fetchall()
                raise AssertionError("mode=ro succeeded without -shm in 0o555 dir")
            except sqlite3.OperationalError:
                pass
        finally:
            ro_probe.close()
        ro_res = subprocess.run([sys.executable, "-I", script, ro_run], capture_output=True, text=True, env=ro_env, timeout=120)
        assert ro_res.returncode == 0 and "Traceback" not in ro_res.stderr, (ro_res.returncode, ro_res.stderr)
        ro_state = json.load(open(os.path.join(ro_run, "run-watch.state.json")))
        assert "RO1" not in ro_state["blind"] and ro_state["sessions"]["RO1"].endswith("ro1-remembered-uuid.db"), ro_state
    finally:
        os.chmod(ro_t3, 0o755)

    # Missing statev2.sqlite falls back cleanly to blind for thread-mapped tasks without creating the database
    for suffix in ("", "-wal", "-shm"):
        if os.path.exists(state_db + suffix):
            os.remove(state_db + suffix)
    os.makedirs(os.path.join(work, "wt-ag", "AG10"), exist_ok=True)
    os.makedirs(os.path.join(ag_run, "AG10"), exist_ok=True)
    ag_tasks["AG10"] = {"worktree": os.path.join(work, "wt-ag", "AG10"), "harness": "antigravity",
                        "thread": "mcp:launch:ag10", "status": "running", "launched": stamp(time.time())}
    json.dump({"started": stamp(old_ag), "tasks": ag_tasks}, open(ag_watch, "w"))
    ag_out3 = subprocess.run([sys.executable, "-I", script, ag_run], capture_output=True, text=True, env=ag_env, timeout=120)
    assert ag_out3.returncode == 0 and "Traceback" not in ag_out3.stderr, (ag_out3.returncode, ag_out3.stderr)
    assert len(lines_for(ag_out3.stdout.splitlines(), "blind", "AG10")) == 1, ag_out3.stdout
    ag_state3 = json.load(open(os.path.join(ag_run, "run-watch.state.json")))
    for t in ("AG1", "AG2", "AG3", "AG10"):
        assert t in ag_state3["blind"], (t, ag_state3["blind"])
    for t in ("AG4", "AG5"):
        assert t not in ag_state3["blind"], (t, ag_state3["blind"])
    assert not os.path.exists(state_db), "run-watch created statev2.sqlite"
    # The orchestrator's own checks (L-4FVR, L-XAYK, the watcher): the owner's settings against their snapshot,
    # once for each new value, a long, structured or secret-looking value as <changed>, a snapshot that can't be
    # read; the next-run line only once nothing is queued and no running task works in the waiting run's
    # repository or holds a lease it needs, at the finish whatever runs, and never once "started"; a watcher
    # that isn't running.
    import plistlib
    o_run = os.path.join(work, "own-run")
    os.makedirs(os.path.join(o_run, "owner"))
    plistlib.dump({"readingSpeed": 1.4, "windowSection": "appearance", "notch": {"x": 1}, "apiToken": "a",
                   "long": "x" * 10, "same": True}, open(os.path.join(o_run, "owner", "app.plist"), "wb"))
    current = os.path.join(work, "own-defaults.plist")
    plistlib.dump({"readingSpeed": 1, "windowSection": "highlight", "notch": {"x": 2}, "apiToken": "b",
                   "long": "y" * 60, "same": True, "added": "k3Jd8sLq0Zp2Xv7Rt5Yw9"}, open(current, "wb"), fmt=plistlib.FMT_XML)
    fake_defaults = os.path.join(bin_dir, "fake-defaults")
    open(fake_defaults, "w").write(f"#!/bin/sh\n[ \"$2\" = com.example.app ] || {{ echo \"Domain $2 does not exist\" >&2; exit 1; }}\ncat {current}\n")
    os.chmod(fake_defaults, 0o755)
    o_env = dict(env, RUN_WATCH_DEFAULTS=fake_defaults)
    o_watch = {"started": stamp(time.time() - 60), "repo": repo, "integration_branch": "main", "tasks": {},
               "owner_defaults": [{"domain": "com.example.app", "snapshot": "owner/app.plist"},
                                  {"domain": "com.example.app", "snapshot": "owner/app.plist", "keys": ["same", "readingSpeed"]},
                                  {"domain": "com.example.gone", "snapshot": "owner/missing.plist"}]}
    json.dump(o_watch, open(os.path.join(o_run, "watch.json"), "w"))

    def own(**kw):
        done = subprocess.run([sys.executable, "-I", script, o_run], capture_output=True, text=True, env=dict(o_env, **kw), timeout=120)
        assert done.returncode == 0 and "Traceback" not in done.stderr, done.stderr
        return done.stdout.splitlines()

    first = own()
    s = sorted(l for l in first if l.startswith("settings "))
    assert "settings com.example.app: readingSpeed 1.4→1" in s, s
    assert s.count("settings com.example.app: readingSpeed 1.4→1") == 1, s      # two entries name it, one line
    for want in ("windowSection appearance→highlight", "notch <changed>→<changed>", "apiToken <changed>→<changed>",
                 "long xxxxxxxxxx→<changed>", "added (none)→<changed>"):
        assert f"settings com.example.app: {want}" in s, (want, s)
    assert not any("same" in l for l in s), s
    assert any(l.startswith("settings com.example.gone: not compared: its snapshot") for l in s), s
    assert not any(l.startswith(("next-run", "watcher")) for l in first), first
    again = own()
    assert not any(l.startswith("settings ") for l in again), again                  # once each
    plistlib.dump({"readingSpeed": 1.6, "windowSection": "highlight", "notch": {"x": 2}, "apiToken": "b",
                   "long": "y" * 60, "same": True, "added": "k3Jd8sLq0Zp2Xv7Rt5Yw9"}, open(current, "wb"))
    third = [l for l in own() if l.startswith("settings ")]
    assert third == ["settings com.example.app: readingSpeed 1.4→1.6"], third        # a new value is told again
    plistlib.dump({"readingSpeed": 1.4, "windowSection": "appearance", "notch": {"x": 1}, "apiToken": "a",
                   "long": "x" * 10, "same": True}, open(current, "wb"))
    assert not any(l.startswith("settings com.example.app") for l in own())        # restored: nothing
    del o_watch["owner_defaults"]

    # next-run: B works in the waiting run's repository; C holds the screen it needs, in the shared lease folder
    other_repo = os.path.join(work, "other-repo")
    os.makedirs(other_repo)
    git("init", "-q", "-b", "main", cwd=other_repo)
    leases = os.path.join(work, "shared-leases")
    os.makedirs(os.path.join(leases, "locks"))
    json.dump({"leases": {"screen": [{"owner": "app-C", "slots": 1, "expires": time.time() + 600, "since": time.time()}]}},
              open(os.path.join(leases, "locks", "state.json"), "w"))
    o_watch["tasks"] = {"B": {"worktree": wt["A"], "status": "running"}, "C": {"worktree": other_repo + "-none", "status": "running"}}
    o_watch["next_run"] = {"thread": "thread-next", "repo": repo, "needs": ["screen"], "leases": leases}
    o_watch["queued"] = []
    json.dump(o_watch, open(os.path.join(o_run, "watch.json"), "w"))
    assert not any(l.startswith("next-run") for l in own()), "B works in its repository"
    o_watch["next_run"]["repo"] = other_repo
    json.dump(o_watch, open(os.path.join(o_run, "watch.json"), "w"))
    assert not any(l.startswith("next-run") for l in own()), "C holds the screen"
    json.dump({"leases": {"screen": [{"owner": "app-C", "slots": 1, "expires": time.time() - 5, "since": time.time() - 900}]}},
              open(os.path.join(leases, "locks", "state.json"), "w"))
    o_watch["queued"] = ["E"]
    json.dump(o_watch, open(os.path.join(o_run, "watch.json"), "w"))
    assert not any(l.startswith("next-run") for l in own()), "E is still queued"
    del o_watch["queued"]
    json.dump(o_watch, open(os.path.join(o_run, "watch.json"), "w"))
    assert not any(l.startswith("next-run") for l in own()), "no queued list: not known to be down to its last tasks"
    o_watch["queued"] = []
    json.dump(o_watch, open(os.path.join(o_run, "watch.json"), "w"))
    nr = [l for l in own() if l.startswith("next-run")]
    assert len(nr) == 1 and nr[0].startswith("next-run thread-next: ") and "B, C" in nr[0], nr
    assert len([l for l in own() if l.startswith("next-run")]) == 1, "every wake until started"
    o_watch["next_run"]["repo"] = repo
    o_watch["finished"] = stamp(time.time())
    json.dump(o_watch, open(os.path.join(o_run, "watch.json"), "w"))
    nr = [l for l in own() if l.startswith("next-run")]
    assert len(nr) == 1 and "this run is finishing" in nr[0], nr                      # at the finish whatever runs
    o_watch["next_run"]["started"] = stamp(time.time())
    del o_watch["finished"]
    json.dump(o_watch, open(os.path.join(o_run, "watch.json"), "w"))
    assert not any(l.startswith("next-run") for l in own()), "started: no line"

    # watcher: none running, then one running (its pid file), then gone
    o_watch["watcher"] = "background"
    json.dump(o_watch, open(os.path.join(o_run, "watch.json"), "w"))
    w = [l for l in own() if l.startswith("watcher")]
    assert len(w) == 1 and "watch-wait isn't running" in w[0], w
    fake_watcher = spawn(["sh", "-c", "sleep 600; :", "watch-wait"], elsewhere)   # sh stays, with the name
    open(os.path.join(o_run, "watch-wait.pid"), "w").write(f"{fake_watcher.pid}\n")
    time.sleep(0.3)
    assert not any(l.startswith("watcher") for l in own()), "a running watcher"
    os.killpg(fake_watcher.pid, signal.SIGKILL)
    fake_watcher.wait()
    w = [l for l in own() if l.startswith("watcher")]
    assert len(w) == 1 and f"pid {fake_watcher.pid} is gone" in w[0], w

finally:
    for p in started:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except OSError:
            pass
        try:
            p.wait(timeout=5)
        except Exception:
            pass
    shutil.rmtree(work, ignore_errors=True)

print("run-watch: ok")
