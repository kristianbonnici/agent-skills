import json, os, sys
from datetime import datetime
folder, name, stamp = sys.argv[1:4]
def event(when, used, warning):
    info = {"status": "allowed_warning" if warning else "allowed", "unifiedWindows": {
        "five_hour": {"utilization": 0.11, "resetsAt": 1893456000, "status": "allowed"},
        "seven_day": {"utilization": used, "resetsAt": 1893456000, "status": "allowed"}}}
    if warning:
        info["overageEnabled"] = False
    body = {"provider": "claudeAgent", "payload": {"type": "rate_limit_event", "rate_limit_info": info, "uuid": "u", "session_id": "s"}}
    return f"[{when}] NATIVE: " + json.dumps(body, separators=(",", ":"))
rows = [event(*row.split(",")[:1], float(row.split(",")[1]), row.endswith("warning")) for row in sys.argv[4:]]
path = os.path.join(folder, name)
open(path, "w").write("\n".join(rows) + "\n")
moment = datetime.fromisoformat(stamp).timestamp()
os.utime(path, (moment, moment))
EOF
