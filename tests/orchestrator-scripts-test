#!/bin/sh
# Checks the long-horizon-orchestrator's helper scripts: lease, run-charts with its run map and usage panel, and usage-sampler.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
scripts="$repo_root/skills/long-horizon-orchestrator/scripts"
work=$(mktemp -d "${TMPDIR:-/tmp}/orchestrator-scripts-test.XXXXXX")
background=""
trap 'for pid in $background; do kill "$pid" 2>/dev/null || true; done; rm -rf "$work"' EXIT HUP INT TERM

# Waits until "lease status" in the run folder $1 shows the text $2.
wait_for_status() {
  tries=0
  until "$1/bin/lease" status | grep -q "$2"; do
    tries=$((tries + 1))
    test "$tries" -lt 50
    sleep 0.1
  done
}

# lease: turns, a timed-out wait, release, run, an unknown resource, and a turn's end.
run="$work/run"
mkdir -p "$run/bin"
cp "$scripts/lease" "$run/bin/lease"
printf '%s\n' '{"screen": {"slots": 1, "max_minutes": 15}, "gpu": {"slots": 2, "max_minutes": 30}}' > "$run/leases.json"
lease="$run/bin/lease"

"$lease" acquire screen --owner A >/dev/null
status=0
"$lease" acquire screen --owner B --wait-minutes 0.01 >/dev/null || status=$?
test "$status" -eq 75
"$lease" acquire screen --owner A >/dev/null            # the same owner renews
"$lease" release screen --owner A >/dev/null
"$lease" acquire screen --owner B --wait-minutes 0.01 >/dev/null
"$lease" status | grep -q '"owner": "B"'
"$lease" release screen --owner B >/dev/null

"$lease" acquire gpu --owner A >/dev/null
"$lease" acquire gpu --owner B >/dev/null                # two slots
status=0
"$lease" acquire gpu --owner C --all --wait-minutes 0.01 >/dev/null || status=$?
test "$status" -eq 75
"$lease" release gpu --owner A >/dev/null
"$lease" release gpu --owner B >/dev/null
"$lease" run gpu --owner C --all -- sh -c 'exit 3' >/dev/null || status=$?
test "$status" -eq 3
"$lease" acquire gpu --owner D --wait-minutes 0.01 >/dev/null   # run released it
"$lease" release gpu --owner D >/dev/null

status=0
"$lease" acquire printer --owner A >/dev/null 2>&1 || status=$?
test "$status" -eq 2

# lease: with nobody waiting a renewal goes on; once someone waits, a renewal past the turn
# releases the lease (76) and the waiter gets it.
run2="$work/run2"
mkdir -p "$run2/bin"
cp "$scripts/lease" "$run2/bin/lease"
printf '%s\n' '{"screen": {"slots": 1, "max_minutes": 15, "turn_minutes": 0.001}}' > "$run2/leases.json"
lease2="$run2/bin/lease"
"$lease2" acquire screen --owner A >/dev/null
sleep 0.2
"$lease2" acquire screen --owner A >/dev/null            # past its turn, but nobody waits
"$lease2" acquire screen --owner B --wait-minutes 1 >/dev/null &
waiter=$!
background="$background $waiter"
wait_for_status "$run2" '"screen:B"'
status=0
"$lease2" acquire screen --owner A >/dev/null 2>&1 || status=$?
test "$status" -eq 76
wait "$waiter"                                           # B got the screen
"$lease2" status | grep -q '"owner": "B"'
"$lease2" status | grep -q '"held_minutes"'

# lease: a renewal while someone waits lasts only to the end of the turn; a resource's own
# wait_minutes is the default wait; a stopped "run" stops its command and releases the lease.
run3="$work/run3"
mkdir -p "$run3/bin"
cp "$scripts/lease" "$run3/bin/lease"
printf '%s\n' '{"screen": {"slots": 1, "max_minutes": 15, "turn_minutes": 2}, "printer": {"slots": 1, "max_minutes": 5, "wait_minutes": 0.01}}' > "$run3/leases.json"
lease3="$run3/bin/lease"
"$lease3" acquire screen --owner A --minutes 15 >/dev/null
"$lease3" acquire screen --owner B --wait-minutes 1 >/dev/null &
waiter=$!
background="$background $waiter"
wait_for_status "$run3" '"screen:B"'
"$lease3" acquire screen --owner A --minutes 15 | grep -q -E 'for up to (1\.9|2) min'
kill "$waiter"
"$lease3" release screen --owner A >/dev/null

"$lease3" acquire printer --owner A >/dev/null
status=0
"$lease3" acquire printer --owner B >/dev/null || status=$?
test "$status" -eq 75
"$lease3" release printer --owner A >/dev/null

"$lease3" run printer --owner C -- sh -c 'echo $$ > "$1"; exec sleep 30' sh "$run3/child.pid" >/dev/null &
runner=$!
background="$background $runner"
wait_for_status "$run3" '"owner": "C"'
tries=0
until test -s "$run3/child.pid"; do tries=$((tries + 1)); test "$tries" -lt 50; sleep 0.1; done
kill -TERM "$runner"
status=0
wait "$runner" || status=$?
test "$status" -eq 143
if kill -0 "$(cat "$run3/child.pid")" 2>/dev/null; then exit 1; fi
if "$lease3" status | grep -q '"owner": "C"'; then exit 1; fi

# lease: a screen that needs the owner away, against a fake ioreg whose answers come from the file
# "owner" beside it ("<idle seconds|none> <locked|unlocked|garbage>"). Acquire waits, in queue order,
# until the screen is unlocked and the owner idle long enough; check tells a holder the owner came
# back; an unreadable state counts as not away.
run4="$work/run4"
mkdir -p "$run4/bin" "$run4/fake"
cp "$scripts/lease" "$run4/bin/lease"
printf '%s\n' '{"screen": {"slots": 1, "max_minutes": 15, "needs_owner_away_seconds": 300}, "gpu": {"slots": 1, "max_minutes": 30}, "camera": {"slots": 1, "needs_owner_away_seconds": 60, "owner_back_seconds": 120}}' > "$run4/leases.json"
cat > "$run4/fake/ioreg" <<'EOF'
#!/bin/sh
read -r idle lock < "$(dirname "$0")/owner"
case "$*" in
  *IOHIDSystem*) if [ "$idle" != none ]; then printf '    | |   "HIDIdleTime" = %s000000000\n' "$idle"; fi ;;
  *Root*)
    if [ "$lock" = garbage ]; then echo 'not a plist'; exit 1; fi
    printf '<?xml version="1.0" encoding="UTF-8"?>\n<plist version="1.0"><dict><key>IOConsoleUsers</key><array><dict>'
    if [ "$lock" = locked ]; then printf '<key>CGSSessionScreenIsLocked</key><true/>'; fi
    printf '<key>kCGSSessionIDKey</key><integer>257</integer></dict></array></dict></plist>\n' ;;
esac
EOF
chmod +x "$run4/fake/ioreg"
owner() { printf '%s %s\n' "$1" "$2" > "$run4/fake/owner.new"; mv "$run4/fake/owner.new" "$run4/fake/owner"; }
LEASE_IOREG="$run4/fake/ioreg"
export LEASE_IOREG
lease4="$run4/bin/lease"
check4() { status=0; "$lease4" check "$1" --owner "$2" > "$run4/check.out" 2>&1 || status=$?; test "$status" -eq "$3"; }
acquire4() { status=0; "$lease4" acquire "$1" --owner "$2" --wait-minutes 0.01 > "$run4/acquire.out" 2>&1 || status=$?; test "$status" -eq "$3"; }

owner 400 unlocked                                       # away: the screen is taken at once
acquire4 screen A 0
check4 screen A 0
"$lease4" status | grep -q '"idle_seconds": 400'
"$lease4" status | grep -q '"reader": '
grep -q 'owner read with' "$run4/locks/log.txt"
owner 100 unlocked                                       # idle under 300 s but over 30 s: A goes on,
check4 screen A 0                                        # while a newcomer would still wait
owner 5 unlocked                                         # the owner comes back mid-turn
check4 screen A 1
grep -q 'back at the computer' "$run4/check.out"
acquire4 screen A 0                                      # a renewal doesn't look (check does)
owner 400 locked                                         # or the screen locks
check4 screen A 2
owner 400 garbage                                        # or its lock state can't be read
check4 screen A 2
owner none unlocked                                      # or the idle time can't be read
check4 screen A 1
owner 400 unlocked
check4 screen A 0
"$lease4" release screen --owner A >/dev/null
check4 screen A 3                                        # released: no longer A's
check4 gpu A 3
"$lease4" acquire gpu --owner A >/dev/null               # a resource without the key ignores the owner
owner 5 locked
check4 gpu A 0
"$lease4" release gpu --owner A >/dev/null
status=0; "$lease4" check screen > /dev/null 2>&1 || status=$?; test "$status" -eq 64   # usage: not "locked"

owner 100 unlocked                                       # the resource's own thresholds
acquire4 camera A 0
check4 camera A 1
"$lease4" release camera --owner A >/dev/null

owner 100 unlocked                                       # not away long enough: the wait runs out
acquire4 screen B 75
grep -q 'at the computer (idle 100s, need 300s)' "$run4/acquire.out"
owner 900 locked                                         # locked counts as not away, however idle
acquire4 screen B 75
grep -q 'the screen is locked' "$run4/acquire.out"
owner 900 garbage                                        # and so does a state that can't be read
acquire4 screen B 75
owner none unlocked
acquire4 screen B 75
grep -q "idle time can't be read" "$run4/acquire.out"

owner 5 unlocked                                         # B waits first; once the owner is away,
"$lease4" acquire screen --owner B --wait-minutes 1 > "$run4/b.out" &   # C, behind it, doesn't get
waiter_b=$!                                              # the screen
background="$background $waiter_b"
wait_for_status "$run4" '"screen:B"'
owner 7 unlocked
sleep 2.5                                                # a poll with a new idle time says nothing new
owner 300 unlocked
acquire4 screen C 75
wait "$waiter_b"
"$lease4" status | grep -q '"owner": "B"'
test "$(grep -c 'until the owner is away' "$run4/b.out")" -eq 1
"$lease4" release screen --owner B >/dev/null

# A config value that isn't a number of seconds, and an ioreg that isn't there, are refused.
printf '%s\n' '{"screen": {"slots": 1, "needs_owner_away_seconds": true}}' > "$work/run4b.json"
mkdir -p "$work/run4b"
cp "$work/run4b.json" "$work/run4b/leases.json"
status=0
"$lease4" acquire screen --owner A --run "$work/run4b" > /dev/null 2>&1 || status=$?
test "$status" -eq 2
status=0
LEASE_IOREG="$run4/fake/missing" "$lease4" acquire screen --owner A > /dev/null 2>&1 || status=$?
test "$status" -eq 2
check_status=0
LEASE_IOREG="$run4/fake/missing" "$lease4" check screen --owner A > /dev/null 2>&1 || check_status=$?
test "$check_status" -eq 64

# Elsewhere than macOS, without an injected ioreg, a resource that needs the owner away is refused.
for action in acquire check status; do
  status=0
  env -u LEASE_IOREG python3 -I - "$lease4" "$run4" "$action" > "$run4/linux.out" 2>&1 <<'EOF' || status=$?
import runpy, sys
lease, run, action = sys.argv[1:]
sys.platform = "linux"
args = [action] + (["screen", "--owner", "D"] if action != "status" else []) + ["--run", run]
sys.exit(runpy.run_path(lease, run_name="lease")["main"](args))
EOF
  grep -q 'only be told on macOS' "$run4/linux.out"
  case $action in acquire) test "$status" -eq 2 ;; check) test "$status" -eq 64 ;; status) test "$status" -eq 0 ;; esac
done
unset LEASE_IOREG

# run-charts: every edge styled once, merged tasks only reach the branch, stopped and parked
# tasks shown dashed, no bar for a parked task; the run map from the same facts.
mkdir -p "$work/pictures"
python3 -I -c 'import base64, sys; open(sys.argv[1], "wb").write(base64.b64decode("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8DwHwAFBQIAX8jx0gAAAABJRU5ErkJggg=="))' "$work/pictures/a.png"
cat > "$work/facts.json" <<'EOF'
{
  "harness": "Claude Code (T3) · Opus 5.5",
  "orchestrator": "Claude Code (T3) · Opus 5.5 (Extra High)",
  "integration": {"branch": "main", "head": "abc1234"},
  "run": {"start": "00:50", "end": "07:35", "level": "xhigh", "worked_minutes": 25, "wakes": 18},
  "pauses": [{"start": "04:17", "end": "05:55", "reason": "Claude limit"}],
  "tasks": [
    {"id": "A", "name": "Settings screen", "level": "high", "first_wave": true, "status": "merged",
     "helpers": [{"label": "Codex · GPT-6.1 Sol (High)", "did": "screen check ×1"},
                 {"label": "Claude Code · Sonnet 5.5 (High)", "did": "Independent review: 2 fixes", "role": "review"}],
     "summary": "A settings screen with the theme and the shortcut.",
     "turns": [["01:00", "01:20"], ["01:25", "01:35"]],
     "pictures": [{"src": "pictures/a.png", "caption": "The settings screen"}, {"src": "pictures/gone.png", "caption": "Gone"}],
     "launched": "01:00", "ended": "01:35", "worked_minutes": 30},
    {"id": "B1", "name": "Word counts", "level": "xhigh", "first_wave": true, "status": "replaced",
     "note": "crashed twice", "launched": "01:00", "ended": "02:10", "worked_minutes": 62},
    {"id": "B2", "name": "Word counts, second try", "level": "xhigh", "replaces": "B1", "status": "merged",
     "launched": "02:15", "ended": "06:40", "worked_minutes": 50},
    {"id": "C", "name": "Command line", "level": "high", "needs": ["A"], "status": "merged",
     "helpers": [{"label": "OpenCode · Kimi K3 (Max)", "did": "research ×1"},
                 {"label": "Copilot · default (High)", "did": "review ×1"},
                 {"label": "OpenCode · Big Pickle (High)", "did": "research ×1"},
                 {"label": "OpenCode · House model (High)", "did": "research ×1", "maker": "z-ai"}],
     "launched": "01:36", "ended": "01:51", "worked_minutes": 14},
    {"id": "D", "name": "Spell check", "level": "max", "first_wave": true, "status": "blocked",
     "note": "blocked: needs API key", "launched": "01:00", "ended": "03:00", "worked_minutes": 65},
    {"id": "E", "name": "Docs for D", "level": "high", "needs": ["D"], "status": "parked"},
    {"id": "F", "name": "Export", "level": "high", "took_place_of": "A", "status": "stopped",
     "launched": "01:36", "ended": "02:30", "worked_minutes": 41},
    {"id": "QA", "name": "Integration QA", "level": "high", "qa": true, "status": "merged",
     "launched": "06:45", "ended": "07:30", "worked_minutes": 44}
  ]
}
EOF
"$scripts/run-charts" "$work/facts.json" "$work/charts" >"$work/charts.out" 2>"$work/charts.err"
graph="$work/charts/graph.mmd"
timeline="$work/charts/timeline.mmd"

python3 -I - "$graph" <<'EOF'
import re, sys
text = open(sys.argv[1]).read()
edges = [l for l in text.splitlines() if re.match(r"\s+\S+ (-->|--->|==>|-\.->|-\.-|<==>) \S+$", l)]
styled = []
for line in re.findall(r"linkStyle ([\d,]+) ", text):
    styled += [int(i) for i in line.split(",")]
assert sorted(styled) == list(range(len(edges))), (len(edges), sorted(styled))
assert "T_A ---> MAIN" in text and "T_B2 --> MAIN" in text and "T_C --> MAIN" in text
for task in ("T_B1", "T_D", "T_E", "T_F", "T_QA"):
    assert f"{task} --> MAIN" not in text and f"{task} ---> MAIN" not in text, task
assert "MAIN <==> T_QA" in text and "T_A ==> T_C" in text and "T_A -.-> T_F" in text
assert "T_B1 --> T_B2" in text and "class T_D blocked" in text and "class T_B1 replaced" in text
assert ':::parked' in text.split("T_E[")[1].splitlines()[0] and ':::parked' in text.split("T_F[")[1].splitlines()[0]
assert "violet above Extra High" in text and "main<br/>abc1234" in text
EOF

grep -q 'Paused 1h 38m :crit, p1, 04:17, 05:55' "$timeline"
grep -q 'D · Spell check · Max · blocked · 2h 00m, worked 1h 05m :active, d, 01:00, 03:00' "$timeline"
grep -q 'F · Export (took A.s place) · stopped, nothing merged' "$timeline"
grep -q 'QA · Integration QA (after the others merged)' "$timeline"
if grep -q 'Docs for D' "$timeline"; then exit 1; fi
grep -q 'Orchestrator · 6h 45m, worked 25m :whole_run, 00:50, 07:35' "$timeline"
grep -q 'whole run 6h 45m, worked 25m' "$graph"
# A: 30, B1: 62, B2: 50, C: 14, D: 65, F: 41, QA: 44 = 306 minutes; A, B1, D, then C and F at 01:36.
grep -qx 'Run time: 6h 45m (00:50–07:35), including 1h 38m paused for quota. The orchestrator worked 25m over 18 wakes; the tasks worked 5h 06m together, with at most 4 running at once.' "$work/charts/summary.txt"
# a pause that names its tasks left the others working: it names them, and isn't the run's paused time
python3 -I -c 'import json, sys; f = json.load(open(sys.argv[1])); f["pauses"] = [dict(f["pauses"][0], which="B2, F")]; json.dump(f, open(sys.argv[2], "w"))' \
  "$work/facts.json" "$work/facts-some-paused.json"
"$scripts/run-charts" "$work/facts-some-paused.json" "$work/charts-some-paused" >/dev/null 2>&1
head -1 "$work/charts-some-paused/summary.txt" | grep -q '^Run time: 6h 45m (00:50–07:35), with B2 and F paused for quota at times\. '

# run map: the page for html_render is short and names only files that exist; the SVG carries the
# standalone page whole; the data has every time in minutes and every wait, relaunch and state.
grep -q 'gone.png' "$work/charts.err"
grep -q 'run-map-t3.html (.* characters; html_render height ' "$work/charts.out"
python3 -I - "$work/charts" <<'EOF'
import json, os, re, sys
from xml.etree import ElementTree
folder = sys.argv[1]
stub = open(os.path.join(folder, "run-map-t3.html")).read()
page = open(os.path.join(folder, "run-map.html")).read()
assert len(stub) < 4000, len(stub)
files = json.loads(re.search(r"window\.RUN_MAP_FILES = (\[.*?\]);", stub).group(1))
carrier = json.loads(re.search(r"fetch\((\".*?\")\)", stub).group(1))
assert all(os.path.isabs(f) and os.path.exists(f) for f in files + [carrier]), files
assert ElementTree.parse(carrier).getroot().find("{http://www.w3.org/2000/svg}desc").text == page
data = json.loads(re.search(r"const DATA = (\{.*?\});\n", page).group(1))
assert len(data["files"]) == len(files) and "/*DATA*/" not in page
tasks = {t["id"]: t for t in data["tasks"]}
assert tasks["A"]["launched"] == 60 and tasks["A"]["turns"] == [[60, 80], [85, 95]] and data["orch"]["start"] == 50
assert [p["caption"] for p in tasks["A"]["pictures"]] == ["The settings screen"]
assert files[tasks["A"]["pictures"][0]["file"]].endswith("pictures/a.png")
assert [h["title"] for h in tasks["A"]["helpers"]] == ["Helper", "Reviewer"]
assert tasks["A"]["helpers"][0]["model"] == "GPT-6.1 Sol" and files[tasks["A"]["helpers"][0]["mark"]].endswith("openai.svg")
assert tasks["A"]["model"] == "Opus 5.5" and tasks["A"]["harness"] == "Claude Code (T3)" and tasks["A"]["effort"] == "High"
assert tasks["D"]["effort"] == "Max" and tasks["D"]["band"] == "above" and tasks["D"]["status"] == "blocked"
assert tasks["E"]["launched"] is None and tasks["E"]["status"] == "parked" and tasks["C"]["needs"] == ["A"]
assert tasks["F"]["place"] == "A" and tasks["B2"]["replaces"] == "B1" and tasks["QA"]["qa"]
assert data["pauses"][0]["tasks"] == ["B2"] and tasks["B2"]["paused"] == "1h 38m · Claude limit" and not tasks["D"]["paused"]
assert data["integration"]["head"] == "abc1234" and data["turns_missing"]
marks = [files[h["mark"]].rsplit("/", 1)[-1] if h["mark"] is not None else h["letter"] for h in tasks["C"]["helpers"]]
assert marks == ["kimi.svg", "githubcopilot.svg", "B", "zai.svg"], marks
EOF
# the makers' marks: every entry's file is there, clean (paths with one fill), and in the notice
python3 -I - "$repo_root/skills/long-horizon-orchestrator/assets/marks" <<'EOF'
import json, re, sys
from pathlib import Path
from xml.etree import ElementTree
folder = Path(sys.argv[1])
entries = json.loads((folder / "marks.json").read_text())
notice = (folder / "NOTICE.md").read_text()
assert len({e["id"] for e in entries}) == len(entries)
for e in entries:
    for key in ("models", "harnesses"):
        if e.get(key):
            re.compile(e[key])
    root = ElementTree.parse(folder / e["file"]).getroot()
    tags = {el.tag.split("}")[1] for el in root.iter()}
    assert tags <= {"svg", "path"}, (e["file"], tags)
    for el in root.iter():
        assert set(el.attrib) <= {"viewBox", "fill", "fill-rule", "d"}, (e["file"], el.attrib.keys())
    assert f"`{e['file']}`" in notice, e["file"]
assert sorted(p.name for p in folder.glob("*.svg")) == sorted({e["file"] for e in entries})
EOF
if command -v node >/dev/null 2>&1; then
  python3 -I -c 'import re, sys; print(re.search(r"<script>\n(.*)</script>", open(sys.argv[1]).read(), re.S).group(1))' \
    "$work/charts/run-map.html" > "$work/run-map.js"
  node --check "$work/run-map.js"
fi

# run-charts without a usage folder writes none of the usage files and no usage data; naming a folder
# that holds no samples changes nothing either (outputs are the ones above).
test ! -e "$work/charts/usage.mmd" && test ! -e "$work/charts/usage-mac.mmd"
test "$(wc -l < "$work/charts/summary.txt")" -eq 1
python3 -I - "$work/charts/run-map.html" <<'EOF'
import json, re, sys
page = open(sys.argv[1]).read()
assert "usage" not in json.loads(re.search(r"const DATA = (\{.*?\});\n", page).group(1))
EOF
mkdir -p "$work/nousage"
python3 -I -c 'import json, sys; f = json.load(open(sys.argv[1])); f["usage"] = {"folder": sys.argv[2]}; json.dump(f, open(sys.argv[3], "w"))' \
  "$work/facts.json" "$work/nousage" "$work/facts-empty.json"
"$scripts/run-charts" "$work/facts-empty.json" "$work/charts-empty" >"$work/charts-empty.out" 2>"$work/charts-empty.err"
grep -q 'no usage samples' "$work/charts-empty.err"
for name in graph.mmd timeline.mmd summary.txt; do cmp "$work/charts/$name" "$work/charts-empty/$name"; done
test ! -e "$work/charts-empty/usage.mmd"

# run-charts with samples: the Mac's samples averaged and peaked per minute, the subscriptions' windows
# as runs of points with the reset held and then dropped, a stale harness log and a provider with no
# reading in the run left out, the makers' colours, the report line and the Mermaid fallback.
mkdir -p "$work/usage"
python3 -I - "$work/usage" <<'EOF'
import json, os, sys
folder = sys.argv[1]
def line(t, **kw):
    return json.dumps(dict(t="2026-10-29T" + t + "+02:00", **kw))
machine = [
    line("01:00:10", cpu=10.0, load1=1.0, mem_used_gb=30.0, mem_total_gb=64.0, gpu=40, disk_free_gb=100.0),
    line("01:00:40", cpu=30.0, load1=1.0, mem_used_gb=34.0, mem_total_gb=64.0, gpu=60, disk_free_gb=99.0),
    "not json at all",
    line("01:01:20", cpu=50.0, load1=1.0, mem_used_gb=32.0, mem_total_gb=64.0, gpu=50, disk_free_gb=98.5),
    line("07:50:00", cpu=99.0, mem_used_gb=60.0, mem_total_gb=64.0, gpu=99, disk_free_gb=1.0),  # after the run
    '{"t": "2026-10-29T01:02',                                                                # cut off by a write in progress
]
open(os.path.join(folder, "machine.jsonl"), "w").write("\n".join(machine) + "\n")
def providers(t, kind, claude, codex, observed, extra=None):
