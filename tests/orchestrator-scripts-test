# lease: "run cpu" starts its command at low priority with its parallel jobs capped at cores ÷ slots
# (MAKEFLAGS, CARGO_BUILD_JOBS, CMAKE_BUILD_PARALLEL_LEVEL unless set, and a swift wrapper that adds
# --jobs unless the command names it); "jobs" sets the cap; other resources run as they are.
mkdir -p "$run5/fakebin"
printf '%s\n' '#!/bin/sh' 'echo "swift $*"' > "$run5/fakebin/swift"
chmod +x "$run5/fakebin/swift"
printf '%s\n' '{"cpu": {"slots": 2, "max_minutes": 15}, "gpu": {"slots": 1}}' > "$run5/leases.json"
PATH="$run5/fakebin:$PATH" LEASE_CORES=8 MAKEFLAGS= "$lease5" run cpu --owner A -- sh -c \
  'echo "nice $(ps -o nice= -p $$) make [$MAKEFLAGS] cargo $CARGO_BUILD_JOBS cmake $CMAKE_BUILD_PARALLEL_LEVEL"; swift build -c release; swift test --jobs 2; swift run -j1 app; swift --version' \
  > "$run5/cpu.out" 2>&1
base=$(ps -o nice= -p $$ | tr -d ' ')                    # this test may itself run at low priority
low=$(( base > 10 ? base : 10 ))
grep -q "^nice *$low make \\[\\] cargo 4 cmake 4\$" "$run5/cpu.out"   # an empty MAKEFLAGS the command set stays
grep -q '^swift build --jobs 4 -c release$' "$run5/cpu.out"
grep -q '^swift test --jobs 2$' "$run5/cpu.out"
grep -q '^swift run -j1 app$' "$run5/cpu.out"
grep -q '^swift --version$' "$run5/cpu.out"
env -u MAKEFLAGS PATH="$run5/fakebin:$PATH" LEASE_CORES=8 "$lease5" run cpu --owner A -- "$lease5" run cpu --owner B -- sh -c \
  'echo "nice $(ps -o nice= -p $$) make $MAKEFLAGS"; swift build' > "$run5/nested.out" 2>&1
grep -q "^nice *$low make -j4\$" "$run5/nested.out"         # nested: not lower again, one wrapper
grep -q '^swift build --jobs 4$' "$run5/nested.out"
printf '%s\n' '{"cpu": {"slots": 2, "max_minutes": 15, "jobs": 3}, "gpu": {"slots": 1}}' > "$run5/leases.json"
env -u MAKEFLAGS PATH="$run5/fakebin:$PATH" LEASE_CORES=8 "$lease5" run cpu --owner A -- sh -c 'echo "make $MAKEFLAGS"; swift build' > "$run5/cpu.out" 2>&1
grep -q '^make -j3$' "$run5/cpu.out"
grep -q '^swift build --jobs 3$' "$run5/cpu.out"
env -u MAKEFLAGS PATH="$run5/fakebin:$PATH" "$lease5" run gpu --owner A -- sh -c 'echo "nice $(ps -o nice= -p $$) make [${MAKEFLAGS:-}]"; swift build' > "$run5/gpu.out" 2>&1
grep -q "^nice *$base make \\[\\]\$" "$run5/gpu.out"
grep -q '^swift build$' "$run5/gpu.out"

