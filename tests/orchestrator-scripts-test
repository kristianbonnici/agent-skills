# heartbeat: an idle wake is one line ("nothing to act on") and a ledger line; run-watch's findings and a
# task's events say to act; a running Fable task makes the usage reading live.
hb="$work/hb-run"
mkdir -p "$hb/usage"
printf '%s\n' '{"t": "2026-11-11T01:46:00+02:00", "providers": {"claude": {"windows": {"weekly": {"used": 22.0}, "five_hour": {"used": 5.0}}}}}' > "$hb/usage/providers.jsonl"
printf '%s\n' '{"tasks": {"A": {"worktree": "/nowhere", "status": "running", "model": "claude-opus-5-5"}}}' > "$hb/watch.json"
printf '# ledger\n' > "$hb.md"
printf '#!/bin/sh\n' > "$work/hb-ps"   # no processes: a test elsewhere on the machine can't show up as a dialog
chmod +x "$work/hb-ps"
export HEARTBEAT_PS="$work/hb-ps"
# Never the real provider-usage: it would read the owner's own accounts, and its answer would differ
# between computers. A check that needs a reading names its own stand-in.
printf '#!/bin/sh\necho "a heartbeat check read live usage without a stand-in" >&2\nexit 1\n' > "$work/hb-usage-unset"
chmod +x "$work/hb-usage-unset"
export HEARTBEAT_PROVIDER_USAGE="$work/hb-usage-unset"
printf '#!/bin/sh\n' > "$work/hb-watch-quiet"
printf '#!/bin/sh\necho "commit A 2026-11-11T01:50:00+02:00 abc fix"\n' > "$work/hb-watch-event"
printf '#!/bin/sh\necho "hang A: stuck"\n' > "$work/hb-watch-flag"
printf '#!/bin/sh\necho %s\n' "'{\"providers\": {\"claude\": {\"windows\": {\"weekly_fable\": {\"used_percent\": 7}}}}}'" > "$work/hb-usage"
chmod +x "$work/hb-watch-quiet" "$work/hb-watch-event" "$work/hb-watch-flag" "$work/hb-usage"
out=$(HEARTBEAT_RUN_WATCH="$work/hb-watch-quiet" "$scripts/heartbeat" "$hb")
case "$out" in *"nothing to act on"*"running A"*"claude five_hour 5%, weekly 22%"*) ;; *) echo "heartbeat idle: $out"; exit 1;; esac
test "$(printf '%s\n' "$out" | wc -l | tr -d ' ')" -eq 1
grep -q '^- [0-9:]* heartbeat: running A' "$hb.md"
out=$(HEARTBEAT_RUN_WATCH="$work/hb-watch-event" "$scripts/heartbeat" "$hb" --no-ledger)
case "$out" in *"act on the lines below"*"commit A"*) ;; *) echo "heartbeat event: $out"; exit 1;; esac
out=$(HEARTBEAT_RUN_WATCH="$work/hb-watch-flag" "$scripts/heartbeat" "$hb" --no-ledger)
case "$out" in *"act on the lines below"*"hang A: stuck"*) ;; *) echo "heartbeat flag: $out"; exit 1;; esac
test "$(grep -c heartbeat "$hb.md")" -eq 1
printf '%s\n' '{"tasks": {"A": {"worktree": "/nowhere", "status": "running", "model": "claude-fable-5-2"}}}' > "$hb/watch.json"
out=$(HEARTBEAT_RUN_WATCH="$work/hb-watch-quiet" HEARTBEAT_PROVIDER_USAGE="$work/hb-usage" "$scripts/heartbeat" "$hb" --no-ledger)
case "$out" in *"live: claude weekly_fable 7%"*) ;; *) echo "heartbeat fable: $out"; exit 1;; esac
printf '#!/bin/sh\necho %s\n' "'{\"providers\": {\"claude\": {\"windows\": {\"weekly\": {\"used_percent\": 7}}}}}'" > "$work/hb-usage-nofable"
chmod +x "$work/hb-usage-nofable"
out=$(HEARTBEAT_RUN_WATCH="$work/hb-watch-quiet" HEARTBEAT_PROVIDER_USAGE="$work/hb-usage-nofable" "$scripts/heartbeat" "$hb" --no-ledger)
case "$out" in *"act on the lines below"*"no live Fable reading"*) ;; *) echo "heartbeat no fable: $out"; exit 1;; esac
printf '#!/bin/sh\necho %s\n' "'{\"providers\": {}}'" > "$work/hb-usage-empty"
chmod +x "$work/hb-usage-empty"
out=$(HEARTBEAT_RUN_WATCH="$work/hb-watch-quiet" HEARTBEAT_PROVIDER_USAGE="$work/hb-usage-empty" "$scripts/heartbeat" "$hb" --no-ledger --live)
case "$out" in *"act on the lines below"*"the live reading had no windows"*) ;; *) echo "heartbeat empty usage: $out"; exit 1;; esac
# Back to a task that is not on Fable: the checks below read no live usage.
printf '%s\n' '{"tasks": {"A": {"worktree": "/nowhere", "status": "running", "model": "claude-opus-5-5"}}}' > "$hb/watch.json"
printf '#!/bin/sh\necho "slept 2026-11-11T03:12:00+02:00 2026-11-11T05:40:00+02:00 (Clamshell Sleep): 148 min"\n' > "$work/hb-watch-slept"
chmod +x "$work/hb-watch-slept"
out=$(HEARTBEAT_RUN_WATCH="$work/hb-watch-slept" "$scripts/heartbeat" "$hb" --no-ledger)
case "$out" in *"act on the lines below"*"slept 03:12"*) ;; *) echo "heartbeat slept: $out"; exit 1;; esac
printf '#!/bin/sh\nexit 3\n' > "$work/hb-watch-broken"
chmod +x "$work/hb-watch-broken"
out=$(HEARTBEAT_RUN_WATCH="$work/hb-watch-broken" "$scripts/heartbeat" "$hb" --no-ledger)
case "$out" in *"act on the lines below"*"run-watch failed (exit 3)"*) ;; *) echo "heartbeat broken run-watch: $out"; exit 1;; esac
printf '#!/bin/sh\necho "vm 123 qemu-system-aarc: still running, 2.0 GB"\n' > "$work/hb-watch-vm"
chmod +x "$work/hb-watch-vm"
out=$(HEARTBEAT_RUN_WATCH="$work/hb-watch-vm" "$scripts/heartbeat" "$hb" --no-ledger)
case "$out" in *"nothing to act on"*"VMs still running: 123 qemu-system-aarc, 2.0 GB"*) ;; *) echo "heartbeat vm: $out"; exit 1;; esac
printf '%s\n' '{"blind": ["A"]}' > "$hb/run-watch.state.json"
out=$(HEARTBEAT_RUN_WATCH="$work/hb-watch-quiet" "$scripts/heartbeat" "$hb" --no-ledger)
case "$out" in *"act on the lines below"*"blind, read their threads: A"*) ;; *) echo "heartbeat blind: $out"; exit 1;; esac
rm "$hb/run-watch.state.json"
# A test's SecurityAgent stand-in is no dialog; the system's own one, by its path, is.
printf '#!/bin/sh\necho "  4242 /var/folders/xy/T/run-watch-test.abc/bin/SecurityAgent"\n' > "$work/hb-ps-standin"
printf '#!/bin/sh\necho "  4243 /System/Library/Frameworks/Security.framework/Versions/A/MachServices/SecurityAgent.bundle/Contents/MacOS/SecurityAgent"\n' > "$work/hb-ps-dialog"
chmod +x "$work/hb-ps-standin" "$work/hb-ps-dialog"
out=$(HEARTBEAT_PS="$work/hb-ps-standin" HEARTBEAT_RUN_WATCH="$work/hb-watch-quiet" "$scripts/heartbeat" "$hb" --no-ledger)
case "$out" in *"nothing to act on"*) ;; *) echo "heartbeat stand-in dialog: $out"; exit 1;; esac
out=$(HEARTBEAT_PS="$work/hb-ps-dialog" HEARTBEAT_RUN_WATCH="$work/hb-watch-quiet" "$scripts/heartbeat" "$hb" --no-ledger)
case "$out" in *"act on the lines below"*"1 password dialog"*) ;; *) echo "heartbeat real dialog: $out"; exit 1;; esac
printf '%s\n' '{"usage_marks": {"claude.weekly": 22}, "tasks": {"A": {"worktree": "/nowhere", "status": "running"}}}' > "$hb/watch.json"
out=$(HEARTBEAT_RUN_WATCH="$work/hb-watch-quiet" "$scripts/heartbeat" "$hb" --no-ledger)
case "$out" in *"act on the lines below"*"usage: claude weekly at 22%, at or past the run's mark of 22%"*) ;; *) echo "heartbeat mark: $out"; exit 1;; esac
status=0
"$scripts/heartbeat" "$hb" --bogus >/dev/null 2>&1 || status=$?
test "$status" -eq 2
unset HEARTBEAT_PS

echo "orchestrator scripts: ok"
