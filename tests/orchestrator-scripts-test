early = by_title("A ses_early_bad")[0]
assert early["tokens"]["input"] == 700 and "couldn't be read" not in (early.get("missing") or ""), early
assert t["incomplete"]["no price for gpt-6-luna"] == 1, t["incomplete"]   # one thread, however many lines
old, new = by_title("C")[0], by_title("A review new (Terra)")[0]
assert old["tokens"]["input"] + old["tokens"]["cache_read"] == 600 and "isn't counted" in old["missing"], old   # 1000 was its baseline
assert new["tokens"]["input"] + new["tokens"]["cache_read"] == 1600 and not new.get("missing"), new          # a new thread: from zero
assert [l["role"] for l in d["lines"] if l["thread"] == "thread:task-b"] == ["task"], "B counted once, as a task"
assert t["malformed"] >= 1 and "malformed log record" in d["paragraph"] and "(antigravity)" in d["paragraph"], d["paragraph"]
assert d["paragraph"].startswith("Cost at API prices (estimate): $") and "not what the subscriptions cost" in d["paragraph"]
assert "| Task A |" in open(os.path.join(root, "costs.md")).read()
