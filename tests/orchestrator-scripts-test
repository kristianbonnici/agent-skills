log = open(os.environ["FAKE_LOG"], "a")
mode = os.environ["FAKE_MODE"]
log.write(json.dumps({"argv": sys.argv[1:], "cwd": os.getcwd(), "pid": os.getpid()}) + "\n"); log.flush()
def send(m):
    sys.stdout.write(json.dumps(m) + "\n"); sys.stdout.flush()
schema = {"type": "object", "properties": {k: {} for k in ("action", "kind", "title", "text", "original", "source", "id")}}
if mode != "old":
    schema["properties"]["tour"] = {"type": "array"}
for line in sys.stdin:
    m = json.loads(line)
    log.write(json.dumps(m) + "\n"); log.flush()
