assert by_title("A ses_empty")[0]["usd"] == 0.0 and not by_title("A ses_empty")[0].get("missing")
assert by_title("A ses_bad")[0]["usd"] is None, by_title("A ses_bad")
assert by_title("A ses_null")[0]["usd"] is None and "couldn't be read" in by_title("A ses_null")[0]["missing"], by_title("A ses_null")
for sid in ("ses_text", "ses_nocache"):
