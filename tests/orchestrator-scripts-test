# --go-live reads OpenCode Go live even with --cached, which alone stays offline; a failed reading has no windows
python3 -I - "$scripts/provider-usage" <<'EOF'
import contextlib, io, json, runpy, sys
ns = runpy.run_path(sys.argv[1], run_name="provider_usage")
live = ns["main"].__globals__
live["opencode_go_keys"] = lambda: ["key"]
calls = []
def fake(key):
    calls.append(key)
    return {"usage": {name: {"percent": 8, "resetsAt": "2099-01-01T00:00:00.000Z"} for name in ("rolling", "weekly", "monthly")}}
live["go_usage"] = fake
def read(*args):
    sys.argv = ["provider-usage", "--only", "opencode_go", *args]
    out = io.StringIO()
    with contextlib.redirect_stdout(out):
        live["main"]()
    return json.loads(out.getvalue())["providers"]["opencode_go"]
offline = read("--cached")
assert not calls and offline["windows"] == {}, (calls, offline)
assert read("--cached", "--go-live")["windows"]["weekly"]["used_percent"] == 8 and calls == ["key"], calls
def down(key):
    raise OSError("no network")
live["go_usage"] = down
failed = read("--cached", "--go-live")
assert failed["windows"] == {} and "live_error" in failed, failed
EOF
