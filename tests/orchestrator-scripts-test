python3 -I -c 'import json, sys; w = json.load(open(sys.argv[1])); w.pop("orchestrator_thread"); json.dump(w, open(sys.argv[1], "w"))' "$costs/run/watch.json"
T3_USERDATA="$costs/t3" OPENCODE_DB="$costs/opencode.db" "$scripts/run-costs" "$costs/run" --json "$costs/costs-no-orch.json" | grep -q "orchestrator's own tokens are not counted"
python3 -I -c 'import json, sys; f = json.load(open(sys.argv[1])); f["costs"] = {"file": sys.argv[2]}; json.dump(f, open(sys.argv[1], "w"))' "$costs/facts-bad.json" "$costs/costs-no-orch.json"
"$scripts/run-charts" "$costs/facts-bad.json" "$costs/charts-no-orch" >/dev/null 2>&1
grep -q "orchestrator's own tokens are not counted" "$costs/charts-no-orch/run-map.html" && grep -q '"incomplete": true' "$costs/charts-no-orch/run-map.html"
python3 -I - "$costs/charts/run-map.html" <<'EOF'
