#!/bin/sh
# Checks the long-horizon-orchestrator's helper scripts: lease, run-charts with its run map and usage panel, and usage-sampler.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
scripts="$repo_root/skills/long-horizon-orchestrator/scripts"
work=$(mktemp -d "${TMPDIR:-/tmp}/orchestrator-scripts-test.XXXXXX")
background=""
trap 'for pid in $background; do kill "$pid" 2>/dev/null || true; done; rm -rf "$work"' EXIT HUP INT TERM

# Waits until "lease status" in the run folder $1 shows the text $2.
wait_for_status() {
  tries=0
  until "$1/bin/lease" status | grep -q "$2"; do
    tries=$((tries + 1))
    test "$tries" -lt 50
    sleep 0.1
  done
}

# lease: turns, a timed-out wait, release, run, an unknown resource, and a turn's end.
run="$work/run"
mkdir -p "$run/bin"
cp "$scripts/lease" "$run/bin/lease"
printf '%s\n' '{"screen": {"slots": 1, "max_minutes": 15}, "gpu": {"slots": 2, "max_minutes": 30}}' > "$run/leases.json"
lease="$run/bin/lease"

"$lease" acquire screen --owner A >/dev/null
status=0
"$lease" acquire screen --owner B --wait-minutes 0.01 >/dev/null || status=$?
test "$status" -eq 75
"$lease" acquire screen --owner A >/dev/null            # the same owner renews
"$lease" release screen --owner A >/dev/null
"$lease" acquire screen --owner B --wait-minutes 0.01 >/dev/null
"$lease" status | grep -q '"owner": "B"'
"$lease" release screen --owner B >/dev/null

"$lease" acquire gpu --owner A >/dev/null
"$lease" acquire gpu --owner B >/dev/null                # two slots
status=0
"$lease" acquire gpu --owner C --all --wait-minutes 0.01 >/dev/null || status=$?
test "$status" -eq 75
"$lease" release gpu --owner A >/dev/null
"$lease" release gpu --owner B >/dev/null
"$lease" run gpu --owner C --all -- sh -c 'exit 3' >/dev/null || status=$?
test "$status" -eq 3
"$lease" acquire gpu --owner D --wait-minutes 0.01 >/dev/null   # run released it
"$lease" release gpu --owner D >/dev/null

status=0
"$lease" acquire printer --owner A >/dev/null 2>&1 || status=$?
test "$status" -eq 2

# lease: with nobody waiting a renewal goes on; once someone waits, a renewal past the turn
# releases the lease (76) and the waiter gets it.
run2="$work/run2"
mkdir -p "$run2/bin"
cp "$scripts/lease" "$run2/bin/lease"
printf '%s\n' '{"screen": {"slots": 1, "max_minutes": 15, "turn_minutes": 0.001}}' > "$run2/leases.json"
lease2="$run2/bin/lease"
"$lease2" acquire screen --owner A >/dev/null
sleep 0.2
"$lease2" acquire screen --owner A >/dev/null            # past its turn, but nobody waits
"$lease2" acquire screen --owner B --wait-minutes 1 >/dev/null &
waiter=$!
background="$background $waiter"
wait_for_status "$run2" '"screen:B"'
status=0
"$lease2" acquire screen --owner A >/dev/null 2>&1 || status=$?
test "$status" -eq 76
wait "$waiter"                                           # B got the screen
"$lease2" status | grep -q '"owner": "B"'
"$lease2" status | grep -q '"held_minutes"'

# lease: a renewal while someone waits lasts only to the end of the turn; a resource's own
# wait_minutes is the default wait; a stopped "run" stops its command and releases the lease.
run3="$work/run3"
mkdir -p "$run3/bin"
cp "$scripts/lease" "$run3/bin/lease"
printf '%s\n' '{"screen": {"slots": 1, "max_minutes": 15, "turn_minutes": 2}, "printer": {"slots": 1, "max_minutes": 5, "wait_minutes": 0.01}}' > "$run3/leases.json"
lease3="$run3/bin/lease"
"$lease3" acquire screen --owner A --minutes 15 >/dev/null
"$lease3" acquire screen --owner B --wait-minutes 1 >/dev/null &
waiter=$!
background="$background $waiter"
wait_for_status "$run3" '"screen:B"'
"$lease3" acquire screen --owner A --minutes 15 | grep -q -E 'for up to (1\.9|2) min'
kill "$waiter"
"$lease3" release screen --owner A >/dev/null

"$lease3" acquire printer --owner A >/dev/null
status=0
"$lease3" acquire printer --owner B >/dev/null || status=$?
test "$status" -eq 75
"$lease3" release printer --owner A >/dev/null

"$lease3" run printer --owner C -- sh -c 'echo $$ > "$1"; exec sleep 30' sh "$run3/child.pid" >/dev/null &
runner=$!
background="$background $runner"
wait_for_status "$run3" '"owner": "C"'
tries=0
until test -s "$run3/child.pid"; do tries=$((tries + 1)); test "$tries" -lt 50; sleep 0.1; done
kill -TERM "$runner"
status=0
wait "$runner" || status=$?
test "$status" -eq 143
if kill -0 "$(cat "$run3/child.pid")" 2>/dev/null; then exit 1; fi
if "$lease3" status | grep -q '"owner": "C"'; then exit 1; fi

# lease: "run" stops the command's whole process group, a grandchild that ignores SIGTERM too, and
# releases the lease only once it is gone; a stop while waiting, or right after the lease is taken,
# releases it; --all on a renewal takes the other slots (or waits for them); nonsense numbers are
# usage errors (2; 64 for check), never tracebacks.
run5="$work/run5"
mkdir -p "$run5/bin"
cp "$scripts/lease" "$run5/bin/lease"
printf '%s\n' '{"printer": {"slots": 1, "max_minutes": 5}, "gpu": {"slots": 2, "max_minutes": 30}}' > "$run5/leases.json"
lease5="$run5/bin/lease"
"$lease5" run printer --owner C --minutes 0.1 -- sh -c 'trap "" TERM; sleep 60 & echo $! > "$1"; wait' sh "$run5/grand.pid" >/dev/null 2>&1 &
runner=$!
background="$background $runner"
wait_for_status "$run5" '"owner": "C"'
tries=0
until test -s "$run5/grand.pid"; do tries=$((tries + 1)); test "$tries" -lt 100; sleep 0.1; done
grand=$(cat "$run5/grand.pid")
background="$background $grand"
"$lease5" acquire printer --owner B --wait-minutes 3 >/dev/null &   # in line for the printer
waiter=$!
background="$background $waiter"
# the lease ends, the command ignores SIGTERM and is killed after a grace: until it is gone, the
# lease stays C's (so the waiter can't start on the printer beside it)
tries=0
while "$lease5" status | grep -q '"owner": "C"'; do tries=$((tries + 1)); test "$tries" -lt 600; sleep 0.1; done
if kill -0 "$grand" 2>/dev/null; then exit 1; fi         # the lease was let go only once it had gone
status=0
wait "$runner" || status=$?
test "$status" -eq 124
wait "$waiter"                                           # then the waiter got the printer
"$lease5" status | grep -q '"owner": "B"'
if kill -0 "$grand" 2>/dev/null; then exit 1; fi
"$lease5" release printer --owner B >/dev/null

"$lease5" acquire printer --owner A >/dev/null           # a stop while waiting for the turn
"$lease5" run printer --owner W --wait-minutes 1 -- true >/dev/null 2>&1 &
waiter=$!
background="$background $waiter"
wait_for_status "$run5" '"printer:W"'
kill -TERM "$waiter"
status=0
wait "$waiter" || status=$?
test "$status" -eq 143
if "$lease5" status | grep -q 'printer:W'; then exit 1; fi
"$lease5" release printer --owner A >/dev/null

python3 -I - "$lease5" "$run5" <<'EOF'
# a stop signal right after the lease was taken: exits 128+15 and the lease is released
import json, os, runpy, signal, sys
lease, run = sys.argv[1:]
ns = runpy.run_path(lease, run_name="lease")
real = ns["Leases"].acquire
def acquire_then_stop(self, *args):
    result = real(self, *args)
    os.kill(os.getpid(), signal.SIGTERM)
    return result
ns["Leases"].acquire = acquire_then_stop
code = ns["main"](["run", "printer", "--owner", "S", "--run", run, "--", "sleep", "30"])
assert code == 143, code
state = json.load(open(os.path.join(run, "locks", "state.json")))
assert state["leases"]["printer"] == [] and not state["waiting"], state
EOF

slots_of() { "$lease5" status | python3 -I -c 'import json, sys; print(sum(l["slots"] for l in json.load(sys.stdin)["leases"].get("gpu", []) if l["owner"] == sys.argv[1]))' "$1"; }
"$lease5" acquire gpu --owner A >/dev/null
"$lease5" acquire gpu --owner B >/dev/null
status=0
"$lease5" acquire gpu --owner A --all --wait-minutes 0.01 >/dev/null || status=$?
test "$status" -eq 75                                    # B holds the other slot: not held as --all
test "$(slots_of A)" -eq 1
test "$(slots_of B)" -eq 1
"$lease5" release gpu --owner B >/dev/null
"$lease5" acquire gpu --owner A --all --wait-minutes 0.01 >/dev/null
test "$(slots_of A)" -eq 2                               # the renewal took the other slot
status=0
"$lease5" acquire gpu --owner C --wait-minutes 0.01 >/dev/null || status=$?
test "$status" -eq 75                                    # the whole GPU is A's
"$lease5" release gpu --owner A >/dev/null

# "run": what a command that exited on its own left running is ended too, without changing its exit
# status; a command that can't start exits 127; a stop landing just after the child started (before it
# is noted) still ends it; killing lease itself (SIGKILL to its group) ends the command within seconds.
status=0
"$lease5" run printer --owner D -- sh -c 'sleep 60 & echo $! > "$1"; exit 7' sh "$run5/left.pid" >/dev/null 2>&1 || status=$?
test "$status" -eq 7
left=$(cat "$run5/left.pid")
background="$background $left"
if kill -0 "$left" 2>/dev/null; then exit 1; fi
if "$lease5" status | grep -q '"owner": "D"'; then exit 1; fi
status=0
"$lease5" run printer --owner E -- /nonexistent/command >/dev/null 2>&1 || status=$?
test "$status" -eq 127
if "$lease5" status | grep -q '"owner": "E"'; then exit 1; fi

python3 -I - "$lease5" "$run5" <<'EOF' >/dev/null
import json, os, runpy, signal, subprocess, sys
lease, run = sys.argv[1:]
ns = runpy.run_path(lease, run_name="lease")
real, started = subprocess.Popen, []
def popen(args, *more, **keywords):
    process = real(args, *more, **keywords)
    if args[0] == "sleep":
        started.append(process.pid)
        os.kill(os.getpid(), signal.SIGTERM)   # the stop lands with the child started and not yet noted
    return process
subprocess.Popen = popen
code = ns["main"](["run", "printer", "--owner", "P", "--run", run, "--", "sleep", "60"])
assert code == 143 and len(started) == 1, (code, started)
try:
    os.kill(started[0], 0)
    raise AssertionError("the child is still running")
except ProcessLookupError:
    pass
state = json.load(open(os.path.join(run, "locks", "state.json")))
assert state["leases"]["printer"] == [], state
EOF

python3 -I - "$lease5" "$run5" "$run5/killed.pid" <<'EOF'
import os, signal, subprocess, sys, time
lease, run, pidfile = sys.argv[1:]
script = 'trap "" TERM; echo $$ > "$1"; while :; do sleep 1; done'
runner = subprocess.Popen([lease, "run", "printer", "--owner", "K", "--run", run, "--", "sh", "-c", script, "sh", pidfile],
                          start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
deadline = time.time() + 60
while time.time() < deadline and not (os.path.exists(pidfile) and os.path.getsize(pidfile)):
    time.sleep(0.1)
child = int(open(pidfile).read())
os.killpg(runner.pid, signal.SIGKILL)   # a harness killing lease and its group, as on a tool timeout
runner.wait()
deadline = time.time() + 90
try:
    while time.time() < deadline:
        try:
            os.kill(child, 0)
        except ProcessLookupError:
            break
        time.sleep(0.2)
    else:
        raise AssertionError("the command outlived lease")
finally:
    try:
        os.killpg(child, signal.SIGKILL)
    except OSError:
        pass
EOF
"$lease5" release printer --owner K >/dev/null

# lease, killed: SIGKILL the moment the command's process exists (a hook between its start and anything
# else lease does): the watcher already knows the group, from the command's own child, and ends it; and
# SIGKILL shortly before the lease's end: the watcher's grace doesn't outlast the lease, so a waiter
# never starts on the resource beside a command that ignores SIGTERM.
python3 -I - "$lease5" "$run5" "$run5/hooked.pid" "$run5/late.pid" <<'EOF'
import os, signal, subprocess, sys, time
lease, run, hooked, late = sys.argv[1:]
def pid_of(path, seconds=60):
    deadline = time.time() + seconds
    while time.time() < deadline and not (os.path.exists(path) and os.path.getsize(path)):
        time.sleep(0.1)
    return int(open(path).read())
def gone(pid, seconds):
    deadline = time.time() + seconds
    while time.time() < deadline:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return True
        time.sleep(0.1)
    return False
stubborn = 'trap "" TERM; echo $$ > "$1"; while :; do sleep 1; done'
hook = r'''
import os, runpy, signal, subprocess, sys
ns = runpy.run_path(sys.argv[1], run_name="lease")
real = subprocess.Popen
def popen(args, *more, **keywords):
    process = real(args, *more, **keywords)
    if args[0] == "sh":
        os.kill(os.getpid(), signal.SIGKILL)   # lease dies as the command's process comes to exist
    return process
subprocess.Popen = popen
ns["main"](["run", "printer", "--owner", "H", "--run", sys.argv[2], "--", "sh", "-c", sys.argv[4], "sh", sys.argv[3]])
'''
runner = subprocess.Popen([sys.executable, "-I", "-c", hook, lease, run, hooked, stubborn], start_new_session=True,
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
runner.wait()
assert runner.returncode == -signal.SIGKILL, runner.returncode
child = pid_of(hooked)
try:
    assert gone(child, 60), "the command outlived a lease killed as it started"
finally:
    try:
        os.killpg(child, signal.SIGKILL)
    except OSError:
        pass
subprocess.run([lease, "release", "printer", "--owner", "H", "--run", run], check=True, capture_output=True)

runner = subprocess.Popen([lease, "run", "printer", "--owner", "L", "--run", run, "--minutes", "0.2", "--", "sh", "-c", stubborn,
                           "sh", late], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
child = pid_of(late)
started = time.time()
waiter = subprocess.Popen([lease, "acquire", "printer", "--owner", "B", "--run", run, "--wait-minutes", "3"],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
time.sleep(max(0, started + 9 - time.time()))          # the lease ends 12 s after it was taken
os.killpg(runner.pid, signal.SIGKILL)
runner.wait()
try:
    assert waiter.wait(timeout=120) == 0
    try:
        os.kill(child, 0)
        raise AssertionError("a waiter took the slot beside the command")
    except ProcessLookupError:
        pass
finally:
    try:
        os.killpg(child, signal.SIGKILL)
    except OSError:
        pass
subprocess.run([lease, "release", "printer", "--owner", "B", "--run", run], check=True, capture_output=True)
EOF

python3 -I - "$lease5" "$run5" <<'EOF' >/dev/null
# a stop that lands while the child starts, and a second one during the cleanup it causes: exit 128+15,
# the child ended, no traceback
import json, os, runpy, signal, subprocess, sys
lease, run = sys.argv[1:]
ns = runpy.run_path(lease, run_name="lease")
real, started = subprocess.Popen, []
def popen(args, *more, **keywords):
    process = real(args, *more, **keywords)
    if args[0] == "sleep":
        started.append(process.pid)
        os.kill(os.getpid(), signal.SIGTERM)
    return process
subprocess.Popen = popen
hold = ns["Leases"].hold
def hold_and_stop_again(self, *args):
    os.kill(os.getpid(), signal.SIGTERM)       # a second SIGTERM, while the cleanup runs
    return hold(self, *args)
ns["Leases"].hold = hold_and_stop_again
code = ns["main"](["run", "printer", "--owner", "Q", "--run", run, "--", "sleep", "60"])
assert code == 143 and len(started) == 1, (code, started)
try:
    os.kill(started[0], 0)
    raise AssertionError("the child is still running")
except ProcessLookupError:
    pass
assert json.load(open(os.path.join(run, "locks", "state.json")))["leases"]["printer"] == []
EOF

# a run inside an earlier, longer acquire, while another waits: what is given back never reaches past the
# end of the turn the renewal was capped at
run6="$work/run6"
mkdir -p "$run6/bin"
cp "$scripts/lease" "$run6/bin/lease"
printf '%s\n' '{"screen": {"slots": 1, "max_minutes": 30, "turn_minutes": 2}}' > "$run6/leases.json"
lease6="$run6/bin/lease"
"$lease6" acquire screen --owner A --minutes 30 >/dev/null
"$lease6" acquire screen --owner B --wait-minutes 3 >/dev/null &
waiter=$!
background="$background $waiter"
wait_for_status "$run6" '"screen:B"'
"$lease6" run screen --owner A --minutes 30 -- true >/dev/null 2>&1
"$lease6" status | python3 -I -c 'import json, sys; left = [l["minutes_left"] for l in json.load(sys.stdin)["leases"]["screen"] if l["owner"] == "A"]; sys.exit(0 if left and left[0] <= 2.1 else 1)'
kill "$waiter"
"$lease6" release screen --owner A >/dev/null

# A run, or an --all that times out, gives back only what it took: a lease the owner already held
# keeps its slots and its end time, and a waiting --all renewal doesn't renew what is held.
# succeeds when the owner's lease on the gpu has at most $2 minutes left
at_most() { "$lease5" status | python3 -I -c 'import json, sys; sys.exit(0 if max(l["minutes_left"] for l in json.load(sys.stdin)["leases"].get("gpu", []) if l["owner"] == sys.argv[1]) <= float(sys.argv[2]) else 1)' "$1" "$2"; }
"$lease5" acquire gpu --owner A --minutes 10 >/dev/null
"$lease5" acquire gpu --owner B >/dev/null
status=0
"$lease5" acquire gpu --owner A --all --minutes 25 --wait-minutes 0.01 >/dev/null || status=$?
test "$status" -eq 75
test "$(slots_of A)" -eq 1
at_most A 10.5                                           # held as it was, not renewed to 25
status=0
"$lease5" run gpu --owner A --all --wait-minutes 0.01 -- true >/dev/null 2>&1 || status=$?
test "$status" -eq 75
test "$(slots_of A)" -eq 1
at_most A 10.5                                           # and not released by the failed run
"$lease5" release gpu --owner B >/dev/null
"$lease5" run gpu --owner A --all -- true >/dev/null 2>&1           # succeeds, and gives the extra slot back
test "$(slots_of A)" -eq 1
at_most A 10.5
"$lease5" release gpu --owner A >/dev/null

usage_error() {
  status=0
  "$@" > "$run5/usage.out" 2>&1 || status=$?
  test "$status" -eq "$expected"
  if grep -q Traceback "$run5/usage.out"; then exit 1; fi
}
expected=2
usage_error "$lease5" acquire printer --owner A --minutes 0
usage_error "$lease5" acquire printer --owner A --minutes -5
usage_error "$lease5" acquire printer --owner A --minutes nan
usage_error "$lease5" acquire printer --owner A --wait-minutes -1
usage_error "$lease5" run printer --owner A --minutes 0 -- true
expected=64
usage_error "$lease5" check printer --owner A --minutes 0
expected=2
n=0
for config in '{"printer": {"slots": "two"}}' '{"printer": {"slots": 0}}' '{"printer": {"slots": 1.5}}' \
    '{"printer": {"max_minutes": -1}}' '{"printer": {"max_minutes": "soon"}}' '{"printer": {"max_minutes": NaN}}' \
    '{"printer": {"turn_minutes": 0}}' '{"printer": {"wait_minutes": -3}}' '{"printer": 5}' '[]'; do
  n=$((n + 1))
  mkdir -p "$work/badconfig$n"
  printf '%s\n' "$config" > "$work/badconfig$n/leases.json"
  usage_error "$lease5" acquire printer --owner A --run "$work/badconfig$n"
done
expected=64
usage_error "$lease5" check printer --owner A --run "$work/badconfig1"

# lease: a screen that needs the owner away, against a fake ioreg whose answers come from the file
# "owner" beside it ("<idle seconds|none> <locked|unlocked|garbage>"). Acquire waits, in queue order,
# until the screen is unlocked and the owner idle long enough; check tells a holder the owner came
# back; an unreadable state counts as not away.
run4="$work/run4"
mkdir -p "$run4/bin" "$run4/fake"
cp "$scripts/lease" "$run4/bin/lease"
printf '%s\n' '{"screen": {"slots": 1, "max_minutes": 15, "needs_owner_away_seconds": 300}, "gpu": {"slots": 1, "max_minutes": 30}, "camera": {"slots": 1, "needs_owner_away_seconds": 60, "owner_back_seconds": 120}}' > "$run4/leases.json"
cat > "$run4/fake/ioreg" <<'EOF'
#!/bin/sh
read -r idle lock < "$(dirname "$0")/owner"
case "$*" in
  *IOHIDSystem*) if [ "$idle" != none ]; then printf '    | |   "HIDIdleTime" = %s000000000\n' "$idle"; fi ;;
  *Root*)
    if [ "$lock" = garbage ]; then echo 'not a plist'; exit 1; fi
    printf '<?xml version="1.0" encoding="UTF-8"?>\n<plist version="1.0"><dict><key>IOConsoleUsers</key><array><dict>'
    if [ "$lock" = locked ]; then printf '<key>CGSSessionScreenIsLocked</key><true/>'; fi
    printf '<key>kCGSSessionIDKey</key><integer>257</integer></dict></array></dict></plist>\n' ;;
esac
EOF
chmod +x "$run4/fake/ioreg"
owner() { printf '%s %s\n' "$1" "$2" > "$run4/fake/owner.new"; mv "$run4/fake/owner.new" "$run4/fake/owner"; }
LEASE_IOREG="$run4/fake/ioreg"
export LEASE_IOREG
lease4="$run4/bin/lease"
check4() { status=0; "$lease4" check "$1" --owner "$2" > "$run4/check.out" 2>&1 || status=$?; test "$status" -eq "$3"; }
acquire4() { status=0; "$lease4" acquire "$1" --owner "$2" --wait-minutes 0.01 > "$run4/acquire.out" 2>&1 || status=$?; test "$status" -eq "$3"; }

owner 400 unlocked                                       # away: the screen is taken at once
acquire4 screen A 0
check4 screen A 0
"$lease4" status | grep -q '"idle_seconds": 400'
"$lease4" status | grep -q '"reader": '
grep -q 'owner read with' "$run4/locks/log.txt"
owner 100 unlocked                                       # idle under 300 s but over 30 s: A goes on,
check4 screen A 0                                        # while a newcomer would still wait
owner 5 unlocked                                         # the owner comes back mid-turn
check4 screen A 1
grep -q 'back at the computer' "$run4/check.out"
acquire4 screen A 0                                      # a renewal doesn't look (check does)
owner 400 locked                                         # or the screen locks
check4 screen A 2
owner 400 garbage                                        # or its lock state can't be read
check4 screen A 2
owner none unlocked                                      # or the idle time can't be read
check4 screen A 1
owner 400 unlocked
check4 screen A 0
"$lease4" release screen --owner A >/dev/null
check4 screen A 3                                        # released: no longer A's
check4 gpu A 3
"$lease4" acquire gpu --owner A >/dev/null               # a resource without the key ignores the owner
owner 5 locked
check4 gpu A 0
"$lease4" release gpu --owner A >/dev/null
status=0; "$lease4" check screen > /dev/null 2>&1 || status=$?; test "$status" -eq 64   # usage: not "locked"

owner 100 unlocked                                       # the resource's own thresholds
acquire4 camera A 0
check4 camera A 1
"$lease4" release camera --owner A >/dev/null

owner 100 unlocked                                       # not away long enough: the wait runs out
acquire4 screen B 75
grep -q 'at the computer (idle 100s, need 300s)' "$run4/acquire.out"
owner 900 locked                                         # locked counts as not away, however idle
acquire4 screen B 75
grep -q 'the screen is locked' "$run4/acquire.out"
owner 900 garbage                                        # and so does a state that can't be read
acquire4 screen B 75
owner none unlocked
acquire4 screen B 75
grep -q "idle time can't be read" "$run4/acquire.out"

owner 5 unlocked                                         # B waits first; once the owner is away,
"$lease4" acquire screen --owner B --wait-minutes 1 > "$run4/b.out" &   # C, behind it, doesn't get
waiter_b=$!                                              # the screen
background="$background $waiter_b"
wait_for_status "$run4" '"screen:B"'
owner 7 unlocked
sleep 2.5                                                # a poll with a new idle time says nothing new
