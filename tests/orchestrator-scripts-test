open(os.environ["FAKE_CODEX_PID"], "w").write(str(os.getpid()))
answer = json.dumps({"jsonrpc": "2.0", "id": 2, "result": {"rateLimits": {"planType": "plus",
    "primary": {"usedPercent": 12.5, "windowDurationMins": 300, "resetsAt": 1893456000},
    "secondary": {"usedPercent": 40, "windowDurationMins": 10080, "resetsAt": 1893999999}}}}) + "\n"
sys.stdin.readline(); sys.stdin.readline(); sys.stdin.readline()
cut = len(answer) // 2
sys.stdout.write(answer[:cut]); sys.stdout.flush()
if os.environ["FAKE_CODEX_MODE"] == "stall":
    time.sleep(60)
time.sleep(0.4)
sys.stdout.write(answer[cut:]); sys.stdout.flush()
time.sleep(60)
