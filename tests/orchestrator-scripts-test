        send({"jsonrpc": "2.0", "id": m["id"], "result": {"protocolVersion": m["params"]["protocolVersion"],
              "capabilities": {"tools": {}}, "serverInfo": {"name": "fake", "version": "1"}}})
    elif m["method"] == "tools/list":
        tools = [{"name": "speak", "inputSchema": {}}] + ([] if mode == "off" else [{"name": "offer_reading", "inputSchema": schema}])
        send({"jsonrpc": "2.0", "id": m["id"], "result": {"tools": tools}})
    elif m["method"] == "tools/call":
        if mode == "hang":
            time.sleep(60)
        send({"jsonrpc": "2.0", "method": "notifications/message", "params": {"level": "info", "data": "reading"}})
