                           os.path.join(run_dir, "report", "final-report.md"), "--repo", repo, "--out", out,
                           "--ask-for-tour", "--read-aloud", server, *extra], capture_output=True, text=True,
                          env=dict(os.environ, FAKE_LOG=log, FAKE_MODE=mode), timeout=60)
    lines = [json.loads(l) for l in open(log)] if os.path.exists(log) else []
    path = os.path.join(out, "offered.json")
    return done, lines, (json.load(open(path)) if os.path.exists(path) else None), time.monotonic() - started

