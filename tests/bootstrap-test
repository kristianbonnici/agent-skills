#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
test_home=$(mktemp -d "${TMPDIR:-/tmp}/agent-skills-test.XXXXXX")
trap 'rm -rf "$test_home"' EXIT HUP INT TERM

# A stand-in for the owner's private state repository.
state_repo="$test_home/agent-skills-state"
mkdir -p "$state_repo/.git" "$state_repo/long-horizon-orchestrator"
printf '# Providers\n' > "$state_repo/long-horizon-orchestrator/providers.md"
printf '# State\n' > "$state_repo/README.md"
export AGENT_SKILLS_STATE="$state_repo"
export XDG_STATE_HOME="$test_home/.local/state"
# Doctor asks npm for newer releases of the pinned runtimes; the test does that with a stand-in npm.
export AGENT_SKILLS_NO_UPDATE_CHECK=1

# An upgrade from a release that installed sketch-infographic (renamed excalidraw-drawing in 2.0.0):
# this repository's old links are retired; a path someone else put there is kept.
mkdir -p "$test_home/.claude/skills" "$test_home/.agents/skills" "$test_home/.codex/skills"
ln -s "$repo_root/skills/sketch-infographic" "$test_home/.claude/skills/sketch-infographic"
# This one looks like the old skill from another or a moved checkout: kept and reported, never removed.
ln -s "$test_home/old-checkout/skills/sketch-infographic/" "$test_home/.agents/skills/sketch-infographic"
ln -s "$test_home/elsewhere/sketch-infographic" "$test_home/.codex/skills/sketch-infographic"
HOME="$test_home" "$repo_root/scripts/doctor" --host claude >"$test_home/doctor-retired.out" 2>&1 || true
grep -q "sketch-infographic is a retired link still installed" "$test_home/doctor-retired.out"
HOME="$test_home" "$repo_root/scripts/bootstrap" --all --skip-dependencies --dry-run >"$test_home/dry.out" 2>&1
test -L "$test_home/.claude/skills/sketch-infographic"
grep -q "DRY RUN: rm $test_home/.claude/skills/sketch-infographic" "$test_home/dry.out"
if grep -q "REMOVED" "$test_home/dry.out"; then echo "a dry run says it removed something" >&2; exit 1; fi

HOME="$test_home" "$repo_root/scripts/bootstrap" --all --skip-dependencies >"$test_home/bootstrap.out" 2>&1
HOME="$test_home" "$repo_root/scripts/bootstrap" --all --skip-dependencies >/dev/null 2>&1
test ! -L "$test_home/.claude/skills/sketch-infographic"
test -L "$test_home/.agents/skills/sketch-infographic"
grep -q "KEEP $test_home/.agents/skills/sketch-infographic -> .*another checkout" "$test_home/bootstrap.out"
test "$(readlink "$test_home/.codex/skills/sketch-infographic")" = "$test_home/elsewhere/sketch-infographic"
grep -q "KEEP $test_home/.codex/skills/sketch-infographic" "$test_home/bootstrap.out"
HOME="$test_home" "$repo_root/scripts/doctor" --host claude >"$test_home/doctor-retired.out" 2>&1 || true
grep -q "PASS retired $test_home/.claude/skills/sketch-infographic not installed" "$test_home/doctor-retired.out"
HOME="$test_home" "$repo_root/scripts/doctor" --host codex >"$test_home/doctor-retired.out" 2>&1 || true
grep -q "PASS retired $test_home/.codex/skills/sketch-infographic holds something else; kept" "$test_home/doctor-retired.out"
grep -q "WARN $test_home/.agents/skills/sketch-infographic -> .* looks like the retired skill" "$test_home/doctor-retired.out"
rm "$test_home/.agents/skills/sketch-infographic"
# A relative link, or one with extra slashes, to the old skill is recognised the same way.
for odd in "skills/sketch-infographic" "$test_home/other/skills/sketch-infographic//" "$test_home/other/skills//sketch-infographic" "./skills/./sketch-infographic"; do
  ln -s "$odd" "$test_home/.agents/skills/sketch-infographic"
  HOME="$test_home" "$repo_root/scripts/doctor" --host codex >"$test_home/doctor-odd.out" 2>&1 || true
  grep -q "WARN $test_home/.agents/skills/sketch-infographic -> .* looks like the retired skill" "$test_home/doctor-odd.out"
  rm "$test_home/.agents/skills/sketch-infographic"
done
rm "$test_home/.codex/skills/sketch-infographic"

test -L "$test_home/.config/opencode/skills/product-design"
test -L "$test_home/.config/opencode/commands/product-design.md"
test -L "$test_home/.factory/skills/product-design"
test -f "$test_home/.gemini/config/skills/product-design/SKILL.md"
test -f "$test_home/.gemini/config/skills/product-design/scripts/browser"
test ! -e "$test_home/.agents/skills/product-design"
test ! -e "$test_home/.codex/skills/product-design"
test -L "$test_home/.agents/skills/long-horizon-task-planner"
test -L "$test_home/.codex/skills/long-horizon-task-planner"
test -L "$test_home/.agents/skills/agent-ready-repo"
test -L "$test_home/.codex/skills/agent-ready-repo"
test "$(readlink "$test_home/.agents/skills/agent-ready-repo")" = "$repo_root/skills/agent-ready-repo"
test "$(readlink "$test_home/.codex/skills/agent-ready-repo")" = "$repo_root/skills/agent-ready-repo"
test -f "$test_home/.codex/skills/agent-ready-repo/SKILL.md"
test -f "$test_home/.codex/skills/agent-ready-repo/agents/openai.yaml"
test -f "$test_home/.codex/skills/agent-ready-repo/references/assessment.md"
test -L "$test_home/.codex/skills/remote-session-reporting"
test -L "$test_home/.agents/skills/remote-session-reporting"
test "$(readlink "$test_home/.claude/skills/remote-session-reporting")" = "$repo_root/skills/remote-session-reporting"
test -f "$test_home/.claude/skills/remote-session-reporting/SKILL.md"
test "$(readlink "$test_home/.claude/skills/skill-evolution")" = "$repo_root/skills/skill-evolution"
test -L "$test_home/.codex/skills/skill-evolution"
test -f "$test_home/.agents/skills/skill-evolution/references/entries.md"
test "$(readlink "$test_home/.claude/skills/skill-evidence")" = "$repo_root/skills/skill-evidence"
test -L "$test_home/.codex/skills/skill-evidence"
test -f "$test_home/.agents/skills/skill-evidence/references/bar.md"
test "$(readlink "$test_home/.claude/skills/disk-cleanup")" = "$repo_root/skills/disk-cleanup"
test -L "$test_home/.codex/skills/disk-cleanup"
test -x "$test_home/.agents/skills/disk-cleanup/scripts/scan"
test "$(readlink "$test_home/.claude/skills/excalidraw-drawing")" = "$repo_root/skills/excalidraw-drawing"
test -L "$test_home/.codex/skills/excalidraw-drawing"
test -f "$test_home/.agents/skills/excalidraw-drawing/scripts/build.mjs"
state_link="$test_home/.local/state/agent-skills/long-horizon-orchestrator/providers.md"
test "$(readlink "$state_link")" = "$state_repo/long-horizon-orchestrator/providers.md"
test ! -e "$test_home/.local/state/agent-skills/README.md"

# Doctor checks the excalidraw-drawing runtime only for hosts that install that skill.
HOME="$test_home" "$repo_root/scripts/doctor" --host factory >"$test_home/doctor-factory.out" 2>&1 || true
if grep -q "excalidraw-drawing runtime" "$test_home/doctor-factory.out"; then
  echo "doctor --host factory checks the excalidraw-drawing runtime" >&2; exit 1
fi
HOME="$test_home" "$repo_root/scripts/doctor" --host claude >"$test_home/doctor-claude.out" 2>&1 || true
grep -q "excalidraw-drawing runtime" "$test_home/doctor-claude.out"

# A newer release of a pinned runtime is a warning, never a failure; no answer from npm is a skip.
# Doctor asks npm only about an installed runtime, so this part needs the repository's runtime.
if [ -f "$repo_root/runtime/excalidraw/node_modules/mcp-excalidraw-server/package.json" ]; then
fake_bin="$test_home/fake-npm"
mkdir -p "$fake_bin"
printf '#!/bin/sh\n[ "$1" = view ] && echo 99.0.0\n' >"$fake_bin/npm"
chmod +x "$fake_bin/npm"
AGENT_SKILLS_NO_UPDATE_CHECK= PATH="$fake_bin:$PATH" HOME="$test_home" "$repo_root/scripts/doctor" --host claude >"$test_home/doctor-newer.out" 2>&1 || true
grep -q "WARN mcp-excalidraw-server 99.0.0 is out; the runtime pins" "$test_home/doctor-newer.out"
if grep -q "FAIL.*99.0.0" "$test_home/doctor-newer.out"; then echo "a newer release failed doctor" >&2; exit 1; fi
printf '#!/bin/sh\nexit 1\n' >"$fake_bin/npm"
AGENT_SKILLS_NO_UPDATE_CHECK= PATH="$fake_bin:$PATH" HOME="$test_home" "$repo_root/scripts/doctor" --host claude >"$test_home/doctor-offline.out" 2>&1 || true
grep -q "SKIP could not ask npm whether mcp-excalidraw-server" "$test_home/doctor-offline.out"
# A prerelease of the pinned version is older than it, not newer.
printf '#!/bin/sh\n[ "$1" = view ] && echo 2.1.2-rc.1\n' >"$fake_bin/npm"
AGENT_SKILLS_NO_UPDATE_CHECK= PATH="$fake_bin:$PATH" HOME="$test_home" "$repo_root/scripts/doctor" --host claude >"$test_home/doctor-pre.out" 2>&1 || true
grep -q "mcp-excalidraw-server 2.1.2 is newer than npm's latest release, 2.1.2-rc.1" "$test_home/doctor-pre.out"
fi

# Hosts read the checkout itself through the links, so doctor fails while the checkout is off its
# default branch or a file a host reads has an uncommitted change. A stand-in checkout holds this
# repository's scripts and manifests, so this passes on any branch and with work in progress.
checkout="$test_home/checkout"
mkdir -p "$checkout"
cp -R "$repo_root/scripts" "$repo_root/install" "$checkout/"
"$repo_root/scripts/manifest" links | awk -F '\t' '$2 != "retired" { print $3 }' | sort -u | while IFS= read -r installed; do
  case "$installed" in
    skills/*) mkdir -p "$checkout/$installed"; echo stand-in >"$checkout/$installed/SKILL.md" ;;
    *) mkdir -p "$(dirname -- "$checkout/$installed")"; echo stand-in >"$checkout/$installed" ;;
  esac
done
in_checkout() {
  HOME="$test_home" git -C "$checkout" -c user.name=test -c user.email=test@example.invalid -c commit.gpgsign=false "$@"
}
checkout_doctor() {
  HOME="$test_home" "$checkout/scripts/doctor" "$@" >"$test_home/doctor-checkout.out" 2>&1 || true
}
in_checkout init -q
in_checkout symbolic-ref HEAD refs/heads/main
in_checkout add -A
in_checkout commit -q -m "A release"
checkout_doctor --host claude
grep -q "PASS checkout is on main" "$test_home/doctor-checkout.out"
grep -q "PASS installed files have no uncommitted changes" "$test_home/doctor-checkout.out"
# A changed file a host reads fails; it is another host's check only if that host reads it too.
echo edit >>"$checkout/skills/review-gate/SKILL.md"
checkout_doctor --host claude
grep -q "FAIL 1 installed file(s) changed and not committed, .*: skills/review-gate/SKILL.md$" "$test_home/doctor-checkout.out"
checkout_doctor --host factory
grep -q "PASS installed files have no uncommitted changes" "$test_home/doctor-checkout.out"
checkout_doctor --host codex
grep -q "FAIL 1 installed file(s) changed and not committed" "$test_home/doctor-checkout.out"
in_checkout checkout -q -- skills/review-gate/SKILL.md
# A new file counts too, also where git is told not to show untracked files.
in_checkout config status.showUntrackedFiles no
echo new >"$checkout/skills/review-gate/notes.md"
checkout_doctor --host claude
grep -q "FAIL 1 installed file(s) changed and not committed, .*: skills/review-gate/notes.md$" "$test_home/doctor-checkout.out"
# Five are named, the rest counted.
for extra in 1 2 3 4 5; do echo new >"$checkout/skills/review-gate/more-$extra.md"; done
checkout_doctor --host claude
grep -q "FAIL 6 installed file(s) changed and not committed, .*, \.\.\.$" "$test_home/doctor-checkout.out"
rm "$checkout/skills/review-gate/notes.md" "$checkout"/skills/review-gate/more-*.md
# A change no host reads does not count.
echo note >"$checkout/NOTES.md"
echo "# a comment" >>"$checkout/scripts/uninstall"
checkout_doctor --host claude
grep -q "PASS installed files have no uncommitted changes" "$test_home/doctor-checkout.out"
in_checkout add -A
in_checkout commit -q -m "Notes"
# Git failing to answer is a failure, not a clean checkout.
cp "$checkout/.git/index" "$test_home/index.kept"
echo "not an index" >"$checkout/.git/index"
checkout_doctor --host claude
grep -q "FAIL git could not say whether installed files have uncommitted changes" "$test_home/doctor-checkout.out"
cp "$test_home/index.kept" "$checkout/.git/index"
# Another branch, and a commit checked out by itself.
in_checkout checkout -q -b work
checkout_doctor --host claude
grep -q "FAIL checkout is on work, not main: " "$test_home/doctor-checkout.out"
in_checkout checkout -q --detach
checkout_doctor --host claude
grep -q "FAIL checkout is at a detached commit ([0-9a-f]*), not on main: " "$test_home/doctor-checkout.out"
# The default branch is the one the remote names, where a clone recorded it.
in_checkout checkout -q -b trunk
in_checkout update-ref refs/remotes/origin/trunk HEAD
in_checkout symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/trunk
checkout_doctor --host claude
grep -q "PASS checkout is on trunk" "$test_home/doctor-checkout.out"
in_checkout checkout -q main
checkout_doctor --host claude
grep -q "FAIL checkout is on main, not trunk: " "$test_home/doctor-checkout.out"
# A copy that is not a git checkout is skipped, also one that sits inside another repository.
rm -rf "$checkout/.git"
checkout_doctor --host claude
grep -q "SKIP .*/checkout is not a git checkout of its own" "$test_home/doctor-checkout.out"
HOME="$test_home" git -C "$test_home" init -q
checkout_doctor --host claude
grep -q "SKIP .*/checkout is not a git checkout of its own" "$test_home/doctor-checkout.out"
if grep -q "checkout is on\|installed file" "$test_home/doctor-checkout.out"; then
  echo "doctor judged a checkout that belongs to another repository" >&2; exit 1
fi
rm -rf "$test_home/.git"

# Uninstall removes a retired link that is still there too.
ln -s "$repo_root/skills/sketch-infographic" "$test_home/.claude/skills/sketch-infographic"
HOME="$test_home" "$repo_root/scripts/uninstall" --all >/dev/null
test ! -L "$test_home/.claude/skills/sketch-infographic"
test ! -e "$test_home/.config/opencode/skills/product-design"
test ! -e "$test_home/.factory/skills/product-design"
test ! -e "$test_home/.gemini/config/skills/product-design"
test ! -e "$test_home/.agents/skills/long-horizon-task-planner"
test ! -e "$test_home/.codex/skills/long-horizon-task-planner"
test ! -L "$test_home/.agents/skills/agent-ready-repo"
test ! -e "$test_home/.agents/skills/agent-ready-repo"
test ! -L "$test_home/.codex/skills/agent-ready-repo"
test ! -e "$test_home/.codex/skills/agent-ready-repo"
test ! -e "$test_home/.claude/skills/remote-session-reporting"
test ! -e "$test_home/.codex/skills/remote-session-reporting"
test ! -e "$test_home/.claude/skills/skill-evolution"
test ! -e "$test_home/.claude/skills/skill-evidence"
test ! -e "$test_home/.claude/skills/disk-cleanup"
test ! -e "$test_home/.claude/skills/excalidraw-drawing"
test ! -e "$test_home/.agents/skills/excalidraw-drawing"
test ! -e "$test_home/.codex/skills/skill-evidence"
test ! -L "$state_link"
test -f "$state_repo/long-horizon-orchestrator/providers.md"

echo "bootstrap-test: passed"
